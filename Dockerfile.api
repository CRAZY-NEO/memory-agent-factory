FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
WORKDIR /app
COPY requirements.api.lock.txt /app/requirements.api.lock.txt
RUN pip install --no-cache-dir -r requirements.api.lock.txt
COPY agent_factory /app/agent_factory
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["uvicorn", "agent_factory.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
