---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	understand(understand)
	retrieve(retrieve)
	plan(plan)
	generate(generate)
	validate(validate)
	review(review)
	advance(advance)
	select(select)
	test(test)
	persist(persist)
	__end__([<p>__end__</p>]):::last
	__start__ --> understand;
	advance --> generate;
	generate --> validate;
	plan --> generate;
	retrieve --> plan;
	review --> generate;
	select -.-> persist;
	select -.-> test;
	test --> persist;
	understand --> retrieve;
	validate -.-> advance;
	validate -.-> review;
	validate -.-> select;
	persist --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
