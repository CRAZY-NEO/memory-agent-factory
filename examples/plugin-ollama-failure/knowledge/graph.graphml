    <node id="source_2e0165dbc2241e8e6701bb3c93fd324a4cb82a2bc106ba30445793252228a40e">
      <data key="d0">Source</data>
      <data key="d1">{"path": "tfidf.md", "sha256": "2e0165dbc2241e8e6701bb3c93fd324a4cb82a2bc106ba30445793252228a40e", "text": "# 中文技术记忆检索：TF-IDF\n\n能力标识：char_tfidf。算法：tfidf。任务：memory_retrieval。\n输入 query、memories、top_k；输出有序的 memory id 和 score。\n\n中文技术笔记可以使用字符一至三元组 TF-IDF 与余弦相似度进行检索，无须额外标注训练数据。先在记忆文本上拟合向量器，再转换查询；不要把查询加入拟合语料。保留英文技术词并统一大小写。检索分数相同按 ID 排序，空查询、空语料和非正 top_k 返回空列表。\n\n适用：小规模中文与英文混合笔记、词面相近的排错记录和项目决策。\n指标：Recall@k、MRR@k、P95 查询耗时；依赖：scikit-learn。\n局限：难以解决同义改写和缺少词面重合的查询；原型每次查询重建索引。\n来源为本项目编写的演示算法说明，算法接口参考 scikit-learn 官方文档：\nhttps://scikit-learn.org/stable/modules/generated/sklearn.feature_extraction.text.TfidfVectorizer.html\n"}</data>
    </node>
    <node id="char_tfidf_efd747a4fcac">
      <data key="d0">Capability</data>
      <data key="d1">{"algorithm": "tfidf", "algorithm_plugin_version": "1.0.0", "applicable_conditions": ["小规模中文与英文混合笔记", "词面相近的排错记录", "项目决策"], "dependencies": ["scikit-learn"], "evidence": "中文技术记忆检索：TF-IDF\n\n能力标识：char_tfidf。算法：tfidf。任务：memory_retrieval。\n输入 query、memories、top_k；输出有序的 memory id 和 score。", "id": "char_tfidf_efd747a4fcac", "inputs": ["query", "memories", "top_k"], "limitations": ["难以解决同义改写", "缺少词面重合的查询", "原型每次查询重建索引"], "metrics": ["Recall@k", "MRR@k", "P95 查询耗时"], "name": "字符 TF-IDF", "outputs": ["memory id", "score"], "source_id": "source_2e0165dbc2241e8e6701bb3c93fd324a4cb82a2bc106ba30445793252228a40e", "task": "memory_retrieval"}</data>
    </node>
    <node id="bm25_8e927a9f2faf">
      <data key="d0">Capability</data>
      <data key="d1">{"algorithm": "bm25", "algorithm_plugin_version": "1.0.0", "applicable_conditions": ["小规模中文与英文混合笔记", "词面相近的排错记录", "项目决策"], "dependencies": [], "evidence": "中文技术笔记可以使用字符一至三元组 TF-IDF 与余弦相似度进行检索，无须额外标注训练数据。先在记忆文本上拟合向量器，再转换查询；不要把查询加入拟合语料。保留英文技术词并统一大小写。检索分数相同按 ID 排序，空查询、空语料和非正 top_k 返回空列表。", "id": "bm25_8e927a9f2faf", "inputs": ["query", "memories"], "limitations": ["难以解决同义改写", "缺少词面重合的查询", "原型每次查询重建索引"], "metrics": ["Recall@k", "MRR@k", "P95 查询耗时"], "name": "字符 BM25", "outputs": ["memory id", "score"], "source_id": "source_2e0165dbc2241e8e6701bb3c93fd324a4cb82a2bc106ba30445793252228a40e", "task": "memory_retrieval"}</data>
