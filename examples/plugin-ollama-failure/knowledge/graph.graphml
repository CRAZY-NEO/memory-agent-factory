4390243902439025}], "query": "Jetson Ollama 如何在局域网访问", "query_id": "v07", "relevant_ids": ["m13"]}, {"predictions": [{"id": "m16", "score": 0.37142857142857144}, {"id": "m24", "score": 0.04838709677419355}, {"id": "m11", "score": 0.038461538461538464}, {"id": "m15", "score": 0.037037037037037035}, {"id": "m07", "score": 0.03571428571428571}], "query": "文本分类类别不平衡不能只看 accuracy", "query_id": "v08", "relevant_ids": ["m16"]}, {"predictions": [{"id": "m19", "score": 0.2564102564102564}, {"id": "m20", "score": 0.08333333333333333}, {"id": "m09", "score": 0.07692307692307693}, {"id": "m23", "score": 0.057692307692307696}, {"id": "m05", "score": 0.046511627906976744}], "query": "SQLite 并发写事务被阻塞", "query_id": "v09", "relevant_ids": ["m19"]}, {"predictions": [{"id": "m21", "score": 0.16326530612244897}, {"id": "m02", "score": 0.08}, {"id": "m06", "score": 0.075}, {"id": "m11", "score": 0.06521739130434782}, {"id": "m08", "score": 0.046511627906976744}], "query": "BM25 和向量检索怎么融合", "query_id": "v10", "relevant_ids": ["m21"]}, {"predictions": [{"id": "m22", "score": 0.26}, {"id": "m11", "score": 0.04}, {"id": "m14", "score": 0.038461538461538464}, {"id": "m16", "score": 0.022222222222222223}, {"id": "m07", "score": 0.01818181818181818}], "query": "中文 TF-IDF 字符 ngram 余弦相似度", "query_id": "v11", "relevant_ids": ["m22"]}, {"predictions": [{"id": "m18", "score": 0.24444444444444444}, {"id": "m01", "score": 0.09259259259259259}, {"id": "m14", "score": 0.07692307692307693}, {"id": "m23", "score": 0.07142857142857142}, {"id": "m15", "score": 0.05660377358490566}], "query": "API 超时指数退避与幂等重试", "query_id": "v12", "relevant_ids": ["m18"]}], "query_count": 12, "split": "validation", "top_k": 5}}, {"algorithm": "jaccard", "capability_id": "char_jaccard_d9bf825b40ee", "code_hash": "e9774adb94c805494638b904d401f3808a6af29c8f9e0974d1b97204dac90257", "code_path": "examples/plugin-ollama-failure/jaccard/r2/retrieval.py", "explanation": "修复后的代码针对原代码中中文 bigram 处理逻辑不稳定的问题进行了重构。原代码强制将中文单字与相邻双字合并，导致在计算 Jaccard 相似度时引入了噪声，且无法准确反映纯字符集合的重合度。修复方案如下：\n\n1. **优化 token 提取逻辑**：移除了原代码中强制添加 bigram 的逻辑。现在只提取英文标识符（字母、数字、下划线）和中文单字。对于中文，仅保留单字，不再生成双字 bigram，这符合 Jaccard 算法基于集合重合度的核心定义。\n\n2. **修正计算策略**：在计算交集和并集时，直接使用 token 集合的 `&amp;` 和 `|` 操作符。由于所有 token 都是纯字符（无空格），并集的大小等于 token 总数，交集大小等于共同 token 数，因此分数计算逻辑 `len(intersection) / len(union)` 是准确的。\n\n3. **保持接口一致性**：函数签名 `retrieve(query, memories, top_k)` 保持不变，输入输出格式未变。验证逻辑中，空查询、空列表、非正 top_k 均返回空列表，符合原规范。同时，同分按 ID 排序的逻辑也得以保留，确保结果稳定性。\n\n该实现严格遵循了 `algorithm_plugin.guidance` 中关于仅使用集合交并比、不使用词频和 IDF 的要求，适用于小规模中文与英文混合的技术笔记检索场景。", "implementation_id": "implementation_20261013T101009_6655f03f_jaccard_r2", "parent": "implementation_20261013T101009_6655f03f_jaccard_r1", "revision": 2, "validation": {"errors": ["stability: fresh process returned different results"], "execution": {"runner": "docker", "wall_seconds": 0.24132699985057116}, "gates": {"algorithms": ["tfidf", "bm25", "jaccard"], "max_candidates": 3, "max_repairs": 2, "metrics": {"mrr_at_k": {"max": null, "min": 0.65}, "p95_ms": {"max": 1000.0, "min": null}, "precision_at_k": {"max": null, "min": 0.2}, "recall_at_k": {"max": null, "min": 0.75}}, "plugin_packages": [], "selection_order": ["recall_at_k", "mrr_at_k", "precision_at_k"], "task": "memory_retrieval", "timeout_seconds": 30.0}, "memory_count": 24, "metric_plugins": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "metrics": {"mrr_at_k": 1.0, "p95_ms": 1.0810350533574817, "precision_at_k": 0.20000000000000004, "recall_at_k": 1.0}, "passed": false, "per_query": [{"predictions": [{"id": "m01", "score": 0.25925925925925924}, {"id": "m02", "score": 0.05263157894736842}, {"id": "m17", "score": 0.05263157894736842}, {"id": "m18", "score": 0.04918032786885246}, {"id": "m24", "score": 0.046875}], "query": "MySQL 连接池等待导致请求超时怎么排查", "query_id": "v01", "relevant_ids": ["m01"]}, {"predictions": [{"id": "m03", "score": 0.17777777777777778}, {"id": "m04", "score": 0.10638297872340426}, {"id": "m15", "score": 0.08333333333333333}, {"id": "m20", "score": 0.06976744186046512}, {"id": "m01", "score": 0.06896551724137931}], "query": "Redis 不存在的 key 一直查数据库", "query_id": "v02", "relevant_ids": ["m03"]}, {"predictions": [{"id": "m05", "score": 0.2702702702702703}, {"id": "m06", "score": 0.09523809523809523}, {"id": "m03", "score": 0.06521739130434782}, {"id": "m14", "score": 0.06521739130434782}, {"id": "m15", "score": 0.043478260869565216}], "query": "Docker 容器退出 137 内存不足", "query_id": "v03", "relevant_ids": ["m05"]}, {"predictions": [{"id": "m07", "score": 0.17391304347826086}, {"id": "m24", "score": 0.037037037037037035}, {"id": "m08", "score": 0.022727272727272728}, {"id": "m14", "score": 0.02127659574468085}, {"id": "m01", "score": 0.017857142857142856}], "query": "Git rebase 冲突如何处理", "query_id": "v04", "relevant_ids": ["m07"]}, {"predictions": [{"id": "m09", "score": 0.22}, {"id": "m19", "score": 0.06382978723404255}, {"id": "m17", "score": 0.04}, {"id": "m01", "score": 0.034482758620689655}, {"id": "m20", "score": 0.023255813953488372}], "query": "asyncio 同步请求阻塞事件循环", "query_id": "v05", "relevant_ids": ["m09"]}, {"predictions": [{"id": "m11", "score": 0.14285714285714285}, {"id": "m21", "score": 0.07272727272727272}, {"id": "m02", "score": 0.06}, {"id": "m23", "score": 0.05357142857142857}, {"id": "m06", "score": 0.0425531914893617}], "query": "RAG 检索效果用哪些指标评估", "query_id": "v06", "relevant_ids": ["m11"]}, {"predictions": [{"id": "m13", "score": 0.14893617021276595}, {"id": "m06", "score": 0.09523809523809523}, {"id": "m03", "score": 0.06521739130434782}, {"id": "m04", "score": 0.043478260869565216}, {"id": "m20", "score": 0.024390243902439025}], "query": "Jetson Ollama 如何在局域网访问", "query_id": "v07", "relevant_ids": ["m13"]}, {"predictions": [{"id": "m16", "score": 0.34285714285714286}, {"id": "m24", "score": 0.05357142857142857}, {"id": "m15", "score": 0.041666666666666664}, {"id": "m11", "score": 0.03773584905660377}, {"id": "m12", "score": 0.03773584905660377}], "query": "文本分类类别不平衡不能只看 accuracy", "query_id": "v08", "relevant_ids": ["m16"]}, {"predictions": [{"id": "m19", "score": 0.24324324324324326}, {"id": "m20", "score": 0.08108108108108109}, {"id": "m09", "score": 0.07547169811320754}, {"id": "m23", "score": 0.058823529411764705}, {"id": "m05", "score": 0.046511627906976744}], "query": "SQLite 并发写事务被阻塞", "query_id": "v09", "relevant_ids": ["m19"]}, {"predictions": [{"id": "m21", "score": 0.16326530612244897}, {"id": "m02", "score": 0.0851063829787234}, {"id": "m06", "score": 0.06818181818181818}, {"id": "m11", "score": 0.058823529411764705}, {"id": "m08", "score": 0.044444444444444446}], "query": "BM25 和向量检索怎么融合", "query_id": "v10", "relevant_ids": ["m21"]}, {"predictions": [{"id": "m22", "score": 0.3111111111111111}, {"id": "m14", "score": 0.04081632653061224}, {"id": "m11", "score": 0.03773584905660377}, {"id": "m16", "score": 0.021739130434782608}, {"id": "m02", "score": 0.0196078431372549}], "query": "中文 TF-IDF 字符 ngram 余弦相似度", "query_id": "v11", "relevant_ids": ["m22"]}, {"predictions": [{"id": "m18", "score": 0.24444444444444444}, {"id": "m01", "score": 0.09090909090909091}, {"id": "m14", "score": 0.0851063829787234}, {"id": "m23", "score": 0.07407407407407407}, {"id": "m15", "score": 0.06382978723404255}], "query": "API 超时指数退避与幂等重试", "query_id": "v12", "relevant_ids": ["m18"]}], "query_count": 12, "split": "validation", "top_k": 5}}], "dataset_hashes": {"memories.json": "95f29cd9ec9088a3e2e531dd5eb30417178dd8d489cf7891caebf55c376bf2bf", "test_queries.json": "3c5c674a30ac8b77037aa9767fbff88eba5f0c276e0f207a28dc68ef06a08fe2", "validation_queries.json": "88ba34d04d0e885026cd26c1ad3d778afd78282246a37147bb4c7cf6267bc9c1"}, "description": "请为个人技术记忆库复刻检索算法，分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较三者，不要只选择其中一个来生成。输入 query、memories、top_k，输出相关记忆 ID 与分数，默认前 5 条。每个候选使用自己的评分方法：TF-IDF 使用余弦相似度，BM25 使用词频与逆文档频率，Jaccard 使用词集合交并比；Jaccard 的集合规则仅约束 Jaccard 候选，不能用于排除 TF-IDF 或 BM25。三者都遵循各自的算法插件指导和参考示例。按配置评估 Recall@k、MRR@k、Precision@k 和 P95 查询耗时，同时检查接口、空输入及跨进程稳定性，选择验证通过的方案并将结果沉淀回知识库。\n", "environment": {"dependencies": {"langgraph": "1.2.14", "networkx": "3.7", "pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": "agent-factory-runner:0.1", "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "docker"}, "llm_calls": 10, "mock_fault_algorithm": null, "mock_fault_injection": false, "model": "qwen3.5:2b", "plan": {"candidates": [{"algorithm": "jaccard", "capability_id": "char_jaccard_d9bf825b40ee", "rationale": "用户明确要求生成 TF-IDF、BM25、Jaccard 三个独立候选并比较，且 Jaccard 仅用于集合重合检索。Jaccard 依赖 Python 标准库，无需额外依赖，适合小规模中文与英文混合笔记，能轻量且可解释地计算词集合重合度，符合“需要轻量且可解释的词集合重合检索”的适用条件。"}], "design_explanation": "设计解释：为满足用户“分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较”的需求，且 Jaccard 仅用于集合重合检索，同时遵循“不能修改验证门槛”和“算法尚未执行”的原则，我们构建了三个独立的算法候选。TF-IDF 候选基于 scikit-learn 实现，适用于词面相近的排错记录；BM25 候选基于 Python 标准库实现，适用于不同长度笔记及明确组件名查询；Jaccard 候选基于 Python 标准库实现，适用于轻量且可解释的集合重合检索。三者均遵循各自的算法插件指导，并评估了 Recall@k、MRR@k、Precision@k 和 P95 查询耗时指标。由于算法尚未执行，暂无法提供验证结果，但候选方案已完整规划。"}, "plugin_catalog": {"algorithms": [{"dependencies": ["scikit-learn"], "environment": "retrieval-v1", "guidance": "使用 sklearn 字符 1 至 3 元组 TF-IDF 与余弦相似度。拟合语料仅为记忆文本，transform([query]) 后与整个语料计算相似度。", "id": "tfidf", "name": "字符 TF-IDF", "task": "memory_retrieval", "version": "1.0.0"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用原文中的非负 IDF、k1=1.5 和 b=0.75。中文单字/双字及英文词分词；将去重的查询词排序后累加，保持跨进程浮点结果一致。", "id": "bm25", "name": "字符 BM25", "task": "memory_retrieval", "version": "1.0.0"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用中文单字/双字及英文词的集合交并比 len(Q &amp; D)/len(Q | D)。不使用词频、TF-IDF 或 BM25；只返回正分结果，处理空集合。", "id": "jaccard", "name": "集合 Jaccard", "task": "memory_retrieval", "version": "1.0.0"}], "metrics": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "modules": ["agent_factory.plugins.algorithms.bm25", "agent_factory.plugins.algorithms.jaccard", "agent_factory.plugins.algorithms.tfidf", "agent_factory.plugins.metrics.latency", "agent_factory.plugins.metrics.mrr", "agent_factory.plugins.metrics.precision", "agent_factory.plugins.metrics.recall"]}, "provider": "ollama", "request": {"description": "请为个人技术记忆库复刻检索算法，分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较三者，不要只选择其中一个来生成。输入 query、memories、top_k，输出相关记忆 ID 与分数，默认前 5 条。每个候选使用自己的评分方法：TF-IDF 使用余弦相似度，BM25 使用词频与逆文档频率，Jaccard 使用词集合交并比；Jaccard 的集合规则仅约束 Jaccard 候选，不能用于排除 TF-IDF 或 BM25。三者都遵循各自的算法插件指导和参考示例。按配置评估 Recall@k、MRR@k、Precision@k 和 P95 查询耗时，同时检查接口、空输入及跨进程稳定性，选择验证通过的方案并将结果沉淀回知识库。\n", "language": "zh", "task": "memory_retrieval", "top_k": 5}, "run_id": "20261013T101009_6655f03f", "runner": "docker", "selected": null, "status": "failed_validation", "test": null, "validation_config": {"algorithms": ["tfidf", "bm25", "jaccard"], "max_candidates": 3, "max_repairs": 2, "metrics": {"mrr_at_k": {"max": null, "min": 0.65}, "p95_ms": {"max": 1000.0, "min": null}, "precision_at_k": {"max": null, "min": 0.2}, "recall_at_k": {"max": null, "min": 0.75}}, "plugin_packages": [], "selection_order": ["recall_at_k", "mrr_at_k", "precision_at_k"], "task": "memory_retrieval", "timeout_seconds": 30.0}, "workflow_events": ["understand", "retrieve", "plan", "generate", "validate", "review", "generate", "validate", "review", "generate", "validate", "select", "persist"]}</data>
