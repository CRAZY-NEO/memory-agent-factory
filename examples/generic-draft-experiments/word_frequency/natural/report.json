            "signature": "def tokenize_word_regex(text: str) -> list[str]",
            "code_excerpt": "def tokenize_word_regex(text: str) -> list[str]:\n    \"\"\"re.findall(r\"\\\\w+\", text) – word chars only, case-sensitive.\"\"\"\n    return re.findall(r\"\\w+\", text)\n",
            "file_sha256": "fcc25f3026bc432576669a57f9c6250ff20c676917e424f35566cd105823c11a"
          },
          {
            "path": "methods/feature_methods.py",
            "name": "tokenize_word_regex_lower",
            "signature": "def tokenize_word_regex_lower(text: str) -> list[str]",
            "code_excerpt": "def tokenize_word_regex_lower(text: str) -> list[str]:\n    \"\"\"re.findall(r\"\\\\w+\", text.lower()) – word chars, case-normalized.\"\"\"\n    return re.findall(r\"\\w+\", text.lower())\n",
