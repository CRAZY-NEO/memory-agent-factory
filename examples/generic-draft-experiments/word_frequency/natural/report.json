            "code_excerpt": "def counter_lowercase_baseline(records: list[str]) -> dict:\n    \"\"\"Counter with re.findall(r\"\\\\w+\"), case-normalized.\"\"\"\n    return _run_pipeline(records, tokenize_word_regex_lower)\n",
