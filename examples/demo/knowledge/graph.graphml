      <data key="d1">{"algorithm": "tfidf", "applicable_conditions": ["小规模中文与英文混合笔记、词面相近的排错记录和项目决策。"], "dependencies": ["scikit-learn"], "evidence": "适用：小规模中文与英文混合笔记、词面相近的排错记录和项目决策。", "id": "char_tfidf_2e0165db", "inputs": ["query", "memories", "top_k"], "limitations": ["局限：难以解决同义改写和缺少词面重合的查询；原型每次查询重建索引。"], "metrics": ["recall_at_k", "mrr_at_k", "p95_ms"], "name": "中文技术记忆 tfidf", "outputs": ["id", "score"], "source_id": "source_2e0165dbc2241e8e6701bb3c93fd324a4cb82a2bc106ba30445793252228a40e", "task": "memory_retrieval"}</data>
    </node>
