    <node id="environment_04adb4fc09973cf3273683081aa283f2a17f92da28ab1d3e10d932d47363e891">
      <data key="d0">Environment</data>
      <data key="d1">{"dependencies": {"langgraph": "1.2.14", "networkx": "3.7", "pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": null, "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "local"}</data>
