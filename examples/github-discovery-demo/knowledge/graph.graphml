    <node id="code_candidate_8e0632accb7e30880bdf7375b957a6d29755abf07e278899af5f443fb04385b9">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def get_user_indices_dir():\n    \"\"\"Get the user's BM25S indices directory (~/.bm25s/indices/).\"\"\"\n    return Path.home() / \".bm25s\" / \"indices\"\n", "code_sha256": "67c8a8d0ce498e19b69dcf710027861bb31f4c81959ab87a1755f7da5fd195ad", "comments": [], "decorators": [], "definition_line": 22, "docstring": "Get the user's BM25S indices directory (~/.bm25s/indices/).", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "494e56b9ebbe6dbee99d7037fdad57f53423edd7135b51252c8f65ce514a9a38", "id": "code_candidate_8e0632accb7e30880bdf7375b957a6d29755abf07e278899af5f443fb04385b9", "imports": [{"alias": null, "level": 0, "line": 15, "module": "argparse", "name": null}, {"alias": null, "level": 0, "line": 16, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 17, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 56, "module": "rich.console", "name": "Console"}, {"alias": null, "level": 0, "line": 57, "module": "rich.prompt", "name": "Prompt"}, {"alias": null, "level": 0, "line": 58, "module": "rich.table", "name": "Table"}, {"alias": null, "level": 0, "line": 59, "module": "rich.panel", "name": "Panel"}, {"alias": "create_index", "level": 2, "line": 130, "module": "high_level", "name": "index"}, {"alias": "load_documents", "level": 2, "line": 130, "module": "high_level", "name": "load"}, {"alias": null, "level": 2, "line": 195, "module": null, "name": "BM25"}, {"alias": null, "level": 2, "line": 196, "module": "high_level", "name": "BM25Search"}], "kind": "function", "line_end": 24, "line_start": 22, "name": "get_user_indices_dir", "parameters": [], "path": "bm25s/terminal/__init__.py", "qualified_name": "get_user_indices_dir", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def get_user_indices_dir()", "source_id": "repo_source_07bb3f9d9e9e6d192a8e90071f73214bbdf17535524595dd05f9192de6312b49", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
