      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_vocab_dict(self):\n        \"\"\"Tests the `get_vocab_dict` method to ensure it returns the correct vocabulary dictionary.\"\"\"\n        self.tokenizer.tokenize(self.corpus, update_vocab=True, show_progress=False)\n        vocab = self.tokenizer.get_vocab_dict()\n        self.assertIsInstance(vocab, dict)\n        self.assertGreater(len(vocab), 0)\n", "code_sha256": "2dbe76e33b30e736dbc343c7a810a3d1499e81d16494ee19e54a3a55e7bab777", "comments": [], "decorators": [], "definition_line": 99, "docstring": "Tests the `get_vocab_dict` method to ensure it returns the correct vocabulary dictionary.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_ca973066df1b93abb87620fa58320669e4a84759ec1f092df945c79821b4b0f2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 104, "line_start": 99, "name": "test_get_vocab_dict", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_get_vocab_dict", "repository_key": "c8acc94ab355e