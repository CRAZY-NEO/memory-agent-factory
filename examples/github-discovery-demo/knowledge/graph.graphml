      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def merge(cls, results: List[\"Results\"]) -&gt; \"Results\":\n        \"\"\"\n        Merge a list of Results objects into a single Results object.\n        \"\"\"\n        documents = np.concatenate([r.documents for r in results], axis=0)\n        scores = np.concatenate([r.scores for r in results], axis=0)\n        return cls(documents=documents, scores=scores)\n", "code_sha256": "90ad715ffe6be97ea1d496a4b147e7287097a81d7c769ddacd6f1dcc9e4f822f", "comments": [], "decorators": ["classmethod"], "definition_line": 81, "docstring": "\n        Merge a list of Results objects into a single Results object.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_de04b9fd32105c2d9b9d57bdc1cc64fceaccfcdd85d26c4ebd745f246537c6f1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, 