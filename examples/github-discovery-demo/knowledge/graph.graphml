un_id": "20261014T104638_183b968d", "source": {"commit": "03eac5a8fb3aa4958ce37415a4cf2220d35157f7", "license": "MIT", "repository": "xhluca/bm25s", "url": "https://github.com/xhluca/bm25s"}, "status": "approved", "task": "memory_retrieval", "version": "20261014T104638_183b968d"}, "search_queries": ["BM25Plus", "BM25"], "source": {"commit": "03eac5a8fb3aa4958ce37415a4cf2220d35157f7", "license": "MIT", "repository": "xhluca/bm25s", "url": "https://github.com/xhluca/bm25s"}, "source_contract": {"adapter_hint": "def score_term(tf, df, doc_len, avg_len, N):\n    if avg_len &lt;= 0 or df &lt;= 0:\n        return 0.0\n    return source_tf_component(tf, doc_len, avg_len, 1.5, 0.75, 0.5) * source_idf_component(df, N)", "cases": [{"expected": [{"id": "a", "score": 1.1996778125075978}, {"id": "b", "score": 1.0397207708399179}, {"id": "c", "score": 0.34657359027997264}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha", "top_k": 3}, {"expected": [{"id": "a", "score": 2.3993556250151955}, {"id": "b", "score": 2.0794415416798357}, {"id": "c", "score": 0.6931471805599453}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha alpha", "top_k": 3}], "defaults": {"b": 0.75, "delta": 0.5, "k1": 1.5}, "kernel_helpers": "import math\n\ndef source_tf_component(tf_array, l_d, l_avg, k1, b, delta):\n    num = (k1 + 1) * tf_array\n    den = k1 * (1 - b + b * l_d / l_avg) + tf_array\n    return num / den + delta\n\ndef source_idf_component(df, N):\n    return math.log((N + 1) / df)", "kernels": [{"code": "def _score_tfc_bm25plus(tf_array, l_d, l_avg, k1, b, delta):\n    num = (k1 + 1) * tf_array\n    den = k1 * (1 - b + b * l_d / l_avg) + tf_array\n    return (num / den) + delta", "path": "bm25s/scoring.py", "qualified_name": "_score_tfc_bm25plus"}, {"code": "def _score_idf_bm25plus(df, N):\n    return math.log((N + 1) / df)", "path": "bm25s/scoring.py", "qualified_name": "_score_idf_bm25plus"}], "scope": "Small public numeric examples; not a proof of full repository equivalence", "status": "derived_scalar_formula_cases"}}, "environment": {"dependencies": {"langgraph": "1.2.14", "networkx": "3.7", "pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": "agent-factory-runner:0.1", "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "docker", "worker_sha256": "b1101f539da9232bf8bb10ae375a6df8e8c1577775b09b77dc0f257636c7d94f"}, "generation_policy": "focused-repair-v2", "llm_calls": 7, "mock_fault_algorithm": null, "mock_fault_injection": false, "model": "qwen3.5:2b", "plan": {"candidates": [{"algorithm": "github_bm25plus", "capability_id": "cap_github_bm25plus_20261014t104638_183b968d", "rationale": "该仓库提供了基于NumPy和Numba的Fast BM25实现，支持中文与英文混合检索，符合用户要求的retrieve(query, memories, top_k=5)接口。其开源许可（MIT）和独立算法库属性使其适合作为后续工厂任务的基础。相比其他仓库，它更专注于高性能计算，且未过度依赖PyTorch等框架，便于用户直接复刻和扩展。"}], "design_explanation": "从实际 GitHub 搜索结果下载固定提交，依据来源证据复刻新方法：The BM25Plus algorithm adapts the standard BM25 scoring by incorporating a delta parameter to adjust document relevance scores. It utilizes a unified tokenization pipeline to convert query and corpus tokens into indices before applying the scoring formula. The implementation requires a custom backend selection mechanism to handle different numerical computation backends efficiently."}, "plugin_catalog": {"algorithms": [{"dependencies": [], "environment": "retrieval-v1", "guidance": "Reproduce BM25Plus from the pinned source scoring functions and constructor defaults. Adapt the retrieve interface and tokenizer only; do not mix in unrelated scoring methods or install dependencies.", "id": "github_bm25plus", "name": "BM25Plus", "provenance": {"commit": "03eac5a8fb3aa4958ce37415a4cf2220d35157f7", "license": "MIT", "repository": "xhluca/bm25s", "url": "https://github.com/xhluca/bm25s"}, "public_cases": [{"expected": [{"id": "a", "score": 1.1996778125075978}, {"id": "b", "score": 1.0397207708399179}, {"id": "c", "score": 0.34657359027997264}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha", "top_k": 3}, {"expected": [{"id": "a", "score": 2.3993556250151955}, {"id": "b", "score": 2.0794415416798357}, {"id": "c", "score": 0.6931471805599453}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha alpha", "top_k": 3}], "task": "memory_retrieval", "version": "20261014T104638_183b968d"}], "metrics": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "modules": ["agent_factory.plugins.algorithms.bm25", "agent_factory.plugins.algorithms.jaccard", "agent_factory.plugins.algorithms.tfidf", "agent_factory.plugins.metrics.latency", "agent_factory.plugins.metrics.mrr", "agent_factory.plugins.metrics.precision", "agent_factory.plugins.metrics.recall"]}, "provider": "ollama", "request": {"description": "请为中文