    <node id="code_candidate_5b2047046bb3678031ea3bca48a41c18e06e10f4374aec15832f16df68e2e2c4">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_scores_with_list_of_ints(self):\n        \"\"\"Test get_scores with list of token IDs (ints)\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Get some valid token IDs\n        valid_token_ids = list(retriever.vocab_dict.values())[:3]\n        \n        # Should work with int token IDs\n        scores = retriever.get_scores(valid_token_ids)\n        \n        self.assertIsInstance(scores, np.ndarray)\n        self.assertEqual(len(scores), len(self.corpus))\n", "code_sha256": "8ea8f4502eb78231cfddbfa04c1766f308ec9930551c9ac723debcccd5d32e44", "comments": [{"line": 166, "text": "# Get some valid token IDs"}, {"line": 169, "text": "# Should work with int token IDs"}], "decorators": [], "definition_line": 161, "docstring": "Test get_scores with list of token IDs (ints)", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_5b2047046bb3678031ea3bca48a41c18e06e10f4374aec15832f16df68e2e2c4", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 173, "line_start": 161, "name": "test_get_scores_with_list_of_ints", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_get_scores_with_list_of_ints", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_get_scores_with_list_of_ints(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
