      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_init_loads_existing_index(self):\n        \"\"\"Test JsonlCorpus loads existing mmindex\"\"\"\n        # Create corpus first time\n        corpus1 = JsonlCorpus(self.test_file, show_progress=False, save_index=True)\n        corpus1.close()\n        \n        # Create corpus second time (should load existing index)\n        corpus2 = JsonlCorpus(self.test_file, show_progress=False, save_index=False)\n        self.assertEqual(len(corpus2), 5)\n        corpus2.close()\n", "code_sha256": "217aedef3f56e2b76216ea6987235ce7befcd7b2e54da0183f6245d47f355608", "comments": [{"line": 134, "text": "# Create corpus first time"}, {"line": 138, "text": "# Create corpus second time (should load existing index)"}], "decorators": [], "definition_line": 132, "docstring": "Test JsonlCorpus loads existing mmindex", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_f512c194053d088c259d68c1a8885f255b2bf8d2eb0b777e46d5a1c6e5b73789", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 141, "line_start": 132, "name": "test_jsonl_corpus_init_loads_existing_index", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestJsonlCorpus.test_jsonl_corpus_init_loads_existing_index", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_jsonl_corpus_init_loads_existing_index(self)", "source_id": "repo_source_4788d7ad1823b10d4c7616a36d80244f130a74dc22f961e34ba43e6e81e60af6", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
