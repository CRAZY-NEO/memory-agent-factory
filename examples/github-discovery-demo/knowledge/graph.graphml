    <node id="code_candidate_c02fcbbbfb7374e383bf0c3c0985baca717bf2780ac0dde1a8743bd3377ccf49">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def merge_cqa_dupstack(data_path, show_progress=True, leave_progress=False):\n    data_path = Path(data_path)\n    dataset = data_path.name\n    assert dataset == \"cqadupstack\", \"Dataset must be CQADupStack\"\n\n    # check if corpus.jsonl exists\n    corpus_path = data_path / \"corpus.jsonl\"\n    if not corpus_path.exists():\n        # combine all the corpus files into one\n        # corpus files are located under cqadupstack/&lt;name&gt;/corpus.jsonl\n        corpus_files = list(data_path.glob(\"*/corpus.jsonl\"))\n        with open(corpus_path, \"w\") as f:\n            for file in tqdm(corpus_files, desc=\"Merging Corpus\", leave=leave_progress, disable=not show_progress):\n                # get the name of the corpus\n                corpus_name = file.parent.name\n\n                with open(file, \"r\") as f2:\n                    for line in tqdm(\n                        f2, desc=f\"Merging {corpus_name} Corpus\", leave=leave_progress, disable=not show_progress\n                    ):\n                        line = json_functions.loads(line)\n                        # add the corpus name to _id\n                        line[\"_id\"] = f\"{corpus_name}_{line['_id']}\"\n                        # write back to file\n                        f.write(json.dumps(line)) # json_functions.dumps generates json that can't be read by beir\n                        f.write(\"\\n\")\n\n    # now, do the same for queries.jsonl\n    queries_path = data_path / \"queries.jsonl\"\n    if not queries_path.exists():\n        queries_files = list(data_path.glob(\"*/queries.jsonl\"))\n        with open(queries_path, \"w\") as f:\n            for file in tqdm(queries_files, desc=\"Merging Queries\", leave=leave_progress, disable=not show_progress):\n                # get the name of the corpus\n                corpus_name = file.parent.name\n\n                with open(file, \"r\") as f2:\n                    for line in tqdm(\n                        f2, desc=f\"Merging {corpus_name} Queries\", leave=leave_progress, disable=not show_progress\n                    ):\n                        line = json_functions.loads(line)\n                        # add the corpus name to _id\n                        line[\"_id\"] = f\"{corpus_name}_{line['_id']}\"\n                        # write back to file\n                        f.write(json_functions.dumps(line))\n                        f.write(\"\\n\")\n\n    # now, do the same for qrels/test.tsv\n    qrels_path = data_path / \"qrels\" / \"test.tsv\"\n    qrels_path.parent.mkdir(parents=True, exist_ok=True)\n\n    if not qrels_path.exists():\n        qrels_files = list(data_path.glob(\"*/qrels/test.tsv\"))\n        with open(qrels_path, \"w\") as f:\n            # First, write the columns: query-id\tcorpus-id\tscore\n            f.write(\"query-id\\tcorpus-id\\tscore\\n\")\n            for file in tqdm(qrels_files, desc=\"Merging Qrels\", leave=leave_progress, disable=not show_progress):\n                # get the name of the corpus\n                corpus_name = file.parent.parent.name\n                with open(file, \"r\") as f2:\n                    # skip first line\n                    next(f2)\n\n                    for line in tqdm(\n                        f2, desc=f\"Merging {corpus_name} Qrels\", leave=leave_progress, disable=not show_progress\n                    ):\n                        # since it's a tsv, split by tab\n                        qid, cid, score = line.strip().split(\"\\t\")\n                        # add the corpus name to _id\n                        qid = f\"{corpus_name}_{qid}\"\n                        cid = f\"{corpus_name}_{cid}\"\n                        # write back to file\n                        f.write(f\"{qid}\\t{cid}\\t{score}\\n\")\n", "code_sha256": "7c257bcdbb805e0654800f80084ca26c6c30b34960b8433a6ffdb5285c08d34d", "comments": [{"line": 56, "text": "# check if corpus.jsonl exists"}, {"line": 59, "text": "# combine all the corpus files into one"}, {"line": 60, "text": "# corpus files are located under cqadupstack/&lt;name&gt;/corpus.jsonl"}, {"line": 64, "text": "# get the name of the corpus"}, {"line": 72, "text": "# add the corpus name to _id"}, {"line": 74, "text": "# write back to file"}, {"line": 75, "text": "# json_functions.dumps generates json that can't be read by beir"}, {"line": 78, "text": "# now, do the same for queries.jsonl"}, {"line": 84, "text": "# get the name of the corpus"}, {"line": 92, "text": "# add the corpus name to _id"}, {"line": 94, "text": "# write back to file"}, {"line": 98, "text": "# now, do the same for qrels/test.tsv"}, {"line": 105, "text": "# First, write the columns: query-id\tcorpus-id\tscore"}, {"line": 108, "text": "# get the name of the corpus"}, {"line": 111, "text": "# skip first line"}, {"line": 117, "text": "# since it's a tsv, split by tab"}, {"line": 119, "text": "# add the corpus name to _id"}, {"line": 122, "text": "# write back to file"}], "decorators": [], "definition_line": 51, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_c02fcbbbfb7374e383bf0c3c0985baca717bf2780ac0dde1a8743bd3377ccf49", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 123, "line_start": 51, "name": "merge_cqa_dupstack", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "data_path"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}], "path": "bm25s/utils/beir.py", "qualified_name": "merge_cqa_dupstack", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def merge_cqa_dupstack(data_path, show_progress=True, leave_progress=False)", "source_id": "repo_source_77ca391adf493104c5b8e45f605714d19238af83005c86fcfe57f52fd5d17419", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
