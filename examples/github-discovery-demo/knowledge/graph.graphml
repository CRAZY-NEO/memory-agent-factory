tion": null, "default": "'indptr.csc.index.npy'", "kind": "positional_or_keyword", "name": "indptr_name"}, {"annotation": null, "default": "'vocab.index.json'", "kind": "positional_or_keyword", "name": "vocab_name"}, {"annotation": null, "default": "'params.index.json'", "kind": "positional_or_keyword", "name": "params_name"}, {"annotation": null, "default": "'nonoccurrence_array.index.npy'", "kind": "positional_or_keyword", "name": "nnoc_name"}, {"annotation": null, "default": "'corpus.jsonl'", "kind": "positional_or_keyword", "name": "corpus_name"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "allow_pickle"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}], "path": "bm25s/__init__.py", "qualified_name": "BM25.save", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def save(self, save_dir, corpus=None, data_name='data.csc.index.npy', indices_name='indices.csc.index.npy', indptr_name='indptr.csc.index.npy', vocab_name='vocab.index.json', params_name='params.index.json', nnoc_name='nonoccurrence_array.index.npy', corpus_name='corpus.jsonl', allow_pickle=False, show_progress=True, leave_progress=False)", "source_id": "repo_source_d2d8bec12150dbd29fb5b8e9c0612950ac3a929c94086450a1edb9144458393c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
