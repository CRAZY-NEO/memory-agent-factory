    <node id="code_candidate_722a8397a8be2b16978b92fc9c0252986fd9570175a82812a1d23688845e55eb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_tfc_robertson(tf_array, l_d, l_avg, k1, b, delta=None):\n    \"\"\"\n    Computes the term frequency component of the BM25 score using Robertson+ (original) variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    # idf component is given by the idf_array\n    # we calculate the term-frequency component (tfc)\n    return tf_array / (k1 * ((1 - b) + b * l_d / l_avg) + tf_array)\n", "code_sha256": "fa718e5d2a59c752bc828fd0e55aa2d60fdcea818c7324d32943ffc682c74c99", "comments": [{"line": 120, "text": "# idf component is given by the idf_array"}, {"line": 121, "text": "# we calculate the term-frequency component (tfc)"}], "decorators": [], "definition_line": 115, "docstring": "\n    Computes the term frequency component of the BM25 score using Robertson+ (original) variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_722a8397a8be2b16978b92fc9c0252986fd9570175a82812a1d23688845e55eb", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 122, "line_start": 115, "name": "_score_tfc_robertson", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "tf_array"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_d"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_avg"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k1"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "b"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "delta"}], "path": "bm25s/scoring.py", "qualified_name": "_score_tfc_robertson", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _score_tfc_robertson(tf_array, l_d, l_avg, k1, b, delta=None)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
