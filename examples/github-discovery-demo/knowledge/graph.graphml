    <node id="code_candidate_3bf14e1791cc58c920f5458442520072d3b226570e1b67832dad2a9ed8b44bdb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def create_mcp_server(index_dir: str, port: int = 8000):\n    # Initialize FastMCP server\n    mcp = FastMCP(\"bm25s\")\n\n    # Load the index\n    print(f\"Loading index from {index_dir}...\")\n    retriever = bm25s.BM25.load(index_dir, load_corpus=True)\n    print(\"Index loaded successfully.\")\n\n    @mcp.tool()\n    def retrieve(query: str, k: int = 10) -&gt; str:\n        \"\"\"\n        Retrieve documents from the index based on the query.\n        \n        Args:\n            query: The search query string.\n            k: The number of documents to retrieve.\n        \"\"\"\n        # Tokenize the query\n        query_tokens = bm25s.tokenize(query)\n        \n        # Retrieve documents\n        results = retriever.retrieve(query_tokens, k=k)\n        \n        # Format results\n        output = []\n        for i, (doc, score) in enumerate(zip(results.documents[0], results.scores[0])):\n            output.append(f\"Rank {i+1} (Score: {score:.4f}):\\n{doc}\\n\")\n            \n        return \"\\n\".join(output)\n\n    @mcp.tool()\n    def get_info() -&gt; str:\n        \"\"\"\n        Get information about the loaded index.\n        \"\"\"\n        return f\"BM25S Index Info:\\n- Vocab Size: {len(retriever.vocab_dict)}\\n- Num Docs: {retriever.scores['num_docs']}\\n- Backend: {retriever.backend}\"\n\n    return mcp\n", "code_sha256": "a0cc2972c1663972d9c73565ca0747f9299ad218e1f0710e3849ab3841a11e24", "comments": [{"line": 6, "text": "# Initialize FastMCP server"}, {"line": 9, "text": "# Load the index"}, {"line": 23, "text": "# Tokenize the query"}, {"line": 26, "text": "# Retrieve documents"}, {"line": 29, "text": "# Format results"}], "decorators": [], "definition_line": 5, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "fbe92cfa6aec5cb6f48c5716eead8ed447900e7a323144b83f7801aa9df13322", "id": "code_candidate_3bf14e1791cc58c920f5458442520072d3b226570e1b67832dad2a9ed8b44bdb", "imports": [{"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "mcp.server.fastmcp", "name": "FastMCP"}, {"alias": null, "level": 0, "line": 50, "module": "argparse", "name": null}], "kind": "function", "line_end": 43, "line_start": 5, "name": "create_mcp_server", "parameters": [{"annotation": "str", "default": null, "kind": "positional_or_keyword", "name": "index_dir"}, {"annotation": "int", "default": "8000", "kind": "positional_or_keyword", "name": "port"}], "path": "bm25s/mcp/server.py", "qualified_name": "create_mcp_server", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def create_mcp_server(index_dir: str, port: int=8000)", "source_id": "repo_source_e6ff580c695cf24a591edb82993eb8a36a2578dd646e15a857a59bb0708eef60", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
