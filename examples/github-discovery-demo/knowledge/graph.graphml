    <node id="code_candidate_291c8d0bb8d0f4dee65d99bb6c7b4419a6a8e34a969c9e37e9679138d58549db">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __init__(self, path, show_progress=True, leave_progress=True, save_index=True, verbosity=1, encoding='utf-8'):\n        self.path = path\n        self.verbosity = verbosity\n        self.encoding = encoding\n\n        # if the index file does not exist, create it\n        if os.path.exists(change_extension(path, \".mmindex.json\")):\n            self.mmindex = load_mmindex(path, encoding=self.encoding)\n        else:\n            logging.info(\"Creating index file for jsonl corpus\")\n            mmindex = find_newline_positions(\n                path, show_progress=show_progress, leave_progress=leave_progress, encoding=self.encoding\n            )\n            if save_index:\n                save_mmindex(mmindex, path, encoding=self.encoding)\n\n            self.mmindex = mmindex\n\n        # Finally, open the file and mmap objects\n        self.load()\n", "code_sha256": "3be5996650792fece84157c5a429ff94aba8a095451e3bf50cf548c5ca6fbfec", "comments": [{"line": 138, "text": "# if the index file does not exist, create it"}, {"line": 151, "text": "# Finally, open the file and mmap objects"}], "decorators": [], "definition_line": 133, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_291c8d0bb8d0f4dee65d99bb6c7b4419a6a8e34a969c9e37e9679138d58549db", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias"