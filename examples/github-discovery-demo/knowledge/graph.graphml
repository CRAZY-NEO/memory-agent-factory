    <node id="code_candidate_e6ba1f3fc08284332d624ebcd4a7480c16c190293f233e99339b4369adcebbdf">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jax_installed_but_unavailable(self):\n        global JAX_IS_AVAILABLE\n        original_jax_is_available = JAX_IS_AVAILABLE\n        JAX_IS_AVAILABLE = False  # Temporarily pretend JAX is not available\n        \n        result_scores, result_indices = topk(self.scores, self.k, backend=\"auto\", sorted=True)\n        self.check_results(result_scores, result_indices, sorted=True)\n        \n        JAX_IS_AVAILABLE = original_jax_is_available  # Restore the original value\n", "code_sha256": "34eba8e1869f1c17d384d2ef80bb2c84f06aa7e070a140a4c537b971b3bff5d0", "comments": [{"line": 59, "text": "# Temporarily pretend JAX is not available"}, {"line": 64, "text": "# Restore the original value"}], "decorators": [], "definition_line": 56, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4e6fe4c42ffcc02b2eba717ac7e1ebacb1d7f64f561ecd9bad0fa3e71b47f4fb", "id": "code_candidate_e6ba1f3fc08284332d624ebcd4a7480c16c190293f233e99339b4369adcebbdf", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.selection", "name": "topk"}], "kind": "method", "line_end": 64, "line_start": 56, "name": "test_jax_installed_but_unavailable", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_topk.py", "qualified_name": "TestTopKSingleQuery.test_jax_installed_but_unavailable", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_jax_installed_but_unavailable(self)", "source_id": "repo_source_f170fde293ed6d8972fe591f8d0f01150ec7c1db1d99a8a1b4550bf94b512791", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
