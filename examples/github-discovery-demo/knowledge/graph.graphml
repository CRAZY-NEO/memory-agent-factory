    <node id="code_candidate_a0161645d12b4d337f5669f517f782079ffea920516665db18bc03cdb39155ed">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def batch_tokenize(tokenizer, texts, add_special_tokens=False, show_progress=True, leave_progress=False):\n    tokenizer_kwargs = dict(\n        return_attention_mask=False,\n        return_token_type_ids=False,\n        add_special_tokens=add_special_tokens,\n        max_length=None,\n    )\n    tokenized = tokenizer(texts, **tokenizer_kwargs)\n    output = []\n\n    for i in tqdm(\n        range(len(texts)), desc=\"Processing tokens (huggingface tokenizer)\", leave=leave_progress, disable=not show_progress\n    ):\n        output.append(tokenized[i].tokens)\n\n    return output\n", "code_sha256": "6169bb714e9f0784168ad489bf5dc31a3822c88a558d566a78bfd7f5fd12340c", "comments": [], "decorators": [], "definition_line": 187, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ef53c4775b6f6fde4a3a4fa5f687268b5f70562a82e11bd0f59c1757b1eed21b", "id": "code_candidate_a0161645d12b4d337f5669f517f782079ffea920516665db18bc03cdb39155ed", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Union"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "BM25"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "__version__"}, {"alias": null, "level": 1, "line": 8, "module": "tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 11, "module": "huggingface_hub", "name": "HfApi"}, {"alias": null, "level"