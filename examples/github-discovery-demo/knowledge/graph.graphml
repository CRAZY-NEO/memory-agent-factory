l, "name": "utils"}, {"alias": "selection_np", "level": 1, "line": 49, "module": null, "name": "selection"}, {"alias": null, "level": 1, "line": 50, "module": "version", "name": "__version__"}, {"alias": null, "level": 1, "line": 51, "module": "tokenization", "name": "tokenize"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_idf_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_nonoccurrence_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_scores_and_indices_for_matrix"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_calculate_doc_freqs"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_jit_ready"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_python"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_tfc_scorer"}, {"alias": null, "level": 0, "line": 1336, "module": "numba", "name": "njit"}, {"alias": null, "level": 1, "line": 1346, "module": "scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 1361, "module": "numba", "name": "njit"}], "kind": "method", "line_end": 324, "line_start": 272, "name": "_compute_relevance_from_scores", "parameters": [{"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indptr"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "num_docs"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "query_tokens_ids"}, {"annotation": "np.dtype", "default": null, "kind": "positional_or_keyword", "name": "dtype"}], "path": "bm25s/__init__.py", "qualified_name": "BM25._compute_relevance_from_scores", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "np.ndarray", "signature": "def _compute_relevance_from_scores(data: np.ndarray, indptr: np.ndarray, indices: np.ndarray, num_docs: int, query_tokens_ids: np.ndarray, dtype: np.dtype) -&gt; np.ndarray", "source_id": "repo_source_d2d8bec12150dbd29fb5b8e9c0612950ac3a929c94086450a1edb9144458393c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
