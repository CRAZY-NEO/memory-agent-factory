    <node id="code_candidate_31b556d98275119292f1abe7ffe226adebe72053b75c17a69247e91b312de839">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def start(self, name):\n        if name in self.results:\n            raise ValueError(f\"Timer with name {name} already started.\")\n        start_time = time.monotonic()\n        self.results[name] = {\"start\": start_time, \"elapsed\": 0, \"last\": start_time}\n        return name\n", "code_sha256": "4adee8c326c9da51eb9fb3bf5e37c3763d08d10bdfa4b6d195a906657a4aee4c", "comments": [], "decorators": [], "definition_line": 42, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_31b556d98275119292f1abe7ffe226adebe72053b75c17a69247e91b312de839", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 47, "line_start": 42, "name": "start", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.start", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def start(self, name)", "source_id": "repo_source_43fd334d6b3ac591ecde766e3edc2ab0b85c456f8eece5f44d103b24d412ad90", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
