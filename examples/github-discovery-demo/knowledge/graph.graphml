      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_zero_k_returns_empty(self):\n        \"\"\"k=0 must keep returning an empty selection (existing contract).\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        scores, indices = topk(query_scores, k=0, backend=\"numpy\", sorted=True)\n        self.assertEqual(scores.size, 0)\n        self.assertEqual(indices.size, 0)\n", "code_sha256": "8ea0be2ea2fceb1941adc6d863907828348e8d93a7e3a8baa0f53cddb0e0f6da", "comments": [], "decorators": [], "definition_line": 96, "docstring": "k=0 must keep returning an empty selection (existing contract).", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_b8ba50e5644894f149dc0e8b6d60cc96530c36fd3eeef77dd96265577c566e26", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 101, "line_start": 96, "name": "test_topk_zero_k_returns_empty", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_zero_k_returns_empty", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_topk_zero_k_returns_empty(self)", "source_id": "repo_source_33f66b9a30f3f6aad8766b2217a780b139864e93e9878cc434c64c8ebc36e517", "status": "unvalidated", "task": null, "trus