      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_loads_function(self):\n        \"\"\"Test loads function\"\"\"\n        json_str = '{\"key\": \"value\", \"number\": 42}'\n        result = json_functions.loads(json_str)\n        self.assertIsInstance(result, dict)\n        self.assertEqual(result[\"key\"], \"value\")\n        self.assertEqual(result[\"number\"], 42)\n", "code_sha256": "f5b7a8fec16f12ae0e7b138c2a541eb963b598369d707e302c39cd533219c79c", "comments": [], "decorators": [], "definition_line": 45, "docstring": "Test loads function", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_da58cfa9c803f38df9668408a07c2548bc567733aac8bf735cd40e3bc064729b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 51, "line_start": 45, "name": "test_loads_function", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_loads_function", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_loads_function(self)", "source_id": "repo_source_86363c7bd77007a75cd4fcb61002823231dd283e1b4458a0392c9c3492df5123", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
