    <node id="code_candidate_116199f212f84d1a52b8612dd586d76fe322f558618cc7c8728968845158a152">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_can_save_locally_non_empty_no_overwrite(self):\n        \"\"\"Test can_save_locally with non-empty directory and no overwrite\"\"\"\n        non_empty_dir = os.path.join(self.tmpdir, \"non_empty\")\n        os.makedirs(non_empty_dir)\n        \n        # Add a file\n        with open(os.path.join(non_empty_dir, \"file.txt\"), \"w\") as f:\n            f.write(\"test\")\n        \n        # Should not be able to save without overwrite\n        result = can_save_locally(non_empty_dir, overwrite_local=False)\n        # The function returns None when it can't save, not False\n        self.assertIsNone(result)\n", "code_sha256": "c7306392f6493bc732d8fb9e12843d8c6b3e7dd0f7aecb3e47c164c1019a7dda", "comments": [{"line": 58, "text": "# Add a file"}, {"line": 62, "text": "# Should not be able to save without overwrite"}, {"line": 64, "text": "# The function returns None when it can't save, not False"}], "decorators": [], "definition_line": 53, "docstring": "Test can_save_locally with non-empty directory and no overwrite", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "28e6fa925022fe2389bec7b19a3d2b1bd8637d9c789a30cbf321af111dcbe48e", "id": "code_candidate_116199f212f84d1a52b8612dd586d76fe322f558618cc7c8728968845158a152", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "can_save_locally"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "is_dir_empty"}], "kind": "method", "line_end": 65, "line_start": 53, "name": "test_can_save_locally_non_empty_no_overwrite", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_hf_utils.py", "qualified_name": "TestHFUtilities.test_can_save_locally_non_empty_no_overwrite", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_can_save_locally_non_empty_no_overwrite(self)", "source_id": "repo_source_406bca734cf4c899d2b56c103ae58a73d5f3f099a05cd0cf518474122551b2a8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
