    <node id="code_candidate_4a5ea76d4bdc4df85ac253e518abe922c18373098f4307efc4d2b8337a865602">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_search_command(self):\n        \"\"\"Test searching an index.\"\"\"\n        # First, create an index\n        index_args = Namespace(\n            file=self.txt_path,\n            output=self.index_dir,\n            column=None\n        )\n        \n        old_stdout = sys.stdout\n        sys.stdout = StringIO()\n        \n        try:\n            index_command(index_args)\n        finally:\n            sys.stdout = old_stdout\n        \n        # Now search\n        search_args = Namespace(\n            index=self.index_dir,\n            query=\"hello world\",\n            top_k=10\n        )\n        \n        sys.stdout = StringIO()\n        \n        try:\n            search_command(search_args)\n        finally:\n            output = sys.stdout.getvalue()\n            sys.stdout = old_stdout\n        \n        # Check output\n        self.assertIn(\"Search results for:\", output)\n        self.assertIn(\"hello world\", output)\n        self.assertIn(\"score:\", output)\n", "code_sha256": "c00d57329403f1bd5e0cdd74eef2ec93937b716986b9274080de8411065daa19", "comments": [{"line": 207, "text": "# First, create an index"}, {"line": 222, "text": "# Now search"}, {"line": 237, "text": "# Check output"}], "decorators": [], "definition_line": 205, "docstring": "Test searching an index.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5a4dced834c7622105997d5c1b1f67ddf32f394afb260cb40e27ae97a9171caa", "id": "code_candidate_4a5ea76d4bdc4df85ac253e518abe922c18373098f4307efc4d2b8337a865602", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias