    <node id="code_candidate_c53fdfc02fca4cdabf354bf75b60f36fbd0fd18aec83acc34d1462d57e31588c">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_filtered_token_ids_empty_query(self):\n        \"\"\"Test retrieve with token IDs that filter to empty query without empty token\"\"\"\n        retriever = BM25()\n        # Index without create_empty_token\n        corpus_for_test = [[\"hello\", \"world\"], [\"foo\", \"bar\"]]\n        retriever.index(corpus_for_test, create_empty_token=False)\n        \n        # Create query with token IDs not in vocab\n        max_id = max(retriever.vocab_dict.values())\n        query_tokens_ids = [[max_id + 100, max_id + 200]]\n        \n        # Since empty token is not in vocab, this should raise an error\n        if \"\" in retriever.vocab_dict:\n            # If empty token exists, skip this test\n            self.skipTest(\"Empty token exists in vocab, cannot test error case\")\n        else:\n            with self.assertRaises(ValueError) as context:\n                retriever.retrieve(query_tokens_ids, k=2)\n            self.assertIn(\"does not contain any tokens\", str(context.exception))\n", "code_sha256": "74fb2c380fce0a11c38340277e9e6ab05d232ebed0b103b9d489672d393eb614", "comments": [{"line": 223, "text": "# Index without create_empty_token"}, {"line": 227, "text": "# Create query with token IDs not in vocab"}, {"line": 231, "text": "# Since empty token is not in vocab, this should raise an error"}, {"line": 233, "text": "# If empty token exists, skip this test"}], "decorators": [], "definition_line": 220, "docstring": "Test retrieve with token IDs that filter to empty query without empty token", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_c53fdfc02fca4cdabf354bf75b60f36fbd0fd18aec83acc34d1462d57e31588c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 238, "line_start": 220, "name": "test_retrieve_with_filtered_token_ids_empty_query", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_filtered_token_ids_empty_query", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_retrieve_with_filtered_token_ids_empty_query(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
