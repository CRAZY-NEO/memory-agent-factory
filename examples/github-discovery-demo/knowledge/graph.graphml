    <node id="code_candidate_94edfcd59544b3a6b3d598c89280272d9583047ef6ddf405886ad788611ccef2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def list_user_indices():\n    \"\"\"List all indices in the user's indices directory.\"\"\"\n    indices_dir = get_user_indices_dir()\n    if not indices_dir.exists():\n        return []\n    \n    indices = []\n    for item in indices_dir.iterdir():\n        if item.is_dir():\n            # Check if it looks like a valid index (has params.index.json)\n            if (item / \"params.index.json\").exists():\n                indices.append(item.name)\n    \n    return sorted(indices)\n", "code_sha256": "a2107c758b564f7a004b8bf2117ffd0748b4a0a5e104833b2ca59651990b5269", "comments": [{"line": 36, "text": "# Check if it looks like a valid index (has params.index.json)"}], "decorators": [], "definition_line": 27, "docstring": "List all indices in the user's indices directory.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "494e56b9ebbe6dbee99d7037fdad57f53423edd7135b51252c8f65ce514a9a38", "id": "code_candidate_94edfcd59544b3a6b3d598c89280272d9583047ef6ddf405886ad788611ccef2", "imports": [{"alias": null, "level": 0, "line": 15, "module": "argparse", "name": null}, {"alias": null, "level": 0, "line": 16, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 17, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 56, "module": "rich.console", "name": "Console"}, {"alias": null, "level": 0, "line": 57, "module": "rich.prompt", "name": "Prompt"}, {"alias": null, "level": 0, "line": 58, "module": "rich.table", "name": "Table"}, {"alias": null, "level": 0, "line": 59, "module": "rich.panel", "name": "Panel"}, {"alias": "create_index", "level": 2, "line": 130, "module": "high_level", "name": "index"}, {"alias": "load_documents", "level": 2, "line": 130, "module": "high_level", "name": "load"}, {"alias": null, "level": 2, "line": 195, "module": null, "name": "BM25"}, {"alias": null, "level": 2, "line": 196, "module": "high_level", "name": "BM25Search"}], "kind": "function", "line_end": 40, "line_start": 27, "name": "list_user_indices", "parameters": [], "path": "bm25s/terminal/__init__.py", "qualified_name": "list_user_indices", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def list_user_indices()", "source_id": "repo_source_07bb3f9d9e9e6d192a8e90071f73214bbdf17535524595dd05f9192de6312b49", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
