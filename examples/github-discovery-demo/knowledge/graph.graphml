    <node id="code_candidate_055f8516e7599d1d77525775b94b69f13b89fcd8cb3b65a52be93274d8cd93b4">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def compile(self, activate_numba=True, warmup=False):\n        \"\"\"\n        Compile the Numba functions for the BM25 index. This will apply the Numba JIT\n        compilation to the `_compute_relevance_from_scores` function and the CSC builder,\n        which will speed up the scoring process and index construction.\n\n        This function requires the `numba` package to be installed. If it is not installed,\n        an ImportError will be raised. You can install Numba with `pip install numba`.\n\n        Behind the scenes, this will reassign the `_compute_relevance_from_scores` method\n        to the JIT-compiled version of the function, and the `_np_csc` method to the\n        JIT-compiled version of the CSC builder.\n        \"\"\"\n        if NUMBA_AVAILABLE is False:\n            raise ImportError(\n                \"Numba is not installed. Please install Numba to compile the BM25 index with `pip install numba`.\"\n            )\n        if activate_numba:\n            self.activate_numba_csc()\n            self.activate_numba_scorer()\n        if warmup:\n            self.warmup_numba_csc()\n            self.warmup_numba_scorer()\n", "code_sha256": "1aff1204a07afcdb065fa9be7e27b405262718df70a6bb97486e713d98397c10", "comments": [], "decorators": [], "definition_line": 1296, "docstring": "\n        Compile the Numba functions for the BM25 index. This will apply the Numba JIT\n        compilation to the `_compute_relevance_from_scores` function and the CSC builder,\n        which will speed up the scoring process and index construction.\n\n        This function requires the `numba` package to be installed. If it is not installed,\n        an ImportError will be raised. You can install Numba with `pip install numba`.\n\n        Behind the scenes, this will reassign the `_compute_relevance_from_scores` method\n        to the JIT-compiled version of the function, and the `_np_csc` method to the\n        JIT-compiled version of the CSC builder.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_055f8516e7599d1d77525775b94b69f13b89fcd8cb3b65a52be93274d8cd93b4", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Union"}, {"alias": "np", "level": 0, "line": 11, "module": "numpy", "name": null}, {"alias": "json_functions", "level": 1, "line": 13, "module": "utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "numba", "name": "njit"}, {"alias": "selection_jit", "level": 1, "line": 17, "module": "numba", "name": "selection"}, {"alias": "sp", "level": 0, "line": 23, "module": "scipy.sparse", "name": null}, {"alias": null, "level": 1, "line": 29, "module": "numba.retrieve_utils", "name": "_retrieve_numba_