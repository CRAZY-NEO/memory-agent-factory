    <node id="code_candidate_12d07c4f7af8424e64f911ef1a406b06628cd9cbaddbbc69e22bab59969933f3">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenizer_update_vocab_if_empty_with_empty_vocab(self):\n        \"\"\"Test tokenizer with update_vocab='if_empty' when vocab is empty\"\"\"\n        tokenizer = Tokenizer()\n        \n        texts = [\"hello world\"]\n        tokenizer.tokenize(texts, update_vocab=\"if_empty\", return_as=\"ids\")\n        \n        # Should have updated vocab\n        self.assertGreater(len(tokenizer.word_to_id), 0)\n", "code_sha256": "bbfd250d7a44f0fc4e52a0b0efc5e4f504a7745de1e85a3c5808b45363797cdf", "comments": [{"line": 76, "text": "# Should have updated vocab"}], "decorators": [], "definition_line": 69, "docstring": "Test tokenizer with update_vocab='if_empty' when vocab is empty", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_12d07c4f7af8424e64f911ef1a406b06628cd9cbaddbbc69e22bab59969933f3", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 77, "line_start": 69, "name": "test_tokenizer_update_vocab_if_empty_with_empty_vocab", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenizer_update_vocab_if_empty_with_empty_vocab", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_tokenizer_update_vocab_if_empty_with_empty_vocab(self)", "source_id": "repo_s