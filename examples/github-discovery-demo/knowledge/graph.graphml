    <node id="code_candidate_6663fc968b89f1aa91615dd7a2e8c39fd1fb3e9fb2d395b004e1cb0a91ebcf2e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def save_vocab_to_hub(\n        self,\n        repo_id: str,\n        token: str = None,\n        local_dir: str = None,\n        commit_message: str = \"Update tokenizer\",\n        overwrite_local: bool = False,\n        private=True,\n        **kwargs,\n    ):\n        \"\"\"\n        This function saves the tokenizer's vocab to the Hugging Face Hub.\n\n        Parameters\n        ----------\n        repo_id: str\n            The unique identifier of the repository to save the model to.\n            The `repo_id` should be in the form of \"username/repo_name\".\n        \n        token: str\n            The Hugging Face API token to use.\n        \n        local_dir: str\n            The directory to save the model to before pushing to the Hub.\n            If it is not empty and `overwrite_local` is False, it will fall\n            back to saving to a temporary directory.\n        \n        commit_message: str\n            The commit message to use when saving the model.\n        \n        overwrite_local: bool\n            Whether to overwrite the existing local directory if it exists.\n        \n        kwargs: dict\n            Additional keyword arguments to pass to `HfApi.upload_folder` call.\n        \"\"\"\n        api = HfApi(token=token)\n        repo_url = api.create_repo(\n            repo_id=repo_id,\n            token=api.token,\n            private=private,\n            repo_type=\"model\",\n            exist_ok=True,\n        )\n        repo_id = repo_url.repo_id\n\n        saving_locally = can_save_locally(local_dir, overwrite_local)\n        if saving_locally:\n            os.makedirs(local_dir, exist_ok=True)\n            save_dir = local_dir\n        else:\n            # save to a temporary directory otherwise\n            save_dir = tempfile.mkdtemp()\n\n        self.save_vocab(save_dir)\n        # push content of the temporary directory to the repo\n        api.upload_folder(\n            repo_id=repo_id,\n            commit_message=commit_message,\n            token=api.token,\n            folder_path=save_dir,\n            repo_type=repo_url.repo_type,\n            **kwargs,\n        )\n        # delete the temporary directory if it was created\n        if not saving_locally:\n            shutil.rmtree(save_dir)\n\n        return repo_url\n", "code_sha256": "86e358a256bd9157b32f72cc0f41a2f2b804aa2ef4c8bd2a4f522bb4fc414c4a", "comments": [{"line": 306, "text": "# save to a temporary directory otherwise"}, {"line": 310, "text": "# push content of the temporary directory to the repo"}, {"line": 319, "text": "# delete the temporary directory if it was created"}], "decorators": [], "definition_line": 255, "docstring": "\n        This function saves the tokenizer's vocab to the Hugging Face Hub.\n\n        Parameters\n        ----------\n        repo_id: str\n            The unique identifier of the repository to save the model to.\n            The `repo_id` should be in the form of \"username/repo_name\".\n        \n        token: str\n            The Hugging Face API token to use.\n        \n        local_dir: str\n            The directory to save the model to before pushing to the Hub.\n            If it is not empty and `overwrite_local` is False, it will fall\n            back to saving to a temporary directory.\n        \n        commit_message: str\n            The commit message to use when saving the model.\n        \n        overwrite_local: bool\n            Whether to overwrite the existing local directory if it exists.\n        \n        kwargs: dict\n            Additional keyword arguments to pass to `HfApi.upload_folder` call.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ef53c4775b6f6fde4a3a4fa5f687268b5f70562a82e11bd0f59c1757b1eed21b", "id": "code_candidate_6663fc968b89f1aa91615dd7a2e8c39fd1fb3e9fb2d395b004e1cb0a91ebcf2e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Union"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "BM25"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "__version__"}, {"alias": null, "level": 1, "line": 8, "module": "tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 11, "module": "huggingface_hub", "name": "HfApi"}, {"alias": null, "level": 0, "line": 23, "module": "tqdm.auto", "name": "tqdm"}], "kind": "method", "line_end": 323, "line_start": 255, "name": "save_vocab_to_hub", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "str", "default": null, "kind": "positional_or_keyword", "name": "repo_id"}, {"annotation": "str", "default": "None", "kind": "positional_or_keyword", "name": "token"}, {"annotation": "str", "default": "None", "kind": "positional_or_keyword", "name": "local_dir"}, {"annotation": "str", "default": "'Update tokenizer'", "kind": "positional_or_keyword", "name": "commit_message"}, {"annotation": "bool", "default": "False", "kind": "positional_or_keyword", "name": "overwrite_local"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "private"}, {"annotation": null, "default": null, "kind": "var_keyword", "name": "kwargs"}], "path": "bm25s/hf.py", "qualified_name": "TokenizerHF.save_vocab_to_hub", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def save_vocab_to_hub(self, repo_id: str, token: str=None, local_dir: str=None, commit_message: str='Update tokenizer', overwrite_local: bool=False, private=True, **kwargs)", "source_id": "repo_source_304890f95653eb167c106807f7767ede53c0bbce2076a3c6ab02cc78ffbc3b9c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
