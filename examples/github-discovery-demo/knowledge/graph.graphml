    <node id="code_candidate_935dd5845ae238bf5c8fcfd80bdb9bce4b24c7962cfc87e191a2ed3bccfc1b4f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _infer_stopwords(stopwords: Union[str, List[str]]) -&gt; Union[List[str], tuple]:\n    # Source of stopwords: https://github.com/nltk/nltk/blob/96ee715997e1c8d9148b6d8e1b32f412f31c7ff7/nltk/corpus/__init__.py#L315\n    # Source of Korean stopwords: https://github.com/stopwords-iso/stopwords-ko (as nltk did not have Korean stopwords)\n    if stopwords in [\"english\", \"en\", True]:  # True is added to support the default\n        return STOPWORDS_EN\n    elif stopwords in [\"english_plus\", \"en_plus\"]:\n        return STOPWORDS_EN_PLUS\n    elif stopwords in [\"german\", \"de\"]:\n        return STOPWORDS_GERMAN\n    elif stopwords in [\"dutch\", \"nl\"]:\n        return STOPWORDS_DUTCH\n    elif stopwords in [\"french\", \"fr\"]:\n        return STOPWORDS_FRENCH\n    elif stopwords in [\"spanish\", \"es\"]:\n        return STOPWORDS_SPANISH\n    elif stopwords in [\"portuguese\", \"pt\"]:\n        return STOPWORDS_PORTUGUESE\n    elif stopwords in [\"italian\", \"it\"]:\n        return STOPWORDS_ITALIAN\n    elif stopwords in [\"russian\", \"ru\"]:\n        return STOPWORDS_RUSSIAN\n    elif stopwords in [\"swedish\", \"sv\"]:\n        return STOPWORDS_SWEDISH\n    elif stopwords in [\"norwegian\", \"no\"]:\n        return STOPWORDS_NORWEGIAN\n    elif stopwords in [\"chinese\", \"zh\"]:\n        return STOPWORDS_CHINESE\n    elif stopwords in [\"turkish\", \"tr\"]:\n        return STOPWORDS_TURKISH\n    elif stopwords in [\"korean\", \"ko\"]:\n        return STOPWORDS_KOREAN\n    elif stopwords in [\"danish\", \"da\"]:\n        return STOPWORDS_DANISH\n    elif stopwords in [None, False]:\n        return []\n    elif isinstance(stopwords, str):\n        raise ValueError(\n            f\"{stopwords} not recognized. Only English stopwords as default, German, Dutch, French, Spanish, Portuguese, Italian, Russian, Swedish, Norwegian, Chinese, Turkish, Korean, and Danish are currently supported. \"\n            \"Please input a list of stopwords\"\n        )\n    else:\n        return stopwords\n", "code_sha256": "f7e802332f590a31e0ad207f86eb9137f69ce540fd0beb1dc11b9e7938f2abb6", "comments": [{"line": 526, "text": "# Source of stopwords: https://github.com/nltk/nltk/blob/96ee715997e1c8d9148b6d8e1b32f412f31c7ff7/nltk/corpus/__init__.py#L315"}, {"line": 527, "text": "# Source of Korean stopwords: https://github.com/stopwords-iso/stopwords-ko (as nltk did not have Korean stopwords)"}, {"line": 528, "text": "# True is added to support the default"}], "decorators": [], "definition_line": 525, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_935dd5845ae238bf5c8fcfd80bdb9bce4b24c7962cfc87e191a2ed3bccfc1b4f", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Union"}, {"alias": null, "level": 0, "line": 5, "module": "typing", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_CHINESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DUTCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN_PLUS"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_FRENCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_GERMAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_ITALIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_KOREAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_NORWEGIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_PORTUGUESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "function", "line_end": 566, "line_start": 525, "name": "_infer_stopwords", "parameters": [{"annotation": "Union[str, List[str]]", "default": null, "kind": "positional_or_keyword", "name": "stopwords"}], "path": "bm25s/tokenization.py", "qualified_name": "_infer_stopwords", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "Union[List[str], tuple]", "signature": "def _infer_stopwords(stopwords: Union[str, List[str]]) -&gt; Union[List[str], tuple]", "source_id": "repo_source_78ed1251f3a4d45980eaad9bcd59ff615e2d8534417caea3ee1795928fc59963", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
