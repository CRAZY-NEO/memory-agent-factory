      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def setUpClass(cls):\n        # check that import orjson fails\n        import bm25s\n        cls.corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n            \"שלום חברים, איך אתם היום?\",\n            \"El café está muy caliente\",\n            \"今天的天气真好!\",\n            \"Как дела?\",\n            \"Türkçe öğreniyorum.\",\n            'שלום חברים'\n        ]\n        corpus_tokens = bm25s.tokenize(cls.corpus, stopwords=\"en\")\n        cls.retriever = bm25s.BM25(corpus=cls.corpus)\n        cls.retriever.index(corpus_tokens)\n        cls.tmpdirname = tempfile.mkdtemp()\n", "code_sha256": "0dff77e164ddd426d8dc9525a60ee554899bc5bd85be740dd7d44efbf676adc5", "comments": [{"line": 138, "text": "# check that import orjson fails"}], "decorators": ["classmethod"], "definition_line": 137, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5c821b6a5a4313298a2dd6cf0c18ca5a42d4e9ce84bab16a261cfb3edb01562b", "id": "code_candidate_7b5e3b36d12ca450d719a9f4bfb71a66ac732f39c9858fcfa96d38761d935489", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 8, "modul