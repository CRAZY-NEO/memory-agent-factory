    <node id="code_candidate_fa73c0c9bcf91ef4b4b6f37caab9ad1f1d2c6009cd62acceb0e6ded66a743f82">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_invalid_backend(self):\n        \"\"\"Test that topk raises ValueError for invalid backend\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        \n        with self.assertRaises(ValueError) as context:\n            topk(query_scores, k=2, backend=\"invalid_backend\")\n        self.assertIn(\"Invalid backend\", str(context.exception))\n", "code_sha256": "a00ebb7c1735b59cd6a8cc237d01192c40643737e7f021744f323d9710c67190", "comments": [], "decorators": [], "definition_line": 15, "docstring": "Test that topk raises ValueError for invalid backend", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_fa73c0c9bcf91ef4b4b6f37caab9ad1f1d2c6009cd62acceb0e6ded66a743f82", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 21, "line_start": 15, "name": "test_topk_invalid_backend", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_invalid_backend", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_topk_invalid_backend(self)", "source_id": "repo_source_2c62d0b88f3153e4da6b2f730dc9799c02f8035fc5ed916c0810a4a2f841f6fd", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
