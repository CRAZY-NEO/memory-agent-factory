      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_results_len(self):\n        \"\"\"Test Results.__len__() method\"\"\"\n        results = Results(\n            documents=np.array([[0, 1], [2, 3], [4, 5]]),\n            scores=np.array([[1.0, 0.5], [0.8, 0.3], [0.9, 0.2]])\n        )\n        \n        self.assertEqual(len(results), 3)\n", "code_sha256": "e7790ed81a1b4227c3c0ad854ec3fee7c3780ff56bac7ea6ff2b902b516814b2", "comments": [], "decorators": [], "definition_line": 115, "docstring": "Test Results.__len__() method", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_67200eea3c2be71e0f9f7b773b15ec478c9eb70ead407ece5f965e55bd1334bd", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 122, "line_start": 115, "name": "test_results_len", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_results_len", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_results_len(self)", "source_id": "