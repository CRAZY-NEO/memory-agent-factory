      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        self.tmpdir = tempfile.mkdtemp()\n        self.corpus = [\n            \"a cat is a feline\",\n            \"a dog is the human's best friend\",\n            \"a bird can fly\",\n        ]\n        self.stemmer = Stemmer.Stemmer(\"english\")\n        self.corpus_tokens = bm25s.tokenize(self.corpus, stopwords=\"en\", stemmer=self.stemmer)\n", "code_sha256": "bec1f3342cb3f813ca4457d9796f5530beae61cc9df9cfa5067eb7bbb6b227af", "comments": [], "decorators": [], "definition_line": 359, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_791a385fb60d13c5dc879282f33f09486838655adf474612229f0775596b39fa", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 367, "line_start": 359, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25LoadingSaving.setUp", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def setUp(self)", "sour