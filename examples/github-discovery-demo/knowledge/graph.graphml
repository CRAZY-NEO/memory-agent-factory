    <node id="code_candidate_dd11a727050246784316add311a497589ce6f0f83f3b43d6846750c78f7a9350">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_auto_backend(self):\n        \"\"\"Test topk with auto backend selection\"\"\"\n        query_scores = np.array([5.0, 2.0, 8.0, 1.0, 6.0], dtype=np.float32)\n\n        scores, indices = topk(query_scores, k=3, backend=\"auto\", sorted=True)\n\n        # Should return top 3: 8.0, 6.0, 5.0\n        self.assertEqual(len(scores), 3)\n        self.assertEqual(len(indices), 3)\n        # Check that the top score is 8.0\n        self.assertEqual(scores[0], 8.0)\n", "code_sha256": "10c596a66cb72d3e50926603b289d0eb78685c7ca522d367fcd2a20b169d7576", "comments": [{"line": 72, "text": "# Should return top 3: 8.0, 6.0, 5.0"}, {"line": 75, "text": "# Check that the top score is 8.0"}], "decorators": [], "definition_line": 66, "docstring": "Test topk with auto backend selection", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_dd11a727050246784316add311a497589ce6f0f83f3b43d6846750c78f7a9350", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 76, "line_start": 66, "name": "test_topk_auto_backend", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_auto_backend", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_topk_auto_backend(self)", "source_id": "repo_source_33f66b9a30f3f6aad8766b2217a780b139864e93e9878cc434c64c8ebc36e517", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
