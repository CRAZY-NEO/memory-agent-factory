    <node id="code_candidate_2b5b14bbf37c66af6ee2f19c3f245a7017004ff1ab1bdfc7337a1e698cfcc2d1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def topk(query_scores, k, backend=\"auto\", sorted=True):\n    \"\"\"\n    This function is used to retrieve the top-k results for a single query. It will only work\n    on a 1-dimensional array of scores.\n    \"\"\"\n    if backend == \"auto\":\n        # if jax.lax is available, use it to speed up selection, otherwise use numpy\n        backend = \"jax\" if JAX_IS_AVAILABLE else \"numpy\"\n    \n    if backend not in [\"numpy\", \"jax\"]:\n        raise ValueError(\"Invalid backend. Please choose from 'numpy' or 'jax'.\")\n    elif backend == \"jax\":\n        if not JAX_IS_AVAILABLE:\n            raise ImportError(\"JAX is not available. Please install JAX with `pip install jax[cpu]` to use this backend.\")\n        return _topk_jax(query_scores, k)\n    else:\n        if k &lt; 0:\n            raise ValueError(f\"k must be a non-negative integer, but got {k}.\")\n        return _topk_numpy(query_scores, k, sorted)\n", "code_sha256": "147a84f97e0b0f3374f3d6e6d0d6c7fe98ce003c10bfdcf4b305fcd48941d517", "comments": [{"line": 54, "text": "# if jax.lax is available, use it to speed up selection, otherwise use numpy"}], "decorators": [], "definition_line": 48, "docstring": "\n    This function is used to retrieve the top-k results for a single query. It will only work\n    on a 1-dimensional array of scores.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "fc6d6e68870a83c13fdd3cfd8fdcbfeb3f200cb7eb65e77b1e9c969214816481", "id": "code_candidate_2b5b14bbf37c66af6ee2f19c3f245a7017004ff1ab1bdfc7337a1e698cfcc2d1", "imports": [{"alias": "np", "level": 0, "line": 1, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "jax.lax", "name": null}], "kind": "function", "line_end": 66, "line_start": 48, "name": "topk", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k"}, {"annotation": null, "default": "'auto'", "kind": "positional_or_keyword", "name": "backend"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "bm25s/selection.py", "qualified_name": "topk", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def topk(query_scores, k, backend='auto', sorted=True)", "source_id": "repo_source_c7da3e4b95a090d35669bdcb2a5e2934540ab6c49f042c6f7e4a8a521b80a18c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
