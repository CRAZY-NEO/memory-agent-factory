    <node id="code_candidate_8dd22345be609c5abbf8572a796e870bc95b130858fe4ae9a52fad5af7cccb2b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        # let's test the functions\n        # random jsonl file\n        self.tmpdirname = tempfile.mkdtemp()\n        file = os.path.join(self.tmpdirname, \"file.jsonl\")\n        self.file = file\n        # content is random uuids\n        import uuid\n\n        self.strings = []\n\n        with open(file, \"w\") as f:\n            for i in range(500):\n                s = str(json.dumps({\"uuid\": str(uuid.uuid4())})) + \"\\n\"\n                self.strings.append(s)\n                f.write(s)\n", "code_sha256": "d64826a0433d957378b1d214587d326448adfbbd4466b48d72909701f176a41d", "comments": [{"line": 15, "text": "# let's test the functions"}, {"line": 16, "text": "# random jsonl file"}, {"line": 20, "text": "# content is random uuids"}], "decorators": [], "definition_line": 14, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "48c282942a3b7bcef2d80831cae74609ace88762a0a192c05508e36deafde792", "id": "code_candidate_8dd22345be609c5abbf8572a796e870bc95b130858fe4ae9a52fad5af7cccb2b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 21, "module": "uuid", "name": null}, {"alias": null, "level": 0, "line": 33, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 36, "module": "orjson", "name": null}], "kind": "method", "line_end": 29, "line_start": 14, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_utils_corpus.py", "qualified_name": "TestUtilsCorpus.setUp", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_0c531e1ca2d23bbeced4a19c29842684c6029387294f8269bf1ad2bfa2ef1431", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
