      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _build_idf_array(\n    doc_frequencies: dict,\n    n_docs: int,\n    compute_idf_fn: callable = None,\n    dtype=\"float32\",\n) -&gt; np.ndarray:\n    n_vocab = len(doc_frequencies)\n    idf_array = np.zeros(n_vocab, dtype=dtype)\n\n    for token_id, df in doc_frequencies.items():\n        if df != 0:\n            idf_array[token_id] = compute_idf_fn(df, N=n_docs)\n\n    return idf_array\n", "code_sha256": "7bd547e59ed3829ce21bb52cee4865ec8ddb3f7f8735bd4bc9b2a764e8bb1da9", "comments": [], "decorators": [], "definition_line": 60, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_c7402defcf4528debfecb97972aed5b17c3bf815e4bfb534bc377bbb846c1338", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 73, "line_start": 60, "name": "_build_idf_array", "parameters": [{"annotation": "dict", "default": null, "kind": "positional_or_keyword", "name": "doc_frequencies"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "n_docs"}, {"annotation": "callable", "default": "None", "kind": "positional_or_keyword", "name": "compute_idf_fn"}, {"annotation": null, "default": "'float32'", "kind": "positional_or_keyword", "name": "dtype"}], "path": "bm25s/scoring.py", "qualified_name": "_build_idf_array", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "np.ndarray", "signature": "def _build_idf_array(doc_frequencies: dict, n_docs: int, compute_idf_fn: callable=None, dtype='float32') -&gt; np.ndarray", "source_id": "repo_source_7b306c163e643ec8ce2daf2e4d3b9445af352760b228e7c9b26fbade2cb8008d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
