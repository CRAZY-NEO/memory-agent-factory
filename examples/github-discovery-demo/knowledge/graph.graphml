      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_empty_query(self):\n        corpus = bm25_hl.load(self.txt_path)\n        retriever = bm25_hl.index(corpus)\n        # Empty query should return empty list\n        results = retriever.search([\"\"], k=1)\n        self.assertEqual(len(results[0]), 0)\n        self.assertEqual(results[0], [])\n", "code_sha256": "6bef6d26193dd93012ad3525ccf8e874409aaee909a90e42aa468dcafa711b06", "comments": [{"line": 108, "text": "# Empty query should return empty list"}], "decorators": [], "definition_line": 105, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "f2daa5e229dd85f66a35367fe63f1cd17e43e18b4276f4497845cbb313d18617", "id": "code_candidate_4292ce9336f646da0cbe61b0460918f799b0574c7e871abb564b86fcd432e869", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": "bm25_hl", "level": 0, "line": 7, "module": "bm25s.high_level", "name": null}], "kind": "method", "line_end": 111, "line_start": 105, "name": "test_empty_query", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/high_level/test_high_level.py", "qualified_name": "TestHighLevel.test_empty_query", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_empty_query(self)", "source_id": "repo_source_94a8358cf0efa7e5536338bc0206c227e225d63e90b699f32ed5ca2974763acb", "status": "unvalidated", "t