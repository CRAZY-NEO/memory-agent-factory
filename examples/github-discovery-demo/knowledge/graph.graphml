    <node id="code_candidate_c56bdb63b7ddfcd811b89a44e8c84e4fb6bc2755cff36a95d53d82fb2afad127">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def setUpClass(cls):\n        # check that import orjson fails\n        import bm25s\n\n        # Create your corpus here\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n            \"שלום חברים, איך אתם היום?\",\n            \"El café está muy caliente\",\n            \"今天的天气真好!\",\n            \"Как дела?\",\n            \"Türkçe öğreniyorum.\"\n        ]\n\n        # optional: create a stemmer\n        stemmer = Stemmer.Stemmer(\"english\")\n\n        # Tokenize the corpus and only keep the ids (faster and saves memory)\n        corpus_tokens = bm25s.tokenize(corpus, stopwords=\"en\", stemmer=stemmer)\n\n        # Create the BM25 model and index the corpus\n        retriever = bm25s.BM25(method='bm25+')\n        retriever.index(corpus_tokens)\n\n        # Save the retriever to temp dir\n        cls.retriever = retriever\n        cls.corpus = corpus\n        cls.corpus_tokens = corpus_tokens\n        cls.stemmer = stemmer\n        cls.tmpdirname = tempfile.mkdtemp()\n", "code_sha256": "89f0f437779bd4cd6a91ee6b0a017f88603603bcdc94eb832f31ac3dedeabc8a", "comments": [{"line": 19, "text": "# check that import orjson fails"}, {"line": 22, "text": "# Create your corpus here"}, {"line": 35, "text": "# optional: create a stemmer"}, {"line": 38, "text": "# Tokenize the corpus and only keep the ids (faster and saves memory)"}, {"line": 41, "text": "# Create the BM25 model and index the corpus"}, {"line": 45, "text": "# Save the retriever to temp dir"}], "decorators": ["classmethod"], "definition_line": 18, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5c821b6a5a4313298a2dd6cf0c18ca5a42d4e9ce84bab16a261cfb3edb01562b", "id": "code_candidate_c56bdb63b7ddfcd811b89a44e8c84e4fb6bc2755cff36a95d53d82fb2afad127", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 20, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 55, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 139, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 161, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 184, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 185, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 50, "line_start": 17, "name": "setUpClass", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cls"}], "path": "tests/core/test_save_load.py", "qualified_name": "TestBM25SLoadingSaving.setUpClass", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUpClass(cls)", "source_id": "repo_source_a1f602b1faea1e6e56b497e0afa6d8afb1eef8bcb387878a190fafea16a61c7a", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", 