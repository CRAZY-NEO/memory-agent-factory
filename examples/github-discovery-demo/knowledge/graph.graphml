      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def create_test_index():\n    corpus = [\n        \"The quick brown fox jumps over the lazy dog\",\n        \"The quick brown fox jumps over the lazy dog\",\n        \"The quick brown fox jumps over the lazy dog\",\n        \"Hello world\",\n        \"This is a test document for bm25s mcp server\"\n    ]\n    \n    retriever = bm25s.BM25()\n    retriever.index(bm25s.tokenize(corpus))\n    \n    save_dir = \"test_index_mcp\"\n    retriever.save(save_dir, corpus=corpus)\n    print(f\"Index saved to {save_dir}\")\n", "code_sha256": "a27a4d6352bd66a5ec38e22ab6116727f478247469336a8d402a1690b1ae9fab", "comments": [], "decorators": [], "definition_line": 5, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "3fc3f494f8c2071905f5178b426d852d6088ade1acb37d991c7d0db19e263d3b", "id": "code_candidate_dd62eb3f168aa987295d7991ab5c5f472a71f66ff55b80a16f96d3732eb8c686", "imports": [{"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}], "kind": "function", "line_end": 19, "line_start": 5, "name": "create_test_index", "parameters": [], "path": "examples/mcp/create_index.py", "qualified_name": "create_test_index", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def create_test_index()", "source_id": "repo_source_8328705f9709ce51a8f78f3d13f0c61059a4fad27c82c1f50336edc4c83ac538", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
