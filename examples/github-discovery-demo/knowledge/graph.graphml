    <node id="code_candidate_03e7829e67ccf35fa2a90bf09273ae038fc128c44b82f03f7f3699a61bc8e6d5">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def postprocess_results_for_eval(results, scores, query_ids):\n    \"\"\"\n    Given the queried results and scores output by BM25S, postprocess them\n    to be compatible with BEIR evaluation functions.\n    query_ids is a list of query ids in the same order as the results.\n    \"\"\"\n\n    results_record = [\n        {\"id\": qid, \"hits\": results[i], \"scores\": list(scores[i])}\n        for i, qid in enumerate(query_ids)\n    ]\n\n    result_dict_for_eval = {\n        res[\"id\"]: {\n            docid: float(score) for docid, score in zip(res[\"hits\"], res[\"scores\"])\n        }\n        for res in results_record\n    }\n\n    return result_dict_for_eval\n", "code_sha256": "48e88d8900f8ec2568a89b522b13ff020af51abd6ef0186d8d3e77888e40c477", "comments": [], "decorators": [], "definition_line": 31, "docstring": "\n    Given the queried results and scores output by BM25S, postprocess them\n    to be compatible with BEIR evaluation functions.\n    query_ids is a list of query ids in the same order as the results.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "c2948559a9978b5b510e2d12e6910f357f69444184a712393bcbcca83efe0152", "id": "code_candidate_03e7829e67ccf35fa2a90bf09273ae038fc128c44b82f03f7f3699a61bc8e6d5", "imports": [{"alias": null, "level": 0, "line": 12, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 15, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 17, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 19, "module": "beir.retrieval.evaluation", "name": "EvaluateRetrieval"}, {"alias": "np", "level": 0, "line": 20, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 21, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 22, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 24, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 25, "module": "bm25s.utils.benchmark", "name": "Timer"}, {"alias": null, "level": 0, "line": 25, "module": "bm25s.utils.benchmark", "name": "get_max_memory_usage"}, {"alias": null, "level": 0, "line": 26, "module": "bm25s.utils.beir", "name": "BASE_URL"}, {"alias": null, "level": 0, "line": 26, "module": "bm25s.utils.beir", "name": "clean_results_keys"}], "kind": "function", "line_end": 50, "line_start": 31, "name": "postprocess_results_for_eval", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "results"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query_ids"}], "path": "examples/evaluate_on_beir.py", "qualified_name": "postprocess_results_for_eval", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def postprocess_results_for_eval(results, scores, query_ids)", "source_id": "repo_source_1e62ae784532ecda1dfb8862395559d0698c3d1fd6edaa34b494f3d82bc16376", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
