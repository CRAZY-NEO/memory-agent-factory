    <node id="code_candidate_3bc396678fda4f1d11889637de92e141ed6474982d9d0b4dde2ee4591ce5b70d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_close_and_load(self):\n        \"\"\"Test JsonlCorpus close and load methods\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False, verbosity=0)\n        \n        # Access an item\n        item = corpus[0]\n        self.assertIsNotNone(item)\n        \n        # Close\n        corpus.close()\n        \n        # Load again\n        corpus.load()\n        \n        # Should be able to access again\n        item = corpus[1]\n        self.assertIsNotNone(item)\n        \n        corpus.close()\n", "code_sha256": "edccb571c0e8a6b391212d44a650002476c02b0bb858539b6f672df1a45af6a9", "comments": [{"line": 257, "text": "# Access an item"}, {"line": 261, "text": "# Close"}, {"line": 264, "text": "# Load again"}, {"line": 267, "text": "# Should be able to access again"}], "decorators": [], "definition_line": 253, "docstring": "Test JsonlCorpus close and load methods", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_3bc396678fda4f1d11889637de92e141ed6474982d9d0b4dde2ee4591ce5b70d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 271, "line_start": 253, "name": "test_jsonl_corpus_close_and_load", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestJsonlCorpus.test_jsonl_corpus_close_and_load", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_jsonl_corpus_close_and_load(self)", "source_id": "repo_source_211fa7d6af255f93f3dc0b1a3484427853aae774b41a3aaad8f9bf1fcb9a6619", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
