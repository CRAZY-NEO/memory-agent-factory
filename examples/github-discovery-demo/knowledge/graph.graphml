    <node id="code_candidate_4210c1261d25fb2f53d4ce6eb021baa6305b0abc9d47d653019f644f4fd57460">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_invalid_weight_mask_length(self):\n        \"\"\"Test retrieve with weight_mask of wrong length\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\"]]\n        \n        # Create weight mask with wrong length\n        weight_mask = np.array([1, 0])  # corpus has 4 docs\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(query_tokens, k=2, weight_mask=weight_mask)\n        self.assertIn(\"length of the weight_mask must be the same\", str(context.exception))\n", "code_sha256": "73d782ff0ffc5bc1b4bed9c9f522f028d2b860c603b672d26640f4ac1cdd1db8", "comments": [{"line": 308, "text": "# Create weight mask with wrong length"}, {"line": 309, "text": "# corpus has 4 docs"}], "decorators": [], "definition_line": 301, "docstring": "Test retrieve with weight_mask of wrong length", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_4210c1261d25fb2f53d4ce6eb021baa6305b0abc9d47d653019f644f4fd57460", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 313, "line_start": 301, "name": "test_retrieve_with_invalid_weight_mask_length", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_invalid_weight_mask_length", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_retrieve_with_invalid_weight_mask_length(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
