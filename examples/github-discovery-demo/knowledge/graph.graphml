    <node id="code_candidate_75e66ee80ca3fc0092526948dceea795581776d9e543204bb4ad087172fdc8d1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_utils_corpus(self):\n        save_dir = \"datasets\"\n        dataset = \"scifact\"\n        data_path = beir.util.download_and_unzip(BASE_URL.format(dataset), save_dir)\n\n        corpus_path = f\"{data_path}/corpus.jsonl\"\n\n        nq = JsonlCorpus(corpus_path)\n\n        # get all ids\n\n        corpus_ids = [doc[\"_id\"] for doc in tqdm(nq)]\n\n        # alternatively, try opening the file and read the _ids as we go\n        corpus_ids_2 = []\n        with open(corpus_path, \"r\") as f:\n            for line in f:\n                doc = json.loads(line)\n                corpus_ids_2.append(doc[\"_id\"])\n\n        self.assertListEqual(corpus_ids, corpus_ids_2)\n\n        # check if jsonl corpus can be closed\n        assert nq.file_obj is not None, \"JsonlCorpus file_obj is None, expected file object\"\n        assert nq.mmap_obj is not None, \"JsonlCorpus mmap_obj is None, expected mmap object\"\n\n        # now, we can close\n        nq.close()\n\n        assert nq.file_obj is None, \"JsonlCorpus file_obj is not None, expected None\"\n        assert nq.mmap_obj is None, \"JsonlCorpus mmap_obj is not None, expected None\"\n\n        # check if jsonl corpus can be loaded\n        nq.load()\n\n        assert nq.file_obj is not None, \"JsonlCorpus file_obj is None, expected file object\"\n        assert nq.mmap_obj is not None, \"JsonlCorpus mmap_obj is None, expected mmap object\"\n\n        corpus_ids = [doc[\"_id\"] for doc in tqdm(nq)]\n        self.assertListEqual(corpus_ids, corpus_ids_2)\n", "code_sha256": "9651eb059ba7e544abeb4acdca154e33f1723b1ed742ff2b0f67ea1334529bb6", "comments": [{"line": 21, "text": "# get all ids"}, {"line": 25, "text": "# alternatively, try opening the file and read the _ids as we go"}, {"line": 34, "text": "# check if jsonl corpus can be closed"}, {"line": 38, "text": "# now, we can close"}, {"line": 44, "text": "# check if jsonl corpus can be loaded"}], "decorators": [], "definition_line": 12, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "fe21cccbd001968adb447b8c015cbe15aa7ec565ef380c4242d1606861744c8e", "id": "code_candidate_75e66ee80ca3fc0092526948dceea795581776d9e543204bb4ad087172fdc8d1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tqdm", "name": "tqdm"}, {"alias": null, "level": 0, "line": 6, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 9, "module": "bm25s.utils.beir", "name": "BASE_URL"}], "kind": "method", "line_end": 51, "line_start": 12, "name": "test_utils_corpus", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/comparison/test_utils_corpus.py", "qualified_name": "TestTopKSingleQuery.test_utils_corpus", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_utils_corpus(self)", "source_id": "repo_source_f1385c4a00cc55579fcff02f56ea05a05a5107b6cce9942e249524fe11e0781a", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
