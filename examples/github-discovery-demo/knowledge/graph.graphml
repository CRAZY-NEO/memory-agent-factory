    <node id="code_candidate_dcd6587359055e9e45ce71e87ac52a5b9c7b9ebf9f43cff45d95f4af2f80ec69">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_corpus_as_ndarray(self):\n        \"\"\"Test retrieve with corpus as numpy array\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\", \"feline\"]]\n        \n        # Create corpus as numpy array\n        corpus = np.array(self.corpus)\n        \n        results = retriever.retrieve(query_tokens, corpus=corpus, k=2)\n        self.assertEqual(len(results.documents), 1)\n        self.assertEqual(len(results.documents[0]), 2)\n", "code_sha256": "bf734fa0e01a877a3f5743377e98bc97eecc357c15fcacdad54d3be1f6cf1088", "comments": [{"line": 322, "text": "# Create corpus as numpy array"}], "decorators": [], "definition_line": 315, "docstring": "Test retrieve with corpus as numpy array", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_dcd6587359055e9e45ce71e87ac52a5b9c7b9ebf9f43cff45d95f4af2f80ec69", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 327, "line_start": 315, "name": "test_retrieve_with_corpus_as_ndarray", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_corpus_as_ndarray", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_retrieve_with_corpus_as_ndarray(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
