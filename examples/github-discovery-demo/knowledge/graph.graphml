    <node id="code_candidate_c53c9129c6e5abd9db0fc58dd83698c9340e4d70545039bb3b39a89eff425710">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_scores_from_ids_with_invalid_token_id(self):\n        \"\"\"Test get_scores_from_ids with token ID higher than vocab size\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Get the max token ID in vocab\n        max_token_id = max(retriever.vocab_dict.values())\n        \n        # Try to query with a token ID that's too high\n        with self.assertRaises(ValueError) as context:\n            retriever.get_scores_from_ids([max_token_id + 100])\n        self.assertIn(\"maximum token ID\", str(context.exception))\n", "code_sha256": "17879d667e3a7378235fcb5cb049308adccd5a1d4e90949055e07d1fad09dc2b", "comments": [{"line": 153, "text": "# Get the max token ID in vocab"}, {"line": 156, "text": "# Try to query with a token ID that's too high"}], "decorators": [], "definition_line": 148, "docstring": "Test get_scores_from_ids with token ID higher than vocab size", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_c53c9129c6e5abd9db0fc58dd83698c9340e4d70545039bb3b39a89eff425710", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 159, "line_start": 148, "name": "test_get_scores_from_ids_with_invalid_token_id", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_get_scores_from_ids_with_invalid_token_id", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_get_scores_from_ids_with_invalid_token_id(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
