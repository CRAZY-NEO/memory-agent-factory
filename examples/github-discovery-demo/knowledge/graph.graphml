    <node id="code_candidate_653bc38735d2bc2388c5fdc18638fe482a1debca0df936e6ba430541808310cf">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenizer_with_length_parameter(self):\n        \"\"\"Test tokenizer with explicit length parameter\"\"\"\n        tokenizer = Tokenizer()\n        \n        # Create a generator\n        texts = (t for t in [\"hello world\", \"foo bar\"])\n        result = tokenizer.tokenize(texts, length=2, return_as=\"ids\", show_progress=False)\n        \n        self.assertEqual(len(result), 2)\n", "code_sha256": "578b64b639c7b701785acc25ec64bfc0e9db17914bd683133496c75cb45e1ae1", "comments": [{"line": 120, "text": "# Create a generator"}], "decorators": [], "definition_line": 116, "docstring": "Test tokenizer with explicit length parameter", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_653bc38735d2bc2388c5fdc18638fe482a1debca0df936e6ba430541808310cf", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 124, "line_start": 116, "name": "test_tokenizer_with_length_parameter", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenizer_with_length_parameter", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_tokenizer_with_length_parameter(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalid