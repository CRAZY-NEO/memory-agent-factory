    <node id="code_candidate_66a7357b4abff2c9cf55d477569189223d2145d92ba852cbf4fbabcfad3b6b1c">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_failing_after_adding_new_tokens_query(self):\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n\n        tokenizer = Tokenizer(\n            stemmer=None, stopwords=None, splitter=lambda x: x.split()\n        )\n        corpus_tokens = tokenizer.tokenize(corpus, return_as=\"tuple\", allow_empty=False)\n\n        bm25 = bm25s.BM25()\n        bm25.index(corpus_tokens, create_empty_token=False)\n\n        query = \"unknownword\"\n        query_tokens = tokenizer.tokenize([query], update_vocab=True, allow_empty=False)\n\n        # assert a valueError is raised\n        with self.assertRaises(ValueError):\n            results, scores = bm25.retrieve(query_tokens, k=3)\n", "code_sha256": "982850ef7bb3701b49789878bbfd3da2a8dfeb81c72684fb0ff7111d61291986", "comments": [{"line": 95, "text": "# assert a valueError is raised"}], "decorators": [], "definition_line": 76, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_66a7357b4abff2c9cf55d477569189223d2145d92ba852cbf4fbabcfad3b6b1c", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 97, "line_start": 76, "name": "test_failing_after_adding_new_tokens_query", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_failing_after_adding_new_tokens_query", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_failing_after_adding_new_tokens_query(self)", "source_id": "repo_source_b31addb9a348ead01c951e739ab2fb217f4525d6b1e0d4ef7fcc27db5e86b89b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
