    <node id="code_candidate_d0ac589f0d0e6a4235a74855ca06e641b668464d6b4f454a098a5aeeba9589dc">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def warmup_numba_csc(self):\n        \"\"\"\n        Warm up the Numba CSC builder by running a dummy CSC construction.\n        This will trigger the JIT compilation of the CSC builder function,\n        ensuring that subsequent CSC constructions are faster.\n        \"\"\"\n        # Create dummy data for warmup\n        dummy_data = np.array([1.0, 2.0, 3.0], dtype=self.dtype)\n        dummy_rows = np.array([0, 1, 2], dtype=self.int_dtype)\n        dummy_cols = np.array([0, 0, 0], dtype=self.int_dtype)\n        shape = (3, 1)\n\n        # Run the warmup CSC construction\n        _ = self._np_csc(\n            data=dummy_data,\n            rows=dummy_rows,\n            cols=dummy_cols,\n            shape=shape,\n        )\n", "code_sha256": "9e8b6e4bcde1e2cd2c2678f1dc79f9ed72defc42938a635e94bef9b429f9725b", "comments": [{"line": 1403, "text": "# Create dummy data for warmup"}, {"line": 1409, "text": "# Run the warmup CSC construction"}], "decorators": [], "definition_line": 1397, "docstring": "\n        Warm up the Numba CSC builder by running a dummy CSC construction.\n        This will trigger the JIT compilation of the CSC builder function,\n        ensuring that subsequent CSC constructions are faster.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_d0ac589f0d0e6a4235a74855ca06e641b668464d6b4f454a098a5aeeba9589dc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Union"}, {"alias": "np", "level": 0, "line": 11, "module": "numpy", "name": null}, {"alias": "json_functions", "level": 1, "line": 13, "module": "utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "numba", "name": "njit"}, {"alias": "selection_jit", "level": 1, "line": 17, "module": "numba", "name": "selection"}, {"alias": "sp", "level": 0, "line": 23, "module": "scipy.sparse", "name": null}, {"alias": null, "level": 1, "line": 29, "module": "numba.retrieve_utils", "name": "_retrieve_numba_functional"}, {"alias": null, "level": 0, "line": 43, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "scoring"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "stopwords"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "tokenization"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "utils"}, {"alias": "selection_np", "level": 1, "line": 49, "module": null, "name": "selection"}, {"alias": null, "level": 1, "line": 50, "module": "version", "name": "__version__"}, {"alias": null, "level": 1, "line": 51, "module": "tokenization", "name": "tokenize"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_idf_array"}, {"