      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_init_without_save_index(self):\n        \"\"\"Test JsonlCorpus initialization without saving index\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False, save_index=False)\n        \n        # Check mmindex file was NOT created\n        mmindex_file = change_extension(self.test_file, \".mmindex.json\")\n        self.assertFalse(os.path.exists(mmindex_file))\n        \n        # But corpus should still work\n        self.assertEqual(len(corpus), 5)\n        item = corpus[0]\n        self.assertEqual(item[\"id\"], 0)\n        \n        corpus.close()\n", "code_sha256": "dde62fde841fd63703ef51982a9a9cb92080e8813bf2775d0433403ad6f37bfd", "comments": [{"line": 292, "text": "# Check mmindex file was NOT created"}, {"line": 296, "text": "# But corpus should still work"}], "decorators": [], "definition_line": 288, "docstring": "Test JsonlCorpus initialization without saving index", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_e2ea2c3fdc262f4468c7ce579f54c7f293885a0fea09ff57cd9e66c249bd6fb0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level