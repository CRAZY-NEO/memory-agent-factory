    <node id="code_candidate_718790ee3e5fb6c883d5ca4a7ea08492396303afccb79646d8820d4290cd649d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_extensionless_corpora_have_independent_indexes(self):\n        directory = os.path.join(self.tmpdir, \"data.v1\")\n        os.makedirs(directory)\n        sources = [\n            (os.path.join(directory, \"first\"), [{\"text\": \"one\"}, {\"text\": \"two\"}]),\n            (os.path.join(directory, \"second\"), [{\"text\": \"another document\"}]),\n        ]\n        for path, documents in sources:\n            with open(path, \"w\", encoding=\"utf-8\") as handle:\n                for document in documents:\n                    handle.write(json_functions.dumps(document) + \"\\n\")\n\n        # Verify both newly created and persisted indexes without sharing offsets.\n        for _ in range(2):\n            for path, documents in sources:\n                corpus = JsonlCorpus(path, show_progress=False, verbosity=0)\n                try:\n                    self.assertEqual(len(corpus), len(documents))\n                    self.assertEqual(corpus[:], documents)\n                finally:\n                    corpus.close()\n        for path, _ in sources:\n            self.assertTrue(os.path.isfile(path + \".mmindex.json\"))\n", "code_sha256": "773839b7ffe4ed7b191668da9261d31179af9cb1bcff656a0679d2147dcfca97", "comments": [{"line": 155, "text": "# Verify both newly created and persisted indexes without sharing offsets."}], "decorators": [], "definition_line": 143, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_718790ee3e5fb6c883d5ca4a7ea08492396303afccb79646d8820d4290cd649d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 165, "line_start": 143, "name": "test_extensionless_corpora_have_independent_indexes", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestJsonlCorpus.test_extensionless_corpora_have_independent_indexes", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_extensionless_corpora_have_independent_indexes(self)", "source_id": "repo_source_211fa7d6af255f93f3dc0b1a3484427853aae774b41a3aaad8f9bf1fcb9a6619", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
