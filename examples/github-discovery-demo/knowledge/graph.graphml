    <node id="code_candidate_d9f44f6a9f38cb5b3606cbd57d225f9d9093cdddbf561fdfdaa8ba05f01c4e41">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_only_unknown_token_query_stemmed(self):\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n\n        stemmer = Stemmer.Stemmer(\"english\")\n\n        tokenizer = Tokenizer(\n            stemmer=stemmer, stopwords=None, splitter=lambda x: x.split()\n        )\n        corpus_tokens = tokenizer.tokenize(corpus, return_as=\"tuple\")\n\n        bm25 = bm25s.BM25()\n        bm25.index(corpus_tokens)\n\n        query = \"unknownword\"\n        query_tokens = tokenizer.tokenize([query], update_vocab=False)\n\n        results, scores = bm25.retrieve(query_tokens, k=3)\n        self.assertTrue(np.all(scores == 0.0))\n", "code_sha256": "e213c532d4bc4f8891e87e4cccdee77b3c408945a755b317b2318c497ae0f27d", "comments": [], "decorators": [], "definition_line": 121, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_d9f44f6a9f38cb5b3606cbd57d225f9d9093cdddbf561fdfdaa8ba05f01c4e41", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 143, "line_start": 121, "name": "test_only_unknown_token_query_stemmed", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_only_unknown_token_query_stemmed", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_only_unknown_token_query_stemmed(self)", "source_id": "repo_source_23d568375b3ef8a255d5097c4dfba9bbfbd9775040bff9bf96c69a677bdcdb80", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
