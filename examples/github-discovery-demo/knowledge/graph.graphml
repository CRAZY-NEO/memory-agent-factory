    <node id="code_candidate_56b435fb05d7b6019ae903d7a58426f8f62a83fc948b89287ab308e3457869e1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def close(self):\n        \"\"\"\n        Close the file and mmap objects. This is useful if you want to free up memory. To reopen them, use the `load` method.\n        If you don't call this method, the objects will be closed automatically when the object is deleted.\n        \"\"\"\n        if hasattr(self, \"file_obj\") and self.file_obj is not None:\n            self.file_obj.close()\n            # delete the object\n            del self.file_obj\n            self.file_obj = None\n        if hasattr(self, \"mmap_obj\") and self.mmap_obj is not None:\n            self.mmap_obj.close()\n            # delete the object\n            del self.mmap_obj\n            self.mmap_obj = None\n        if self.verbosity &gt;= 1:\n            logging.info(\"Closed file and mmap objects\")\n", "code_sha256": "ce466bf7a0facc69f6add33fef83286f63f6866458255c746b465840cbec43ea", "comments": [{"line": 198, "text": "# delete the object"}, {"line": 203, "text": "# delete the object"}], "decorators": [], "definition_line": 191, "docstring": "\n        Close the file and mmap objects. This is useful if you want to free up memory. To reopen them, use the `load` method.\n        If you don't call this method, the objects will be closed automatically when the object is deleted.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_56b435fb05d7b6019ae903d7a58426f8f62a83fc948b89287ab308e3457869e1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "method", "line_end": 207, "line_start": 191, "name": "close", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "bm25s/utils/corpus.py", "qualified_name": "JsonlCorpus.close", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def close(self)", "source_id": "repo_source_9c238e0d8cf02a60a1ca21fc96a53350ddd66bc2d369bca811ec00af2621e2bf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
