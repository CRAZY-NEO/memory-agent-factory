    <node id="code_candidate_6fa32a99048db7745da03abeb0fa894e1c3ded3cbdc40df3d551a85c6396bfd2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_with_invalid_stemmer(self):\n        \"\"\"Test tokenization with invalid stemmer raises error\"\"\"\n        texts = [\"hello world\"]\n        \n        # Pass a non-callable, non-stemmer object\n        with self.assertRaises(ValueError) as context:\n            bm25s.tokenize(texts, stemmer=\"not_a_stemmer\", return_ids=False)\n        self.assertIn(\"Stemmer must have\", str(context.exception))\n", "code_sha256": "14a12e7cdae717daaef046280ca687f62ac6d40bf453c3ec128a0c4fd243bf3a", "comments": [{"line": 142, "text": "# Pass a non-callable, non-stemmer object"}], "decorators": [], "definition_line": 138, "docstring": "Test tokenization with invalid stemmer raises error", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_6fa32a99048db7745da03abeb0fa894e1c3ded3cbdc40df3d551a85c6396bfd2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 145, "line_start": 138, "name": "test_tokenize_with_invalid_stemmer", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenize_with_invalid_stemmer", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_tokenize_with_invalid_stemmer(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efa