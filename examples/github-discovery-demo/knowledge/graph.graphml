    <node id="code_candidate_bafd575477b66b97531a85e6df6097cf072acba9e493c3682f80b939a82dbbeb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_e_retrieve_nogil_parallel_threads(self):\n        retriever = bm25s.BM25.load(\n            self.tmpdirname,\n            data_name=\"data.index.csc.npy\",\n            indices_name=\"indices.index.csc.npy\",\n            indptr_name=\"indptr.index.csc.npy\",\n            vocab_name=\"vocab.json\",\n            nnoc_name=\"nonoccurrence_array.npy\",\n            params_name=\"params.json\",\n            load_corpus=True,\n            auto_compile=False,\n        )\n        retriever.compile(activate_numba=True, warmup=False)\n\n        self.assertTrue(retriever.backend == \"numba\", \"The backend should be 'numba'\")\n\n        queries = [[\"my cat loves to purr\"], [\"a fish likes swimming\"]]\n        query_tokens_list = [\n            bm25s.tokenize(query, stopwords=\"en\", stemmer=self.stemmer)\n            for query in queries\n        ]\n        top_k = 2\n\n        def retrieve(query_tokens):\n            return retriever.retrieve(query_tokens, k=top_k, return_as=\"tuple\", n_threads=1)\n\n        # Warm up JIT on the main thread so compilation is not raced.\n        expected_a, expected_b = [retrieve(query_tokens) for query_tokens in query_tokens_list]\n\n        with ThreadPoolExecutor(max_workers=2) as executor:\n            retrieved_a, retrieved_b = executor.map(retrieve, query_tokens_list)\n\n        self.assertTrue(np.all(retrieved_a.scores == expected_a.scores), \"The retrieved scores should be the same\")\n        self.assertTrue(np.all(retrieved_a.documents == expected_a.documents), \"The retrieved documents should be the same\")\n        self.assertTrue(np.all(retrieved_b.scores == expected_b.scores), \"The retrieved scores should be the same\")\n        self.assertTrue(np.all(retrieved_b.documents == expected_b.documents), \"The retrieved documents should be the same\")\n", "code_sha256": "79259f08c34b06cde51ab4b40fe562d87bc51a37e5d8381fac26bfc21135cf4b", "comments": [{"line": 202, "text": "# Warm up JIT on the main thread so compilation is not raced."}], "decorators": [], "definition_line": 176, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "73298969a0628fccdf9af5cde6e7a7c3335a4d3b93692e5f372b8270867b78e9", "id": "code_candidate_bafd575477b66b97531a85e6df6097cf072acba9e493c3682f80b939a82dbbeb", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 8, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 211, "line_start": 176, "name": "test_e_retrieve_nogil_parallel_threads", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/numba/test_numba_backend_retrieve.py", "qualified_name": "TestNumbaBackendRetrieve.test_e_retrieve_nogil_parallel_threads", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_e_retrieve_nogil_parallel_threads(self)", "source_id": "repo_source_b8e3921c3fdab33bd0b2d3d1840d50c656236bccc001188c044ed04a06c878a6", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
