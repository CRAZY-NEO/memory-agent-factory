    <node id="code_candidate_df5d033f8573217bbfb422333cf0de2fddf47273530b220b56e469b14313a098">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_negative_k_raises(self):\n        \"\"\"Negative k must raise a clear ValueError on every backend.\n\n        Before the fix, k&lt;0 silently returned an empty selection on the numpy\n        backend and crashed with a confusing \"negative dimensions\" error on the\n        numba backend. k=0 intentionally returns an empty selection.\n        \"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        backends = [(\"numpy\", lambda k: topk(query_scores, k=k, backend=\"numpy\"))]\n        if _NUMBA_AVAILABLE:\n            backends.append((\"numba\", lambda k: topk_numba(query_scores, k=k)))\n\n        for name, call in backends:\n            for k in (-1, -3):\n                with self.assertRaises(ValueError) as context:\n                    call(k)\n                self.assertIn(\"k must be a non-negative integer\", str(context.exception))\n", "code_sha256": "055e8a933ba7127092f3adbaf2799674905f2117a57eb7db28481da5e2012986", "comments": [], "decorators": [], "definition_line": 78, "docstring": "Negative k must raise a clear ValueError on every backend.\n\n        Before the fix, k&lt;0 silently returned an empty selection on the numpy\n        backend and crashed with a confusing \"negative dimensions\" error on the\n        numba backend. k=0 intentionally returns an empty selection.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_df5d033f8573217bbfb422333cf0de2fddf47273530b220b56e469b14313a098", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 94, "line_start": 78, "name": "test_topk_negative_k_raises", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_negative_k_raises", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_topk_negative_k_raises(self)", "source_id": "repo_source_2c62d0b88f3153e4da6b2f730dc9799c02f8035fc5ed916c0810a4a2f841f6fd", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_0f6e32efe01899058c3cc28f12472dcdfda478457c40d3ccfaec7b3d234fb365">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_zero_k_returns_empty(self):\n        \"\"\"k=0 must keep returning an empty selection (existing contract).\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        scores, indices = topk(query_scores, k=0, backend=\"numpy\", sorted=True)\n        self.assertEqual(scores.size, 0)\n        self.assertEqual(indices.size, 0)\n", "code_sha256": "8ea0be2ea2fceb1941adc6d863907828348e8d93a7e3a8baa0f53cddb0e0f6da", "comments": [], "decorators": [], "definition_line": 96, "docstring": "k=0 must keep returning an empty selection (existing contract).", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_0f6e32efe01899058c3cc28f12472dcdfda478457c40d3ccfaec7b3d234fb365", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 101, "line_start": 96, "name": "test_topk_zero_k_returns_empty", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_zero_k_returns_empty", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_topk_zero_k_returns_empty(self)", "source_id": "repo_source_2c62d0b88f3153e4da6b2f730dc9799c02f8035fc5ed916c0810a4a2f841f6fd", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
