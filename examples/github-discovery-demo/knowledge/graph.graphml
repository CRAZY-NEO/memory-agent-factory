    <node id="code_candidate_be946a51f3023818943867b77f239191948b58c02a5eb07f42ce1abc2caa10c0">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _np_csc_python(data, rows, cols, shape):\n    \"\"\"\n    Pure NumPy implementation of CSC construction.\n    \"\"\"\n    n_cols = shape[1]\n\n    # 1. Compute indptr\n    col_counts = np.bincount(cols, minlength=n_cols)\n\n    indptr = np.zeros(n_cols + 1, dtype=np.int64)\n    np.cumsum(col_counts, out=indptr[1:])\n\n    # 2. Sort the data\n    packed_indices = (cols.astype(np.int64) &lt;&lt; 32) | rows.astype(np.int64)\n    sorter = np.argsort(packed_indices)\n\n    # 3. Reorder arrays based on the sort\n    sorted_data = data[sorter]\n    sorted_indices = rows[sorter]\n    \n    return sorted_data, sorted_indices, indptr\n", "code_sha256": "57e64b0055ef0d1b89590ca40d2841da98e82aa5426f33cbb5ba4cd52a05b0c1", "comments": [{"line": 418, "text": "# 1. Compute indptr"}, {"line": 424, "text": "# 2. Sort the data"}, {"line": 428, "text": "# 3. Reorder arrays based on the sort"}], "decorators": [], "definition_line": 412, "docstring": "\n    Pure NumPy implementation of CSC construction.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_be946a51f3023818943867b77f239191948b58c02a5eb07f42ce1abc2caa10c0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 432, "line_start": 412, "name": "_np_csc_python", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "rows"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cols"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "shape"}], "path": "bm25s/scoring.py", "qualified_name": "_np_csc_python", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _np_csc_python(data, rows, cols, shape)", "source_id": "repo_source_7b306c163e643ec8ce2daf2e4d3b9445af352760b228e7c9b26fbade2cb8008d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
