      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_is_dir_empty_non_empty_dir(self):\n        \"\"\"Test is_dir_empty with non-empty directory\"\"\"\n        non_empty_dir = os.path.join(self.tmpdir, \"non_empty\")\n        os.makedirs(non_empty_dir)\n        \n        # Add a file\n        with open(os.path.join(non_empty_dir, \"file.txt\"), \"w\") as f:\n            f.write(\"test\")\n        \n        self.assertFalse(is_dir_empty(non_empty_dir))\n", "code_sha256": "0ebb215c6b3c2d64de5abafcbd74e2e588df6375c83f57fd242091bf171c7b81", "comments": [{"line": 34, "text": "# Add a file"}], "decorators": [], "definition_line": 29, "docstring": "Test is_dir_empty with non-empty directory", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "28e6fa925022fe2389bec7b19a3d2b1bd8637d9c789a30cbf321af111dcbe48e", "id": "code_candidate_e569e52c7203d5ceeff615bc9ff1103beed2e769385c00d24de31c6c3e2adae0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "can_save_locally"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "is_dir_empty"}], "kind": "method", "line_end": 38, "line_start": 29, "name": "test_is_dir_empty_non_empty_dir", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_hf_utils.py", "qualified_name": "TestHFUtilities.test_is_dir_empty_non_empty_dir", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_is_dir_empty_non_empty_dir(self)", "source_id": "rep