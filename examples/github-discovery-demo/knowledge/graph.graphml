    <node id="code_candidate_e1347648bfef4dd1bfa686cfb5bf9a0cfe3f2fe687717c9805b1d9fffe4bf98c">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_git(package_dir):\n    exact_tag = _git_describe(package_dir, \"--exact-match\")\n    if exact_tag:\n        return _normalize_version(exact_tag)\n\n    description = _git_describe(package_dir, \"--long\")\n    if not description:\n        return None\n\n    match = re.match(r\"(.+)-(\\d+)-g([0-9a-f]+)$\", description)\n    if not match:\n        return None\n\n    tag, distance, sha = match.groups()\n    version = _normalize_version(tag)\n    if distance == \"0\":\n        return version\n\n    suffix = \".dev\" if \".post\" in version else \".post\"\n    return f\"{version}{suffix}{distance}+g{sha}\"\n", "code_sha256": "a355c46b32cc59a908d9f87f4a7a812f19fa29887a9d196d18091c08f4daa475", "comments": [], "decorators": [], "definition_line": 75, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_e1347648bfef4dd1bfa686cfb5bf9a0cfe3f2fe687717c9805b1d9fffe4bf98c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 94, "line_start": 75, "name": "_version_from_git", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_version_from_git", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _version_from_git(package_dir)", "source_id": "repo_source_13ee5cb4f55ed53f88981f2ba569c0924350129c88964ae446001d7220237703", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
