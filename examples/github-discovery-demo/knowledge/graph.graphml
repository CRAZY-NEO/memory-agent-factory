    <node id="code_candidate_d1c49ea20ce673257f2826753481010f3e94895f22bc51feea9b8470fc454867">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_index_with_token_ids_when_zero_exists(self):\n        \"\"\"Test indexing with token IDs when 0 already exists\"\"\"\n        # Create corpus as list of token IDs including 0\n        corpus_token_ids = [[0, 1, 2], [1, 2, 3], [0, 3, 4]]\n        \n        retriever = BM25()\n        retriever.index(corpus_token_ids, create_empty_token=True)\n        \n        # Should add max+1 as empty token since 0 exists\n        self.assertIsNotNone(retriever.vocab_dict)\n", "code_sha256": "6b56dec9e85f17a4efcccebd6ad7a0eec194f7837677cc66bd97195795e8358a", "comments": [{"line": 139, "text": "# Create corpus as list of token IDs including 0"}, {"line": 145, "text": "# Should add max+1 as empty token since 0 exists"}], "decorators": [], "definition_line": 137, "docstring": "Test indexing with token IDs when 0 already exists", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_d1c49ea20ce673257f2826753481010f3e94895f22bc51feea9b8470fc454867", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 146, "line_start": 137, "name": "test_index_with_token_ids_when_zero_exists", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_index_with_token_ids_when_zero_exists", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_index_with_token_ids_when_zero_exists(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
