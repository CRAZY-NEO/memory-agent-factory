    <node id="code_candidate_91f6c159ed8c673582c441e052dab155f185cafe7714084c36118396e94bc6b3">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def get_line(\n    path,\n    index,\n    mmindex,\n    encoding=\"utf-8\",\n    file_obj=None,\n    mmap_obj=None,\n) -&gt; str:\n    path = str(path)\n    if file_obj is None:\n        file_obj = open(path, \"r\", encoding=encoding)\n        CLOSE_FILE = True\n    else:\n        CLOSE_FILE = False\n\n    if mmap_obj is None:\n        mmap_obj = mmap.mmap(file_obj.fileno(), 0, access=mmap.ACCESS_READ)\n        CLOSE_MMAP = True\n    else:\n        CLOSE_MMAP = False\n\n    mmap_obj.seek(mmindex[index])\n    result = mmap_obj.readline().decode(encoding)\n\n    if CLOSE_MMAP:\n        mmap_obj.close()\n\n    if CLOSE_FILE:\n        file_obj.close()\n\n    return result\n", "code_sha256": "ee6c1f093f442ec5fb0fd09191a4f5e5d8edb5270fd73b933cace82ea3eb2149", "comments": [{"line": 72, "text": "# now we can jump to any line in the file thanks to the index and mmap"}], "decorators": [], "definition_line": 73, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_91f6c159ed8c673582c441e052dab155f185cafe7714084c36118396e94bc6b3", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "function", "line_end": 103, "line_start": 73, "name": "get_line", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "path"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "index"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "mmindex"}, {"annotation": null, "default": "'utf-8'", "kind": "positional_or_keyword", "name": "encoding"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "file_obj"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "mmap_obj"}], "path": "bm25s/utils/corpus.py", "qualified_name": "get_line", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "str", "signature": "def get_line(path, index, mmindex, encoding='utf-8', file_obj=None, mmap_obj=None) -&gt; str", "source_id": "repo_source_9c238e0d8cf02a60a1ca21fc96a53350ddd66bc2d369bca811ec00af2621e2bf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_06f9ccd74f430da9274ec8a3d28fe8be402c8a5c898fe48de2888e5bbc62b22e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __init__(self, path, show_progress=True, leave_progress=True, save_index=True, verbosity=1, encoding='utf-8'):\n        self.path = path\n        self.verbosity = verbosity\n        self.encoding = encoding\n\n        # if the index file does not exist, create it\n        if os.path.exists(change_extension(path, \".mmindex.json\")):\n            self.mmindex = load_mmindex(path, encoding=self.encoding)\n        else:\n            logging.info(\"Creating index file for jsonl corpus\")\n            mmindex = find_newline_positions(\n                path, show_progress=show_progress, leave_progress=leave_progress, encoding=self.encoding\n            )\n            if save_index:\n                save_mmindex(mmindex, path, encoding=self.encoding)\n\n            self.mmindex = mmindex\n\n        # Finally, open the file and mmap objects\n        self.load()\n", "code_sha256": "3be5996650792fece84157c5a429ff94aba8a095451e3bf50cf548c5ca6fbfec", "comments": [{"line": 138, "text": "# if the index file does not exist, create it"}, {"line": 151, "text": "# Finally, open the file and mmap objects"}], "decorators": [], "definition_line": 133, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_06f9ccd74f430da9274ec8a3d28fe8be402c8a5c898fe48de2888e5bbc62b22e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "method", "line_end": 152, "line_start": 133, "name": "__init__", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "path"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "leave_progress"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "save_index"}, {"annotation": null, "default": "1", "kind": "positional_or_keyword", "name": "verbosity"}, {"annotation": null, "default": "'utf-8'", "kind": "positional_or_keyword", "name": "encoding"}], "path": "bm25s/utils/corpus.py", "qualified_name": "JsonlCorpus.__init__", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def __init__(self, path, show_progress=True, leave_progress=True, save_index=True, verbosity=1, encoding='utf-8')", "source_id": "repo_source_9c238e0d8cf02a60a1ca21fc96a53350ddd66bc2d369bca811ec00af2621e2bf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
