"name": "test_jsonl_corpus_getitem_invalid_type", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestJsonlCorpus.test_jsonl_corpus_getitem_invalid_type", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_jsonl_corpus_getitem_invalid_type(self)", "source_id": "repo_source_211fa7d6af255f93f3dc0b1a3484427853aae774b41a3aaad8f9bf1fcb9a6619", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
