      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def unchunk(lsts):\n    # merge all lsts into one list\n    return [item for lst in lsts for item in lst]\n", "code_sha256": "36a2a40b472905cbd661694dedbda3738d277bb8e825c66c5249d1918d800a40", "comments": [{"line": 33, "text": "# merge all lsts into one list"}], "decorators": [], "definition_line": 32, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "b3c3f4cb4763b2918bfc153e36e6e31970a23a7e6ae57c587215bb3a89e338e4", "id": "code_candidate_c50ac9951e769838b34528d6865de58f8eff4cec8a9e29dc0516eaf19af1841e", "imports": [{"alias": "mp", "level": 0, "line": 18, "module": "multiprocessing", "name": null}, {"alias": null, "level": 0, "line": 20, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 21, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 22, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 23, "module": "bm25s.utils.benchmark", "name": "Timer"}, {"alias": null, "level": 0, "line": 24, "module": "bm25s.utils.beir", "name": "BASE_URL"}], "kind": "function", "line_end": 34, "line_start": 32, "name": "unchunk", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "lsts"}], "path": "examples/tokenize_multiprocess.py", "qualified_name": "unchunk", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def unchunk(lsts)", "source_id": "repo_source_5bb559e834f4c21b304c2ccff12cd39ef698bf60e01ad2f9c26df0ade1bea2d3", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
