      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_backend_auto_selection_no_numba(self):\n        \"\"\"Test backend auto selection when numba is not available\"\"\"\n        # Create a BM25 instance with auto backend\n        retriever = BM25(backend=\"auto\")\n        # The backend should be set based on availability\n        # We can't easily test without numba, but we can at least verify it doesn't crash\n        self.assertIn(retriever.backend, [\"numpy\", \"numba\"])\n", "code_sha256": "63232676e51f5ebb65547fdb67c785f29a766293cb6bda5b8fde2156cadeba82", "comments": [{"line": 27, "text": "# Create a BM25 instance with auto backend"}, {"line": 29, "text": "# The backend should be set based on availability"}, {"line": 30, "text": "# We can't easily test without numba, but we can at least verify it doesn't crash"}], "decorators": [], "definition_line": 25, "docstring": "Test backend auto selection when numba is not available", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_d9ea223433d38cfb3f5426b995d6661593a1e41b97351387c415e320f7135eb1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 31, "line_start":