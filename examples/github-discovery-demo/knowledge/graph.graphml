      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_return_types(self):\n        \"\"\"Tests the `tokenize` method with different `return_as` parameter values (`ids`, `string`, `tuple`).\"\"\"\n        result_ids = self.tokenizer.tokenize(self.corpus, return_as=\"ids\", show_progress=False)\n        result_strings = self.tokenizer.tokenize(self.corpus, return_as=\"string\", show_progress=False)\n        result_tuple = self.tokenizer.tokenize(self.corpus, return_as=\"tuple\", show_progress=False)\n\n        self.assertIsInstance(result_ids, list)\n        self.assertIsInstance(result_strings, list)\n        self.assertIsInstance(result_tuple, tuple)\n", "code_sha256": "66c4e98ae38e84fbf41bdafce207a58a8c812b8085ddadf9370d12889cfd90cc", "comments": [], "decorators": [], "definition_line": 106, "docstring": "Tests the `tokenize` method with different `return_as` parameter values (`ids`, `string`, `tuple`).", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_d7d39612be1f5a57435f8faa950d4f93df0877ec080ea6536a29cd362449dfcd", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 114, "line_star