      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def tearDownClass(cls):\n        \"\"\"Cleans up resources after all tests have run (not required in this test case).\"\"\"\n        # delete temp dir\n        shutil.rmtree(cls.tmpdir)\n", "code_sha256": "803430667e7fec35a744536ee5c7fee86ae3699c2dc0dc40d54e809a6251ffa3", "comments": [{"line": 232, "text": "# delete temp dir"}], "decorators": ["classmethod"], "definition_line": 230, "docstring": "Cleans up resources after all tests have run (not required in this test case).", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_58ab8c25c39d538972023acbe4e94adb013ea65dd00ae3c89010a6da7d216da6", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 233, "line_start": 229, "name": "tearDownClass", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cls"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.tearDownClass", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def tearDownClass(cls)", "source_id": "repo_source_ae51486d134a6041ab337f3bc922236f8149c1552157012e7e67afcf3e89ab60", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
