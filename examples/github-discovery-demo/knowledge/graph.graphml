      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __init__(self, prefix=\"\", precision=4):\n        self.results = {}\n        self.prefix = prefix\n        self.precision = precision\n", "code_sha256": "27a228cb96f06755cbe778d9f8df66fde09e447e65fac31b6fc4ed8729d58c39", "comments": [], "decorators": [], "definition_line": 37, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_a3dc69d5a2a610b0a10e9ed6f7969aabd35d1233782c2f4476fecb727a30f2f4", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 40, "line_start": 37, "name": "__init__", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": "''", "kind": "positional_or_keyword", "name": "prefix"}, {"annotation": null, "default": "4", "kind": "positional_or_keyword", "name": "precision"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.__init__", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def __init__(self, prefix='', precision=4)", "source_id": "repo_source_43fd334d6b3ac591ecde766e3edc2ab0b85c456f8eece5f44d103b24d412ad90", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
