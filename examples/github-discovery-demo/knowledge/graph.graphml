    <node id="code_candidate_46c74623a60d60da90816371a9f9ba2311ffd2d543ca9572e27fbdac423a80ce">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def setUpClass(cls):\n        # check that import orjson fails\n        import bm25s\n\n        # Create your corpus here\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n            \"שלום חברים, איך אתם היום?\",\n            \"El café está muy caliente\",\n            \"今天的天气真好!\",\n            \"Как дела?\",\n            \"Türkçe öğreniyorum.\"\n        ]\n\n        # optional: create a stemmer\n        stemmer = Stemmer.Stemmer(\"english\")\n\n        # Tokenize the corpus and only keep the ids (faster and saves memory)\n        corpus_tokens = bm25s.tokenize(corpus, stopwords=\"en\", stemmer=stemmer)\n\n        # Create the BM25 model and index the corpus\n        retriever = bm25s.BM25(method='bm25+')\n        retriever.index(corpus_tokens)\n\n        # Save the retriever to temp dir\n        cls.retriever = retriever\n        cls.corpus = corpus\n        cls.corpus_tokens = corpus_tokens\n        cls.stemmer = stemmer\n        cls.tmpdirname = tempfile.mkdtemp()\n", "code_sha256": "89f0f437779bd4cd6a91ee6b0a017f88603603bcdc94eb832f31ac3dedeabc8a", "comments": [{"line": 19, "text": "# check that import orjson fails"}, {"line": 22, "text": "# Create your corpus here"}, {"line": 35, "text": "# optional: create a stemmer"}, {"line": 38, "text": "# Tokenize the corpus and only keep the ids (faster and saves memory)"}, {"line": 41, "text": "# Create the BM25 model and index the corpus"}, {"line": 45, "text": "# Save the retriever to temp dir"}], "decorators": ["classmethod"], "definition_line": 18, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5c821b6a5a4313298a2dd6cf0c18ca5a42d4e9ce84bab16a261cfb3edb01562b", "id": "code_candidate_46c74623a60d60da90816371a9f9ba2311ffd2d543ca9572e27fbdac423a80ce", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 20, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 55, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 139, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 161, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 184, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 185, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 50, "line_start": 17, "name": "setUpClass", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cls"}], "path": "tests/core/test_save_load.py", "qualified_name": "TestBM25SLoadingSaving.setUpClass", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def setUpClass(cls)", "source_id": "repo_source_f6f16b47903aa7267a69de367190d46e23e404c17dc67b599c3fad64d79d6741", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", 