    <node id="code_candidate_6637bfddeedecbf482c20aa154eee694af4b8c7553cae169bb6642b397fdb77b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(index_dir=\"bm25s_indices/\", data_dir=\"datasets\", dataset=\"nq\", split=\"test\", bsize=20):\n    index_dir = Path(index_dir) / dataset\n    mmap = True\n    print(\"Using memory-mapped index (mmap) to reduce memory usage.\")\n\n    timer = bm25s.utils.benchmark.Timer(\"[BM25S]\")\n\n    queries = bm25s.utils.beir.load_queries(dataset, save_dir=data_dir)\n    qrels = bm25s.utils.beir.load_qrels(dataset, split=split, save_dir=data_dir)\n    queries_lst = [v[\"text\"] for k, v in queries.items() if k in qrels]\n    print(f\"Loaded {len(queries_lst)} queries.\")\n\n    # Tokenize the queries\n    stemmer = Stemmer.Stemmer(\"english\")\n    queries_tokenized = bm25s.tokenize(queries_lst, stemmer=stemmer, return_ids=False)\n\n    mem_use = bm25s.utils.benchmark.get_max_memory_usage()\n    print(f\"Initial memory usage: {mem_use:.2f} GB\")\n\n    # Load the BM25 index and retrieve the top-k results\n    print(\"Loading the BM25 index...\")\n    t = timer.start(\"Loading index\")\n    retriever = bm25s.BM25.load(index_dir, mmap=mmap, load_corpus=True)\n    retriever.backend = \"numba\"\n    num_docs = retriever.scores[\"num_docs\"]\n    timer.stop(t, show=True, n_total=num_docs)\n\n    mem_use = bm25s.utils.benchmark.get_max_memory_usage()\n    print(f\"Memory usage after loading the index: {mem_use:.2f} GB\")\n\n    print(\"Retrieving the top-k results...\")\n    t = timer.start(\"Retrieving\")\n\n    batches = []\n\n    for i in tqdm(range(0, len(queries_lst), bsize)):\n        batches.append(retriever.retrieve(queries_tokenized[i : i + bsize], k=10))\n        \n        # reload the corpus and scores to free up memory\n        retriever.load_scores(save_dir=index_dir, mmap=mmap, num_docs=num_docs)\n        if isinstance(retriever.corpus, bm25s.utils.corpus.JsonlCorpus):\n            retriever.corpus.load()\n\n    results = bm25s.Results.merge(batches)\n\n    timer.stop(t, show=True, n_total=len(queries_lst))\n\n    # get memory usage\n    mem_use = bm25s.utils.benchmark.get_max_memory_usage()\n    print(f\"Final (peak) memory usage: {mem_use:.2f} GB\")\n\n    print(\"-\" * 50)\n    first_result = results.documents[0]\n    print(f\"First score (# 1 result): {results.scores[0, 0]:.4f}\")\n    print(f\"First result (# 1 result):\\n{first_result[0]}\")\n", "code_sha256": "fd831083538ce3aec7228ddab4f2fc00b4eebc9e697cc7c89180d48cbc34941b", "comments": [{"line": 46, "text": "# Tokenize the queries"}, {"line": 53, "text": "# Load the BM25 index and retrieve the top-k results"}, {"line": 72, "text": "# reload the corpus and scores to free up memory"}, {"line": 81, "text": "# get memory usage"}], "decorators": [], "definition_line": 34, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5ce81fd4c49ba2bd2564b29109fe82b7ed54fd3f550443ca13fe9100e43bcf9b", "id": "code_candidate_6637bfddeedecbf482c20aa154eee694af4b8c7553cae169bb6642b397fdb77b", "imports": [{"alias": null, "level": 0, "line": 28, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 29, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 30, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 31, "module": "tqdm", "name": "tqdm"}], "kind": "function", "line_end": 88, "line_start": 34, "name": "main", "parameters": [{"annotation": null, "default": "'bm25s_indices/'", "kind": "positional_or_keyword", "name": "index_dir"}, {"annotation": null, "default": "'datasets'", "kind": "positional_or_keyword", "name": "data_dir"}, {"annotation": null, "default": "'nq'", "kind": "positional_or_keyword", "name": "dataset"}, {"annotation": null, "default": "'test'", "kind": "positional_or_keyword", "name": "split"}, {"annotation": null, "default": "20", "kind": "positional_or_keyword", "name": "bsize"}], "path": "examples/retrieve_nq_with_batching.py", "qualified_name": "main", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def main(index_dir='bm25s_indices/', data_dir='datasets', dataset='nq', split='test', bsize=20)", "source_id": "repo_source_aafb4cb5df8687aa53a6182190db6b66165c94c2085b669175da9fa9b159bd44", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
