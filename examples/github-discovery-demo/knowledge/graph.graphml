      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef sift_up(values, indices, pos, length):\n    startpos = pos\n    new_value = values[pos]\n    new_index = indices[pos]\n    childpos = 2 * pos + 1\n    while childpos &lt; length:\n        rightpos = childpos + 1\n        if rightpos &lt; length and values[rightpos] &lt; values[childpos]:\n            childpos = rightpos\n        values[pos] = values[childpos]\n        indices[pos] = indices[childpos]\n        pos = childpos\n        childpos = 2 * pos + 1\n    values[pos] = new_value\n    indices[pos] = new_index\n    sift_down(values, indices, startpos, pos)\n", "code_sha256": "22901dae9aafacf8295e307bee6bd169ebd6747e1eb1563b34e4419503f70a2c", "comments": [], "decorators": ["njit(nogil=True)"], "definition_line": 49, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_a0bb5e68cd5abc0753833c48b2ffbc9f059f2a8f40a540569d5c86a1b4218f4b", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 64, "line_start": 48, "name": "sift_up", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "values"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "pos"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "length"}], "path": "bm25s/numba/selection.py", "qualified_name": "sift_up", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def sift_up(values, indices, pos, length)", "source_id": "repo_source_fe79b4a0e95dc30caa0268cb9c9c83acfa0f516285fcb809326d026e57a94e2b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
