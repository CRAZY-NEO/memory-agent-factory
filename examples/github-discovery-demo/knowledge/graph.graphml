    <node id="code_candidate_24968ecf8d7d68c379afb0a4859af75419ffd399a65cb4dab52516c7609eee83">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_dumps_with_unicode(self):\n        \"\"\"Test dumps with unicode characters\"\"\"\n        data = {\"text\": \"héllo wörld\"}\n        \n        # With ensure_ascii=False\n        result = json_functions.dumps(data, ensure_ascii=False)\n        self.assertIsInstance(result, str)\n        \n        # Should be able to load it back\n        loaded = json_functions.loads(result)\n        self.assertEqual(loaded[\"text\"], \"héllo wörld\")\n", "code_sha256": "0f877aa30352e3859070ef8aba92a4f30f2c96f6b3cffc80b4a201c80abfc8d8", "comments": [{"line": 37, "text": "# With ensure_ascii=False"}, {"line": 41, "text": "# Should be able to load it back"}], "decorators": [], "definition_line": 33, "docstring": "Test dumps with unicode characters", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_24968ecf8d7d68c379afb0a4859af75419ffd399a65cb4dab52516c7609eee83", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 43, "line_start": 33, "name": "test_dumps_with_unicode", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_dumps_with_unicode", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_dumps_with_unicode(self)", "source_id": "repo_source_4984691608886d7ad2efe38d4ace55d30ada338a0e182157102471e62e25548f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
