    <node id="code_candidate_bcc2dbf813445aef3d5ea8c959e3d61aa2c594c6bed48d2ee7281435adac9c38">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def create_parser():\n    \"\"\"Create the argument parser for the terminal CLI.\"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"bm25\",\n        description=\"BM25S Terminal CLI - Index and search documents\",\n    )\n    \n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n    \n    # Index subcommand\n    index_parser = subparsers.add_parser(\n        \"index\",\n        help=\"Index documents from a file (CSV, TXT, JSON, or JSONL)\",\n    )\n    index_parser.add_argument(\n        \"file\",\n        type=str,\n        help=\"Path to the input file (CSV, TXT, JSON, or JSONL)\",\n    )\n    index_parser.add_argument(\n        \"-o\", \"--output\",\n        type=str,\n        default=None,\n        help=\"Output directory/name for the index (default: &lt;filename&gt;_index)\",\n    )\n    index_parser.add_argument(\n        \"-c\", \"--column\",\n        type=str,\n        default=None,\n        help=\"Column name for document text (for CSV/JSON/JSONL files)\",\n    )\n    index_parser.add_argument(\n        \"-u\", \"--user\",\n        action=\"store_true\",\n        default=False,\n        help=\"Save index to user directory (~/.bm25s/indices/)\",\n    )\n    \n    # Search subcommand\n    search_parser = subparsers.add_parser(\n        \"search\",\n        help=\"Search an index with a query\",\n    )\n    search_parser.add_argument(\n        \"-i\", \"--index\",\n        type=str,\n        default=None,\n        help=\"Path to the index directory (or index name if using -u)\",\n    )\n    search_parser.add_argument(\n        \"query\",\n        type=str,\n        help=\"Search query\",\n    )\n    search_parser.add_argument(\n        \"-k\", \"--top-k\",\n        type=int,\n        default=10,\n        help=\"Number of results to return (default: 10)\",\n    )\n    search_parser.add_argument(\n        \"-s\", \"--save\",\n        type=str,\n        default=None,\n        help=\"Save results to a JSON file at the specified path\",\n    )\n    search_parser.add_argument(\n        \"-u\", \"--user\",\n        action=\"store_true\",\n        default=False,\n        help=\"Use index from user directory (~/.bm25s/indices/). Shows picker if -i not specified.\",\n    )\n    \n    return parser\n", "code_sha256": "7faf8e77bd41739422702884ea58c006a23b2b6c4fbae47afea7ae8de17d6e0f", "comments": [{"line": 305, "text": "# Index subcommand"}, {"line": 334, "text": "# Search subcommand"}], "decorators": [], "definition_line": 296, "docstring": "Create the argument parser for the terminal CLI.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "494e56b9ebbe6dbee99d7037fdad57f53423edd7135b51252c8f65ce514a9a38", "id": "code_candidate_bcc2dbf813445aef3d5ea8c959e3d61aa2c594c6bed48d2ee7281435adac9c38", "imports": [{"alias": null, "level": 0, "line": 15, "module": "argparse", "name": null}, {"alias": null, "level": 0, "line": 16, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 17, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 56, "module": "rich.console", "name": "Console"}, {"alias": null, "level": 0, "line": 57, "module": "rich.prompt", "name": "Prompt"}, {"alias": null, "level": 0, "line": 58, "module": "rich.table", "name": "Table"}, {"alias": null, "level": 0, "line": 59, "module": "rich.panel", "name": "Panel"}, {"alias": "create_index", "level": 2, "line": 130, "module": "high_level", "name": "index"}, {"alias": "load_documents", "level": 2, "line": 130, "module": "high_level", "name": "load"}, {"alias": null, "level": 2, "line": 195, "module": null, "name": "BM25"}, {"alias": null, "level": 2, "line": 196, "module": "high_level", "name": "BM25Search"}], "kind": "function", "line_end": 369, "line_start": 296, "name": "create_parser", "parameters": [], "path": "bm25s/terminal/__init__.py", "qualified_name": "create_parser", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def create_parser()", "source_id": "repo_source_d90ec750371a8e4f760393696c89eb4723fedbe28852d9f0c4288c8fc61d6fd9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
