      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_select_idf_scorer_invalid_method(self):\n        \"\"\"Test that _select_idf_scorer raises ValueError for invalid method\"\"\"\n        with self.assertRaises(ValueError) as context:\n            _select_idf_scorer(\"invalid_method\")\n        self.assertIn(\"Invalid score_idf_inner value\", str(context.exception))\n", "code_sha256": "6b0e4361f76e50cbf1ec0dd06aa89099c328536719d05beaec9d17570a7dd967", "comments": [], "decorators": [], "definition_line": 20, "docstring": "Test that _select_idf_scorer raises ValueError for invalid method", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "12dde22d99c544ae01ed2fce528c6a05ab27be8a781de28a699c38a8397797a8", "id": "code_candidate_dbf53d9a8eea3830d722afa691965bf0bd0aeb0c5b51abe073b3eb73bd2539d5", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_legacy"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_tfc_scorer"}], "kind": "method", "line_end": 24, "line_start": 20, "name": "test_select_idf_scorer_invalid_method", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_scoring.py", "qualified_name": "TestScoringFunctions.test_select_idf_scorer_invalid_method", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_select_idf_scorer_invalid_met