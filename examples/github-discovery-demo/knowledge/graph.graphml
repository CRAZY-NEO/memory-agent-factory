    <node id="code_candidate_4c93f738e50d4aa5ffad77b8a63db2de2f12371ab49ba92747d58e3ab480f2f0">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_with_load_vocab_false(self):\n        \"\"\"Test load with load_vocab=False\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        retriever.save(self.tmpdir)\n        \n        # Load without vocab\n        loaded = BM25.load(self.tmpdir, load_vocab=False)\n        \n        # vocab_dict should be empty\n        self.assertEqual(len(loaded.vocab_dict), 0)\n", "code_sha256": "f905d642e13a9f626b99f46efbbf450ffc8225e9b80d8724db0d6ef2c08c7c53", "comments": [{"line": 413, "text": "# Load without vocab"}, {"line": 416, "text": "# vocab_dict should be empty"}], "decorators": [], "definition_line": 407, "docstring": "Test load with load_vocab=False", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_4c93f738e50d4aa5ffad77b8a63db2de2f12371ab49ba92747d58e3ab480f2f0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 417, "line_start": 407, "name": "test_load_with_load_vocab_false", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qua