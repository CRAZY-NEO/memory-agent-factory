    <node id="code_candidate_293050778ff46c925b961a5ce99ce5a49f8752304c7f8e992d4c3aa8bc8a778b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_empty_sentence_and_unknown_word(self):\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n        new_docs = [\"cat\", \"\", \"potato\"]\n        tokenizer = Tokenizer(stopwords=\"en\")\n        corpus_tokens = tokenizer.tokenize(corpus)\n        new_docs_tokens = tokenizer.tokenize(new_docs)\n\n        self.assertTrue(np.all(new_docs_tokens == np.array([[1], [0], [0]])))\n", "code_sha256": "b9b4cb668c8a2f69f3142886199fdd0a370cb8e0e4bbc042221c07af662ca465", "comments": [], "decorators": [], "definition_line": 215, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_293050778ff46c925b961a5ce99ce5a49f8752304c7f8e992d4c3aa8bc8a778b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 227, "line_start": 215, "name": "test_empty_sentence_and_unknown_word", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_empty_sentence_and_unknown_word", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_empty_sentence_and_unknown_word(self)", "source_id": "repo_source_f01c1006e1a4861755fc65ea7a7f183e7109351add93b6ab38a478c435375b0f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
