    <node id="code_candidate_0c87ae2bce768c07623de53b282034eee5fe1527ff355cad419596797886177c">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def elapsed(self, name, precision=None):\n        if precision is None:\n            precision = self.precision\n\n        if not self.has_started(name):\n            raise ValueError(f\"Timer with name {name} not started.\")\n        if not self.has_stopped(name):\n            raise ValueError(f\"Timer with name {name} not stopped.\")\n\n        return round(self.results[name][\"elapsed\"], precision)\n", "code_sha256": "eec20682388c33f0fca641ea49b4c86453673ee60e520b1437340bb8dc63490b", "comments": [], "decorators": [], "definition_line": 99, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_0c87ae2bce768c07623de53b282034eee5fe1527ff355cad419596797886177c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 108, "line_start": 99, "name": "elapsed", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "precision"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.elapsed", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def elapsed(self, name, precision=None)", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d013be753eacf3220cbe96f3ac675f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_e7e65a2f736a899932e0ee08436106b17a725f04317e2c04f49fe922fd2a3fd0">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def show(self, name, offset=0, n_total=None):\n        t = self.elapsed(name) + offset\n        s = f\"{self.prefix} {name}: {t:.4f}s\"\n        if n_total is not None:\n            # calculate throughput\n            throughput = n_total / t\n            s += f\" ({throughput:.2f}/s)\"\n        print(s)\n", "code_sha256": "c06c94d310fabaa85bdda641930d8985ab4d4c89b742327b06e841a5f0a14e95", "comments": [{"line": 114, "text": "# calculate throughput"}], "decorators": [], "definition_line": 110, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_e7e65a2f736a899932e0ee08436106b17a725f04317e2c04f49fe922fd2a3fd0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 117, "line_start": 110, "name": "show", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}, {"annotation": null, "default": "0", "kind": "positional_or_keyword", "name": "offset"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "n_total"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.show", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def show(self, name, offset=0, n_total=None)", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d013be753eacf3220cbe96f3ac675f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_3306a6aab0049526b58e77ad7f0ebe33e38ad9f99ba38cce9a2936a83fe9d94e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def show_all(self):\n        for name in self.results:\n            if self.has_stopped(name):\n                self.show(name)\n", "code_sha256": "aad5b005a3eecf0eec37991bf9c2ec66525ce1005ad0531e3f101274ff7a6afc", "comments": [], "decorators": [], "definition_line": 119, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_3306a6aab0049526b58e77ad7f0ebe33e38ad9f99ba38cce9a2936a83fe9d94e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 122, "line_start": 119, "name": "show_all", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.show_all", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def show_all(self)", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d013be753eacf3220cbe96f3ac675f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
