    <node id="code_candidate_0df9ade963007b2904484c8680f33b4865409bb9218fefe8e3bc444d3b57ed81">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef _numba_sorted_top_k(array: np.ndarray, k: int, sorted=True):\n    n = len(array)\n    if k &gt; n:\n        k = n\n\n    values = np.zeros(k, dtype=array.dtype)  # aka scores\n    indices = np.zeros(k, dtype=np.int32)\n    length = 0\n\n    for i, value in enumerate(array):\n        if length &lt; k:\n            heap_push(values, indices, value, i, length)\n            length += 1\n        else:\n            if value &gt; values[0]:\n                values[0] = value\n                indices[0] = i\n                sift_up(values, indices, 0, length)\n\n    if sorted:\n        # # This is the original code for sorting, we can skip it and return the values and indices\n        # # to let numpy handle the sorting\n        # top_k_values = np.zeros(k, dtype=array.dtype)\n        # top_k_indices = np.zeros(k, dtype=np.int32)\n\n        # for i in range(k - 1, -1, -1):\n        #     top_k_values[i], top_k_indices[i] = heap_pop(values, indices, length)\n        #     length -= 1\n        # values = top_k_values\n        # indices = top_k_indices\n\n        # This is the new code that uses numpy to sort the values and indices instead of\n        # using the heap to sort them.\n        sorted_indices = np.flip(np.argsort(values))\n        indices = indices[sorted_indices]\n        values = values[sorted_indices]\n\n    return values, indices\n", "code_sha256": "7c49e35cc62f7ecb36ebec1de89680338f189b9fb72fbd4a4f96d80273b67383", "comments": [{"line": 92, "text": "# aka scores"}, {"line": 107, "text": "# # This is the original code for sorting, we can skip it and return the values and indices"}, {"line": 108, "text": "# # to let numpy handle the sorting"}, {"line": 109, "text": "# top_k_values = np.zeros(k, dtype=array.dtype)"}, {"line": 110, "text": "# top_k_indices = np.zeros(k, dtype=np.int32)"}, {"line": 112, "text": "# for i in range(k - 1, -1, -1):"}, {"line": 113, "text": "#     top_k_values[i], top_k_indices[i] = heap_pop(values, indices, length)"}, {"line": 114, "text": "#     length -= 1"}, {"line": 115, "text": "# values = top_k_values"}, {"line": 116, "text": "# indices = top_k_indices"}, {"line": 118, "text": "# This is the new code that uses numpy to sort the values and indices instead of"}, {"line": 119, "text": "# using the heap to sort them."}], "decorators": ["njit(nogil=True)"], "definition_line": 87, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_0df9ade963007b2904484c8680f33b4865409bb9218fefe8e3bc444d3b57ed81", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 124, "line_start": 86, "name": "_numba_sorted_top_k", "parameters": [{"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "array"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "k"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "bm25s/numba/selection.py", "qualified_name": "_numba_sorted_top_k", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _numba_sorted_top_k(array: np.ndarray, k: int, sorted=True)", "source_id": "repo_source_fe79b4a0e95dc30caa0268cb9c9c83acfa0f516285fcb809326d026e57a94e2b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
