    <node id="code_candidate_252d3a3a6170087c2437d9f543046860cfbb02590eabcd24445c41c256ec3592">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def load_vocab_from_hub(\n        cls,\n        repo_id: str,\n        revision=None,\n        token=None,\n        local_dir=None,\n    ):\n        \"\"\"\n        This function loads the tokenizer's vocab from the Hugging Face Hub.\n\n        Parameters\n        ----------\n        repo_id: str\n            The unique identifier of the repository to load the model from.\n            The `repo_id` should be in the form of \"username/repo_name\".\n        \n        revision: str\n            The revision of the model to load.\n        \n        token: str\n            The Hugging Face API token to use.\n        \n        local_dir: str\n            The local dir where the model will be stored after downloading.\n        \n        allow_pickle: bool\n            Whether to allow pickling the model. Default is False.\n        \"\"\"\n        api = HfApi(token=token)\n        # check if the model exists\n        repo_url = api.repo_info(repo_id)\n        if repo_url is None:\n            raise ValueError(f\"Model {repo_id} not found on the Hugging Face Hub.\")\n\n        snapshot = api.snapshot_download(\n            repo_id=repo_id, revision=revision, token=token, local_dir=local_dir\n        )\n        if snapshot is None:\n            raise ValueError(f\"Model {repo_id} not found on the Hugging Face Hub.\")\n\n        return cls.load_vocab(save_dir=snapshot)\n", "code_sha256": "e14359cf860e018600658cc42790d0c52fd28de775e592b15ee804dc73e667a8", "comments": [{"line": 354, "text": "# check if the model exists"}], "decorators": [], "definition_line": 325, "docstring": "\n        This function loads the tokenizer's vocab from the Hugging Face Hub.\n\n        Parameters\n        ----------\n        repo_id: str\n            The unique identifier of the repository to load the model from.\n            The `repo_id` should be in the form of \"username/repo_name\".\n        \n        revision: str\n            The revision of the model to load.\n        \n        token: str\n            The Hugging Face API token to use.\n        \n        local_dir: str\n            The local dir where the model will be stored after downloading.\n        \n        allow_pickle: bool\n            Whether to allow pickling the model. Default is False.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ef53c4775b6f6fde4a3a4fa5f687268b5f70562a82e11bd0f59c1757b1eed21b", "id": "code_candidate_252d3a3a6170087c2437d9f543046860cfbb02590eabcd24445c41c256ec3592", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Union"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "BM25"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "__version__"}, {"alias": null, "level": 1, "line": 8, "module": "tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 11, "module": "huggingface_hub", "name": "HfApi"}, {"alias": null, "level": 0, "line": 23, "module": "tqdm.auto", "name": "tqdm"}], "kind": "method", "line_end": 365, "line_start": 325, "name": "load_vocab_from_hub", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cls"}, {"annotation": "str", "default": null, "kind": "positional_or_keyword", "name": "repo_id"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "revision"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "token"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "local_dir"}], "path": "bm25s/hf.py", "qualified_name": "TokenizerHF.load_vocab_from_hub", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def load_vocab_from_hub(cls, repo_id: str, revision=None, token=None, local_dir=None)", "source_id": "repo_source_0276421611c94f62aae4f29f2f8c49b6a55fdbc5f9730e16e2b68068c8b133ae", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
