      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_is_dir_empty_nonexistent(self):\n        \"\"\"Test is_dir_empty with non-existent directory\"\"\"\n        non_existent = os.path.join(self.tmpdir, \"does_not_exist\")\n        self.assertTrue(is_dir_empty(non_existent))\n", "code_sha256": "40fa4dbc8c68c6c5651f000b28eff07da8149bc08265057cdfd1becf069fd548", "comments": [], "decorators": [], "definition_line": 18, "docstring": "Test is_dir_empty with non-existent directory", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "28e6fa925022fe2389bec7b19a3d2b1bd8637d9c789a30cbf321af111dcbe48e", "id": "code_candidate_17b4b38e886a6f7eaf752cf31485b0c1dd47f74cc5fb86d9eb458bfd053d3246", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "can_save_locally"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "is_dir_empty"}], "kind": "method", "line_end": 21, "line_start": 18, "name": "test_is_dir_empty_nonexistent", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_hf_utils.py", "qualified_name": "TestHFUtilities.test_is_dir_empty_nonexistent", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_is_dir_empty_nonexistent(self)", "source_id": "repo_source_406bca734cf4c899d2b56c103ae58a73d5f3f099a05cd0cf518474122551b2a8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
