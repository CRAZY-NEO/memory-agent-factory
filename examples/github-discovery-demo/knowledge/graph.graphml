      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef _numba_unsorted_top_k_legacy(array: np.ndarray, k: int):\n    top_k_values = np.zeros(k, dtype=np.float32)\n    top_k_indices = np.zeros(k, dtype=np.int32)\n\n    min_value = 0.0\n    min_value_idx = 0\n\n    for i, value in enumerate(array):\n        if value &gt; min_value:\n            top_k_values[min_value_idx] = value\n            top_k_indices[min_value_idx] = i\n            min_value_idx = top_k_values.argmin()\n            min_value = top_k_values[min_value_idx]\n\n    return top_k_values, top_k_indices\n", "code_sha256": "c5c06e0ba1d3d40ab2fc7e7d9cd0ec99441a0ba212e967fa848c0c60b752cdeb", "comments": [], "decorators": ["njit(nogil=True)"], "definition_line": 14, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_3d878a3429c7c7732147a3b5e25458980934b0ec58037fbc5c3e978a8727cc39", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 28, "line_start": 13, "name": "_numba_unsorted_top_k_legacy", "parameters": [{"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "array"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "k"}], "path": "bm25s/numba/selection.py", "qualified_name": "_numba_unsorted_top_k_legacy", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _numba_unsorted_top_k_legacy(array: np.ndarray, k: int)", "source_id": "repo_source_fe79b4a0e95dc30caa0268cb9c9c83acfa0f516285fcb809326d026e57a94e2b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_com