    <node id="code_candidate_5e7e33b61d4bc8b72ec794ba28982bb9ead0e5e09753d02f43531b4c6b5cac8c">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_corpus_with_mmap(self):\n        \"\"\"Test load_corpus with mmap=True\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        retriever.save(self.tmpdir, corpus=self.corpus)\n        \n        # Load with mmap and corpus\n        loaded = BM25.load(self.tmpdir, load_corpus=True, mmap=True)\n        \n        # Corpus should be JsonlCorpus\n        self.assertIsInstance(loaded.corpus, bm25s.utils.corpus.JsonlCorpus)\n        loaded.corpus.close()\n", "code_sha256": "2de4dfe0a6568778e3e44b4172c23a33ae416afaf82f2f0ce7676d3eab53030d", "comments": [{"line": 425, "text": "# Load with mmap and corpus"}, {"line": 428, "text": "# Corpus should be JsonlCorpus"}], "decorators": [], "definition_line": 419, "docstring": "Test load_corpus with mmap=True", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_5e7e33b61d4bc8b72ec794ba28982bb9ead0e5e09753d02f43531b4c6b5cac8c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 430, "line_start": 419, "name": "test_load_corpus_with_mmap", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25LoadingSaving.test_load_corpus_with_mmap", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_load_corpus_with_mmap(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
