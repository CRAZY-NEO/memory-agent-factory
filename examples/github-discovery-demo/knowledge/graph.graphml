    <node id="code_candidate_f9bd39abbe3700b542b32761e687dde8938e5adab9ad7812710aeb4c068fa880">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def has_stopped(self, name):\n        return self.has_started(name) and \"stopped\" in self.results[name]\n", "code_sha256": "e6de32367172f4d1bf3ba976467d53250738ecd98f6d0a823d071cbe8888fbbe", "comments": [], "decorators": [], "definition_line": 96, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_f9bd39abbe3700b542b32761e687dde8938e5adab9ad7812710aeb4c068fa880", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 97, "line_start": 96, "name": "has_stopped", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.has_stopped", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def has_stopped(self, name)", "source_id": "repo_source_43fd334d6b3ac591ecde766e3edc2ab0b85c456f8eece5f44d103b24d412ad90", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
