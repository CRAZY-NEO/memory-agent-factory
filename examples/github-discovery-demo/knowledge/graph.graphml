    <node id="code_candidate_ddf7a31f1c6a8f543513c12eca58f34f8d51241b8bcda3e648489e0afcbb5e5f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_invalid_tuple_length(self):\n        \"\"\"Test retrieve with invalid tuple (wrong number of elements)\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Pass tuple with 3 elements instead of 2\n        invalid_query = ([0, 1], {\"a\": 0}, \"extra\")\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(invalid_query, k=2)\n        self.assertIn(\"Expected a list of string or a tuple of two elements\", str(context.exception))\n", "code_sha256": "6799ac19d56ad423d81ec3883b827d3f6edae4ab79cec357dfddc3ccf33ab420", "comments": [{"line": 245, "text": "# Pass tuple with 3 elements instead of 2"}], "decorators": [], "definition_line": 240, "docstring": "Test retrieve with invalid tuple (wrong number of elements)", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_ddf7a31f1c6a8f543513c12eca58f34f8d51241b8bcda3e648489e0afcbb5e5f", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 250, "line_start": 240, "name": "test_retrieve_with_invalid_tuple_length", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_invalid_tuple_length", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_retrieve_with_invalid_tuple_length(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
