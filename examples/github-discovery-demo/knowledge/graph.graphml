    <node id="code_candidate_0ccdc5c42c34364e438562bf3f7f499b193a18240ec52b823eae8db5b52264ea">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_return_as_documents(self):\n        \"\"\"Test retrieve with return_as='documents'\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\"]]\n        \n        # Test return_as='documents'\n        results = retriever.retrieve(query_tokens, k=2, return_as=\"documents\")\n        \n        # Should return only documents, not Results tuple\n        self.assertIsInstance(results, np.ndarray)\n        self.assertEqual(len(results), 1)\n        self.assertEqual(len(results[0]), 2)\n", "code_sha256": "d2064ce9c2db31203547ef9a4b2692f46f1b0236b1108c7b3d22f7fc1df1c0e5", "comments": [{"line": 336, "text": "# Test return_as='documents'"}, {"line": 339, "text": "# Should return only documents, not Results tuple"}], "decorators": [], "definition_line": 329, "docstring": "Test retrieve with return_as='documents'", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_0ccdc5c42c34364e438562bf3f7f499b193a18240ec52b823eae8db5b52264ea", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 342, "line_start": 32