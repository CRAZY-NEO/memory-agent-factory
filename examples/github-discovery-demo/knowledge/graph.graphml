    <node id="code_candidate_66e7479473df010c3449cd58821c17eda3755bfb9ae0c5b0c134a140bce976ae">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _get_build_version(package_dir):\n    return (\n        _version_from_environment()\n        or _version_from_pkg_info(package_dir)\n        or _version_from_git(package_dir)\n        or \"0.0.0\"\n    )\n", "code_sha256": "736fa4db4a047606223c41a13c00581c238983de7724f46c32f2b8dee7a3dfb9", "comments": [], "decorators": [], "definition_line": 97, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_66e7479473df010c3449cd58821c17eda3755bfb9ae0c5b0c134a140bce976ae", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 103, "line_start": 97, "name": "_get_build_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_get_build_version", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _get_build_version(package_dir)", "source_id": "repo_source_13ee5cb4f55ed53f88981f2ba569c0924350129c88964ae446001d7220237703", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
