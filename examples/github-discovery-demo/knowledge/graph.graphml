      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": true, "code": "async def test_server():\n    index_dir = \"bm25s_indices/nq\"\n    mcp = create_mcp_server(index_dir)\n    \n    print(\"Testing get_info tool...\")\n    info = await mcp.call_tool(\"get_info\", arguments={})\n    print(f\"Info: {info}\")\n    \n    print(\"\\nTesting retrieve tool...\")\n    results = await mcp.call_tool(\"retrieve\", arguments={\"query\": \"what is the capital of France\", \"k\": 2})\n    print(f\"Results: {results}\")\n", "code_sha256": "f3121a963c6e29537490eed8430dd5762b63081e10b9e5dc770bd3d704756234", "comments": [], "decorators": [], "definition_line": 5, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "0c54995b006bd4668cfe21fe5de40aefac65a8f8df31e21f46f42cbec1270086", "id": "code_candidate_4bf5b8616fc3768854c08a2fbcd3973b19ad8932312b428d64b5c2c1c35a26b5", "imports": [{"alias": null, "level": 0, "line": 2, "module": "asyncio", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.mcp", "name": "create_mcp_server"}], "kind": "function", "line_end": 15, "line_start": 5, "name": "test_server", "parameters": [], "path": "examples/mcp/verify_server.py", "qualified_name": "test_server", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "async def test_server()", "source_id": "repo_source_1ef78be584fd77d21dbbb29068ed96f815fd963d34b0ddf5fd306f5bfcf2dd68", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
