    <node id="code_candidate_249a0acbd309fec028a90c389ec01fe5e59865aedbe8cde8a5749f6233c0e462">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _git_describe(package_dir, *args):\n    try:\n        return subprocess.check_output(\n            [\n                \"git\",\n                \"describe\",\n                \"--tags\",\n                \"--match\",\n                \"[0-9]*\",\n                \"--match\",\n                \"v[0-9]*\",\n                *args,\n            ],\n            cwd=package_dir,\n            stderr=subprocess.DEVNULL,\n            text=True,\n        ).strip()\n    except (OSError, subprocess.CalledProcessError):\n        return None\n", "code_sha256": "a44dc813da4357d02ef76b67705a8414b197509734f6557021c90e90bdf22d92", "comments": [], "decorators": [], "definition_line": 51, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_249a0acbd309fec028a90c389ec01fe5e59865aedbe8cde8a5749f6233c0e462", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 69, "line_start": 51, "name": "_git_describe", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}, {"annotation": null, "default": null, "kind": "var_positional", "name": "args"}], "path": "setup.py", "qualified_name": "_git_describe", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _git_describe(package_dir, *args)", "source_id": "repo_source_3c0d305f10eb306cd3fff0347217bae386f41f7f7d84c64af09d4d3b405f33d8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
