    <node id="code_candidate_ec36510de5035f32ac5911a854b483f6afdb4ad493cc416f95b8424f0e5b5259">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _git_describe(package_dir, *args):\n    try:\n        return subprocess.check_output(\n            [\n                \"git\",\n                \"describe\",\n                \"--tags\",\n                \"--match\",\n                \"[0-9]*\",\n                \"--match\",\n                \"v[0-9]*\",\n                *args,\n            ],\n            cwd=package_dir,\n            stderr=subprocess.DEVNULL,\n            text=True,\n        ).strip()\n    except (OSError, subprocess.CalledProcessError):\n        return None\n", "code_sha256": "a44dc813da4357d02ef76b67705a8414b197509734f6557021c90e90bdf22d92", "comments": [], "decorators": [], "definition_line": 54, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_ec36510de5035f32ac5911a854b483f6afdb4ad493cc416f95b8424f0e5b5259", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 72, "line_start": 54, "name": "_git_describe", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}, {"annotation": null, "default": null, "kind": "var_positional", "name": "args"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_git_describe", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _git_describe(package_dir, *args)", "source_id": "repo_source_e5fc7c562