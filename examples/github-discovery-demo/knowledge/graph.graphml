    <node id="code_candidate_0c41bb42bc33de1f5bb7f7cc0b66be5be9c6121c267afc18d3500d75141b6dff">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def unchunk(lsts):\n    # merge all lsts into one list\n    return [item for lst in lsts for item in lst]\n", "code_sha256": "36a2a40b472905cbd661694dedbda3738d277bb8e825c66c5249d1918d800a40", "comments": [{"line": 33, "text": "# merge all lsts into one list"}], "decorators": [], "definition_line": 32, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "b3c3f4cb4763b2918bfc153e36e6e31970a23a7e6ae57c587215bb3a89e338e4", "id": "code_candidate_0c41bb42bc33de1f5bb7f7cc0b66be5be9c6121c267afc18d3500d75141b6dff", "imports": [{"alias": "mp", "level": 0, "line": 18, "module": "multiprocessing", "name": null}, {"alias": null, "level": 0, "line": 20, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 21, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 22, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 23, "module": "bm25s.utils.benchmark", "name": "Timer"}, {"alias": null, "level": 0, "line": 24, "module": "bm25s.utils.beir", "name": "BASE_URL"}], "kind": "function", "line_end": 34, "line_start": 32, "name": "unchunk", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "lsts"}], "path": "examples/tokenize_multiprocess.py", "qualified_name": "unchunk", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def unchunk(lsts)", "source_id": "repo_source_f305fe0c49d4a57d1e4effa26234a87eb318d20336222a90e2aa1f426b262b37", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
