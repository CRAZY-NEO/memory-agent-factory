    <node id="code_candidate_c705be592367a0cf87769c60f3002935a9b273bcf83596e00c23d89a1451d3c8">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_failure_of_bad_tuple(self):\n        # try to pass a tuple of tokens with different lengths\n        query = \"a cat is a feline, it's sometimes beautiful but cannot fly\"\n        query_tokens_obj = bm25s.tokenize([query], stopwords=\"en\", stemmer=self.stemmer, return_ids=True)\n        query_tokens_texts = bm25s.tokenize([query], stopwords=\"en\", stemmer=self.stemmer, return_ids=False)\n        ids, vocab = query_tokens_obj\n        query_tokens_tuple = (vocab, ids)\n\n        with self.assertRaises(ValueError):\n            self.retriever.retrieve(query_tokens_tuple, k=2)\n        \n        # now, test if there's vocab twice or ids twice\n        query_tokens_tuple = (ids, ids)\n        with self.assertRaises(ValueError):\n            self.retriever.retrieve(query_tokens_tuple, k=2)\n\n        # finally, test only passing vocab\n        query_tokens_tuple = (vocab, )\n        with self.assertRaises(ValueError):\n            self.retriever.retrieve(query_tokens_tuple, k=2)\n", "code_sha256": "95d18264164deec0d6a3b4516b793fc4fe2b4ff9c8c5a4d3a5bc02346f6a9fc1", "comments": [{"line": 136, "text": "# try to pass a tuple of tokens with different lengths"}, {"line": 146, "text": "# now, test if there's vocab twice or ids twice"}, {"line": 151, "text": "# finally, test only passing vocab"}], "decorators": [], "definition_line": 135, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5718fb93b60a5492163f5d29f31e473256f4b83dc609b998383a179f58528a5b", "id": "code_candidate_c705be592367a0cf87769c60f3002935a9b273bcf83596e00c23d89a1451d3c8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 154, "line_start": 135, "name": "test_failure_of_bad_tuple", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_retrieve.py", "qualified_name": "TestBM25SLoadingSaving.test_failure_of_bad_tuple", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_failure_of_bad_tuple(self)", "source_id": "repo_source_52f4533e86d53978d1e9bef7f8c6f16503c80b8c8064f4a81655169933cdf5db", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
