    <node id="code_candidate_81814196c69eaaac89bca4bdaec3d8af96a247556b70c0f7c235790390e70b7e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        self.tmpdir = tempfile.mkdtemp()\n        self.corpus = [\n            \"a cat is a feline\",\n            \"a dog is the human's best friend\",\n            \"a bird can fly\",\n        ]\n        self.stemmer = Stemmer.Stemmer(\"english\")\n        self.corpus_tokens = bm25s.tokenize(self.corpus, stopwords=\"en\", stemmer=self.stemmer)\n", "code_sha256": "bec1f3342cb3f813ca4457d9796f5530beae61cc9df9cfa5067eb7bbb6b227af", "comments": [], "decorators": [], "definition_line": 359, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_81814196c69eaaac89bca4bdaec3d8af96a247556b70c0f7c235790390e70b7e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 367, "line_start": 359, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25LoadingSaving.setUp", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUp(self)", "sour