    <node id="code_candidate_9b962c5a193acd3d73e1726fb45c02781cba5e2b24b6fc97500ed1bcb1b4f39b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def topk(query_scores, k, backend=\"numba\", sorted=True):\n    \"\"\"\n    This function is used to retrieve the top-k results for a single query. It will only work\n    on a 1-dimensional array of scores.\n    \"\"\"\n    if backend not in [\"numba\"]:\n        raise ValueError(\n            \"Invalid backend. Only 'numba' is supported.\"\n        )\n    elif backend == \"numba\":\n        if k &lt; 0:\n            raise ValueError(f\"k must be a non-negative integer, but got {k}.\")\n        uns_scores, uns_indices = _numba_sorted_top_k(query_scores, k)\n        if sorted:\n            sorted_inds = np.flip(np.argsort(uns_scores))\n            query_inds = uns_indices[sorted_inds]\n            query_scores = uns_scores[sorted_inds]\n        else:\n            query_inds = uns_indices\n            query_scores = uns_scores\n\n        return query_scores, query_inds\n\n    else:\n        raise ValueError(\"Invalid backend. Only 'numba' is supported.\")\n", "code_sha256": "681d6fcf4dd8bf6999636685f372e621ebdf2e515c0c2f905525c480f653cd91", "comments": [], "decorators": [], "definition_line": 127, "docstring": "\n    This function is used to retrieve the top-k results for a single query. It will only work\n    on a 1-dimensional array of scores.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_9b962c5a193acd3d73e1726fb45c02781cba5e2b24b6fc97500ed1bcb1b4f39b", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 151, "line_start": 127, "name": "topk", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k"}, {"annotation": null, "default": "'numba'", "kind": "positional_or_keyword", "name": "backend"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "bm25s/numba/selection.py", "qualified_name": "topk", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def topk(query_scores, k, backend='numba', sorted=True)", "source_id": "repo_source_fe79b4a0e95dc30caa0268cb9c9c83acfa0f516285fcb809326d026e57a94e2b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
