    <node id="code_candidate_ac9cbbcf12ad025918efdf47818ee99a62369a323db55445aaeb3193c242b901">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_invalid_backend(self):\n        \"\"\"Test that topk raises ValueError for invalid backend\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        \n        with self.assertRaises(ValueError) as context:\n            topk(query_scores, k=2, backend=\"invalid_backend\")\n        self.assertIn(\"Invalid backend\", str(context.exception))\n", "code_sha256": "a00ebb7c1735b59cd6a8cc237d01192c40643737e7f021744f323d9710c67190", "comments": [], "decorators": [], "definition_line": 15, "docstring": "Test that topk raises ValueError for invalid backend", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_ac9cbbcf12ad025918efdf47818ee99a62369a323db55445aaeb3193c242b901", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 21, "line_start": 15, "name": "test_topk_invalid_backend", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_invalid_backend", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_topk_invalid_backend(self)", "source_id": "repo_source_33f66b9a30f3f6aad8766b2217a780b139864e93e9878cc434c64c8ebc36e517", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
