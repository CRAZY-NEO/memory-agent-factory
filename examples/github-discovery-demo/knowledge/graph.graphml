    <node id="code_candidate_d203a0170fd60cbe3833baac8341add59b1f0d59381033e101efce6dfadd9902">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_tfc_bm25l(tf_array, l_d, l_avg, k1, b, delta):\n    \"\"\"\n    Computes the term frequency component of the BM25 score using BM25L variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    c_array = tf_array / (1 - b + b * l_d / l_avg)\n    return ((k1 + 1) * (c_array + delta)) / (k1 + c_array + delta)\n", "code_sha256": "e80868717eaa984cf690e38f47af6caf4c538e1c2cf56caf76a331f0f128aa1d", "comments": [], "decorators": [], "definition_line": 143, "docstring": "\n    Computes the term frequency component of the BM25 score using BM25L variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_d203a0170fd60cbe3833baac8341add59b1f0d59381033e101efce6dfadd9902", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 149, "line_start": 143, "name": "_score_tfc_bm25l", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "tf_array"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_d"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_avg"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k1"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "b"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "delta"}], "path": "bm25s/scoring.py", "qualified_name": "_score_tfc_bm25l", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _score_tfc_bm25l(tf_array, l_d, l_avg, k1, b, delta)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
