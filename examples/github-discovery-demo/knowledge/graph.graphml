    <node id="code_candidate_78859380f27633700af2c151151607d9f49974ae31bd2d41f84e958bac011821">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_token_ids_no_vocab_set(self):\n        \"\"\"Test retrieve with token IDs when unique_token_ids_set is not set\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Manually remove unique_token_ids_set to test error case\n        retriever.unique_token_ids_set = None\n        \n        query_tokens_ids = [[0, 1, 2]]\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(query_tokens_ids, k=2)\n        self.assertIn(\"unique_token_ids_set attribute is not found\", str(context.exception))\n", "code_sha256": "1ffb84df967602161db0f2daaf4d1bd54907568c83c2d4208c3427f2ba0dfa04", "comments": [{"line": 211, "text": "# Manually remove unique_token_ids_set to test error case"}], "decorators": [], "definition_line": 206, "docstring": "Test retrieve with token IDs when unique_token_ids_set is not set", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_78859380f27633700af2c151151607d9f49974ae31bd2d41f84e958bac011821", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 218, "line_start": 206, "name": "test_retrieve_with_token_ids_no_vocab_set", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_token_ids_no_vocab_set", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_retrieve_with_token_ids_no_vocab_set(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
