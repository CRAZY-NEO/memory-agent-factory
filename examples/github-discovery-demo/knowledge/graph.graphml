    <node id="code_candidate_486182343995fd041113cc7752a613630c4d38d8bb273c41ed6c79f9a1d18d9b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_dumps_with_unicode(self):\n        \"\"\"Test dumps with unicode characters\"\"\"\n        data = {\"text\": \"héllo wörld\"}\n        \n        # With ensure_ascii=False\n        result = json_functions.dumps(data, ensure_ascii=False)\n        self.assertIsInstance(result, str)\n        \n        # Should be able to load it back\n        loaded = json_functions.loads(result)\n        self.assertEqual(loaded[\"text\"], \"héllo wörld\")\n", "code_sha256": "0f877aa30352e3859070ef8aba92a4f30f2c96f6b3cffc80b4a201c80abfc8d8", "comments": [{"line": 37, "text": "# With ensure_ascii=False"}, {"line": 41, "text": "# Should be able to load it back"}], "decorators": [], "definition_line": 33, "docstring": "Test dumps with unicode characters", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_486182343995fd041113cc7752a613630c4d38d8bb273c41ed6c79f9a1d18d9b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 43, "line_start": 33, "name": "test_dumps_with_unicode", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_dumps_with_unicode", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_dumps_with_unicode(self)", "source_id": "repo_source_86363c7bd77007a75cd4fcb61002823231dd283e1b4458a0392c9c3492df5123", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
