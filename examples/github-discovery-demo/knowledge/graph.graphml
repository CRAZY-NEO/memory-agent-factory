      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(repo_name=\"xhluca/bm25s-fiqa-index\"):\n    queries = [\n        \"Is chemotherapy effective for treating cancer?\",\n        \"Is Cardiac injury is common in critical cases of COVID-19?\",\n    ]\n\n    retriever = bm25s.hf.BM25HF.load_from_hub(\n        repo_name, load_corpus=False, mmap=False\n    )\n\n    retriever.backend = \"numba\"  # this can also be set during initialization of the retriever\n\n    # Tokenize the queries\n    stemmer = Stemmer.Stemmer(\"english\")\n    tokenizer = bm25s.tokenization.Tokenizer(stemmer=stemmer)\n    queries_tokenized = tokenizer.tokenize(queries)\n\n    # Retrieve the top-k results\n    results = retriever.retrieve(queries_tokenized, k=3)\n    # show first results\n    result = results.documents[0]\n    print(f\"First score (# 1 result): {results.scores[0, 0]:.4f}\")\n    print(f\"First result (# 1 result): {result[0]}\")\n", "code_sha256": "4d224e7e5a663ee180d4dc3b428885ea96409320684b1d5a2b97031e23bea29a", "comments": [{"line": 30, "text": "# this can also be set during initialization of the retriever"}, {"line": 32, "text": "# Tokenize the queries"}, {"line": 37, "text": "# Retrieve the top-k results"}, {"line": 39, "text": "# show first results"}], "decorators": [], "definition_line": 20, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6c3bbc2c72465a84effc44cee7b247fabb31c9889ca3ad1b99307948482ccefa", "id": "code_candidate_5d1546318235ac8fd0a3dd86fd27e40f73ebbd94494b1fb9c4600985fddf00f4", "imports": [{"alias": null, "level": 0, "line": 15, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 16, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "bm25s.hf", "name": null}], "kind": "function", "line_end": 42, "line_start": 20, "name": "main", "parameters": [{"annotation": null, "default": "'xhluca/bm25s-fiqa-index'", "kind": "positional_or_keyword", "name": "repo_name"}], "path": "examples/retrieve_with_numba_hf.py", "qualified_name": "main", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def main(repo_name='xhluca/bm25s-fiqa-index')", "source_id": "repo_source_aa243ddc736b7b4e4364a7a0b536a0930ea270f14e35ac7c02c26d47a8902e4b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
