      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_select_tfc_scorer_invalid_method(self):\n        \"\"\"Test that _select_tfc_scorer raises ValueError for invalid method\"\"\"\n        with self.assertRaises(ValueError) as context:\n            _select_tfc_scorer(\"invalid_method\")\n        self.assertIn(\"Invalid score_tfc value\", str(context.exception))\n", "code_sha256": "f28a322127765f12f64d06ec3141dc8d960b9289ebd10065a802453d3bfa89c7", "comments": [], "decorators": [], "definition_line": 14, "docstring": "Test that _select_tfc_scorer raises ValueError for invalid method", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "12dde22d99c544ae01ed2fce528c6a05ab27be8a781de28a699c38a8397797a8", "id": "code_candidate_54b3d835919639629fda2c2f3a22d8f3c08f3432b6082b876ddb6456605cbb36", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_legacy"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_tfc_scorer"}], "kind": "method", "line_end": 18, "line_start": 14, "name": "test_select_tfc_scorer_invalid_method", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_scoring.py", "qualified_name": "TestScoringFunctions.test_select_tfc_scorer_invalid_method", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_select_tfc_scorer_invalid_method(self)", "source_id": "repo_source_fca0a6b92ed7a8cbd71d36e3ae76645f1face97602e204f5bdbf676ddbf7162e", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
