      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_tuple_invalid_second_element(self):\n        \"\"\"Test retrieve with tuple where second element is not dict\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Pass tuple with non-dict second element\n        invalid_query = ([[0, 1]], \"not a dict\")\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(invalid_query, k=2)\n        self.assertIn(\"second element of the tuple passed to retrieve must be a dictionary\", str(context.exception))\n", "code_sha256": "547057e2706802cf653df43c42b58299fa3a452a2ab55bd9b77fa62e57d00491", "comments": [{"line": 269, "text": "# Pass tuple with non-dict second element"}], "decorators": [], "definition_line": 264, "docstring": "Test retrieve with tuple where second element is not dict", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_de1ec5c2faac10364d411f801c3fa9aff5ee7778413948b0e0cc53dbb0b58c78", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 274, "line_start": 264, "name": "test_retrieve_with_tuple_invalid_secon