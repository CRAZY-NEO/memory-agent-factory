      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def download_multipart_release(dataset_url, dst_path):\n        part_paths = []\n        for part_idx in range(1000):\n            part_path = dst_path.parent / f\"{dst_path.name}.part-{part_idx:03d}\"\n            part_url = f\"{dataset_url}.part-{part_idx:03d}\"\n            try:\n                download_file(\n                    part_url, part_path, f\"Downloading {dataset} part {part_idx:03d}\"\n                )\n            except urllib.error.HTTPError as exc:\n                if part_path.exists():\n                    part_path.unlink()\n                if exc.code == 404 and part_idx &gt; 0:\n                    break\n                raise\n            part_paths.append(part_path)\n\n        if not part_paths:\n            raise FileNotFoundError(\n                f\"No release assets found for dataset {dataset} at {dataset_url}\"\n            )\n\n        with open(dst_path, \"wb\") as f_out:\n            for part_path in tqdm(\n                part_paths,\n                desc=f\"Assembling {dataset}\",\n                leave=leave_progress,\n                disable=not show_progress,\n            ):\n                with open(part_path, \"rb\") as f_in:\n                    while True:\n                        chunk = f_in.read(8192 * 2)\n                        if not chunk:\n                            break\n                        f_out.write(chunk)\n                part_path.unlink()\n", "code_sha256": "51eba721d3f98d40c1a029126b02cab32db2922a9ac87d57259654f792d9efda", "comments": [], "decorators": [], "definition_line": 171, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_a70ff2bffc29d3e7bb2405aa1340f13d539853a329f824ce43cdf1a7fc35ed07", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 206, "line_start": 171, "name": "download_multipart_release", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dataset_url"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dst_path"}], "path": "bm25s/utils/beir.py", "qualified_name": "download_dataset.&lt;locals&gt;.download_multipart_release", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def download_multipart_release(dataset_url, dst_path)", "source_id": "repo_source_8d0a5ba853f1ae9e036b0f4d309f8140f0353428be2275ab322bc2656e685f36", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
