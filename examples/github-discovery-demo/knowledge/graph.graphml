      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @unittest.mock.patch(\"bm25s.utils.json_functions.dumps\", json_functions.dumps_with_builtin)\n    @unittest.mock.patch(\"bm25s.utils.json_functions.loads\", json.loads)\n    def test_c_save_no_orjson(self):\n        self.assertEqual(json_functions.dumps_with_builtin, json_functions.dumps)\n        self.assertEqual(json_functions.loads, json.loads)\n        self.test_a_save()\n", "code_sha256": "0910b6090d6dd35065f96558e79cc9c43c92c50ab3dd313db5f37aa78a8abc93", "comments": [], "decorators": ["unittest.mock.patch('bm25s.utils.json_functions.dumps', json_functions.dumps_with_builtin)", "unittest.mock.patch('bm25s.utils.json_functions.loads', json.loads)"], "definition_line": 114, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5c821b6a5a4313298a2dd6cf0c18ca5a42d4e9ce84bab16a261cfb3edb01562b", "id": "code_candidate_2f0eca32e7b9854561d72608690a4e8d7c2182113aeadc354f429082d16632bc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 20, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 55, "module": "orjson", "name": null