    <node id="code_candidate_4557c81ea6f1f0b1c054a3515943eed4de2e222798b3e8286a2c9c4cdd2b757f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def load(path, document_column=None):\n    \"\"\"\n    Loads a csv, json, jsonl, or txt file from the given path. For json, we expect a list of dicts.\n    Returns a list of strings (corpus) that can be passed to `bm25s.index`.\n\n    Parameters\n    ----------\n    path : str\n        The file path to load the documents from.\n\n    document_column : str, optional\n        The column name to use as the document text when loading from csv, or the key when loading from json/jsonl.\n        If None, the first column will be used by default.\n    \n    Returns\n    -------\n    List[str]\n        A list of strings representing the documents.\n    \"\"\"\n\n    path = Path(path)\n    documents = []\n\n    if path.suffix == \".txt\":\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            documents = [line.strip() for line in f if line.strip()]\n\n    elif path.suffix == \".json\":\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            data = json.load(f)\n            if isinstance(data, list):\n                if len(data) &gt; 0 and isinstance(data[0], str):\n                    documents = data\n                elif len(data) &gt; 0 and isinstance(data[0], dict):\n                    if document_column is None:\n                        # Use the first key available in the first element\n                        document_column = list(data[0].keys())[0]\n                    documents = [d[document_column] for d in data]\n            else:\n                raise ValueError(\"JSON file must contain a list of strings or dicts.\")\n\n    elif path.suffix == \".jsonl\":\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                if not line.strip():\n                    continue\n                d = json.loads(line)\n                if document_column is None and not documents:\n                    # Infer column from first line\n                    document_column = list(d.keys())[0]\n                \n                if document_column in d:\n                    documents.append(d[document_column])\n                else:\n                    # skip or error? Let's skip if key missing, or error. \n                    # raising error is safer for \"load\"\n                    raise ValueError(f\"Key '{document_column}' not found in JSONL line: {line[:50]}...\")\n\n    elif path.suffix == \".csv\":\n        with open(path, \"r\", newline=\"\", encoding=\"utf-8\") as f:\n            reader = csv.DictReader(f)\n            if document_column is None:\n                if reader.fieldnames:\n                    document_column = reader.fieldnames[0]\n                else:\n                    return BM25Search(corpus=[])\n\n            for row in reader:\n                if document_column in row:\n                    documents.append(row[document_column])\n                else:\n                     raise ValueError(f\"Column '{document_column}' not found in CSV.\")\n    else:\n        raise ValueError(f\"Unsupported file extension: {path.suffix}\")\n\n    return documents\n", "code_sha256": "31c1b8829fadb77068b6279373c4e35e918dfa75787d704496df0a03fac1be00", "comments": [{"line": 212, "text": "# Use the first key available in the first element"}, {"line": 225, "text": "# Infer column from first line"}, {"line": 231, "text": "# skip or error? Let's skip if key missing, or error. "}, {"line": 232, "text": "# raising error is safer for \"load\""}], "decorators": [], "definition_line": 177, "docstring": "\n    Loads a csv, json, jsonl, or txt file from the given path. For json, we expect a list of dicts.\n    Returns a list of strings (corpus) that can be passed to `bm25s.index`.\n\n    Parameters\n    ----------\n    path : str\n        The file path to load the documents from.\n\n    document_column : str, optional\n        The column name to use as the document text when loading from csv, or the key when loading from json/jsonl.\n        If None, the first column will be used by default.\n    \n    Returns\n    -------\n    List[str]\n        A list of strings representing the documents.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "946e755ab1ea7890870f58c12cc72022dac540c52d09c0cb0be179acbe05acb8", "id": "code_candidate_4557c81ea6f1f0b1c054a3515943eed4de2e222798b3e8286a2c9c4cdd2b757f", "imports": [{"alias": null, "level": 0, "line": 9, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "csv", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 12, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 14, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 15, "module": "typing", "name": "List"}], "kind": "function", "line_end": 252, "line_start": 177, "name": "load", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "path"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "document_column"}], "path": "bm25s/high_level/__init__.py", "qualified_name": "load", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def load(path, document_column=None)", "source_id": "repo_source_b9ce63029d8c4cc8634d27d47d4556086d0d9779fb099d6938836d40403268ed", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
