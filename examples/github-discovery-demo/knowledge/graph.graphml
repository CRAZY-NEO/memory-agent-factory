      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @staticmethod\n    def _infer_corpus_object(corpus):\n        \"\"\"\n        Verifies if the corpus is a list of list of strings, an object with the `ids` and `vocab` attributes,\n        or a tuple of two lists: first is list of list of ids, second is the vocab dictionary.\n        \"\"\"\n        if hasattr(corpus, \"ids\") and hasattr(corpus, \"vocab\"):\n            return \"object\"\n        elif isinstance(corpus, tuple) and len(corpus) == 2:\n            c1, c2 = corpus\n            if isinstance(c1, list) and isinstance(c2, dict):\n                return \"tuple\"\n            else:\n                raise ValueError(\n                    \"Corpus must be a list of list of tokens, an object with the `ids` and `vocab` attributes, or a tuple of two lists: the first list is the list of unique token IDs, and the second list is the list of token IDs for each document.\"\n                )\n        elif isinstance(corpus, Iterable):\n            if is_list_of_list_of_type(corpus, type_=int):\n                return \"token_ids\"\n            else:\n                return \"tokens\"\n        else:\n            raise ValueError(\n                \"Corpus must be a list of list of tokens, an object with the `ids` and `vocab` attributes, or a tuple of two lists: the first list is the list of unique token IDs, and the second list is the list of token IDs for each document.\"\n            )\n", "code_sha256": "877f21b1afb681397ba9d9db07ebe3f033cd9086aa213d499ebb9ecb3e0a5fb9", "comments": [], "decorators": ["staticmethod"], "definition_line": 247, "docstring": "\n        Verifies if the corpus is a list of list of strings, an object with the `ids` and `vocab` attributes,\n        or a tuple of two lists: first is list of list of ids, second is the vocab dictionary.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_9a6b54c6085d701dfbce0f0b1129d3ad08b6188fc3db81a946207051b7debd19", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Union"}, {"alias": "np", "level": 0, "line": 11, "module": "numpy", "name": null}, {"alias": "json_functions", "level": 1, "line": 13, "module": "utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "numba", "name": "njit"}, {"alias": "selection_jit", "level": 1, "line": 17, "module": "numba", "name": "selection"}, {"alias": "sp", "level": 0, "line": 23, "module": "scipy.sparse", "name": null}, {"alias": null, "level": 1, "line": 29, "module": "numba.retrieve_utils", "name": "_retrieve_numba_functional"}, {"alias": null, "level": 0, "line": 43, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "scoring"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "stopwords"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "tokenization"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "utils"}, {"alias": "selection_np", "level": 1, "line": 49, "module": null, "name": "selection"}, {"alias": null, "level": 1, "line": 50, "module": "version", "name": "__version__"}, {"alias": null, "level": 1, "line": 51, "module": "tokenization", "name": "tokenize"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_idf_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_nonoccurrence_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_scores_and_indices_for_matrix"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_calculate_doc_freqs"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_jit_ready"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_python"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_tfc_scorer"}, {"alias": null, "level": 0, "line": 1336, "module": "numba", "name": "njit"}, {"alias": null, "level": 1, "line": 1346, "module": "scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 1361, "module": "numba", "name": "njit"}], "kind": "method", "line_end": 270, "line_start": 246, "name": "_infer_corpus_object", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "corpus"}], "path": "bm25s/__init__.py", "qualified_name": "BM25._infer_corpus_object", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _infer_corpus_object(corpus)", "source_id": "repo_source_8eb1f8d56c3a2f6aec5c33dcdfe9363289533bb4a9