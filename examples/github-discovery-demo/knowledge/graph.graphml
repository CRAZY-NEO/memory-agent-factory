      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_is_dir_empty_empty_dir(self):\n        \"\"\"Test is_dir_empty with empty directory\"\"\"\n        empty_dir = os.path.join(self.tmpdir, \"empty\")\n        os.makedirs(empty_dir)\n        self.assertTrue(is_dir_empty(empty_dir))\n", "code_sha256": "5811315839c17be03ffe85c3faa733a41656756ca80ce72730e40d6b328bb3db", "comments": [], "decorators": [], "definition_line": 23, "docstring": "Test is_dir_empty with empty directory", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "28e6fa925022fe2389bec7b19a3d2b1bd8637d9c789a30cbf321af111dcbe48e", "id": "code_candidate_836a0fea04e7cded9615f685d45e83e74da05f86abbcd9da1cfd1f9974190cc8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "can_save_locally"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "is_dir_empty"}], "kind": "method", "line_end": 27, "line_start": 23, "name": "test_is_dir_empty_empty_dir", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_hf_utils.py", "qualified_name": "TestHFUtilities.test_is_dir_empty_empty_dir", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_is_dir_empty_empty_dir(self)", "source_id": "repo_source_406bca734cf4c899d2b56c103ae58a73d5f3f099a05cd0cf518474122551b2a8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
