      <data key="d1">{"byte_count": 669, "encoding": "utf-8", "id": "repo_source_cb3be2c9415f11a12f773f9f8e99c161cfda96befe49e93a37887c8a71da68f7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 2, "line": 3, "module": null, "name": "BM25TestCase"}], "module_docstring": null, "path": "tests/comparison_full/test_bm25_pt.py", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "sha256": "90d80cd9485020b5d94e816e7c6c6a7b7eb0b7e6d0173404c1caf7d1adc76069", "source_type": "python_repository", "text": "import unittest\n\nfrom .. import BM25TestCase\n\nclass TestBM25PTQuick(BM25TestCase):\n    def test_bm25_sparse_vs_rank_bm25_on_nfcorpus(self):\n        self.compare_with_bm25_pt(\"nfcorpus\")\n    \n    def test_bm25_sparse_vs_rank_bm25_on_scifact(self):\n        self.compare_with_bm25_pt(\"scifact\")\n    \n    def test_bm25_sparse_vs_rank_bm25_on_scidocs(self):\n        self.compare_with_bm25_pt(\"scidocs\")\n\n    # fiqa\n    def test_bm25_sparse_vs_rank_bm25_on_fiqa(self):\n        self.compare_with_bm25_pt(\"fiqa\")\n\n    # arguana\n    def test_bm25_sparse_vs_rank_bm25_on_arguana(self):\n        self.compare_with_bm25_pt(\"arguana\")\n\nif __name__ == '__main__':\n    unittest.main()\n"}</data>
