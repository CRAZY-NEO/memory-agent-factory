": 1, "line": 52, "module": "scoring", "name": "_select_tfc_scorer"}, {"alias": null, "level": 0, "line": 1336, "module": "numba", "name": "njit"}, {"alias": null, "level": 1, "line": 1346, "module": "scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 1361, "module": "numba", "name": "njit"}], "kind": "method", "line_end": 579, "line_start": 572, "name": "get_tokens_ids", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[str]", "default": null, "kind": "positional_or_keyword", "name": "query_tokens"}], "path": "bm25s/__init__.py", "qualified_name": "BM25.get_tokens_ids", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "List[int]", "signature": "def get_tokens_ids(self, query_tokens: List[str]) -&gt; List[int]", "source_id": "repo_source_d2d8bec12150dbd29fb5b8e9c0612950ac3a929c94086450a1edb9144458393c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
