    <node id="code_candidate_99c17559dd90091526ae8aafac60803b3a717883502e90584e6a3181b71ac2b6">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_compute_relevance_from_scores_jit_ready(self):\n        \"\"\"Test the JIT-ready implementation of _compute_relevance_from_scores\"\"\"\n        # Create sample data for testing\n        data = np.array([1.0, 2.0], dtype=np.float32)\n        indices = np.array([0, 1], dtype=np.int32)\n        indptr = np.array([0, 1, 2], dtype=np.int32)\n        num_docs = 3\n        query_tokens_ids = np.array([0, 1], dtype=np.int32)\n        dtype = np.float32\n\n        scores = _compute_relevance_from_scores_jit_ready(\n            data, indptr, indices, num_docs, query_tokens_ids, dtype\n        )\n\n        # Expected: doc 0 has score 1.0, doc 1 has score 2.0, doc 2 has score 0.0\n        expected = np.array([1.0, 2.0, 0.0], dtype=np.float32)\n        np.testing.assert_array_almost_equal(scores, expected)\n", "code_sha256": "d2d054acb64903f57df65d32d07c8bae2f778b00ba9424f6979845a78dfa0dc5", "comments": [{"line": 66, "text": "# Create sample data for testing"}, {"line": 78, "text": "# Expected: doc 0 has score 1.0, doc 1 has score 2.0, doc 2 has score 0.0"}], "decorators": [], "definition_line": 64, "docstring": "Test the JIT-ready implementation of _compute_relevance_from_scores", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "12dde22d99c544ae01ed2fce528c6a05ab27be8a781de28a699c38a8397797a8", "id": "code_candidate_99c17559dd90091526ae8aafac60803b3a717883502e90584e6a3181b71ac2b6", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_legacy"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_tfc_scorer"}], "kind": "method", "line_end": 80, "line_start": 64, "name": "test_compute_relevance_from_scores_jit_ready", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_scoring.py", "qualified_name": "TestScoringFunctions.test_compute_relevance_from_scores_jit_ready", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_compute_relevance_from_scores_jit_ready(self)", "source_id": "repo_source_fca0a6b92ed7a8cbd71d36e3ae76645f1face97602e204f5bdbf676ddbf7162e", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
