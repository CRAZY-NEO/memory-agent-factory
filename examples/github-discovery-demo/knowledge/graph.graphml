      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_is_tuple_of_list_of_tokens_valid(self):\n        \"\"\"Test _is_tuple_of_list_of_tokens with valid input\"\"\"\n        result = bm25s._is_tuple_of_list_of_tokens(([\"hello\", \"world\"],))\n        self.assertTrue(result)\n", "code_sha256": "997ca72b8575c10f6293902a11e4b65851a09c1b5439fe818ffae70f13bc3889", "comments": [], "decorators": [], "definition_line": 59, "docstring": "Test _is_tuple_of_list_of_tokens with valid input", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e3931e4316271c69f108b1b84deeda9b0db9b6b572aabb8cdf9a72c919e42678", "id": "code_candidate_43d84834189e134b5c9b83f6267902eeaf872c9f184f9fd4a78a4928a4f442d7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 86, "module": "importlib", "name": null}], "kind": "method", "line_end": 62, "line_start": 59, "name": "test_is_tuple_of_list_of_tokens_valid", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_init_utils.py", "qualified_name": "TestBM25SUtilityFunctions.test_is_tuple_of_list_of_tokens_valid", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_is_tuple_of_list_of_tokens_valid(self)", "source_id": "repo_source_ad9e070ab3dddfc0d60ad26c2eea48ee096cfa92ac60a3212773e00b019e37ee", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
