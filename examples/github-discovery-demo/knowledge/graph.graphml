    <node id="code_candidate_0317c64c8c321f0a49094c0fd991811c60f77fcd935ad890c81b06da6779a920">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def has_stopped(self, name):\n        return self.has_started(name) and \"stopped\" in self.results[name]\n", "code_sha256": "e6de32367172f4d1bf3ba976467d53250738ecd98f6d0a823d071cbe8888fbbe", "comments": [], "decorators": [], "definition_line": 96, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_0317c64c8c321f0a49094c0fd991811c60f77fcd935ad890c81b06da6779a920", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 97, "line_start": 96, "name": "has_stopped", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.has_stopped", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def has_stopped(self, name)", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d013be753eacf3220cbe96f3ac675f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
