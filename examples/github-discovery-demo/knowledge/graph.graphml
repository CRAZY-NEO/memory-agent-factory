      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_stopwords_none_and_false(self):\n        \"\"\"Test stopwords inference returns empty list for None and False\"\"\"\n        stopwords = _infer_stopwords(None)\n        self.assertEqual(stopwords, [])\n        \n        stopwords = _infer_stopwords(False)\n        self.assertEqual(stopwords, [])\n", "code_sha256": "7c1ae81a46ad3ffd451afc5f592594b6c0bf546a88b8987e6c727d9de0740b81", "comments": [], "decorators": [], "definition_line": 37, "docstring": "Test stopwords inference returns empty list for None and False", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_4ff427690304617ffb5f76c1eeb31f3818f7bce49066991ec5be32a80cfaffd7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 43, "line_start": 37, "name": "test_infer_stopwords_none_and_false", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_infer_stopwords_none_and_false", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_infer_stopwords_none_and_false(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
