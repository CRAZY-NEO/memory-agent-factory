    <node id="code_candidate_7547eddcc5d7415016a14488f0ce30ec12baf27c28b300664e1ae531dd04f933">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_a_save(self):\n        # save the retriever to temp dir\n        self.retriever.save(\n            self.tmpdirname,\n            data_name=\"data.index.csc.npy\",\n            indices_name=\"indices.index.csc.npy\",\n            indptr_name=\"indptr.index.csc.npy\",\n            vocab_name=\"vocab.json\",\n            nnoc_name=\"nonoccurrence_array.npy\",\n            params_name=\"params.json\",\n        )\n\n        # assert that the following files are saved\n        fnames = [\n            \"data.index.csc.npy\",\n            \"indices.index.csc.npy\",\n            \"indptr.index.csc.npy\",\n            \"vocab.json\",\n            \"nonoccurrence_array.npy\",\n            \"params.json\",\n        ]\n\n        for fname in fnames:\n            error_msg = f\"File {fname} not found in even though it should be saved by the .save() method\"\n            path_exists = os.path.exists(os.path.join(self.tmpdirname, fname))\n            self.assertTrue(path_exists, error_msg)\n", "code_sha256": "9f0d8160fb4ca9e25362952353f6ab8670f252fc0ec955bfc0d393cbcea7c3ad", "comments": [{"line": 60, "text": "# save the retriever to temp dir"}, {"line": 71, "text": "# assert that the following files are saved"}], "decorators": [], "definition_line": 59, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5c821b6a5a4313298a2dd6cf0c18ca5a42d4e9ce84bab16a261cfb3edb01562b", "id": "code_candidate_7547eddcc5d7415016a14488f0ce30ec12baf27c28b300664e1ae531dd04f933", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 20, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 55, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 139, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 161, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 184, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 185, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 84, "line_start": 59, "name": "test_a_save", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_save_load.py", "qualified_name": "TestBM25SLoadingSaving.test_a_save", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_a_save(self)", "source_id": "repo_source_f6f16b47903aa7267a69de367190d46e23e404c17dc67b599c3fad64d79d6741", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
