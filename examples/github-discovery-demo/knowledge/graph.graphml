    <node id="code_candidate_83b33fa2e18be52a5aec4c40aed6b6a11284c816d663dc10d402d1e8cc54fd4f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_create_parser(self):\n        \"\"\"Test that the parser is created correctly.\"\"\"\n        parser = create_parser()\n        self.assertIsNotNone(parser)\n        \n        # Test index subcommand parsing\n        args = parser.parse_args([\"index\", \"test.csv\", \"-o\", \"output_dir\"])\n        self.assertEqual(args.command, \"index\")\n        self.assertEqual(args.file, \"test.csv\")\n        self.assertEqual(args.output, \"output_dir\")\n        \n        # Test search subcommand parsing\n        args = parser.parse_args([\"search\", \"--index=myindex\", \"query text\"])\n        self.assertEqual(args.command, \"search\")\n        self.assertEqual(args.index, \"myindex\")\n        self.assertEqual(args.query, \"query text\")\n", "code_sha256": "1ea7852a6ab0117e9a832ea0ddf87d3e8d20bb972e3e9ffaff8a5c8457e27220", "comments": [{"line": 66, "text": "# Test index subcommand parsing"}, {"line": 72, "text": "# Test search subcommand parsing"}], "decorators": [], "definition_line": 61, "docstring": "Test that the parser is created correctly.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5a4dced834c7622105997d5c1b1f67ddf32f394afb260cb40e27ae97a9171caa", "id": "code_candidate_83b33fa2e18be52a5aec4c40aed6b6a11284c816d663dc10d402d1e8cc54fd4f", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "io", "name": "StringIO"}, {"alias": null, "level": 0, "line": 9, "module": "argparse", "name": "Namespace"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "create_parser"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "get_user_indices_dir"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "index_command"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "list_user_indices"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "main"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "search_command"}], "kind": "method", "line_end": 76, "line_start": 61, "name": "test_create_parser", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/high_level/test_terminal.py", "qualified_name": "TestTerminalCLI.test_create_parser", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_create_parser(self)", "source_id": "repo_source_1e04a67e65d6b5a67b8d0d56d50b2c43ffaa3b04a8e9bd963db12c249f2a8e15", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
