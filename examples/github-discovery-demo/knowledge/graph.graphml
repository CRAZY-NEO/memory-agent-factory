      <data key="d1">{"byte_count": 911, "encoding": "utf-8", "id": "repo_source_d3e2a5af6268f0818261c55a14820465ca7b3117c165817f2bc6a756820c5c78", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 2, "line": 3, "module": null, "name": "BM25TestCase"}], "module_docstring": null, "path": "tests/comparison/test_rank_bm25.py", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "sha256": "d7e87ce66f7e48313c49f1ce89ab8e2a368f185c2e6d71bacb3ec2a8af419f74", "source_type": "python_repository", "text": "import unittest\n\nfrom .. import BM25TestCase\n\nclass TestRankBM25Quick(BM25TestCase):\n    def test_bm25_sparse_vs_rank_bm25_on_nfcorpus(self):\n        self.compare_with_rank_bm25(\"nfcorpus\", corpus_subsample=2000, queries_subsample=200)\n    \n    def test_bm25_sparse_vs_rank_bm25_on_scifact(self):\n        self.compare_with_rank_bm25(\"scifact\", corpus_subsample=2000, queries_subsample=200)\n    \n    def test_bm25_sparse_vs_rank_bm25_on_scidocs(self):\n        self.compare_with_rank_bm25(\"scidocs\", corpus_subsample=2000, queries_subsample=200)\n\n    # fiqa\n    def test_bm25_sparse_vs_rank_bm25_on_fiqa(self):\n        self.compare_with_rank_bm25(\"fiqa\", corpus_subsample=2000, queries_subsample=200)\n\n    # arguana\n    def test_bm25_sparse_vs_rank_bm25_on_arguana(self):\n        self.compare_with_rank_bm25(\"arguana\", queries_subsample=100, corpus_subsample=1000)\n\nif __name__ == '__main__':\n    unittest.main()\n"}</data>
