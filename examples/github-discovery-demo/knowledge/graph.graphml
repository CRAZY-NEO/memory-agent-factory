    <node id="code_candidate_591261cc028908c4423e534a2655317c3a7a96179ad063c2aedb489c05c39dfe">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_idf_lucene(df, N):\n    \"\"\"\n    Computes the inverse document frequency component of the BM25 score using Lucene variant (accurate)\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    return math.log(1 + (N - df + 0.5) / (df + 0.5))\n", "code_sha256": "8922c01b32b8aff640a422fd2fdd3b51913daf777d52659fa78f2b3789aff32e", "comments": [], "decorators": [], "definition_line": 190, "docstring": "\n    Computes the inverse document frequency component of the BM25 score using Lucene variant (accurate)\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_591261cc028908c4423e534a2655317c3a7a96179ad063c2aedb489c05c39dfe", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 195, "line_start": 190, "name": "_score_idf_lucene", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "df"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "N"}], "path": "bm25s/scoring.py", "qualified_name": "_score_idf_lucene", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _score_idf_lucene(df, N)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
