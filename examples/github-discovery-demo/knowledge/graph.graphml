    <node id="code_candidate_b897a4039e738724eca4a05acf3bb152db44371624cc234c5125d3e3a33cef89">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_tuple_invalid_first_element(self):\n        \"\"\"Test retrieve with tuple where first element is not iterable\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Pass tuple with non-iterable first element\n        invalid_query = (123, {\"a\": 0})\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(invalid_query, k=2)\n        self.assertIn(\"first element of the tuple passed to retrieve must be an iterable\", str(context.exception))\n", "code_sha256": "44d1c234fa94185229fe917992488c6e967fe6bc8a1178744790a8e4e081bff5", "comments": [{"line": 257, "text": "# Pass tuple with non-iterable first element"}], "decorators": [], "definition_line": 252, "docstring": "Test retrieve with tuple where first element is not iterable", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_b897a4039e738724eca4a05acf3bb152db44371624cc234c5125d3e3a33cef89", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 262, "line_start": 252, "name": "test_retrieve_with_tuple_invalid_first_element", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_tuple_invalid_first_element", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_retrieve_with_tuple_invalid_first_element(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
