      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def _get_top_k_results(\n        self,\n        query_tokens_single: List[str],\n        k: int = 1000,\n        backend=\"auto\",\n        sorted: bool = False,\n        weight_mask: np.ndarray = None,\n    ):\n        \"\"\"\n        This function is used to retrieve the top-k results for a single query.\n        Since it's a hidden function, the user should not call it directly and\n        may change in the future. Please use the `retrieve` function instead.\n        \"\"\"\n        if len(query_tokens_single) == 0:\n            logger.info(\n                msg=\"The query is empty. This will result in a zero score for all documents.\"\n            )\n            scores_q = np.zeros(self.scores[\"num_docs\"], dtype=self.dtype)\n        else:\n            scores_q = self.get_scores(query_tokens_single, weight_mask=weight_mask)\n\n        if backend.startswith(\"numba\"):\n            if NUMBA_AVAILABLE is False:\n                raise ImportError(\n                    \"Numba is not installed. Please install numba to use the numba backend.\"\n                )\n            topk_scores, topk_indices = selection_jit.topk(\n                scores_q, k=k, sorted=sorted, backend=backend\n            )\n        else:\n            topk_scores, topk_indices = selection_np.topk(\n                scores_q, k=k, sorted=sorted, backend=backend\n            )\n\n        return topk_scores, topk_indices\n", "code_sha256": "0b1774d720ca3f50a414f89148827a0116f62893df39500479981465f47d611a", "comments": [], "decorators": [], "definition_line": 640, "docstring": "\n        This function is used to retrieve the top-k results for a single query.\n        Since it's a hidden function, the user should not call it directly and\n        may change in the future. Please use the `retrieve` function instead.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_8ab7203d1ff3b7baae67ff55f17a91c85f319d401c4f39bf5c9c231e2fbe6e85", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Union"}, {"alias": "np", "level": 0, "line": 11, "module": "numpy", "name": null}, {"alias": "json_functions", "level": 1, "line": 13, "module": "utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "numba", "name": "njit"}, {"alias": "selection_jit", "level": 1, "line": 17, "module": "numba", "name": "selection"}, {"alias": "sp", "level": 0, "line": 23, "module": "scipy.sparse", "name": null}, {"alias": null, "level": 1, "line": 29, "module": "numba.retrieve_utils", "name": "_retrieve_numba_functional"}, {"alias": null, "level": 0, "line": 43, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "scoring"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "stopwords"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "tokenization"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "utils"}, {"alias": "selection_np", "level": 1, "line": 49, "module": null, "name": "selection"}, {"alias": null, "level": 1, "line": 50, "module": "version", "name": "__version__"}, {"alias": null, "level": 1, "line": 51, "module": "tokenization", "name": "tokenize"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_idf_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_nonoccurrence_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_scores_and_indices_for_matrix"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_calculate_doc_freqs"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_jit_ready"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_python"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_tfc_scorer"}, {"alias": null, "level": 0, "line": 1336, "module": "numba", "name": "njit"}, {"alias": null, "level": 1, "line": 1346, "module": "scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 1361, "module": "numba", "name": "njit"}], "kind": "method", "line_end": 674, "line_start": 640, "name": "_get_top_k_results", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[str]", "default": null, "kind": "positional_or_keyword", "name": "query_tokens_single"}, {"annotation": "int", "default": "1000", "kind": "positional_or_keyword", "name": "k"}, {"annotation": null, "default": "'auto'", "kind": "positional_or_keyword", "name": "backend"}, {"annotation": "bool", "default": "False", "kind": "positional_or_keyword", "name": "sorted"}, {"annotation": "np.ndarray", "default": "None", "kind": "positional_or_keyword", "name": "weight_mask"}], "path": "bm25s/__init__.py", "qualified_name": "BM25._get_top_k_results", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _get_top_k_results(self, query_tokens_single: List[str], k: int=1000, backend='auto', sorted: bool=False, weight_mask: np.ndarray=None)", "source_id": "repo_source_d2d8bec12150dbd29fb5b8e9c0612950ac3a929c94086450a1edb9144458393c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
