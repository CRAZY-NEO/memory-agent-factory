    <node id="code_candidate_86d018f7d368ec8e30fd445fa5f36c868f9367b587c61c95814d81050fd97619">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def download_dataset(\n    dataset,\n    base_url=GH_URL,\n    save_dir=\"./datasets\",\n    unzip=True,\n    redownload=False,\n    show_progress=True,\n    leave_progress=False,\n):\n    import urllib.request\n    import urllib.error\n    import zipfile\n    from pathlib import Path\n    from tqdm.auto import tqdm\n\n    save_dir = Path(save_dir)\n    save_dir.mkdir(parents=True, exist_ok=True)\n\n    url = base_url.format(dataset)\n    # check if zip file already exist\n    save_zip_path = save_dir / \"archive\" / f\"{dataset}.zip\"\n    save_zip_path.parent.mkdir(parents=True, exist_ok=True)\n\n    def download_file(src_url, dst_path, desc):\n        pbar = tqdm(\n            unit=\"B\",\n            unit_scale=True,\n            desc=desc,\n            leave=leave_progress,\n            disable=not show_progress,\n        )\n        with open(dst_path, \"wb\") as f:\n            response = urllib.request.urlopen(src_url)\n            total_size = int(response.headers.get(\"content-length\", 0))\n            block_size = 8192 * 2\n            pbar.total = total_size\n            while True:\n                buffer = response.read(block_size)\n                if not buffer:\n                    break\n                f.write(buffer)\n                pbar.update(len(buffer))\n\n        pbar.close()\n\n    def download_multipart_release(dataset_url, dst_path):\n        part_paths = []\n        for part_idx in range(1000):\n            part_path = dst_path.parent / f\"{dst_path.name}.part-{part_idx:03d}\"\n            part_url = f\"{dataset_url}.part-{part_idx:03d}\"\n            try:\n                download_file(\n                    part_url, part_path, f\"Downloading {dataset} part {part_idx:03d}\"\n                )\n            except urllib.error.HTTPError as exc:\n                if part_path.exists():\n                    part_path.unlink()\n                if exc.code == 404 and part_idx &gt; 0:\n                    break\n                raise\n            part_paths.append(part_path)\n\n        if not part_paths:\n            raise FileNotFoundError(\n                f\"No release assets found for dataset {dataset} at {dataset_url}\"\n            )\n\n        with open(dst_path, \"wb\") as f_out:\n            for part_path in tqdm(\n                part_paths,\n                desc=f\"Assembling {dataset}\",\n                leave=leave_progress,\n                disable=not show_progress,\n            ):\n                with open(part_path, \"rb\") as f_in:\n                    while True:\n                        chunk = f_in.read(8192 * 2)\n                        if not chunk:\n                            break\n                        f_out.write(chunk)\n                part_path.unlink()\n\n    if not save_zip_path.exists() or redownload:\n        try:\n            download_file(url, save_zip_path, f\"Downloading {dataset}\")\n        except urllib.error.HTTPError as exc:\n            if exc.code == 404:\n                download_multipart_release(url, save_zip_path)\n            else:\n                raise\n\n    # now that we have the zip file, extract it\n    if unzip:\n        with zipfile.ZipFile(save_zip_path, \"r\") as zip_ref:\n            zip_ref.extractall(save_dir)\n\n        # if it's CQADupStack, merge the corpus, queries, and qrels\n        if dataset == \"cqadupstack\":\n            merge_cqa_dupstack(save_dir / dataset, show_progress=show_progress, leave_progress=leave_progress)\n\n        return save_dir / dataset\n    else:\n        return save_zip_path\n", "code_sha256": "5a20d66af5ae87bfb05c342154ffb652ccff82dece1b742e99dcc0ab7df46d0f", "comments": [{"line": 145, "text": "# check if zip file already exist"}, {"line": 217, "text": "# now that we have the zip file, extract it"}, {"line": 222, "text": "# if it's CQADupStack, merge the corpus, queries, and qrels"}], "decorators": [], "definition_line": 126, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_86d018f7d368ec8e30fd445fa5f36c868f9367b587c61c95814d81050fd97619", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 228, "line_start": 126, "name": "download_dataset", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dataset"}, {"annotation": null, "default": "GH_URL", "kind": "positional_or_keyword", "name": "base_url"}, {"annotation": null, "default": "'./datasets'", "kind": "positional_or_keyword", "name": "save_dir"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "unzip"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "redownload"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}], "path": "bm25s/utils/beir.py", "qualified_name": "download_dataset", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def download_dataset(dataset, base_url=GH_URL, save_dir='./datasets', unzip=True, redownload=False, show_progress=True, leave_progress=False)", "source_id": "repo_source_8d0a5ba853f1ae9e036b0f4d309f8140f0353428be2275ab322bc2656e685f36", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
