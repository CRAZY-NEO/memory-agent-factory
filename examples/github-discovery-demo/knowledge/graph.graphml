okenized], corpus: List[Any]=None, k: int=10, sorted: bool=True, return_as: str='tuple', show_progress: bool=True, leave_progress: bool=False, n_threads: int=0, chunksize: int=50, backend_selection: str='auto', weight_mask: np.ndarray=None)", "source_id": "repo_source_d2d8bec12150dbd29fb5b8e9c0612950ac3a929c94086450a1edb9144458393c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
