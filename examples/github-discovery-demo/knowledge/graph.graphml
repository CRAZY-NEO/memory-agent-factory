    <node id="code_candidate_4312e7ed91e0d54e730a003b3d0a81379be88fd176c6f0a09fe1220841817226">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _git_describe(package_dir, *args):\n    try:\n        return subprocess.check_output(\n            [\n                \"git\",\n                \"describe\",\n                \"--tags\",\n                \"--match\",\n                \"[0-9]*\",\n                \"--match\",\n                \"v[0-9]*\",\n                *args,\n            ],\n            cwd=package_dir,\n            stderr=subprocess.DEVNULL,\n            text=True,\n        ).strip()\n    except (OSError, subprocess.CalledProcessError):\n        return None\n", "code_sha256": "a44dc813da4357d02ef76b67705a8414b197509734f6557021c90e90bdf22d92", "comments": [], "decorators": [], "definition_line": 54, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_4312e7ed91e0d54e730a003b3d0a81379be88fd176c6f0a09fe1220841817226", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 72, "line_start": 54, "name": "_git_describe", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}, {"annotation": null, "default": null, "kind": "var_positional", "name": "args"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_git_describe", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _git_describe(package_dir, *args)", "source_id": "repo_source_13ee5cb4f