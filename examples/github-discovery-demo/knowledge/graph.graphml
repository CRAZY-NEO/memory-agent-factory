, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "method", "line_end": 511, "line_start": 493, "name": "decode", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[List[int]]", "default": null, "kind": "positional_or_keyword", "name": "docs"}], "path": "bm25s/tokenization.py", "qualified_name": "Tokenizer.decode", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "List[List[str]]", "signature": "def decode(self, docs: List[List[int]]) -&gt; List[List[str]]", "source_id": "repo_source_78ed1251f3a4d45980eaad9bcd59ff615e2d8534417caea3ee1795928fc59963", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
