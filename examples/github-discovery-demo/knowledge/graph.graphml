    <node id="code_candidate_f4f28ad6e22380ce2d81a36f9e2f69ae76d7cc4e21673f70b7d750477d772760">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def check_results(self, result_scores, result_indices, sorted=True):\n        if sorted:\n            np.testing.assert_allclose(result_scores, self.expected_scores)\n            np.testing.assert_array_equal(result_indices, self.expected_indices)\n        else:\n            self.assertEqual(len(result_scores), self.k)\n            self.assertEqual(len(result_indices), self.k)\n            self.assertTrue(np.all(np.isin(result_scores, self.expected_scores)))\n            self.assertTrue(np.all(np.isin(result_indices, self.expected_indices)))\n", "code_sha256": "b80fb72e580830f8876bce913f859c57d1d5bfbf670922083953661ed76e4055", "comments": [], "decorators": [], "definition_line": 24, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "d3edf322f0f6a98845031102b759253f4a38ea8f7bced4d14206cd4b498500ed", "id": "code_candidate_f4f28ad6e22380ce2d81a36f9e2f69ae76d7cc4e21673f70b7d750477d772760", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.numba.selection", "name": "topk"}], "kind": "method", "line_end": 32, "line_start": 24, "name": "check_results", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_indices"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "tests/numba/test_topk_numba.py", "qualified_name": "TestTopKSingleQuery.check_results", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def check_results(self, result_scores, result_indices, sorted=True)", "source_id": "repo_source_96e34f39921b537a86bcc7eaa31a11534437912859ddaa910322b9bb7c3fbcfe", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
