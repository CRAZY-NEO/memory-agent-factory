    <node id="code_candidate_e888c95a257f66af1efd493db4c41ddb46bb9831e1e1b1957e8ffcf637aed7e3">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __init__(\n        self,\n        lower: bool = True,\n        splitter: Union[str, Callable] = r\"(?u)\\b\\w\\w+\\b\",\n        stopwords: Union[str, List[str]] = \"english\",\n        stemmer: Callable = None,  # type: ignore\n    ):\n        self.lower = lower\n        if isinstance(splitter, str):\n            splitter = re.compile(splitter).findall\n        if not callable(splitter):\n            raise ValueError(\"splitter must be a callable or a regex pattern.\")\n\n        # Exception handling for stemmer when we are using PyStemmer, which has a stemWords method\n        if hasattr(stemmer, \"stemWord\"):\n            stemmer = stemmer.stemWord\n        if not callable(stemmer) and stemmer is not None:\n            raise ValueError(\"stemmer must be callable or have a `stemWord` method.\")\n\n        self.stopwords = _infer_stopwords(stopwords)\n        self.splitter = splitter\n        self.stemmer = stemmer\n\n        self.reset_vocab()\n", "code_sha256": "a21c2626844a4e5b9c72633274141dd84e6078a346a8110416a532686515954e", "comments": [{"line": 155, "text": "# type: ignore"}, {"line": 163, "text": "# Exception handling for stemmer when we are using PyStemmer, which has a stemWords method"}], "decorators": [], "definition_line": 150, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_e888c95a257f66af1efd493db4c41ddb46bb9831e1e1b1957e8ffcf637aed7e3", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4,