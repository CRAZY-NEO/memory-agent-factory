      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_empty_file(self):\n        \"\"\"Test handling of empty input file.\"\"\"\n        empty_file = os.path.join(self.tmpdirname, \"empty.txt\")\n        with open(empty_file, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"\")\n        \n        args = Namespace(\n            file=empty_file,\n            output=self.index_dir,\n            column=None\n        )\n        \n        with self.assertRaises(SystemExit) as context:\n            index_command(args)\n        \n        self.assertEqual(context.exception.code, 1)\n", "code_sha256": "26fef186370c1da9dfd308397c7cce0ba18ef36cf74df4b9e8b3af0868a5d8e7", "comments": [], "decorators": [], "definition_line": 377, "docstring": "Test handling of empty input file.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5a4dced834c7622105997d5c1b1f67ddf32f394afb260cb40e27ae97a9171caa", "id": "code_candidate_5312066c1f3697751b392b3d71d884819b53710b8baa5a51645f3413194d8e12", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "io", "name": "StringIO"}, {"alias": null, "level": 0, "line": 9, "module": "argparse", "name": "Namespace"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "create_parser"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "get_user_indices_dir"}, {"alias": null, "