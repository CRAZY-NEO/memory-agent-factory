    <node id="code_candidate_fa035a414bfbb2c7c18f2b77f195ea17e330958a8aebaa34f1f5ca8909608ff9">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_numpy_backend_unsorted(self):\n        \"\"\"Test topk with numpy backend unsorted\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        \n        scores, indices = topk(query_scores, k=2, backend=\"numpy\", sorted=False)\n        \n        # Should return top 2 but unsorted\n        # Check that we got the right values (order doesn't matter)\n        self.assertEqual(len(scores), 2)\n        self.assertEqual(len(indices), 2)\n        self.assertIn(4.0, scores)\n        self.assertIn(3.0, scores)\n", "code_sha256": "99fd9f6dacb56694314c3969505e91809a8407c34c0a7b32994cc6359075e800", "comments": [{"line": 59, "text": "# Should return top 2 but unsorted"}, {"line": 60, "text": "# Check that we got the right values (order doesn't matter)"}], "decorators": [], "definition_line": 53, "docstring": "Test topk with numpy backend unsorted", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_fa035a414bfbb2c7c18f2b77f195ea17e330958a8aebaa34f1f5ca8909608ff9", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 64, "line_start": 53, "name": "test_topk_numpy_backend_unsorted", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_numpy_backend_unsorted", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_topk_numpy_backend_unsorted(self)", "source_id": "repo_source_2c62d0b88f3153e4da6b2f730dc9799c02f8035fc5ed916c0810a4a2f841f6fd", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
