    <node id="code_candidate_e854aafa4009d5dd90bb1c9f67dbac60732e68c25544c49388d367413d50c16c">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        np.random.seed(42)\n        self.k = 5\n        self.scores = np.random.uniform(-10, 10, 2000)\n        self.expected_scores = np.sort(self.scores)[-self.k:][::-1]\n        self.expected_indices = np.argsort(self.scores)[-self.k:][::-1]\n", "code_sha256": "7cc17233afcb8d62a54b5fe62ce6e4ab1863614ba454e0613da05839295d4583", "comments": [], "decorators": [], "definition_line": 17, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4e6fe4c42ffcc02b2eba717ac7e1ebacb1d7f64f561ecd9bad0fa3e71b47f4fb", "id": "code_candidate_e854aafa4009d5dd90bb1c9f67dbac60732e68c25544c49388d367413d50c16c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.selection", "name": "topk"}], "kind": "method", "line_end": 22, "line_start": 17, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_topk.py", "qualified_name": "TestTopKSingleQuery.setUp", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_d8c0c16807ca643d93b05e35468e304719f6928525fd4f102c4d86f6a999ba21", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_1217a7e5f8e4a9cfb0f87ee861407713156b2fb45c1503670c35fc648e1d7380">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def check_results(self, result_scores, result_indices, sorted=True):\n        if sorted:\n            np.testing.assert_allclose(result_scores, self.expected_scores)\n            np.testing.assert_array_equal(result_indices, self.expected_indices)\n        else:\n            self.assertEqual(len(result_scores), self.k)\n            self.assertEqual(len(result_indices), self.k)\n            self.assertTrue(np.all(np.isin(result_scores, self.expected_scores)))\n            self.assertTrue(np.all(np.isin(result_indices, self.expected_indices)))\n", "code_sha256": "b80fb72e580830f8876bce913f859c57d1d5bfbf670922083953661ed76e4055", "comments": [], "decorators": [], "definition_line": 24, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4e6fe4c42ffcc02b2eba717ac7e1ebacb1d7f64f561ecd9bad0fa3e71b47f4fb", "id": "code_candidate_1217a7e5f8e4a9cfb0f87ee861407713156b2fb45c1503670c35fc648e1d7380", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.selection", "name": "topk"}], "kind": "method", "line_end": 32, "line_start": 24, "name": "check_results", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_indices"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "tests/core/test_topk.py", "qualified_name": "TestTopKSingleQuery.check_results", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def check_results(self, result_scores, result_indices, sorted=True)", "source_id": "repo_source_d8c0c16807ca643d93b05e35468e304719f6928525fd4f102c4d86f6a999ba21", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
