    <node id="code_candidate_2fbfd4713d4445551e5b6c894184190649922a2d66db4c6095f01efe3e40afb2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_failing_after_adding_new_tokens_query(self):\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n\n        tokenizer = Tokenizer(\n            stemmer=None, stopwords=None, splitter=lambda x: x.split()\n        )\n        corpus_tokens = tokenizer.tokenize(corpus, return_as=\"tuple\", allow_empty=False)\n\n        bm25 = bm25s.BM25()\n        bm25.index(corpus_tokens, create_empty_token=False)\n\n        query = \"unknownword\"\n        query_tokens = tokenizer.tokenize([query], update_vocab=True, allow_empty=False)\n\n        # assert a valueError is raised\n        with self.assertRaises(ValueError):\n            results, scores = bm25.retrieve(query_tokens, k=3)\n", "code_sha256": "982850ef7bb3701b49789878bbfd3da2a8dfeb81c72684fb0ff7111d61291986", "comments": [{"line": 95, "text": "# assert a valueError is raised"}], "decorators": [], "definition_line": 76, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_2fbfd4713d4445551e5b6c894184190649922a2d66db4c6095f01efe3e40afb2", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 97, "line_start": 76, "name": "test_failing_after_adding_new_tokens_query", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_failing_after_adding_new_tokens_query", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_failing_after_adding_new_tokens_query(self)", "source_id": "repo_source_23d568375b3ef8a255d5097c4dfba9bbfbd9775040bff9bf96c69a677bdcdb80", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
