    <node id="code_candidate_4e86d8001be0faabccaa1da9814063b75fd462ee2b823f3fe12be58e21448229">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_numpy_backend(self):\n        \"\"\"Test topk with numpy backend\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        \n        scores, indices = topk(query_scores, k=2, backend=\"numpy\", sorted=True)\n        \n        # Should return top 2: 4.0 (index 2) and 3.0 (index 0)\n        expected_scores = np.array([4.0, 3.0], dtype=np.float32)\n        expected_indices = np.array([2, 0], dtype=np.int64)\n        \n        np.testing.assert_array_almost_equal(scores, expected_scores)\n        np.testing.assert_array_equal(indices, expected_indices)\n", "code_sha256": "2a07457aeb6ef31aaa9dfd0f684908c660d4d77d914e0dffc64760ebf50cd3f7", "comments": [{"line": 46, "text": "# Should return top 2: 4.0 (index 2) and 3.0 (index 0)"}], "decorators": [], "definition_line": 40, "docstring": "Test topk with numpy backend", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_4e86d8001be0faabccaa1da9814063b75fd462ee2b823f3fe12be58e21448229", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 51, "line_start": 40, "name": "test_topk_numpy_backend", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_numpy_backend", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_topk_numpy_backend(self)", "source_id": "repo_source_33f66b9a30f3f6aad8766b2217a780b139864e93e9878cc434c64c8ebc36e517", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
