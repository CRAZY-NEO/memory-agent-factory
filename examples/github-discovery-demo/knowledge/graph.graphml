    <node id="code_candidate_3fe3c4ee0bd3adbf5a014c37a22114c0021e489c2ad4e21e8f774dfd4b1b4651">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenizer_return_as_stream(self):\n        \"\"\"Test tokenizer with return_as='stream'\"\"\"\n        tokenizer = Tokenizer()\n        \n        texts = [\"hello world\", \"foo bar\"]\n        stream = tokenizer.tokenize(texts, return_as=\"stream\")\n        \n        # Should return a generator/iterator\n        results = list(stream)\n        self.assertEqual(len(results), 2)\n", "code_sha256": "90bc5aba51b9c3da1cc21b911a52640c7a554498ec85477b0de78d51e776c949", "comments": [{"line": 112, "text": "# Should return a generator/iterator"}], "decorators": [], "definition_line": 105, "docstring": "Test tokenizer with return_as='stream'", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_3fe3c4ee0bd3adbf5a014c37a22114c0021e489c2ad4e21e8f774dfd4b1b4651", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 114, "line_start": 105, "name": "test_tokenizer_return_as_stream", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenizer_return_as_stream", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_tokenizer_return_as_stream(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6e4f348f68071df2836562d96b9", "status": "unvalidated", "ta