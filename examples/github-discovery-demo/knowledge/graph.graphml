    <node id="code_candidate_e62504f86386c80241ff6328779165e9de569b66b9f7c3d4deffc8c70bb61e29">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        self.tmpdirname = tempfile.mkdtemp()\n        self.data_dir = self.tmpdirname\n        \n        # Create dummy data\n        self.corpus_txt = [\n            \"hello world\",\n            \"this is a test\",\n            \"bm25s is fast\"\n        ]\n        \n        self.corpus_dicts = [\n            {\"id\": 1, \"text\": \"hello world\"},\n            {\"id\": 2, \"text\": \"this is a test\"},\n            {\"id\": 3, \"text\": \"bm25s is fast\"}\n        ]\n        \n        # Write files\n        self.txt_path = os.path.join(self.data_dir, \"corpus.txt\")\n        with open(self.txt_path, \"w\", encoding=\"utf-8\") as f:\n            for line in self.corpus_txt:\n                f.write(line + \"\\n\")\n                \n        self.csv_path = os.path.join(self.data_dir, \"corpus.csv\")\n        with open(self.csv_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n            writer = csv.DictWriter(f, fieldnames=[\"id\", \"text\"])\n            writer.writeheader()\n            for doc in self.corpus_dicts:\n                writer.writerow(doc)\n                \n        self.jsonl_path = os.path.join(self.data_dir, \"corpus.jsonl\")\n        with open(self.jsonl_path, \"w\", encoding=\"utf-8\") as f:\n            for doc in self.corpus_dicts:\n                f.write(json.dumps(doc) + \"\\n\")\n                \n        self.json_path = os.path.join(self.data_dir, \"corpus.json\")\n        with open(self.json_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(self.corpus_dicts, f)\n            \n        self.json_list_path = os.path.join(self.data_dir, \"corpus_list.json\")\n        with open(self.json_list_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(self.corpus_txt, f)\n", "code_sha256": "42de74dd9327dc8d964d93723d0e36a5ed4ca807ed013a0a76103a91a093b12d", "comments": [{"line": 14, "text": "# Create dummy data"}, {"line": 27, "text": "# Write files"}], "decorators": [], "definition_line": 10, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "f2daa5e229dd85f66a35367fe63f1cd17e43e18b4276f4497845cbb313d18617", "id": "code_candidate_e62504f86386c80241ff6328779165e9de569b66b9f7c3d4deffc8c70bb61e29", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": "bm25_hl", "level": 0, "line": 7, "module": "bm25s.high_level", "name": null}], "kind": "method", "line_end": 51, "line_start": 10, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/high_level/test_high_level.py", "qualified_name": "TestHighLevel.setUp", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_94a8358cf0efa7e5536338bc0206c227e225d63e90b699f32ed5ca2974763acb", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
