    <node id="code_candidate_1f871c6ef943c4eb81443ee942f9005ec603ecbcab28bc256003b3f2f53943dc">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def setUpClass(cls):\n\n        # Create your corpus here\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n\n        # optional: create a stemmer\n        stemmer = Stemmer.Stemmer(\"english\")\n\n        # Tokenize the corpus and only keep the ids (faster and saves memory)\n        corpus_tokens = bm25s.tokenize(corpus, stopwords=\"en\", stemmer=stemmer)\n\n        # Create the BM25 model and index the corpus\n        retriever = bm25s.BM25(method='bm25+', backend=\"numba\", corpus=corpus, auto_compile=False)\n        retriever.compile(activate_numba=True, warmup=False)\n        retriever.index(corpus_tokens)\n\n        # Save the retriever to temp dir\n        cls.retriever = retriever\n        cls.corpus = corpus\n        cls.corpus_tokens = corpus_tokens\n        cls.stemmer = stemmer\n        cls.tmpdirname = tempfile.mkdtemp()\n", "code_sha256": "e066a1db37c1423ef932b33ebb41c9f6a015d5b973bf1d82a73089a0690c4340", "comments": [{"line": 16, "text": "# Create your corpus here"}, {"line": 24, "text": "# optional: create a stemmer"}, {"line": 27, "text": "# Tokenize the corpus and only keep the ids (faster and saves memory)"}, {"line": 30, "text": "# Create the BM25 model and index the corpus"}, {"line": 35, "text": "# Save the retriever to temp dir"}], "decorators": ["classmethod"], "definition_line": 14, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "73298969a0628fccdf9af5cde6e7a7c3335a4d3b93692e5f372b8270867b78e9", "id": "code_candidate_1f871c6ef943c4eb81443ee942f9005ec603ecbcab28bc256003b3f2f53943dc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 8, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 40, "line_start": 13, "name": "setUpClass", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cls"}], "path": "tests/numba/test_numba_backend_retrieve.py", "qualified_name": "TestNumbaBackendRetrieve.setUpClass", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUpClass(cls)", "source_id": "repo_source_b8e3921c3fdab33bd0b2d3d1840d50c656236bccc001188c044ed04a06c878a6", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
