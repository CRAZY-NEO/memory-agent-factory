      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_k_larger_than_corpus(self):\n        corpus = bm25_hl.load(self.txt_path)\n        retriever = bm25_hl.index(corpus)\n        # Corpus has 3 docs, requesting k=10 should not fail\n        results = retriever.search([\"test\"], k=10)\n        self.assertEqual(len(results[0]), 3)\n", "code_sha256": "e6a1b140168d35afd425e58aacac3db1bb773588c51779b387918f39ffcb8ae3", "comments": [{"line": 101, "text": "# Corpus has 3 docs, requesting k=10 should not fail"}], "decorators": [], "definition_line": 98, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "f2daa5e229dd85f66a35367fe63f1cd17e43e18b4276f4497845cbb313d18617", "id": "code_candidate_bb94b1478fc0c8ab405c2ac4c3188321780b583e7b371749afa8bea415ff8738", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": "bm25_hl", "level": 0, "line": 7, "module": "bm25s.high_level", "name": null}], "kind": "method", "line_end": 103, "line_start": 98, "name": "test_k_larger_than_corpus", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/high_level/test_high_level.py", "qualified_name": "TestHighLevel.test_k_larger_than_corpus", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_k_larger_than_corpus(self)", "source_id": "repo_source_94a8358cf0efa7e5536338bc0206c227e225d63e90b699f32ed5ca2974763acb", "s