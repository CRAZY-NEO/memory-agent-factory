    <node id="code_candidate_13cd59a2fc74e34e64945c180a7313cf59b01a8d7fdf0d13bfcbb76fd9632d67">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_tfc_atire(tf_array, l_d, l_avg, k1, b, delta=None):\n    \"\"\"\n    Computes the term frequency component of the BM25 score using ATIRE variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    # idf component is given by the idf_array\n    # we calculate the term-frequency component (tfc)\n    return (tf_array * (k1 + 1)) / (tf_array + k1 * (1 - b + b * l_d / l_avg))\n", "code_sha256": "bc24cc8ec813a594bb326f941ef9608e45655b5d8ff3cb4a068da0e0c2935fdd", "comments": [{"line": 138, "text": "# idf component is given by the idf_array"}, {"line": 139, "text": "# we calculate the term-frequency component (tfc)"}], "decorators": [], "definition_line": 133, "docstring": "\n    Computes the term frequency component of the BM25 score using ATIRE variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_13cd59a2fc74e34e64945c180a7313cf59b01a8d7fdf0d13bfcbb76fd9632d67", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 140, "line_start": 133, "name": "_score_tfc_atire", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "tf_array"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_d"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_avg"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k1"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "b"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "delta"}], "path": "bm25s/scoring.py", "qualified_name": "_score_tfc_atire", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _score_tfc_atire(tf_array, l_d, l_avg, k1, b, delta=None)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
