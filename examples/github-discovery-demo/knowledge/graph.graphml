      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_allow_empty_true(self):\n        \"\"\"Test tokenization with allow_empty=True\"\"\"\n        texts = [\"\"]  # Empty string\n        result = bm25s.tokenize(texts, allow_empty=True, return_ids=True)\n        \n        # Should have empty list\n        self.assertEqual(len(result.ids[0]), 0)\n", "code_sha256": "37ad79929c56bcfe6020485d54e614671621f8b995cbd095aad9f5badab22978", "comments": [{"line": 157, "text": "# Empty string"}, {"line": 160, "text": "# Should have empty list"}], "decorators": [], "definition_line": 155, "docstring": "Test tokenization with allow_empty=True", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_dbf4947ecb042c41dbd1acb2b61165c2bd6251ee881345df41fd84f0725f2212", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 161, "line_start": 155, "name": "test_tokenize_allow_empty_true", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenize_allow_empty_true", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_tokenize_allow_empty_true(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6e4f348f68071df2836562d96b9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", 