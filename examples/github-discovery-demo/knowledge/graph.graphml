    <node id="code_candidate_488edc8cf30d5a80dd6690fd69df7fbbc7877b0c9e87b2a072fa9904af0cfa84">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _normalize_version(value):\n    version = value.strip()\n    if version.startswith(\"refs/tags/\"):\n        version = version.rsplit(\"/\", 1)[-1]\n    if version.startswith(\"v\"):\n        version = version[1:]\n    return version\n", "code_sha256": "c0ba7224954d153004286f4cab99c742d6ceb882efbc3fa5c43f93b1e178a098", "comments": [], "decorators": [], "definition_line": 15, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_488edc8cf30d5a80dd6690fd69df7fbbc7877b0c9e87b2a072fa9904af0cfa84", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 21, "line_start": 15, "name": "_normalize_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "value"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_normalize_version", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _normalize_version(value)", "source_id": "repo_source_13ee5cb4f55ed53f88981f2ba569c0924350129c88964ae446001d7220237703", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
