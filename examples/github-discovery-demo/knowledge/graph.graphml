      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(args=None):\n    \"\"\"Main entry point for the terminal CLI.\"\"\"\n    parser = create_parser()\n    parsed_args = parser.parse_args(args)\n    \n    if parsed_args.command == \"index\":\n        index_command(parsed_args)\n    elif parsed_args.command == \"search\":\n        search_command(parsed_args)\n    else:\n        parser.print_help()\n        sys.exit(1)\n", "code_sha256": "7f646a4bf173c3f4aa4dc9837a36699e3892def06e8f236388565b762fa8ed82", "comments": [], "decorators": [], "definition_line": 372, "docstring": "Main entry point for the terminal CLI.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "494e56b9ebbe6dbee99d7037fdad57f53423edd7135b51252c8f65ce514a9a38", "id": "code_candidate_4e20cb33471527cf1e4b27d7b431db3e76a879368fcdd43619f1263610f78758", "imports": [{"alias": null, "level": 0, "line": 15, "module": "argparse", "name": null}, {"alias": null, "level": 0, "line": 16, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 17, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 56, "module": "rich.console", "name": "Console"}, {"alias": null, "level": 0, "line": 57, "module": "rich.prompt", "name": "Prompt"}, {"alias": null, "level": 0, "line": 58, "module": "rich.table", "name": "Table"}, {"alias": null, "level": 0, "line": 59, "module": "rich.panel", "name": "Panel"}, {"alias": "create_index", "level": 2, "line": 130, "module": "high_level", "name": "index"}, {"alias": "load_documents", "level": 2, "line": 130, "module": "high_level", "name": "load"}, {"alias": null, "level": 2, "line": 195, "module": null, "name": "BM25"}, {"alias": null, "level": 2, "line": 196, "module": "high_level", "name": "BM25Search"}], "kind": "function", "line_end": 383, "line_start": 372, "name": "main", "parameters": [{"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "args"}], "path": "bm25s/terminal/__init__.py", "qualified_name": "main", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def main(args=None)", "source_id": "repo_source_d90ec750371a8e4f760393696c89eb4723fedbe28852d9f0c4288c8fc61d6fd9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
