    <node id="code_candidate_b217291bde07de268f74b465a12de2764e60b20f609d063d46f18cf8ace646b2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_save_load_vocab(self):\n        \"\"\"\n        Tests the save_vocab and load_vocab methods to ensure that the vocabulary is saved and loaded correctly.\n        First, this test will tokenize a corpus and store the tokens for later comparison. Then, the vocabulary\n        will be saved to a file, and the tokenizer will be re-initialized. Finally, the vocabulary will be loaded\n        from the file, and the tokenization will be performed again. The tokens from the first tokenization and the\n        second tokenization should be the same.\n        \"\"\"\n        corpus = self.corpus_large[:500]\n        # Tokenize the corpus and store the tokens\n        tokenizer = Tokenizer(stemmer=self.stemmer)\n        tokens_original = tokenizer.tokenize(corpus, return_as=\"ids\", update_vocab=True, show_progress=False)\n        vocab = tokenizer.get_vocab_dict()\n        \n        # Save the vocabulary to a temp dir\n        tokenizer.save_vocab(save_dir=self.tmpdir, vocab_name=\"vocab.tokenizer.json\")\n\n        # Re-initialize the tokenizer and load the vocabulary from the file\n        tokenizer2 = Tokenizer(stemmer=self.stemmer)\n        tokenizer2.load_vocab(save_dir=self.tmpdir, vocab_name=\"vocab.tokenizer.json\")\n\n        # Tokenize the corpus again\n        tokens_new = tokenizer2.tokenize(corpus, return_as=\"ids\", show_progress=False)\n        vocab_new = tokenizer2.get_vocab_dict()\n\n        # Compare the tokens from the first and second tokenization\n        self.assertEqual(tokens_original, tokens_new)\n        # Compare the vocabularies from the first and second tokenization\n        self.assertEqual(vocab, vocab_new)\n", "code_sha256": "55e25ab5d504e201e95f540be9ec1f26fd1e5e7b2e0265a0a3c2c1ec6a5fec8f", "comments": [{"line": 166, "text": "# Tokenize the corpus and store the tokens"}, {"line": 171, "text": "# Save the vocabulary to a temp dir"}, {"line": 174, "text": "# Re-initialize the tokenizer and load the vocabulary from the file"}, {"line": 178, "text": "# Tokenize the corpus again"}, {"line": 182, "text": "# Compare the tokens from the first and second tokenization"}, {"line": 184, "text": "# Compare the vocabularies from the first and second tokenization"}], "decorators": [], "definition_line": 157, "docstring": "\n        Tests the save_vocab and load_vocab methods to ensure that the vocabulary is saved and loaded correctly.\n        First, this test will tokenize a corpus and store the tokens for later comparison. Then, the vocabulary\n        will be saved to a file, and the tokenizer will be re-initialized. Finally, the vocabulary will be loaded\n        from the file, and the tokenization will be performed again. The tokens from the first tokenization and the\n        second tokenization should be the same.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_b217291bde07de268f74b465a12de2764e60b20f609d063d46f18cf8ace646b2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 185, "line_start": 157, "name": "test_save_load_vocab", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_save_load_vocab", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_save_load_vocab(self)", "source_id": "repo_source_f01c1006e1a4861755fc65ea7a7f183e7109351add93b6ab38a478c435375b0f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_63654454d529653eca7d59a3aa50460057781644163e29cacfe2516d5ce722bd">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_save_load_stopwords(self):\n        \"\"\"\n        Tests the save_stopwords and load_stopwords methods to ensure that the stopwords are saved and loaded correctly.\n        First, this test will tokenize a corpus and store the tokens for later comparison. Then, the stopwords will be\n        saved to a file, and the tokenizer will be re-initialized. Finally, the stopwords will be loaded from the file,\n        and the tokenization will be performed again. The tokens from the first tokenization and the second tokenization\n        should be the same.\n        \"\"\"\n        corpus = self.corpus_large[:500]\n        # Tokenize the corpus and store the tokens\n        tokenizer = Tokenizer(stemmer=self.stemmer, stopwords=\"english\")\n        tokens_original = tokenizer.tokenize(corpus, return_as=\"ids\", update_vocab=True, show_progress=False)\n        stopwords = tokenizer.stopwords\n        \n        # Save the stopwords to a temp dir\n        tokenizer.save_stopwords(save_dir=self.tmpdir, stopwords_name=\"stopwords.tokenizer.json\")\n\n        # Re-initialize the tokenizer and load the stopwords from the file\n        tokenizer2 = Tokenizer(stemmer=self.stemmer, stopwords=[])\n\n        # check if stopwords are empty\n        self.assertEqual(tokenizer2.stopwords, [])\n\n        tokenizer2.load_stopwords(save_dir=self.tmpdir, stopwords_name=\"stopwords.tokenizer.json\")\n\n        # Check if the stopwords are loaded correctly\n        self.assertEqual(stopwords, tuple(tokenizer2.stopwords))\n", "code_sha256": "388b5ff1204006fba6d20da54a588056d48b4667b09a4d974a0998d2f79602f1", "comments": [{"line": 196, "text": "# Tokenize the corpus and store the tokens"}, {"line": 201, "text": "# Save the stopwords to a temp dir"}, {"line": 204, "text": "# Re-initialize the tokenizer and load the stopwords from the file"}, {"line": 207, "text": "# check if stopwords are empty"}, {"line": 212, "text": "# Check if the stopwords are loaded correctly"}], "decorators": [], "definition_line": 187, "docstring": "\n        Tests the save_stopwords and load_stopwords methods to ensure that the stopwords are saved and loaded correctly.\n        First, this test will tokenize a corpus and store the tokens for later comparison. Then, the stopwords will be\n        saved to a file, and the tokenizer will be re-initialized. Finally, the stopwords will be loaded from the file,\n        and the tokenization will be performed again. The tokens from the first tokenization and the second tokenization\n        should be the same.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_63654454d529653eca7d59a3aa50460057781644163e29cacfe2516d5ce722bd", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 213, "line_start": 187, "name": "test_save_load_stopwords", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_save_load_stopwords", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_save_load_stopwords(self)", "source_id": "repo_source_f01c1006e1a4861755fc65ea7a7f183e7109351add93b6ab38a478c435375b0f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
