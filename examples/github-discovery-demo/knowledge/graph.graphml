    <node id="code_candidate_114b7de7c4f8ce383573f55aeca8755e3eb1902a23a9322a6dfaea792d4fac13">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_idf_atire(df, N):\n    \"\"\"\n    Computes the inverse document frequency component of the BM25 score using ATIRE variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    return math.log(N / df)\n", "code_sha256": "3666b0f7397f9353723932ffc3fa62b628281a9c3e6ed2923efe2cc8c9ad4f16", "comments": [], "decorators": [], "definition_line": 198, "docstring": "\n    Computes the inverse document frequency component of the BM25 score using ATIRE variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_114b7de7c4f8ce383573f55aeca8755e3eb1902a23a9322a6dfaea792d4fac13", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 203, "line_start": 198, "name": "_score_idf_atire", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "df"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "N"}], "path": "bm25s/scoring.py", "qualified_name": "_score_idf_atire", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _score_idf_atire(df, N)", "source_id": "repo_source_25d