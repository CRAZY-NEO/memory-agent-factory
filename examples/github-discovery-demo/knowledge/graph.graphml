    <node id="code_candidate_0819f8715168129402e354f9ad4e6a49bbc58618350fe4cb1b777e3bbe075f40">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(save_dir=\"datasets\", index_dir=\"bm25s_indices/\", dataset=\"nq\"):\n    index_dir = Path(index_dir) / dataset\n    index_dir.mkdir(parents=True, exist_ok=True)\n    \n    print(\"Downloading the dataset...\")\n    bm25s.utils.beir.download_dataset(dataset, save_dir=save_dir)\n    print(\"Loading the corpus...\")\n    corpus = bm25s.utils.beir.load_corpus(dataset, save_dir=save_dir)\n    corpus_records = [\n        {\"id\": k, \"title\": v[\"title\"], \"text\": v[\"text\"]} for k, v in corpus.items()\n    ]\n    corpus_lst = [r[\"title\"] + \" \" + r[\"text\"] for r in corpus_records]\n\n    stemmer = Stemmer.Stemmer(\"english\")\n    tokenizer = bm25s.tokenization.Tokenizer(stemmer=stemmer)\n    corpus_tokens = tokenizer.tokenize(corpus_lst, return_as=\"tuple\")\n\n    retriever = bm25s.BM25(corpus=corpus_records, backend=\"numba\")\n    retriever.index(corpus_tokens)\n    \n    retriever.save(index_dir)\n    tokenizer.save_vocab(index_dir)\n    tokenizer.save_stopwords(index_dir)\n    print(f\"Saved the index to {index_dir}.\")\n    \n    # get memory usage\n    mem_use = bm25s.utils.benchmark.get_max_memory_usage()\n    print(f\"Peak memory usage: {mem_use:.2f} GB\")\n", "code_sha256": "6debde766699693586424157fe9ae54bf8df4127fa03fd1de69434ae6b360368", "comments": [{"line": 49, "text": "# get memory usage"}], "decorators": [], "definition_line": 24, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "96935b66b97dee909514f8874e1d0588755d6ab6641526a88b9bcc44a9507a53", "id": "code_candidate_0819f8715168129402e354f9ad4e6a49bbc58618350fe4cb1b777e3bbe075f40", "imports": [{"alias": null, "level": 0, "line": 19, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 20, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 21, "module": "Stemmer", "name": null}], "kind": "function", "line_end": 51, "line_start": 24, "name": "main", "parameters": [{"annotation": null, "default": "'datasets'", "kind": "positional_or_keyword", "name": "save_dir"}, {"annotation": null, "default": "'bm25s_indices/'", "kind": "positional_or_keyword", "name": "index_dir"}, {"annotation": null, "default": "'nq'", "kind": "positional_or_keyword", "name": "dataset"}], "path": "examples/index_nq.py", "qualified_name": "main", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def main(save_dir='datasets', index_dir='bm25s_indices/', dataset='nq')", "source_id": "repo_source_0ae1e040da69aff3e31584ddea6fd2f8002ca79628a75b7747daf4c7064849cc", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
