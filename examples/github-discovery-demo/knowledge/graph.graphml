    <node id="code_candidate_b744d42bb8a14f92d161ce8102957620749c30709859d5e83ce99a69974d83f2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_results_merge(self):\n        \"\"\"Test Results.merge() method\"\"\"\n        # Create sample results\n        results1 = Results(\n            documents=np.array([[0, 1], [2, 3]]),\n            scores=np.array([[1.0, 0.5], [0.8, 0.3]])\n        )\n        results2 = Results(\n            documents=np.array([[4, 5]]),\n            scores=np.array([[0.9, 0.2]])\n        )\n        \n        merged = Results.merge([results1, results2])\n        \n        expected_docs = np.array([[0, 1], [2, 3], [4, 5]])\n        expected_scores = np.array([[1.0, 0.5], [0.8, 0.3], [0.9, 0.2]])\n        \n        np.testing.assert_array_equal(merged.documents, expected_docs)\n        np.testing.assert_array_equal(merged.scores, expected_scores)\n", "code_sha256": "de8c91cd232a263511e2a1440a12002cda46c49c7ed3cee079d610730b77250c", "comments": [{"line": 97, "text": "# Create sample results"}], "decorators": [], "definition_line": 95, "docstring": "Test Results.merge() method", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_b744d42bb8a14f92d161ce8102957620749c30709859d5e83ce99a69974d83f2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 113, "line_start": 95, "name": "test_results_merge", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_results_merge", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_results_merge(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
