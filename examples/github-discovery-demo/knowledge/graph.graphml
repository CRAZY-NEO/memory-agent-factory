      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_corpus_without_mmap(self):\n        \"\"\"Test load_corpus with mmap=False\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        retriever.save(self.tmpdir, corpus=self.corpus)\n        \n        # Load without mmap\n        loaded = BM25.load(self.tmpdir, load_corpus=True, mmap=False)\n        \n        # Corpus should be a list\n        self.assertIsInstance(loaded.corpus, list)\n        self.assertEqual(len(loaded.corpus), len(self.corpus))\n", "code_sha256": "dcf69e6246cb753932c099d33a9de1a91b24d153b31fd530338cb7ca30fcdc02", "comments": [{"line": 438, "text": "# Load without mmap"}, {"line": 441, "text": "# Corpus should be a list"}], "decorators": [], "definition_line": 432, "docstring": "Test load_corpus with mmap=False", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_a909a3e6c71a242172847e857175b1343e4684a3e770c6e18b13596e5564c2dc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 443, "line_start": 432, "name": "test_load_corpus_without_mmap", "parameters": [{"annotation": null, "default": null, "kind": "posit