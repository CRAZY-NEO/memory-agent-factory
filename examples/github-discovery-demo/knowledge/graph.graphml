      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_compute_relevance_from_scores_jit_ready_multiple_tokens_same_doc(self):\n        \"\"\"Test the JIT-ready implementation with multiple tokens in same doc\"\"\"\n        # Create sample data: both tokens appear in doc 0\n        data = np.array([1.5, 2.5], dtype=np.float32)\n        indices = np.array([0, 0], dtype=np.int32)\n        indptr = np.array([0, 1, 2], dtype=np.int32)\n        num_docs = 2\n        query_tokens_ids = np.array([0, 1], dtype=np.int32)\n        dtype = np.float32\n\n        scores = _compute_relevance_from_scores_jit_ready(\n            data, indptr, indices, num_docs, query_tokens_ids, dtype\n        )\n\n        # Expected: doc 0 has score 1.5 + 2.5 = 4.0, doc 1 has score 0.0\n        expected = np.array([4.0, 0.0], dtype=np.float32)\n        np.testing.assert_array_almost_equal(scores, expected)\n", "code_sha256": "fd744d0dd44c27d4efee3d2f14f36567e0299fe8fdb3dce0e4d55dda9eb16687", "comments": [{"line": 84, "text": "# Create sample data: both tokens appear in doc 0"}, {"line": 96, "text": "# Expected: doc 0 has score 1.5 + 2.5 = 4.0, doc 1 has score 0.0"}], "decorators": [], "definition_line": 82, "docstring": "Test the JIT-ready implementation with multiple tokens in same doc", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "12dde22d99c544ae01ed2fce528c6a05ab27be8a781de28a699c38a8397797a8", "id": "code_candidate_8243448934abd51ebd389f50922a08110acb01e6b8d81a2a8a79a012be615b21", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_legacy"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_tfc_scorer"}], "kind": "method", "line_end": 98, "line_start": 82, "name": "test_compute_relevance_from_scores_jit_ready_multiple_tokens_same_doc", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_scoring.py", "qualified_name": "TestScoringFunctions.test_compute_relevance_from_scores_jit_ready_multiple_tokens_same_doc", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_compute_relevance_from_scores_jit_ready_multiple_tokens_same_doc(self)", "source_id": "repo_source_3dfd7ffc50ded65ec33600c3a1707b7fc7dcd90c18a3c7dd083a37fbc92d70ca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
