    <node id="code_candidate_afd2e91e9270fad310da8f80892fdc0ea3cb621bd8b2c991c91fba38aafdc25d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_only_unknown_token_query(self):\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n\n        tokenizer = Tokenizer(\n            stemmer=None, stopwords=None, splitter=lambda x: x.split()\n        )\n        corpus_tokens = tokenizer.tokenize(corpus, return_as=\"tuple\")\n\n        bm25 = bm25s.BM25()\n        bm25.index(corpus_tokens)\n\n        query = \"unknownword\"\n        query_tokens = tokenizer.tokenize([query], update_vocab=False)\n\n        results, scores = bm25.retrieve(query_tokens, k=3)\n        self.assertTrue(np.all(scores == 0.0))\n", "code_sha256": "1428e803cd60d1229073195f3ff453376265a32d7eb97cb8388d1dc1c27959b6", "comments": [], "decorators": [], "definition_line": 99, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_afd2e91e9270fad310da8f80892fdc0ea3cb621bd8b2c991c91fba38aafdc25d", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 119, "line_start": 99, "name": "test_only_unknown_token_query", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_only_unknown_token_query", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_only_unknown_token_query(self)", "source_id": "repo_source_b31addb9a348ead01c951e739ab2fb217f4525d6b1e0d4ef7fcc27db5e86b89b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
