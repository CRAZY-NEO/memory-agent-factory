      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_save_and_load_mmindex(self):\n        \"\"\"Test save_mmindex and load_mmindex\"\"\"\n        mmindex = [0, 10, 20, 30]\n        save_mmindex(mmindex, self.test_file)\n        \n        # Check file was created\n        mmindex_file = change_extension(self.test_file, \".mmindex.json\")\n        self.assertTrue(os.path.exists(mmindex_file))\n        \n        # Load it back\n        loaded = load_mmindex(self.test_file)\n        self.assertEqual(loaded, mmindex)\n", "code_sha256": "05e282cbe7323ee85ff40565401a4d7b0931d03b900643b581e15e4b1486d68b", "comments": [{"line": 69, "text": "# Check file was created"}, {"line": 73, "text": "# Load it back"}], "decorators": [], "definition_line": 64, "docstring": "Test save_mmindex and load_mmindex", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_5881160a09d916d7726781641419044c4a4f250bd00b63a536c08e86305cdf45", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"a