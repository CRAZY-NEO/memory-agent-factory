      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def load_vocab(self, save_dir: str, vocab_name: str = \"vocab.tokenizer.json\"):\n        \"\"\"\n        Load the vocabulary dictionaries from a file. The file should be saved in JSON format.\n\n        Parameters\n        ----------\n        save_dir : str\n            The directory where the vocabulary file is saved.\n        \n        vocab_name : str, optional\n            The name of the vocabulary file.\n        \n        Note\n        ----\n        The vocabulary file should be saved in JSON format, with the following keys:\n        - word_to_stem: a dictionary mapping words to their stemmed words\n        - stem_to_sid: a dictionary mapping stemmed words to their stemmed IDs\n        - word_to_id: a dictionary mapping words to their word\n        \"\"\"\n        path = Path(save_dir) / vocab_name\n\n        with open(path, \"r\", encoding='utf-8') as f:\n            d = json_functions.loads(f.read())\n            self.word_to_stem = d[\"word_to_stem\"]\n            self.stem_to_sid = d[\"stem_to_sid\"]\n            self.word_to_id = d[\"word_to_id\"]\n", "code_sha256": "70e001e870614d959c246bf30d5bd1be87e7916015d9ce1a42438336833ab28d", "comments": [], "decorators": [], "definition_line": 211, "docstring": "\n        Load the vocabulary dictionaries from a file. The file should be saved in JSON format.\n\n        Parameters\n        ----------\n        save_dir : str\n            The directory where the vocabulary file is saved.\n        \n        vocab_name : str, optional\n            The name of the vocabulary file.\n        \n        Note\n        ----\n        The vocabulary file should be saved in JSON format, with the following keys:\n        - word_to_stem: a dictionary mapping words to their stemmed words\n        - stem_to_sid: a dictionary mapping stemmed words to their stemmed IDs\n        - word_to_id: a dictionary mapping words to their word\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_8993ae28ca5376107ee99c6abb65e32f3b12299a35d81a63a839cbe6a890f30d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Union"}, {"alias": null, "level": 0, "line": 5, "module": "typing", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_CHINESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DUTCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN_PLUS"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_FRENCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_GERMAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_ITALIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_KOREAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_NORWEGIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_PORTUGUESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "method", "line_end": 236, "line_start": 211, "name": "load_vocab", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "str", "default": null, "kind": "positional_or_keyword", "name": "save_dir"}, {"annotation": "str", "default": "'vocab.tokenizer.json'", "kind": "positional_or_keyword", "name": "vocab_name"}], "path": "bm25s/tokenization.py", "qualified_name": "Tokenizer.load_vocab", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def load_vocab(self, save_dir: str, vocab_name: str='vocab.tokenizer.json')", "source_id": "repo_source_36f95b7073422ec39462657e59cf575ac2ab039132824d11ee0768e259ce5bbf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
