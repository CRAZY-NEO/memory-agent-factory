: "scoring", "name": "_select_tfc_scorer"}, {"alias": null, "level": 0, "line": 1336, "module": "numba", "name": "njit"}, {"alias": null, "level": 1, "line": 1346, "module": "scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 1361, "module": "numba", "name": "njit"}], "kind": "method", "line_end": 1294, "line_start": 1288, "name": "_np_csc", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "rows"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cols"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "shape"}], "path": "bm25s/__init__.py", "qualified_name": "BM25._np_csc", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _np_csc(data, rows, cols, shape)", "source_id": "repo_source_8eb1f8d56c3a2f6aec5c33dcdfe9363289533bb4a91754a766f3a81c67b25ae4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
