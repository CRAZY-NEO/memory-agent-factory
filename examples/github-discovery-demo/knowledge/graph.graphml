      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_dumps_with_builtin_ensure_ascii(self):\n        \"\"\"Test dumps_with_builtin with ensure_ascii parameter\"\"\"\n        data = {\"text\": \"hello world\"}\n        result = json_functions.dumps_with_builtin(data, ensure_ascii=True)\n        self.assertIsInstance(result, str)\n", "code_sha256": "21f7ff167ae230a13e6b805fc8cd4d40590976741837b7323dee1836cb35882e", "comments": [], "decorators": [], "definition_line": 16, "docstring": "Test dumps_with_builtin with ensure_ascii parameter", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_3116a0dae9216de4a8e1587dfda7b5f506ac3f673c540752549ad0c8ada2bdfe", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 20, "line_start": 16, "name": "test_dumps_with_builtin_ensure_ascii", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_dumps_with_builtin_ensure_ascii", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_dumps_with_builtin_ensure_ascii(self)", "source_id": "repo_source_4984691608886d7ad2efe38d4ace55d30ada338a0e182157102471e62e25548f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
