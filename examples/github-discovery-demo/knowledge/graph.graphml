    <node id="code_candidate_9d5916ce33cd28211f375203e1db6451ab77cebb7ac3b380a08db3f427048b31">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_long_document_truncation(self):\n        \"\"\"Test that long documents are truncated in search output.\"\"\"\n        # Create a file with a very long document\n        long_doc = \"word \" * 100  # 500 characters\n        long_file = os.path.join(self.tmpdirname, \"long.txt\")\n        with open(long_file, \"w\", encoding=\"utf-8\") as f:\n            f.write(long_doc + \"\\n\")\n            f.write(\"short doc\\n\")\n        \n        args = Namespace(\n            file=long_file,\n            output=self.index_dir,\n            column=None\n        )\n        \n        old_stdout = sys.stdout\n        sys.stdout = StringIO()\n        \n        try:\n            index_command(args)\n        finally:\n            sys.stdout = old_stdout\n        \n        # Search and check truncation\n        search_args = Namespace(\n            index=self.index_dir,\n            query=\"word\",\n            top_k=2\n        )\n        \n        sys.stdout = StringIO()\n        \n        try:\n            search_command(search_args)\n        finally:\n            output = sys.stdout.getvalue()\n            sys.stdout = old_stdout\n        \n        # Should have \"...\" for truncated content\n        self.assertIn(\"...\", output)\n", "code_sha256": "7ef9f86b574917e57f04b358b37037f41bff881e084b060dd6dcdd5cf43ec120", "comments": [{"line": 396, "text": "# Create a file with a very long document"}, {"line": 397, "text": "# 500 characters"}, {"line": 417, "text": "# Search and check truncation"}, {"line": 432, "text": "# Should have \"...\" for truncated content"}], "decorators": [], "definition_line": 394, "docstring": "Test that long documents are truncated in search output.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5a4dced834c7622105997d5c1b1f67ddf32f394afb260cb40e27ae97a9171caa", "id": "code_candidat