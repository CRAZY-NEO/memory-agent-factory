    <node id="code_candidate_1d01818f0a9bcad693bf69ab992b51bd05509c02649c10323b4d8a5ad7253b18">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __repr__(self):\n        \"\"\"\n        Returns:\n            a string representation of the class.\n            for example, for a small corpus, it would be something like:\n            ----\n            Tokenized(\n              \"ids\": [\n                0: [0, 1, 2, 3]\n              ],\n              \"vocab\": [\n                '': 4\n                'cat': 0\n                'feline': 1\n                'likes': 2\n                'purr': 3\n              ],\n            )\n            ----\n\n            and, for example, for a large corpus, it would be something like:\n            ----\n            Tokenized(\n              \"ids\": [\n                0: [0, 1, 2, 3]\n                1: [4, 5, 6, 7, 8, 9]\n                2: [10, 11, 12, 13, 14]\n                3: [15, 16, 17, 18, 19]\n                4: [0, 1, 2, 3, 0, 20, 21, 22, 23, 24, ...]\n                5: [0, 1, 2, 3]\n                6: [4, 5, 6, 7, 8, 9]\n                7: [10, 11, 12, 13, 14]\n                8: [15, 16, 17, 18, 19]\n                9: [0, 1, 2, 3, 0, 20, 21, 22, 23, 24, ...]\n                ... (total 500000 docs)\n              ],\n              \"vocab\": [\n                '': 29\n                'animal': 12\n                'beautiful': 11\n                'best': 6\n                'bird': 10\n                'can': 13\n                'carefully': 27\n                'casually': 28\n                'cat': 0\n                'creature': 16\n                ... (total 30 tokens)\n              ],\n            )\n            ----\n        \"\"\"\n        lines_print_max_num = 10\n        single_doc_print_max_len = 10\n        lines = [\"Tokenized(\", '  \"ids\": [']\n        for doc_idx, document in enumerate(self.ids[:lines_print_max_num]):\n            preview = document[:single_doc_print_max_len]\n            if len(document) &gt; single_doc_print_max_len:\n                preview += [\"...\"]\n            lines.append(f\"    {doc_idx}: [{', '.join([str(x) for x in preview])}]\")\n        if len(self.ids) &gt; lines_print_max_num:\n            lines.append(f\"    ... (total {len(self.ids)} docs)\")\n        lines.append(f'  ],\\n  \"vocab\": [')\n        vocab_keys = sorted(list(self.vocab.keys()))\n        for vocab_idx, key_ in enumerate(vocab_keys[:lines_print_max_num]):\n            val_ = self.vocab[key_]\n            lines.append(f\"    {key_!r}: {val_}\")\n        if len(list(vocab_keys)) &gt; 10:\n            lines.append(f\"    ... (total {len(vocab_keys)} tokens)\")\n        lines.append(\"  ],\\n)\")\n        return \"\\n\".join(lines)\n", "code_sha256": "ff9c45f41f64209c72dc94fe031c793bcc3c95a21f22415bf298c3dec376fffd", "comments": [], "decorators": [], "definition_line": 50, "docstring": "\n        Returns:\n            a string representation of the class.\n            for example, for a small corpus, it would be something like:\n            ----\n            Tokenized(\n              \"ids\": [\n                0: [0, 1, 2, 3]\n              ],\n              \"vocab\": [\n                '': 4\n                'cat': 0\n                'feline': 1\n                'likes': 2\n                'purr': 3\n              ],\n            )\n            ----\n\n            and, for example, for a large corpus, it would be something like:\n            ----\n            Tokenized(\n              \"ids\": [\n                0: [0, 1, 2, 3]\n                1: [4, 5, 6, 7, 8, 9]\n                2: [10, 11, 12, 13, 14]\n                3: [15, 16, 17, 18, 19]\n                4: [0, 1, 2, 3, 0, 20, 21, 22, 23, 24, ...]\n                5: [0, 1, 2, 3]\n                6: [4, 5, 6, 7, 8, 9]\n                7: [10, 11, 12, 13, 14]\n                8: [15, 16, 17, 18, 19]\n                9: [0, 1, 2, 3, 0, 20, 21, 22, 23, 24, ...]\n                ... (total 500000 docs)\n              ],\n              \"vocab\": [\n                '': 29\n                'animal': 12\n                'beautiful': 11\n                'best': 6\n                'bird': 10\n                'can': 13\n                'carefully': 27\n                'casually': 28\n                'cat': 0\n                'creature': 16\n                ... (total 30 tokens)\n              ],\n            )\n            ----\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_1d01818f0a9bcad693bf69ab992b51bd05509c02649c10323b4d8a5ad7253b18", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Union"}, {"alias": null, "level": 0, "line": 5, "module": "typing", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_CHINESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DUTCH"}, {"alias": null, "level": 1, "line": 21, "module": 