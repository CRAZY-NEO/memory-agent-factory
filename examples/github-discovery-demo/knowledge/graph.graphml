    <node id="code_candidate_930c7f785f3d4ecc04b86b4fc1f9e511444e1a437c214721cc765f7bb1e3c5d8">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_with_stemmer_callable(self):\n        \"\"\"Test tokenization with callable stemmer\"\"\"\n        # Create a simple callable stemmer\n        def simple_stemmer(tokens):\n            return [t[:3] for t in tokens]  # Take up to the first 3 chars (returns whole token if shorter)\n        \n        texts = [\"running jumping\"]\n        result = bm25s.tokenize(texts, stemmer=simple_stemmer, return_ids=False)\n        \n        # Tokens should be stemmed\n        self.assertIsNotNone(result)\n", "code_sha256": "f6324918fa5205bf9a1d757b9b75f6a684c49f44b8a8e46547f4c106cfaad4ba", "comments": [{"line": 128, "text": "# Create a simple callable stemmer"}, {"line": 130, "text": "# Take up to the first 3 chars (returns whole token if shorter)"}, {"line": 135, "text": "# Tokens should be stemmed"}], "decorators": [], "definition_line": 126, "docstring": "Test tokenization with callable stemmer", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_930c7f785f3d4ecc04b86b4fc1f9e511444e1a437c214721cc765f7bb1e3c5d8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 136, "line_start": 126, "name": "test_tokenize_with_stemmer_callable", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenize_with_stemmer_callable", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_tokenize_with_stemmer_callable(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
