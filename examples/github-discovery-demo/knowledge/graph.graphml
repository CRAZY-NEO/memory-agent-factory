    <node id="code_candidate_f5327daa3059d8c4e0bdd8bb7812ac6b460ec8dfd8929c33e2cc6b982080541d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_stopwords_custom_list(self):\n        \"\"\"Test stopwords inference with custom list\"\"\"\n        custom_stopwords = [\"the\", \"a\", \"an\"]\n        stopwords = _infer_stopwords(custom_stopwords)\n        self.assertEqual(stopwords, custom_stopwords)\n", "code_sha256": "26477c1f0c26a5cd47ee749a07b3c769e564e0451cef83bd2c99b691b098d16c", "comments": [], "decorators": [], "definition_line": 50, "docstring": "Test stopwords inference with custom list", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_f5327daa3059d8c4e0bdd8bb7812ac6b460ec8dfd8929c33e2cc6b982080541d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 54, "line_start": 50, "name": "test_infer_stopwords_custom_list", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_infer_stopwords_custom_list", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_infer_stopwords_custom_list(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
