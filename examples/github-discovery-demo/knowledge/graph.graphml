      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_corpus_object_with_tokens(self):\n        \"\"\"Test _infer_corpus_object with list of tokens\"\"\"\n        corpus = [[\"hello\", \"world\"], [\"foo\", \"bar\"]]\n        result = BM25._infer_corpus_object(corpus)\n        self.assertEqual(result, \"tokens\")\n", "code_sha256": "1d26d80c81edb0e323fd31cbb7e7a2cafc476806dc19092516f1359ca9a13f77", "comments": [], "decorators": [], "definition_line": 73, "docstring": "Test _infer_corpus_object with list of tokens", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_fc1501e3cde3afed3fc1562193ca4a471fe250922af168ed5de5fa9e14a991c5", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 77, "line_start": 73, "name": "test_infer_corpus_object_with_tokens", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_infer_corpus_object_with_tokens", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_infer_corpus_object_with_tokens(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
