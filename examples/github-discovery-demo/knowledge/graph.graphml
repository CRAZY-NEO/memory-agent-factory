    <node id="code_candidate_762d3380584d14b41c82f79722c836fc6e607bf5cabf4688059e7a3116929786">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def load_jsonl(\n    dataset,\n    fname,\n    save_dir=\"./datasets\",\n    show_progress=True,\n    leave_progress=False,\n    return_dict=True,\n    force_title=False,\n    remove=None,\n):\n    dataset_path = Path(save_dir) / dataset\n    corpus_path = dataset_path / fname\n\n    if not corpus_path.exists():\n        raise FileNotFoundError(f\"Corpus file not found at {corpus_path}\")\n\n    corpus = []\n    with open(corpus_path, \"r\") as f:\n        # get the number of bytes in the file\n        num_lines = sum(1 for i in open(corpus_path, \"rb\"))\n        pbar = tqdm(\n            f,\n            desc=\"[{}] loading {}\".format(dataset, fname),\n            leave=leave_progress,\n            disable=not show_progress,\n            total=num_lines,\n        )\n        for line in pbar:\n            line = json_functions.loads(line)\n            if force_title:\n                line[\"title\"] = line.get(\"title\")\n            if remove is not None:\n                for key in remove:\n                    del line[key]\n            corpus.append(line)\n            # update the progress bar wrt the number of bytes read\n\n    if return_dict:\n        corpus = {doc.pop(\"_id\"): doc for doc in corpus}\n\n    return corpus\n", "code_sha256": "fb6e56dca9668e8ff1efd810d703b38b8f2a77599122ebc43c32b07e48680702", "comments": [{"line": 249, "text": "# get the number of bytes in the file"}, {"line": 266, "text": "# update the progress bar wrt the number of bytes read"}], "decorators": [], "definition_line": 231, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_762d3380584d14b41c82f79722c836fc6e607bf5cabf4688059e7a3116929786", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 271, "line_start": 231, "name": "load_jsonl", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dataset"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "fname"}, {"annotation": null, "default": "'./datasets'", "kind": "positional_or_keyword", "name": "save_dir"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "return_dict"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "force_title"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "remove"}], "path": "bm25s/utils/beir.py", "qu