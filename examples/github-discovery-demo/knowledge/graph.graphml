    <node id="code_candidate_cdabfa48201d1dc8cf510150356a670625c89a70a20a46b767f6b1e49c4fb7a6">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def stem(self, tokens)-&gt;list:\n        \"\"\"\n        Applies the current stemmer to a list of tokens and returns the stemmed tokens. \n        This is done because bm25s passes a list of strings to the stemmer, \n        and the nltk function expects a single string per call. \n\n        Args:\n            tokens (list): A list of tokens to be stemmed.\n\n        Returns:\n            list: A list of stemmed tokens.\n        \"\"\"\n        return [self.stemmer.stem(token) for token in tokens]\n", "code_sha256": "76d56ad6e007caaf1cd40bd7088fd62e5291e519f54f1e7eddd6e9a3d6f8fb78", "comments": [], "decorators": [], "definition_line": 31, "docstring": "\n        Applies the current stemmer to a list of tokens and returns the stemmed tokens. \n        This is done because bm25s passes a list of strings to the stemmer, \n        and the nltk function expects a single string per call. \n\n        Args:\n            tokens (list): A list of tokens to be stemmed.\n\n        Returns:\n            list: A list of stemmed tokens.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "c817d2e2a1759dc8373bed500ecb20c84bf1b9d2c5af0d6034e9e700bc05e3cf", "id": "code_candidate_cdabfa48201d1dc8cf510150356a670625c89a70a20a46b767f6b1e49c4fb7a6", "imports": [{"alias": null, "level": 0, "line": 3, "module": "nltk.stem.porter", "name": "PorterStemmer"}, {"alias": null, "level": 0, "line": 4, "module": "nltk.stem.snowball", "name": "SnowballStemmer"}, {"alias": null, "level": 0, "line": 5, "module": "nltk.stem.lancaster", "name": "LancasterStemmer"}], "kind": "method", "line_end": 43, "line_start": 31, "name": "stem", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "tokens"}], "path": "examples/nltk_stemmer.py", "qualified_name": "NLTKMultiStemmer.stem", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "list", "signature": "def stem(self, tokens) -&gt; list", "source_id": "repo_source_b9325616ddeaddd7df785a31450bd8d74f1b3f430e72551b585f5f2864157975", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
