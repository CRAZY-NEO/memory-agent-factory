    <node id="code_candidate_fcdba8423d5d1ceb1ff2233aec97444e8f15367f86deb268ca51615c0f185fad">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_auto_backend(self):\n        \"\"\"Test topk with auto backend selection\"\"\"\n        query_scores = np.array([5.0, 2.0, 8.0, 1.0, 6.0], dtype=np.float32)\n\n        scores, indices = topk(query_scores, k=3, backend=\"auto\", sorted=True)\n\n        # Should return top 3: 8.0, 6.0, 5.0\n        self.assertEqual(len(scores), 3)\n        self.assertEqual(len(indices), 3)\n        # Check that the top score is 8.0\n        self.assertEqual(scores[0], 8.0)\n", "code_sha256": "10c596a66cb72d3e50926603b289d0eb78685c7ca522d367fcd2a20b169d7576", "comments": [{"line": 72, "text": "# Should return top 3: 8.0, 6.0, 5.0"}, {"line": 75, "text": "# Check that the top score is 8.0"}], "decorators": [], "definition_line": 66, "docstring": "Test topk with auto backend selection", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_fcdba8423d5d1ceb1ff2233aec97444e8f15367f86deb268ca51615c0f185fad", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 76, "line_start": 66, "name": "test_topk_auto_backend", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_auto_backend", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_topk_auto_backend(self)", "source_id": "repo_source_2c62d0b88f3153e4da6b2f730dc9799c02f8035fc5ed916c0810a4a2f841f6fd", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
