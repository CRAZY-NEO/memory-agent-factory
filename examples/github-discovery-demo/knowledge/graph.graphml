    <node id="code_candidate_af2b55de42567054bed302b9b274c24904b82a6075c83139ab96c217999c74c1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_stopwords_none_and_false(self):\n        \"\"\"Test stopwords inference returns empty list for None and False\"\"\"\n        stopwords = _infer_stopwords(None)\n        self.assertEqual(stopwords, [])\n        \n        stopwords = _infer_stopwords(False)\n        self.assertEqual(stopwords, [])\n", "code_sha256": "7c1ae81a46ad3ffd451afc5f592594b6c0bf546a88b8987e6c727d9de0740b81", "comments": [], "decorators": [], "definition_line": 37, "docstring": "Test stopwords inference returns empty list for None and False", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_af2b55de42567054bed302b9b274c24904b82a6075c83139ab96c217999c74c1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 43, "line_start": 37, "name": "test_infer_stopwords_none_and_false", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_infer_stopwords_none_and_false", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_infer_stopwords_none_and_false(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6e4f348f68071df2836562d96b9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
