    <node id="code_candidate_d4f0cea5653d10436397360c3ab27c1c3c6aac1db62c07a94c6268f0c858a581">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def streaming_tokenize(\n        self, texts: List[str], update_vocab: Union[bool, str] = True, allow_empty: bool = True\n    ):\n        \"\"\"\n        Tokenize a list of strings and return a generator of token IDs.\n\n        Parameters\n        ----------\n        texts : List[str]\n            A list of strings to tokenize.\n\n        update_vocab : bool, optional\n            Whether to update the vocabulary dictionary with the new tokens. If true,\n            the different dictionaries making up the vocabulary will be updated with the\n            new tokens. If False, the function will not update the vocabulary. Unless you have\n            a stemmer and the stemmed word is in the stem_to_sid dictionary.  If \"never\",\n            the function will never update the vocabulary, even if the stemmed word is in\n            the stem_to_sid dictionary. Note that update_vocab=\"if_empty\" is not supported\n            in this method, only in the `tokenize` method.\n        \n        allow_empty : bool, optional\n            Whether to allow the splitter to return an empty string. If False, the splitter \n            will return an empty list, which may cause issues if the tokenizer is not expecting\n            an empty list. If True, the splitter will return a list with a single empty string.\n        \"\"\"\n        stopwords_set = set(self.stopwords) if self.stopwords is not None else None\n        using_stopwords = stopwords_set is not None\n        using_stemmer = self.stemmer is not None\n            \n        if allow_empty is True and update_vocab is True and \"\" not in self.word_to_id:\n            idx = max(self.word_to_id.values(), default=-1) + 1\n            self.word_to_id[\"\"] = idx\n            \n            if using_stemmer:\n                if \"\" not in self.word_to_stem:\n                    self.word_to_stem[\"\"] = \"\"\n                if \"\" not in self.stem_to_sid:\n                    self.stem_to_sid[\"\"] = idx\n        \n        for text in texts:\n            if self.lower:\n                text = text.lower()\n\n            splitted_words = list(self.splitter(text))\n\n            if allow_empty is True and len(splitted_words) == 0:\n                splitted_words = [\"\"]\n            \n            doc_ids = []\n            for word in splitted_words:\n                if word in self.word_to_id:\n                    wid = self.word_to_id[word]\n                    doc_ids.append(wid)\n                    continue\n\n                if using_stopwords and word in stopwords_set:\n                    continue\n\n                # We are always updating the word_to_stem mapping since even new\n                # words that we have never seen before can be stemmed, with the\n                # possibility that the stemmed ID is already in the stem_to_sid\n                if using_stemmer:\n                    if word in self.word_to_stem:\n                        stem = self.word_to_stem[word]\n                    else:\n                        stem = self.stemmer(word)\n                        self.word_to_stem[word] = stem\n\n                    # if the stem is already in the stem_to_sid, we can just use the ID\n                    # and update the word_to_id dictionary, unless update_vocab is \"never\"\n                    # in which case we skip this word\n                    if update_vocab != \"never\" and stem in self.stem_to_sid:\n                        sid = self.stem_to_sid[stem]\n                        self.word_to_id[word] = sid\n                        doc_ids.append(sid)\n\n                    elif update_vocab is True:\n                        sid = len(self.stem_to_sid)\n                        self.stem_to_sid[stem] = sid\n                        self.word_to_id[word] = sid\n                        doc_ids.append(sid)\n                else:\n                    # if we are not using a stemmer, we can just update the word_to_id\n                    # directly rather than going through the stem_to_sid dictionary\n                    if update_vocab is True and word not in self.word_to_id:\n                        wid = len(self.word_to_id)\n                        self.word_to_id[word] = wid\n                        doc_ids.append(wid)\n\n            if len(doc_ids) == 0 and allow_empty is True and \"\" in self.word_to_id:\n                doc_ids = [self.word_to_id[\"\"]]\n            \n            yield doc_ids\n", "code_sha256": "71d51722bae99c985d2eef04e7bfcf6b05b8b68f8413b490deab64e68190fb75", "comments": [{"line": 332, "text": "# We are always updating the word_to_stem mapping since even new"}, {"line": 333, "text": "# words that we have never seen before can be stemmed, with the"}, {"line": 334, "text": "# possibility that the stemmed ID is already in the stem_to_sid"}, {"line": 342, "text": "# if the stem is already in the stem_to_sid, we can just use the ID"}, {"line": 343, "text": "# and update the word_to_id dictionary, unless update_vocab is \"never\""}, {"line": 344, "text": "# in which case we skip this word"}, {"line": 356, "text": "# if we are not using a stemmer, we can just update the word_to_id"}, {"line": 357, "text": "# directly rather than going through the stem_to_sid dictionary"}], "decorators": [], "definition_line": 274, "docstring": "\n        Tokenize a list of strings and return a generator of token IDs.\n\n        Parameters\n        ----------\n        texts : List[str]\n            A list of strings to tokenize.\n\n        update_vocab : bool, optional\n            Whether to update the vocabulary dictionary with the new tokens. If true,\n            the different dictionaries making up the vocabulary will be updated with the\n            new tokens. If False, the function will not update the vocabulary. Unless you have\n            a stemmer and the stemmed word is in the stem_to_sid dictionary.  If \"never\",\n            the function will never update the vocabulary, even if the stemmed word is in\n            the stem_to_sid dictionary. Note that update_vocab=\"if_empty\" is not supported\n            in this method, only in the `tokenize` method.\n        \n        allow_empty : bool, optional\n            Whether to allow the splitter to return an empty string. If False, the splitter \n            will return an empty list, which may cause issues if the tokenizer is not expecting\n            an empty list. If True, the splitter will return a list with a single empty string.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_d4f0cea5653d10436397360c3ab27c1c3c6aac1db62c07a94c6268f0c858a581", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Union"}, {"alias": null, "level": 0, "line": 5, "module": "typing", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_CHINESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DUTCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN_PLUS"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_FRENCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_GERMAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_ITALIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_KOREAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_NORWEGIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_PORTUGUESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "method", "line_end": 366, "line_start": 274, "name": "streaming_tokenize", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[str]", "default": null, "kind": "positional_or_keyword", "name": "texts"}, {"annotation": "Union[bool, str]", "default": "True", "kind": "positional_or_keyword", "name": "update_vocab"}, {"annotation": "bool", "default": "True", "kind": "positional_or_keyword", "name": "allow_empty"}], "path": "bm25s/tokenization.py", "qualified_name": "Tokenizer.streaming_tokenize", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def streaming_tokenize(self, texts: List[str], update_vocab: Union[bool, str]=True, allow_empty: bool=True)", "source_id": "repo_source_78ed1251f3a4d45980eaad9bcd59ff615e2d8534417caea3ee1795928fc59963", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
