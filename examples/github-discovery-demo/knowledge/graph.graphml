      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def save_scores(scores, artifact_dir=\"tests/artifacts\"):\n    if os.getenv(\"ARTIFACTS_DIR\"):\n        artifacts_dir = Path(os.getenv(\"BM25_ARTIFACTS_DIR\"))\n    elif artifact_dir is not None:\n        artifacts_dir = Path(artifact_dir)\n    else:\n        artifacts_dir = Path(__file__).parent / \"artifacts\"\n\n    if \"dataset\" not in scores:\n        raise ValueError(\"scores must contain a 'dataset' key.\")\n    if \"model\" not in scores:\n        raise ValueError(\"scores must contain a 'model' key.\")\n    \n    artifacts_dir = artifacts_dir / scores[\"model\"]\n    artifacts_dir.mkdir(exist_ok=True, parents=True)\n\n    filename = f\"{scores['dataset']}-{os.urandom(8).hex()}.json\"\n    with open(artifacts_dir / filename, \"w\") as f:\n        json.dump(scores, f, indent=2)\n", "code_sha256": "7af1a594febea9004e523e30a1709fbf0346836db3b12b21a236204bb3e1a3fd", "comments": [{"line": 14, "text": "# Make sure to import or define the functions/classes you're going to use,"}, {"line": 15, "text": "# such as bm25s.skl_tokenize and the bm25s.BM25 class, among others."}], "decorators": [], "definition_line": 16, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5eab360363855dfda1b9fad0cbb21a6ca4e4382b4d1941c60051391c74aa6e70", "id": "code_candidate_1d5f58e3503c3527649fe05da88eb20c34f8fa4398258642289ecb62fbaeaf2b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "warnings", "name": null}, {"alias": "np", "level": 0, "line": 8, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils.beir", "name": "BASE_URL"}, {"alias": null, "level": 0, "line": 47, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 48, "module": "beir.util", "name": "download_and_unzip"}, {"alias": null, "level": 0, "line": 49, "module": "rank_bm25", "name": null}, {"alias": null, "level": 0, "line": 50, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 181, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 182, "module": "beir.util", "name": "download_and_unzip"}, {"alias": null, "level": 0, "line": 183, "module": "bm25_pt", "name": null}, {"alias": null, "level": 0, "line": 184, "module": "bm25s.hf", "name": null}, {"alias": null, "level": 0, "line": 186, "module": "transformers", "name": "AutoTokenizer"}], "kind": "function", "line_end": 34, "line_start": 16, "name": "save_scores", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "scores"}, {"annotation": null, "default": "'tests/artifacts'", "kind": "positional_or_keyword", "name": "artifact_dir"}], "path": "tests/__init__.py", "qualified_name": "save_scores", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def save_scores(scores, artifact_dir='tests/artifacts')", "source_id": "repo_source_7112c9ea16878095bdba83cf5cd315e5ce5dd2daabf4a77a271b6c95ac430bf4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
