    <node id="code_candidate_ae4d42466a3d55e92777d109d4af6f30d48d1386bccb5c1d7d8c54b4a8c238ee">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_jax_not_available(self):\n        \"\"\"Test that topk raises ImportError when JAX backend is requested but not available\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        \n        # This test will only fail if JAX is not available\n        # Since JAX might be installed, we'll use a different approach\n        # We'll test the error path by checking if the import error is raised\n        try:\n            import jax\n            # If JAX is available, skip this test or test with numpy backend\n            self.skipTest(\"JAX is available, cannot test error case\")\n        except ImportError:\n            # JAX is not available, test should raise ImportError\n            with self.assertRaises(ImportError) as context:\n                topk(query_scores, k=2, backend=\"jax\")\n            self.assertIn(\"JAX is not available\", str(context.exception))\n", "code_sha256": "c8c074789c7478a27d08e62b0e4412afecfea3a581772bb6a6385ac9f610ed55", "comments": [{"line": 27, "text": "# This test will only fail if JAX is not available"}, {"line": 28, "text": "# Since JAX might be installed, we'll use a different approach"}, {"line": 29, "text": "# We'll test the error path by checking if the import error is raised"}, {"line": 32, "text": "# If JAX is available, skip this test or test with numpy backend"}, {"line": 35, "text": "# JAX is not available, test should raise ImportError"}], "decorators": [], "definition_line": 23, "docstring": "Test that topk raises ImportError when JAX backend is requested but not available", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_ae4d42466a3d55e92777d109d4af6f30d48d1386bccb5c1d7d8c54b4a8c238ee", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 38, "line_start": 23, "name": "test_topk_jax_not_available", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_jax_not_available", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_topk_jax_not_available(self)", "source_id": "repo_source_2c62d0b88f3153e4da6b2f730dc9799c02f8035fc5ed916c0810a4a2f841f6fd", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
