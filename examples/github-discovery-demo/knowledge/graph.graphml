    <node id="code_candidate_c991cfef1118db7940261973addd32704cc5581f44779fab03dcf2b2b0d73b15">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_save_with_non_iterable_corpus(self):\n        \"\"\"Test save with non-iterable corpus parameter\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Try to save with non-iterable corpus\n        # This should raise TypeError since the code tries to enumerate\n        with self.assertRaises(TypeError):\n            retriever.save(self.tmpdir, corpus=12345)\n", "code_sha256": "9a9d9b94ae1f46a207286a0561a2e063e64c450f98853e7c89d9a585a088e94c", "comments": [{"line": 388, "text": "# Try to save with non-iterable corpus"}, {"line": 389, "text": "# This should raise TypeError since the code tries to enumerate"}], "decorators": [], "definition_line": 383, "docstring": "Test save with non-iterable corpus parameter", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_c991cfef1118db7940261973addd32704cc5581f44779fab03dcf2b2b0d73b15", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 391, "line_start": 383, "name": "test_save_with_non_iterable_corpus", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25LoadingSaving.test_save_with_non_iterable_corpus", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_save_with_non_iterable_corpus(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
