    <node id="code_candidate_bdf808b8235fc599b2839695950709a2b61aa528a32a6294577a6c2a44ded4c7">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _get_build_version(package_dir):\n    return (\n        _version_from_environment()\n        or _version_from_pkg_info(package_dir)\n        or _version_from_git(package_dir)\n        or \"0.0.0\"\n    )\n", "code_sha256": "736fa4db4a047606223c41a13c00581c238983de7724f46c32f2b8dee7a3dfb9", "comments": [], "decorators": [], "definition_line": 94, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_bdf808b8235fc599b2839695950709a2b61aa528a32a6294577a6c2a44ded4c7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 100, "line_start": 94, "name": "_get_build_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "setup.py", "qualified_name": "_get_build_version", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _get_build_version(package_dir)", "source_id": "repo_source_3c0d305f10eb306cd3fff0347217bae386f41f7f7d84c64af09d4d3b405f33d8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
