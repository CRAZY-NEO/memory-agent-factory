    <node id="code_candidate_2e55bae131a5f0b77a276ca0e3ab2c1dc6d14077c4e041c39f287a38c27b48bc">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(user, save_dir=\"datasets\", repo_name=\"bm25s-scifact-testing\", dataset=\"scifact\"):\n    # First, use the beir library to download the dataset, and process it\n    data_path = beir.util.download_and_unzip(BASE_URL.format(dataset), save_dir)\n    corpus, _, __ = GenericDataLoader(data_folder=data_path).load(split=\"test\")\n    corpus_records = [\n        {'id': k, 'title': v[\"title\"], 'text': v[\"text\"]} for k, v in corpus.items()\n    ]\n    corpus_lst = [r[\"title\"] + \" \" + r[\"text\"] for r in corpus_records]\n\n    # We will use the snowball stemmer from the PyStemmer library and tokenize the corpus\n    stemmer = Stemmer.Stemmer(\"english\")\n    corpus_tokenized = bm25s.tokenize(corpus_lst, stemmer=stemmer)\n\n    # We create a BM25 retriever, index the corpus, and save to Hugging Face Hub\n    retriever = bm25s.hf.BM25HF()\n    retriever.index(corpus_tokenized)\n\n    hf_token = os.getenv(\"HF_TOKEN\")\n    retriever.save_to_hub(repo_id=f\"{user}/{repo_name}\", token=hf_token, corpus=corpus_records)\n\n    # you can do the same with a tokenizer class\n    tokenizer = bm25s.hf.TokenizerHF(stemmer=stemmer)\n    tokenizer.tokenize(corpus_lst, update_vocab=True)\n    tokenizer.save_vocab_to_hub(repo_id=f\"{user}/{repo_name}\", token=hf_token)\n\n    # you can also load the retriever and tokenizer from the hub\n    tokenizer_new = bm25s.hf.TokenizerHF(stemmer=stemmer, stopwords=[])\n    tokenizer_new.load_vocab_from_hub(repo_id=f\"{user}/{repo_name}\", token=hf_token)\n\n    # You can do the same for stopwords\n    stopwords = tokenizer.stopwords\n    tokenizer.save_stopwords_to_hub(repo_id=f\"{user}/{repo_name}\", token=hf_token)\n\n    # you can also load the stopwords from the hub\n    tokenizer_new.load_stopwords_from_hub(repo_id=f\"{user}/{repo_name}\", token=hf_token)\n    \n    print(\"Original stopwords:\", stopwords)\n    print(\"Reloaded stopwords:\", tokenizer_new.stopwords)\n", "code_sha256": "f2ab520326d07c839a6fff04c9ca128d99f05f2f78a4e300874dc30b0cef3e94", "comments": [{"line": 33, "text": "# First, use the beir library to download the dataset, and process it"}, {"line": 41, "text": "# We will use the snowball stemmer from the PyStemmer library and tokenize the corpus"}, {"line": 45, "text": "# We create a BM25 retriever, index the corpus, and save to Hugging Face Hub"}, {"line": 52, "text": "# you can do the same with a tokenizer class"}, {"line": 57, "text": "# you can also load the retriever and tokenizer from the hub"}, {"line": 61, "text": "# You can do the same for stopwords"}, {"line": 65, "text": "# you can also load the stopwords from the hub"}], "decorators": [], "definition_line": 32, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "cbdd6ae770173717c2a24a0b8a44d778f7a4c10088ffb69f2513cd9aad6fa6c8", "id": "code_candidate_2e55bae131a5f0b77a276ca0e3ab2c1dc6d14077c4e041c39f287a38c27b48bc", "imports": [{"alias": null, "level": 0, "line": 23, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 24, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 25, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 26, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 28, "module": "bm25s.hf", "name": null}, {"alias": null, "level": 0, "line": 29, "module": "bm25s.utils.beir", "name": "BASE_URL"}], "kind": "function", "line_end": 69, "line_start": 32, "name": "main", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "user"}, {"annotation": null, "default": "'datasets'", "kind": "positional_or_keyword", "name": "save_dir"}, {"annotation": null, "default": "'bm25s-scifact-testing'", "kind": "positional_or_keyword", "name": "repo_name"}, {"annotation": null, "default": "'scifact'", "kind": "positional_or_keyword", "name": "dataset"}], "path": "examples/index_to_hf.py", "qualified_name": "main", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def main(user, save_dir='datasets', repo_name='bm25s-scifact-testing', dataset='scifact')", "source_id": "repo_source_c452b9da8e1376b52ae788061c12a1d118c50fe74cc4c6f8715db3ef6b2b1fd5", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
