    <node id="code_candidate_fb9daa6063bfb232294ba417143a83a12dc7bc5f0895c6b5fe682a937b81a12b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_empty_query_handling(self):\n        \"\"\"Test handling of empty query\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Create an empty query\n        empty_query_tokens = [[]]\n        \n        # Should not crash and return results with zero scores\n        results = retriever.retrieve(empty_query_tokens, k=2)\n        \n        self.assertEqual(len(results.documents), 1)\n        self.assertEqual(len(results.documents[0]), 2)\n        # All scores should be zero for empty query\n        self.assertTrue(np.all(results.scores[0] == 0))\n", "code_sha256": "a75263ccec96977c0973aaf9ddcf8e7ac4220d87f58e6406b5d055e2678596e2", "comments": [{"line": 84, "text": "# Create an empty query"}, {"line": 87, "text": "# Should not crash and return results with zero scores"}, {"line": 92, "text": "# All scores should be zero for empty query"}], "decorators": [], "definition_line": 79, "docstring": "Test handling of empty query", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_fb9daa6063bfb232294ba417143a83a12dc7bc5f0895c6b5fe682a937b81a12b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 93, "line_start": 79, "name": "test_empty_query_handling", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_empty_query_handling", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_empty_query_handling(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
