      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_init_creates_index(self):\n        \"\"\"Test JsonlCorpus initialization creates mmindex\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False, save_index=True)\n        \n        # Check mmindex file was created\n        mmindex_file = change_extension(self.test_file, \".mmindex.json\")\n        self.assertTrue(os.path.exists(mmindex_file))\n        \n        corpus.close()\n", "code_sha256": "3cce890ac0905c8b53da6d9dfa21ef34353e40f0e24248e332f210d36805c7d2", "comments": [{"line": 126, "text": "# Check mmindex file was created"}], "decorators": [], "definition_line": 122, "docstring": "Test JsonlCorpus initialization creates mmindex", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_a1b0162c1bf5dc541d4dbef8cb4e0a9c952d4e65063433f83529c0520570c76e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name"