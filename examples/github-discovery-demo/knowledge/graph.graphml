      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef heap_pop(values, indices, length):\n    return_value = values[0]\n    return_index = indices[0]\n    last_value = values[length - 1]\n    last_index = indices[length - 1]\n    values[0] = last_value\n    indices[0] = last_index\n    sift_up(values, indices, 0, length - 1)\n    return return_value, return_index\n", "code_sha256": "7c49d13a707d4e7e3b97311f7393367dd9fe245a74faeaf9a0ac27edcbf0eb5e", "comments": [], "decorators": ["njit(nogil=True)"], "definition_line": 75, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_912918a57c016cd568acfc8f5bca6494c0c4363527108b6032f9613dbc91c2c2", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 83, "line_start": 74, "name": "heap_pop", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "values"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "length"}], "path": "bm25s/numba/selection.py", "qualified_name": "heap_pop", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def heap_pop(values, indices, length)", "source_id": "repo_source_275760e66b6f7c91ae64ee22b3b6a0d3d558c52aaf93aa3ff022e5f030261f8c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
