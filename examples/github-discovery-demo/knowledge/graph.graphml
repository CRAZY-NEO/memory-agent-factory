    <node id="code_candidate_54010f356b4416d80b52c3cb6a40962d92066933cd9eed9c194536ab554fd18b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_environment():\n    for key in (\"BM25S_VERSION\", \"RELEASE_TAG\"):\n        value = os.environ.get(key)\n        if value:\n            return _normalize_version(value)\n\n    if os.environ.get(\"GITHUB_REF_TYPE\") == \"tag\":\n        value = os.environ.get(\"GITHUB_REF_NAME\")\n        if value:\n            return _normalize_version(value)\n\n    github_ref = os.environ.get(\"GITHUB_REF\", \"\")\n    if github_ref.startswith(\"refs/tags/\"):\n        return _normalize_version(github_ref)\n\n    return None\n", "code_sha256": "662f585cfae403cc6ea71da1add4eeb07a164ef9e6cc41b52d519996c3a9d088", "comments": [], "decorators": [], "definition_line": 24, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_54010f356b4416d80b52c3cb6a40962d92066933cd9eed9c194536ab554fd18b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 39, "line_start": 24, "name": "_version_from_environment", "parameters": [], "path": "bm25s/high_level/setup.py", "qualified_name": "_version_from_environment", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _version_from_environment()", "source_id": "repo_source_13ee5cb4f55ed53f88981f2ba569c0924350129c88964ae446001d7220237703", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
