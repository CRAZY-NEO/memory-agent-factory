      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_invalid_stemmer(self):\n        \"\"\"Tests the `__init__` method for handling an invalid `stemmer` input.\"\"\"\n        with self.assertRaises(ValueError):\n            Tokenizer(stemmer=\"not_callable\") # type: ignore\n", "code_sha256": "6c6b6f7695c93a84ed3dc4852854d49e3c430ad5967d0ebbe29edb21c2e04310", "comments": [{"line": 81, "text": "# type: ignore"}], "decorators": [], "definition_line": 78, "docstring": "Tests the `__init__` method for handling an invalid `stemmer` input.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_141a7d91c07f986b4ee2bb1e84035ea5a1d79b9f0a4002b17ab1e5dbad76431c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 81, "line_start": 78, "name": "test_invalid_stemmer", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_invalid_stemmer", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_invalid_ste