    <node id="code_candidate_c6c543ac71bfebe6ed8c4df06df9885b7c152bc941323cee3fc619afc3cd9979">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def get_line(\n    path,\n    index,\n    mmindex,\n    encoding=\"utf-8\",\n    file_obj=None,\n    mmap_obj=None,\n) -&gt; str:\n    path = str(path)\n    if file_obj is None:\n        file_obj = open(path, \"r\", encoding=encoding)\n        CLOSE_FILE = True\n    else:\n        CLOSE_FILE = False\n\n    if mmap_obj is None:\n        mmap_obj = mmap.mmap(file_obj.fileno(), 0, access=mmap.ACCESS_READ)\n        CLOSE_MMAP = True\n    else:\n        CLOSE_MMAP = False\n\n    mmap_obj.seek(mmindex[index])\n    result = mmap_obj.readline().decode(encoding)\n\n    if CLOSE_MMAP:\n        mmap_obj.close()\n\n    if CLOSE_FILE:\n        file_obj.close()\n\n    return result\n", "code_sha256": "ee6c1f093f442ec5fb0fd09191a4f5e5d8edb5270fd73b933cace82ea3eb2149", "comments": [{"line": 72, "text": "# now we can jump to any line in the file thanks to the index and mmap"}], "decorators": [], "definition_line": 73, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_c6c543ac71bfebe6ed8c4df06df9885b7c152bc941323cee3fc619afc3cd9979", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "function", "line_end": 103, "line_start": 73, "name": "get_line", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "path"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "index"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "mmindex"}, {"annotation": null, "default": "'utf-8'", "kind": "positional_or_keyword", "name": "encoding"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "file_obj"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "mmap_obj"}], "path": "bm25s/utils/corpus.py", "qualified_name": "get_line", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "str", "signature": "def get_line(path, index, mmindex, encoding='utf-8', file_obj=None, mmap_obj=None) -&gt; str", "source_id": "repo_source_3a590e9df8c804c7e0ab59f7ac50e34f1861c4a59d907626f359b08c345a4784", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
