      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        # Initialize the Tokenizer with default settings\n        self.tokenizer = Tokenizer(stemmer=self.stemmer)\n", "code_sha256": "c13a3f203188342ebea1d083d99cc7201bebefbbb3aa11253a4c95ea9c1f4f44", "comments": [{"line": 38, "text": "# Initialize the Tokenizer with default settings"}], "decorators": [], "definition_line": 37, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_41f08f1f6be3127e9a367b1ce2353881c722c375a6a0c4095979df96a23857c7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 39, "line_start": 37, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.setUp", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_f01c1006e1a4861755fc65ea7a7f183e7109351add93b6ab38a478c435375b0f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
