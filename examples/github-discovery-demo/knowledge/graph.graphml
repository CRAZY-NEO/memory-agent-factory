      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_with_default_settings(self):\n        \"\"\"Tests the `tokenize` method with default settings.\"\"\"\n        result = self.tokenizer.tokenize(self.corpus, update_vocab=True, return_as=\"ids\", show_progress=True)\n        self.assertIsInstance(result, list)\n        for doc in result:\n            self.assertIsInstance(doc, list)\n            for token_id in doc:\n                self.assertIsInstance(token_id, int)\n", "code_sha256": "71a3868ad5dbbf4cc53a1932fff360a807e90a71f48e060d70638b294e620999", "comments": [], "decorators": [], "definition_line": 41, "docstring": "Tests the `tokenize` method with default settings.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_cd3aee890293ed183524add861f45a00c44c3277cb0466f74e7fca6adb86aaf4", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 48, "line_start": 41, "name": "test_tokenize_with_default_settings", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.tes