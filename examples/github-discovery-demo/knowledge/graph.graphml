      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_csv(self):\n        corpus = bm25_hl.load(self.csv_path, document_column=\"text\")\n        self.assertEqual(len(corpus), 3)\n        self.assertEqual(corpus[0], \"hello world\")\n        \n        retriever = bm25_hl.index(corpus)\n        results = retriever.search([\"fast\"], k=1)\n        self.assertIn(\"fast\", results[0][0][\"document\"])\n", "code_sha256": "f16beb7695fe6dbbaa83b29cfb5406067663d18290e3d7bac68b7780411b2bbe", "comments": [], "decorators": [], "definition_line": 68, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "f2daa5e229dd85f66a35367fe63f1cd17e43e18b4276f4497845cbb313d18617", "id": "code_candidate_dcf608d4326b9ec70ce8e91042416dffc95a919d19b4b3580de54c72e91c8e2a", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": "bm25_hl", "level": 0, "line": 7, "module": "bm25s.high_level", "name": null}], "kind": "method", "line_end": 75, "line_start": 68, "name": "test_load_csv", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/high_level/test_high_level.py", "qualified_name": "TestHighLevel.test_load_csv", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_load_csv(self)", "source_id": "repo_source_94a8358cf0efa7e5536338bc0206c227e225d63e90b699f32ed5ca2974763acb", "status": "unvalidated", "task": null, "tru