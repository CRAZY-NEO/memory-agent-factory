    <node id="code_candidate_c18d494b235f439cc5c7af9a02db32a0ec56d68a3e5db54c06e2c47d289942f8">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _compute_relevance_from_scores_jit_ready(\n    data: np.ndarray,\n    indptr: np.ndarray,\n    indices: np.ndarray,\n    num_docs: int,\n    query_tokens_ids: np.ndarray,\n    dtype: np.dtype,\n) -&gt; np.ndarray:\n    \"\"\"\n    This internal static function calculates the relevance scores for a given query,\n    by using the BM25 scores that have been precomputed in the BM25 eager index.\n    This version is ready for JIT compilation with numba, but is slow if not compiled.\n    \"\"\"\n    indptr_starts = indptr[query_tokens_ids]\n    indptr_ends = indptr[query_tokens_ids + 1]\n\n    scores = np.zeros(num_docs, dtype=dtype)\n    for i in range(len(query_tokens_ids)):\n        start, end = indptr_starts[i], indptr_ends[i]\n        # The following code is slower with numpy, but faster after JIT compilation\n        for j in range(start, end):\n            scores[indices[j]] += data[j]\n\n    return scores\n", "code_sha256": "077c31865adc4e66bc3bc5332738e1d3164f50a2ee93c981bc1a2b566d751778", "comments": [{"line": 364, "text": "# The following code is slower with numpy, but faster after JIT compilation"}], "decorators": [], "definition_line": 345, "docstring": "\n    This internal static function calculates the relevance scores for a given query,\n    by using the BM25 scores that have been precomputed in the BM25 eager index.\n    This version is ready for JIT compilation with numba, but is slow if not compiled.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_c18d494b235f439cc5c7af9a02db32a0ec56d68a3e5db54c06e2c47d289942f8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 368, "line_start": 345, "name": "_compute_relevance_from_scores_jit_ready", "parameters": [{"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indptr"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "num_docs"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "query_tokens_ids"}, {"annotation": "np.dtype", "default": null, "kind": "positional_or_keyword", "name": "dtype"}], "path": "bm25s/scoring.py", "qualified_name": "_compute_relevance_from_scores_jit_ready", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "np.ndarray", "signature": "def _compute_relevance_from_scores_jit_ready(data: np.ndarray, indptr: np.ndarray, indices: np.ndarray, num_docs: int, query_tokens_ids: np.ndarray, dtype: np.dtype) -&gt; np.ndarray", "source_id": "repo_source_7b306c163e643ec8ce2daf2e4d3b9445af352760b228e7c9b26fbade2cb8008d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
