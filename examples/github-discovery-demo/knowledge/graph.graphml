      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def setUpClass(cls):\n        # Define a sample corpus\n        cls.corpus = [\n            \"This is a test sentence.\",\n            \"Another sentence for testing.\",\n            \"Machine learning is fun!\",\n            \"The quick brown fox jumps over the lazy dog.\",\n        ]\n\n        cls.corpus_large = []\n\n        # load tests/data/nfcorpus.txt\n        with open(\"tests/data/nfcorpus.txt\", \"r\") as file:\n            for line in file:\n                cls.corpus_large.append(line.strip())\n\n        # Initialize a stemmer\n        cls.stemmer = Stemmer.Stemmer(\"english\")\n\n        # temp dir\n        cls.tmpdir = tempfile.mkdtemp()\n", "code_sha256": "616397bd894b503b3227aa0f6966a53d79c2520e8712962a50e1187bc6b6ccfa", "comments": [{"line": 16, "text": "# Define a sample corpus"}, {"line": 26, "text": "# load tests/data/nfcorpus.txt"}, {"line": 31, "text": "# Initialize a stemmer"}, {"line": 34, "text": "# temp dir"}], "decorators": ["classmethod"], "definition_line": 15, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_e44dabc765d8fdda905fb5eef3481f3d13138c643afb6f538d5e60f50f425d75", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "nump