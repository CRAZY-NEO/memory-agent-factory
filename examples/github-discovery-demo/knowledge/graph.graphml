    <node id="code_candidate_49542bccb9be2e81e16ce5fa6624e01cc21820f5fe4082cfcffa8cc9fbfde804">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _get_counts_from_token_ids(token_ids, dtype, int_dtype):\n    token_counter = Counter(token_ids)\n    voc_ind = np.array(list(token_counter.keys()), dtype=int_dtype)\n    tf_array = np.array(list(token_counter.values()), dtype=dtype)\n\n    return voc_ind, tf_array\n", "code_sha256": "9deca861facb0bacfe2f9a6a50bc00ebb37f347f051290a6e4a4c334b0da18ab", "comments": [], "decorators": [], "definition_line": 238, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_49542bccb9be2e81e16ce5fa6624e01cc21820f5fe4082cfcffa8cc9fbfde804", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 243, "line_start": 238, "name": "_get_counts_from_token_ids", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "token_ids"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dtype"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "int_dtype"}], "path": "bm25s/scoring.py", "qualified_name": "_get_counts_from_token_ids", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _get_counts_from_token_ids(token_ids, dtype, int_dtype)", "source_id": "repo_source_7b306c163e643ec8ce2daf2e4d3b9445af352760b228e7c9b26fbade2