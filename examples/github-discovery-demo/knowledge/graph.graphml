      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef sift_down(values, indices, startpos, pos):\n    new_value = values[pos]\n    new_index = indices[pos]\n    while pos &gt; startpos:\n        parentpos = (pos - 1) &gt;&gt; 1\n        parent_value = values[parentpos]\n        if new_value &lt; parent_value:\n            values[pos] = parent_value\n            indices[pos] = indices[parentpos]\n            pos = parentpos\n            continue\n        break\n    values[pos] = new_value\n    indices[pos] = new_index\n", "code_sha256": "342c89108571f4a7b7d7c59631813e17130c49cb178d0d553644ddbb69ea2aa8", "comments": [], "decorators": ["njit(nogil=True)"], "definition_line": 32, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_953a8571b017dfd1383876b27635b7a76ee06d3bd9088fa18f7e0a5d13b5de92", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 45, "line_start": 31, "name": "sift_down", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "values"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "startpos"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "pos"}], "path": "bm25s/numba/selection.py", "qualified_name": "sift_down", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def sift_down(values, indices, startpos, pos)", "source_id": "repo_source_275760e66b6f7c91ae64ee22b3b6a0d3d558c52aaf93aa3ff022e5f030261f8c", "status": "unv