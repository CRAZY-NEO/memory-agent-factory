    <node id="code_candidate_688adfd70eff2f057175ec1982740b1b015f1c8341eb582044d8c4091412ad96">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_unique_tokens(self):\n        \"\"\"Test get_unique_tokens function\"\"\"\n        corpus_tokens = [[\"hello\", \"world\"], [\"foo\", \"bar\"], [\"hello\", \"foo\"]]\n        unique = bm25s.get_unique_tokens(corpus_tokens, show_progress=False)\n        \n        self.assertIsInstance(unique, set)\n        self.assertEqual(len(unique), 4)\n        self.assertIn(\"hello\", unique)\n        self.assertIn(\"world\", unique)\n        self.assertIn(\"foo\", unique)\n        self.assertIn(\"bar\", unique)\n", "code_sha256": "ab963d204fb3e9ee6f3dfa887a7421408211ee82ab8b804026b43e85f10aa8a0", "comments": [], "decorators": [], "definition_line": 64, "docstring": "Test get_unique_tokens function", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e3931e4316271c69f108b1b84deeda9b0db9b6b572aabb8cdf9a72c919e42678", "id": "code_candidate_688adfd70eff2f057175ec1982740b1b015f1c8341eb582044d8c4091412ad96", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 86, "module": "importlib", "name": null}], "kind": "method", "line_end": 74, "line_start": 64, "name": "test_get_unique_tokens", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_init_utils.py", "qualified_name": "TestBM25SUtilityFunctions.test_get_unique_tokens", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_get_unique_tokens(self)", "source_id": "repo_source_ad9e070ab3dddfc0d60ad26c2eea48ee096cfa92ac60a3212773e00b019e37ee", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
