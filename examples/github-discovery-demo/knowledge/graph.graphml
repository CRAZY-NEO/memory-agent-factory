    <node id="code_candidate_4540bce78555f90ffe83a27c52078945e207e5861714aed76370ee9992c65976">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_compute_relevance_from_scores_legacy(self):\n        \"\"\"Test the legacy implementation of _compute_relevance_from_scores\"\"\"\n        # Create sample data for testing\n        # Simple case: 3 docs, 2 tokens\n        # Token 0 appears in doc 0 with score 1.0\n        # Token 1 appears in doc 1 with score 2.0\n        data = np.array([1.0, 2.0], dtype=np.float32)\n        indices = np.array([0, 1], dtype=np.int32)\n        indptr = np.array([0, 1, 2], dtype=np.int32)\n        num_docs = 3\n        query_tokens_ids = [0, 1]\n        dtype = np.float32\n\n        scores = _compute_relevance_from_scores_legacy(\n            data, indptr, indices, num_docs, query_tokens_ids, dtype\n        )\n\n        # Expected: doc 0 has score 1.0, doc 1 has score 2.0, doc 2 has score 0.0\n        expected = np.array([1.0, 2.0, 0.0], dtype=np.float32)\n        np.testing.assert_array_almost_equal(scores, expected)\n", "code_sha256": "74ca7350b9df5b68800ab81c97e46e475533cf89503373cb269e6dcfcdefeecb", "comments": [{"line": 28, "text": "# Create sample data for testing"}, {"line": 29, "text": "# Simple case: 3 docs, 2 tokens"}, {"line": 30, "text": "# Token 0 appears in doc 0 with score 1.0"}, {"line": 31, "text": "# Token 1 appears in doc 1 with score 2.0"}, {"line": 43, "text": "# Expected: doc 0 has score 1.0, doc 1 has score 2.0, doc 2 has score 0.0"}], "decorators": [], "definition_line": 26, "docstring": "Test the legacy implementation of _compute_relevance_from_scores", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "12dde22d99c544ae01ed2fce528c6a05ab27be8a781de28a699c38a8397797a8", "id": "code_candidate_4540bce78555f90ffe83a27c52078945e207e5861714aed76370ee9992c65976", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_legacy"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_tfc_scorer"}], "kind": "method", "line_end": 45, "line_start": 26, "name": "test_compute_relevance_from_scores_legacy", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_scoring.py", "qualified_name": "TestScoringFunctions.test_compute_relevance_from_scores_legacy", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_compute_relevance_from_scores_legacy(self)", "source_id": "repo_source_3dfd7ffc50ded65ec33600c3a1707b7fc7dcd90c18a3c7dd083a37fbc92d70ca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
