      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_to_tokenized_tuple(self):\n        \"\"\"Tests the `to_tokenized_tuple` method to ensure it correctly converts token IDs to a named tuple.\"\"\"\n        docs = self.tokenizer.tokenize(self.corpus, return_as=\"ids\", show_progress=False)\n        tokenized_tuple = self.tokenizer.to_tokenized_tuple(docs) # type: ignore\n        self.assertIsInstance(tokenized_tuple, tuple)\n        self.assertEqual(len(tokenized_tuple.ids), len(docs)) # type: ignore\n", "code_sha256": "ebce7a65956a48d6919cc1f1c43e8017e598be1400d5be9e5a6b641e309a28b7", "comments": [{"line": 131, "text": "# type: ignore"}, {"line": 133, "text": "# type: ignore"}], "decorators": [], "definition_line": 128, "docstring": "Tests the `to_tokenized_tuple` method to ensure it correctly converts token IDs to a named tuple.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_efe5f396581b1ec1e42a3088447fc7d96e765274d0768dcd106ca3b04d981b4b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 133, "line_start": 128, "name": "test_to_tokenized_tuple", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_to_tokenized_tuple", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_to_tokenized_tuple(self)", "source_id": "repo_source_f01c1006e1a4861755fc65ea7a7f183e7109351add93b6ab38a478c435375b0f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
