    <node id="code_candidate_09527ed62b1b573bcc0ae989cb053e252565b1cbf2336aab9c8e7cc3ada3032b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _select_tfc_scorer(method) -&gt; callable:\n    if method == \"robertson\":\n        return _score_tfc_robertson\n    elif method == \"lucene\":\n        return _score_tfc_lucene\n    elif method == \"atire\":\n        return _score_tfc_atire\n    elif method == \"bm25l\":\n        return _score_tfc_bm25l\n    elif method == \"bm25+\":\n        return _score_tfc_bm25plus\n    else:\n        error_msg = f\"Invalid score_tfc value: {method}. Choose from 'robertson', 'lucene', 'atire'.\"\n        raise ValueError(error_msg)\n", "code_sha256": "8501996018b4855b2d2ba658b6aaaaeb1cff5873fabd7c60a5fd5d2350057eaa", "comments": [], "decorators": [], "definition_line": 162, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_09527ed62b1b573bcc0ae989cb053e252565b1cbf2336aab9c8e7cc3ada3032b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 175, "line_start": 162, "name": "_select_tfc_scorer", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "method"}], "path": "bm25s/scoring.py", "qualified_name": "_select_tfc_scorer", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "callable", "signature": "def _select_tfc_scorer(method) -&gt; callable", "source_id": "repo_source_7b306c163e643ec8ce2daf2e4d3b9445af352760b228e7c9b26fbade2cb8008d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
