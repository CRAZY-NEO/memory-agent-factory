      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_index_json_file(self):\n        \"\"\"Test indexing a JSON file.\"\"\"\n        args = Namespace(\n            file=self.json_path,\n            output=self.index_dir,\n            column=\"text\"\n        )\n        \n        old_stdout = sys.stdout\n        sys.stdout = StringIO()\n        \n        try:\n            index_command(args)\n        finally:\n            output = sys.stdout.getvalue()\n            sys.stdout = old_stdout\n        \n        self.assertTrue(os.path.exists(self.index_dir))\n        self.assertIn(\"Loaded 3 documents\", output)\n", "code_sha256": "5bbc949187d380d85766093a163d5dad2ad25586450d69ec813bd1d62ca89448", "comments": [], "decorators": [], "definition_line": 146, "docstring": "Test indexing a JSON file.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5a4dced834c7622105997d5c1b1f67ddf32f394afb260cb40e27ae97a9171caa", "id": "code_candidate_6368e8c66c9cdc6f80418024bcf78acc9a2da255adfca86a8d07f9402e31330d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "io", "name": "StringIO"}, {"alias": null, "level": 0, "line": 9, "module": "argparse", "name": "Namespace"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "create_parser"}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.terminal", "name": "get_user_indices_dir