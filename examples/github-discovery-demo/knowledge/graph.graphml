      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def set_stemmer(self, stemmer_name, language='english'):\n        \"\"\"\n        Sets the current stemmer to the specified stemmer name\n\n        Args:\n            stemmer_name (str): The name of the stemmer to use.\n        Raises:\n            ValueError: If the specified stemmer name is not available.\n        \"\"\"\n        if stemmer_name in self.available_stemmers:\n            self.stemmer_name = stemmer_name\n            if stemmer_name == 'snowball':\n                self.language = language\n                self.stemmer = SnowballStemmer(self.language)\n            else:\n                self.stemmer = self.available_stemmers[stemmer_name]\n        else:\n            raise ValueError(f\"Invalid stemmer name: {stemmer_name}. Available stemmers: {list(self.available_stemmers.keys())}\")\n", "code_sha256": "5b6db85d805330039a3e032aee7a885e936e51c62730c8b2b8fa44a939deb854", "comments": [], "decorators": [], "definition_line": 45, "docstring": "\n        Sets the current stemmer to the specified stemmer name\n\n        Args:\n            stemmer_name (str): The name of the stemmer to use.\n        Raises:\n            ValueError: If the specified stemmer name is not available.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "c817d2e2a1759dc8373bed500ecb20c84bf1b9d2c5af0d6034e9e700bc05e3cf", "id": "code_candidate_5e3af5f5a0acb3ce6a4f34e3162ae53eae1b07e2c795c5bedc3266d238b50aa7", "imports": [{"alias": null, "level": 0, "line": 3, "module": "nltk.stem.porter", "name": "PorterStemmer"}, {"alias": null, "level": 0, "line": 4, "module": "nltk.stem.snowball", "name": "SnowballStemmer"}, {"alias": null, "level": 0, "line": 5, "module": "nltk.stem.lancaster", "name": "LancasterStemmer"}], "kind": "method", "line_end": 62, "line_start": 45, "name": "set_stemmer", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "stemmer_name"}, {"annotation": null, "default": "'english'", "kind": "positional_or_keyword", "name": "language"}], "path": "examples/nltk_stemmer.py", "qualified_name": "NLTKMultiStemmer.set_stemmer", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def set_stemmer(self, stemmer_name, language='english')", "source_id": "repo_source_b9325616ddeaddd7df785a31450bd8d74f1b3f430e72551b585f5f2864157975", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
