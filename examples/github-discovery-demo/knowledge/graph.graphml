    <node id="code_candidate_96565c908b180ce753cdf0b1848b5069959370c1cbeaf7d12bfd04c31be346df">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_git(package_dir):\n    exact_tag = _git_describe(package_dir, \"--exact-match\")\n    if exact_tag:\n        return _normalize_version(exact_tag)\n\n    description = _git_describe(package_dir, \"--long\")\n    if not description:\n        return None\n\n    match = re.match(r\"(.+)-(\\d+)-g([0-9a-f]+)$\", description)\n    if not match:\n        return None\n\n    tag, distance, sha = match.groups()\n    version = _normalize_version(tag)\n    if distance == \"0\":\n        return version\n\n    suffix = \".dev\" if \".post\" in version else \".post\"\n    return f\"{version}{suffix}{distance}+g{sha}\"\n", "code_sha256": "a355c46b32cc59a908d9f87f4a7a812f19fa29887a9d196d18091c08f4daa475", "comments": [], "decorators": [], "definition_line": 75, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_96565c908b180ce753cdf0b1848b5069959370c1cbeaf7d12bfd04c31be346df", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 94, "line_start": 75, "name": "_version_from_git", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_version_from_git", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _version_from_git(package_dir)", "source_id": "repo_source_e5fc7c562f0444f38f1579ffd481649872143a2e16ecd1931db291ef5c679eef", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
