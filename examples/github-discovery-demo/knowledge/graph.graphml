      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(repo_name=\"xhluca/bm25s-fiqa-index\"):\n    queries = [\n        \"Is chemotherapy effective for treating cancer?\",\n        \"Is Cardiac injury is common in critical cases of COVID-19?\",\n    ]\n\n    retriever = bm25s.hf.BM25HF.load_from_hub(\n        repo_name, load_corpus=False, mmap=False\n    )\n\n    # Tokenize the queries\n    stemmer = Stemmer.Stemmer(\"english\")\n    queries_tokenized = bm25s.tokenize(queries, stemmer=stemmer)\n\n    # Retrieve the top-k results\n    retriever.activate_numba_scorer()\n    results = retriever.retrieve(queries_tokenized, k=3, backend_selection=\"numba\")\n    # show first results\n    result = results.documents[0]\n    print(f\"First score (# 1 result):{results.scores[0, 0]}\")\n    print(f\"First result (# 1 result):\\n{result[0]}\")\n", "code_sha256": "5d712edf631a5b4fdffd10f9ab79602d8cd2d853509f604f2e478327efa9d6fd", "comments": [{"line": 30, "text": "# Tokenize the queries"}, {"line": 34, "text": "# Retrieve the top-k results"}, {"line": 37, "text": "# show first results"}], "decorators": [], "definition_line": 20, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e8716a45d4ab967aee563f7a39064e0e01222ef9403b43ae32d1e831225193e6", "id": "code_candidate_f5d9de6a3fae8bba8ab89fe3ddf0ed56c917d871bea56e1a144b1b4dc41b9c48", "imports": [{"alias": null, "level": 0, "line": 15, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 16, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "bm25s.hf", "name": null}], "kind": "function", "line_end": 40, "line_start": 20, "name": "main", "parameters": [{"annotation": null, "default": "'xhluca/bm25s-fiqa-index'", "kind": "positional_or_keyword", "name": "repo_name"}], "path": "examples/retrieve_with_numba_advanced.py", "qualified_name": "main", "reposito