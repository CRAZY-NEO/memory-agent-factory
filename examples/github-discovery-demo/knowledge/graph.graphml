    <node id="code_candidate_f7d8381e938adc61748622fa5e6fef6625892dec42f418701c42586940b58b5e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_invalid_weight_mask_length(self):\n        \"\"\"Test retrieve with weight_mask of wrong length\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\"]]\n        \n        # Create weight mask with wrong length\n        weight_mask = np.array([1, 0])  # corpus has 4 docs\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(query_tokens, k=2, weight_mask=weight_mask)\n        self.assertIn(\"length of the weight_mask must be the same\", str(context.exception))\n", "code_sha256": "73d782ff0ffc5bc1b4bed9c9f522f028d2b860c603b672d26640f4ac1cdd1db8", "comments": [{"line": 308, "text": "# Create weight mask with wrong length"}, {"line": 309, "text": "# corpus has 4 docs"}], "decorators": [], "definition_line": 301, "docstring": "Test retrieve with weight_mask of wrong length", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_f7d8381e938adc61748622fa5e6fef6625892dec42f418701c42586940b58b5e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 3