      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_bm25_load_rejects_truncated_corpus_with_saved_index(self):\n        documents = [\"alpha beta\", \"gamma delta\"]\n        tokens = bm25s.tokenize(documents, show_progress=False)\n        model = bm25s.BM25(backend=\"numpy\")\n        model.index(tokens, show_progress=False)\n        model.save(self.directory, corpus=documents, show_progress=False)\n\n        corpus = JsonlCorpus(self.path, show_progress=False, verbosity=0)\n        self.addCleanup(corpus.close)\n        self.assertEqual(len(corpus), 2)\n        corpus.close()\n        self.path.write_bytes(b\"\")\n\n        with self.assertRaises(ValueError):\n            loaded = bm25s.BM25.load(\n                self.directory, mmap=True, load_corpus=True, show_progress=False\n            )\n            self.addCleanup(loaded.corpus.close)\n", "code_sha256": "9315d2c13b9847e90a40d022e1310ef0c8fb67431c76eae6de10b98e90fbac66", "comments": [], "decorators": [], "definition_line": 45, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "89148d421a705bf1e74fea0181523df8aa3f52c4b7aa048dbc71814b6de92aba", "id": "code_candidate_918b3f81537bb44851d3f2eb2b9c604185ff57ed57b2ff233bdcdc56d64c0207", "imports": [{"alias": null, "level": 0, "line": 1, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}], "kind": "method", "line_end": 62, "line_start": 45, "name": "test_bm25_load_rejects_truncated_corpus_with_saved_index", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus_truncation.py", "qualified_name": "TestCorpusTruncation.test_bm25_load_rejects_truncated_corpus_with_saved_index", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_bm25_load_rejects_truncated_corpus_with_saved_index(self)", "source_id": "repo_source_b638a254a6fc85f3fc14cf3439868106a732c663f8b9f9cdb39331d3c0ce0e80", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
