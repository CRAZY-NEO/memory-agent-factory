      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def index(documents, language: str = \"english\"):\n    return BM25Search(corpus=documents, language=language)\n", "code_sha256": "fd1ebd8d988d5c2c0d77cd06527937ec84fa3caedab7222ff5841bccf1cbdb07", "comments": [], "decorators": [], "definition_line": 173, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "946e755ab1ea7890870f58c12cc72022dac540c52d09c0cb0be179acbe05acb8", "id": "code_candidate_9143143e30c33658080da7216b1d9e850b57941877e590107b4581588769dede", "imports": [{"alias": null, "level": 0, "line": 9, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "csv", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 12, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 14, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 15, "module": "typing", "name": "List"}], "kind": "function", "line_end": 174, "line_start": 173, "name": "index", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "documents"}, {"annotation": "str", "default": "'english'", "kind": "positional_or_keyword", "name": "language"}], "path": "bm25s/high_level/__init__.py", "qualified_name": "index", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def index(documents, language: str='english')", "source_id": "repo_source_b9ce63029d8c4cc8634d27d47d4556086d0d9779fb099d6938836d40403268ed", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
