    <node id="code_candidate_0f986dc3c935b068a9b1ff4ad49913dee58d2266caaf9702910138cc08bfd516">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _get_build_version(package_dir):\n    return (\n        _version_from_environment()\n        or _version_from_pkg_info(package_dir)\n        or _version_from_git(package_dir)\n        or \"0.0.0\"\n    )\n", "code_sha256": "736fa4db4a047606223c41a13c00581c238983de7724f46c32f2b8dee7a3dfb9", "comments": [], "decorators": [], "definition_line": 94, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_0f986dc3c935b068a9b1ff4ad49913dee58d2266caaf9702910138cc08bfd516", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 100, "line_start": 94, "name": "_get_build_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "setup.py", "qualified_name": "_get_build_version", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _get_build_version(package_dir)", "source_id": "repo_source_0d1f311b51d0d09ed327befd6df90b17c01d1bb753011e01353c1c098b4f217d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
