    <node id="code_candidate_70fab63fc942b8c33b810865a1de1e5d2783c15d0306d7057dd8dbc655c893f3">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(user, repo_name=\"bm25s-scifact-index\"):\n    queries = [\n        \"Is chemotherapy effective for treating cancer?\",\n        \"Is Cardiac injury is common in critical cases of COVID-19?\",\n    ]\n\n    # Load the BM25 index from Hugging Face Hub\n    # mmap=True helps to reduce memory usage by memory-mapping the index\n    # load_corpus=True loads the corpus along with the index, so you can access the documents\n    retriever = bm25s.hf.BM25HF.load_from_hub(\n        f\"{user}/{repo_name}\", load_corpus=True, mmap=True\n    )\n\n    # Tokenize the queries\n    stemmer = Stemmer.Stemmer(\"english\")\n    queries_tokenized = bm25s.tokenize(queries, stemmer=stemmer)\n\n    # Retrieve the top-k results\n    results = retriever.retrieve(queries_tokenized, k=3)\n    # show first results\n    result = results.documents[0]\n    print(f\"First score (# 1 result):{results.scores[0, 0]}\")\n    print(f\"First result (# 1 result):\\n{result[0]}\")\n", "code_sha256": "a81c2299571a2931ec4bb6db3f822e427c0bca26d718bd5c41a9a0e0452a90c6", "comments": [{"line": 37, "text": "# Load the BM25 index from Hugging Face Hub"}, {"line": 38, "text": "# mmap=True helps to reduce memory usage by memory-mapping the index"}, {"line": 39, "text": "# load_corpus=True loads the corpus along with the index, so you can access the documents"}, {"line": 44, "text": "# Tokenize the queries"}, {"line": 48, "text": "# Retrieve the top-k results"}, {"line": 50, "text": "# show first results"}], "decorators": [], "definition_line": 31, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "109bb65fd32b0b2b695dac8e47a2100de768f818064d1fbf911191702a2b698c", "id": "code_candidate_70fab63fc942b8c33b810865a1de1e5d2783c15d0306d7057dd8dbc655c893f3", "imports": [{"alias": null, "level": 0, "line": 26, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 27, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 29, "module": "bm25s.hf", "name": null}], "kind": "function", "line_end": 53, "line_start": 31, "name": "main", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "user"}, {"annotation": null, "default": "'bm25s-scifact-index'", "kind": "positional_or_keyword", "name": "repo_name"}], "path": "examples/retrieve_from_hf.py", "qualified_name": "main", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def main(user, repo_name='bm25s-scifact-index')", "source_id": "repo_source_059f7012b6b006a7b86e43ebab6d544b64db61489b0fbc6907b34a354bbde620", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
