    <node id="code_candidate_f0a32c4128adf4b0819692ab1b68385bbd733f13405fa72c4840177df21b10a8">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_compare_class_with_functional(self):\n        \"\"\"Tests the `to_lists_of_strings` method to ensure it converts token IDs back to strings properly.\"\"\"\n        docs = self.tokenizer.tokenize(self.corpus_large, return_as=\"ids\", show_progress=False)\n        strings = self.tokenizer.decode(docs) # type: ignore\n\n        # now, do the same using bm25s.tokenize\n        strings2 = self.tokenizer.tokenize(self.corpus_large, return_as=\"string\")\n        \n        # compare the two\n        self.assertEqual(strings, strings2)\n", "code_sha256": "fefc7b31954dcdf45bd4c20ca683d3a27813d38d6b98dd8610e0729647eb4ce0", "comments": [{"line": 145, "text": "# compare return_ids with decode"}, {"line": 149, "text": "# type: ignore"}, {"line": 151, "text": "# now, do the same using bm25s.tokenize"}, {"line": 154, "text": "# compare the two"}], "decorators": [], "definition_line": 146, "docstring": "Tests the `to_lists_of_strings` method to ensure it converts token IDs back to strings properly.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_f0a32c4128adf4b0819692ab1b68385bbd733f13405fa72c4840177df21b10a8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 155, "line_start": 146, "name": "test_compare_class_with_functional", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_compare_class_with_functional", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_compare_class_with_functional(self)", "source_id": "repo_source_ae51486d134a6041ab337f3bc922236f8149c1552157012e7e67afcf3e89ab60", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
