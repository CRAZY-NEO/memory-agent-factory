      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        self.tmpdir = tempfile.mkdtemp()\n        \n        # Create a test jsonl file\n        self.test_file = os.path.join(self.tmpdir, \"test.jsonl\")\n        self.test_data = [\n            {\"id\": 0, \"text\": \"first line\"},\n            {\"id\": 1, \"text\": \"second line\"},\n            {\"id\": 2, \"text\": \"third line\"},\n            {\"id\": 3, \"text\": \"fourth line\"},\n        ]\n        \n        with open(self.test_file, \"w\", encoding=\"utf-8\") as f:\n            for item in self.test_data:\n                f.write(json_functions.dumps(item) + \"\\n\")\n", "code_sha256": "ab4b9b6dc188bec1d574be33e024f1f7a23a15ddf50cd05f6d3602cae101d7b7", "comments": [{"line": 23, "text": "# Create a test jsonl file"}], "decorators": [], "definition_line": 20, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_27224d900f80dac4a03073a4f42cf0fc040930819b235c0fbaa502169df9436c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 34, "line_start": 20, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestCorpusUtilities.setUp", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_4788d7ad1823b10d4c7616a36d80244f130a74dc22f961e34ba43e6e81e60af6", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
