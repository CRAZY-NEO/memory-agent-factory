    <node id="code_candidate_e9c63eb305625711834bbe9298ffacaf01ab55405bf76d0360698d57f1ca6100">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_is_tuple_of_list_of_tokens_valid(self):\n        \"\"\"Test _is_tuple_of_list_of_tokens with valid input\"\"\"\n        result = bm25s._is_tuple_of_list_of_tokens(([\"hello\", \"world\"],))\n        self.assertTrue(result)\n", "code_sha256": "997ca72b8575c10f6293902a11e4b65851a09c1b5439fe818ffae70f13bc3889", "comments": [], "decorators": [], "definition_line": 59, "docstring": "Test _is_tuple_of_list_of_tokens with valid input", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e3931e4316271c69f108b1b84deeda9b0db9b6b572aabb8cdf9a72c919e42678", "id": "code_candidate_e9c63eb305625711834bbe9298ffacaf01ab55405bf76d0360698d57f1ca6100", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 86, "module": "importlib", "name": null}], "kind": "method", "line_end": 62, "line_start": 59, "name": "test_is_tuple_of_list_of_tokens_valid", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_init_utils.py", "qualified_name": "TestBM25SUtilityFunctions.test_is_tuple_of_list_of_tokens_valid", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_is_tuple_of_list_of_tokens_valid(self)", "source_id": "repo_source_d2e25ca3d658c6e9e322eb7ac31fb9670b4a1818f495385ec9ffab88d1efb78c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
