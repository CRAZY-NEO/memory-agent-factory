      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        self.tmpdir = tempfile.mkdtemp()\n        \n        # Create a test jsonl file\n        self.test_file = os.path.join(self.tmpdir, \"corpus.jsonl\")\n        self.test_data = [\n            {\"id\": 0, \"text\": \"first document\"},\n            {\"id\": 1, \"text\": \"second document\"},\n            {\"id\": 2, \"text\": \"third document\"},\n            {\"id\": 3, \"text\": \"fourth document\"},\n            {\"id\": 4, \"text\": \"fifth document\"},\n        ]\n        \n        with open(self.test_file, \"w\", encoding=\"utf-8\") as f:\n            for item in self.test_data:\n                f.write(json_functions.dumps(item) + \"\\n\")\n", "code_sha256": "1d35e0391d54c902ee47a4d3e227e4c48dd07c970c349d7d349ef4325b62875b", "comments": [{"line": 104, "text": "# Create a test jsonl file"}], "decorators": [], "definition_line": 101, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_fde3fb5173cdb1fc05c1b9de2869d3b7744fd9900540f0907d4261927ef4a007", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.