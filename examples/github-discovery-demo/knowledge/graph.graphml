    <node id="code_candidate_31b6d1522eb2f0a2da3be7a64f1b3546a0492648bc748bc78f4975ae636e0677">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_constructor_rejects_truncated_file_with_saved_index(self):\n        corpus = JsonlCorpus(self.path, show_progress=False, verbosity=0)\n        self.addCleanup(corpus.close)\n        self.assertEqual(len(corpus), 2)\n        self.assertTrue(Path(change_extension(self.path, \".mmindex.json\")).is_file())\n        corpus.close()\n        self.path.write_bytes(b\"\")\n\n        with self.assertRaises(ValueError):\n            reopened = JsonlCorpus(self.path, show_progress=False, verbosity=0)\n            self.addCleanup(reopened.close)\n", "code_sha256": "bc9798210465a7d96b8cd6f5144e0413bb753170fdfbeaedcb37f9a30a69a72b", "comments": [], "decorators": [], "definition_line": 19, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "89148d421a705bf1e74fea0181523df8aa3f52c4b7aa048dbc71814b6de92aba", "id": "code_candidate_31b6d1522eb2f0a2da3be7a64f1b3546a0492648bc748bc78f4975ae636e0677", "imports": [{"alias": null, "level": 0, "line": 1, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}], "kind": "method", "line_end": 29, "line_start": 19, "name": "test_constructor_rejects_truncated_file_with_saved_index", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus_truncation.py", "qualified_name": "TestCorpusTruncation.test_constructor_rejects_truncated_file_with_saved_index", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_constructor_rejects_truncated_file_with_saved_index(self)", "source_id": "repo_source_916ea447a52fddd7945de51f690d6ff5eb59e69caef98bac29449edcddd14a4f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
