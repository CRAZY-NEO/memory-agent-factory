    <node id="code_candidate_c6950747839e0f44a1718d30a8fbf2972015c14829514a62166177cf50c11f0d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_scores_with_invalid_type(self):\n        \"\"\"Test get_scores with invalid input type\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Try with a string instead of list\n        with self.assertRaises(ValueError) as context:\n            retriever.get_scores(\"not a list\")\n        self.assertIn(\"must be a list\", str(context.exception))\n", "code_sha256": "bee3eb3bafe190bc88191fa29251cce08ee60ff26b2e29c69c520f609c67217d", "comments": [{"line": 180, "text": "# Try with a string instead of list"}], "decorators": [], "definition_line": 175, "docstring": "Test get_scores with invalid input type", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_c6950747839e0f44a1718d30a8fbf2972015c14829514a62166177cf50c11f0d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 183, "line_start": 175, "name": "test_get_scores_with_invalid_type", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_get_scores_with_invalid_type", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_get_scores_with_invalid_type(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
