tion": null, "default": "'indptr.csc.index.npy'", "kind": "positional_or_keyword", "name": "indptr_name"}, {"annotation": null, "default": "'vocab.index.json'", "kind": "positional_or_keyword", "name": "vocab_name"}, {"annotation": null, "default": "'params.index.json'", "kind": "positional_or_keyword", "name": "params_name"}, {"annotation": null, "default": "'nonoccurrence_array.index.npy'", "kind": "positional_or_keyword", "name": "nnoc_name"}, {"annotation": null, "default": "'corpus.jsonl'", "kind": "positional_or_keyword", "name": "corpus_name"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "allow_pickle"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}], "path": "bm25s/__init__.py", "qualified_name": "BM25.save", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def save(self, save_dir, corpus=None, data_name='data.csc.index.npy', indices_name='indices.csc.index.npy', indptr_name='indptr.csc.index.npy', vocab_name='vocab.index.json', params_name='params.index.json', nnoc_name='nonoccurrence_array.index.npy', corpus_name='corpus.jsonl', allow_pickle=False, show_progress=True, leave_progress=False)", "source_id": "repo_source_8eb1f8d56c3a2f6aec5c33dcdfe9363289533bb4a91754a766f3a81c67b25ae4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
