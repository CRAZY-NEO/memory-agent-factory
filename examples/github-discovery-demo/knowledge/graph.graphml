      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_c_mmap_retrieve_with_numba(self):\n        # load the retriever from temp dir\n        retriever = bm25s.BM25.load(\n            self.tmpdirname,\n            data_name=\"data.index.csc.npy\",\n            indices_name=\"indices.index.csc.npy\",\n            indptr_name=\"indptr.index.csc.npy\",\n            vocab_name=\"vocab.json\",\n            nnoc_name=\"nonoccurrence_array.npy\",\n            params_name=\"params.json\",\n            load_corpus=True,\n            mmap=True,\n            auto_compile=False,\n        )\n        retriever.compile(activate_numba=True, warmup=False)\n\n        self.assertTrue(retriever.backend == \"numba\", \"The backend should be 'numba'\")\n\n        reloaded_corpus_text = [c[\"text\"] for c in retriever.corpus]\n        self.assertTrue(reloaded_corpus_text == self.corpus, \"The corpus should be the same as the original corpus\")\n\n        # now, let's retrieve the top-k results for a query\n        query = [\"my cat loves to purr\", \"a fish likes swimming\"]\n        query_tokens = bm25s.tokenize(query, stopwords=\"en\", stemmer=self.stemmer)\n        \n        # retrieve the top-k results\n        top_k = 2\n        retrieved = retriever.retrieve(query_tokens, k=top_k, return_as=\"tuple\")\n        retrieved_docs = retriever.retrieve(query_tokens, k=top_k, return_as=\"documents\")\n\n        # now, let's retrieve the top-k results for a query using numpy\n        retriever.backend = \"numpy\"\n        retrieved_np = retriever.retrieve(query_tokens, k=top_k, return_as=\"tuple\")\n        retrieved_docs_np = retriever.retrieve(query_tokens, k=top_k, return_as=\"documents\")\n        # assert that the results are the same\n        self.assertTrue(np.all(retrieved.scores == retrieved_np.scores), \"The retrieved scores should be the same\")\n        self.assertTrue(np.all(retrieved.documents == retrieved_np.documents), \"The retrieved documents should be the same\")\n        self.assertTrue(np.all(retrieved_docs == retrieved_docs_np), \"The results should be the same\")\n", "code_sha256": "5f31c508d6674c0e4a436ea987a78ebb180e1efb1aeb0afdec245780d61f5853", "comments": [{"line": 107, "text": "# finally, check when it's loaded with mmap"}, {"line": 109, "text": "# load the retriever from temp dir"}, {"line": 129, "text": "# now, let's retrieve the top-k results for a query"}, {"line": 133, "text": "# retrieve the top-k results"}, {"line": 138, "text": "# now, let's retrieve the top-k results for a query using numpy"}, {"line": 142, "text": "# assert that the results are the same"}], "decorators": [], "definition_line": 108, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "73298969a0628fccdf9af5cde6e7a7c3335a4d3b93692e5f372b8270867b78e9", "id": "code_candidate_81f6fa17f90c58458741f8f31eb0baef90e3e54a594907f0299061dee8592b7a", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 8, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 145, "line_start": 108, "name": "test_c_mmap_retrieve_with_numba", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/numba/test_numba_backend_retrieve.py", "qualified_name": "TestNumbaBacken