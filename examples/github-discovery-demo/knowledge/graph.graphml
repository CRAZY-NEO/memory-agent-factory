    <node id="code_candidate_cf51859cb51cda26fc0a5282327bbfdecc14526244c72fb4b124a905844baf78">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def save_stopwords(self, save_dir: str, stopwords_name: str = \"stopwords.tokenizer.json\"):\n        \"\"\"\n        Save the stopwords to a file. The file is saved in JSON format.\n\n        Parameters\n        ----------\n        save_dir : str\n            The directory where the stopwords file is saved.\n        \n        stopwords_name : str, optional\n            The name of the stopwords file. Default is \"stopwords.tokenizer.json\".\n        \"\"\"\n        save_dir: Path = Path(save_dir)\n        path = save_dir / stopwords_name\n\n        save_dir.mkdir(parents=True, exist_ok=True)\n        with open(path, \"w\", encoding='utf-8') as f:\n            f.write(json_functions.dumps(self.stopwords))\n", "code_sha256": "482796aa9abb3efabd27765aff2f2093af2499d7c68c9f961d7d781c696d6c1a", "comments": [], "decorators": [], "definition_line": 238, "docstring": "\n        Save the stopwords to a file. The file is saved in JSON format.\n\n        Parameters\n        ----------\n        save_dir : str\n            The directory where the stopwords file is saved.\n        \n        stopwords_name : str, optional\n            The name of the stopwords file. Default is \"stopwords.tokenizer.json\".\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_cf51859cb51cda26fc0a5282327bbfdecc14526244c72fb4b124a905844baf78", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "le