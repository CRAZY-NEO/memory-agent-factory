    <node id="code_candidate_9bc5e8d2bb2f550c2bac3c82a47231da5c0ba2447a26ef6a700c53316e817cd7">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        np.random.seed(42)\n        self.k = 5\n        self.scores = np.random.uniform(-10, 10, 2000)\n        self.expected_scores = np.sort(self.scores)[-self.k:][::-1]\n        self.expected_indices = np.argsort(self.scores)[-self.k:][::-1]\n", "code_sha256": "7cc17233afcb8d62a54b5fe62ce6e4ab1863614ba454e0613da05839295d4583", "comments": [], "decorators": [], "definition_line": 17, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "d3edf322f0f6a98845031102b759253f4a38ea8f7bced4d14206cd4b498500ed", "id": "code_candidate_9bc5e8d2bb2f550c2bac3c82a47231da5c0ba2447a26ef6a700c53316e817cd7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.numba.selection", "name": "topk"}], "kind": "method", "line_end": 22, "line_start": 17, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/numba/test_topk_numba.py", "qualified_name": "TestTopKSingleQuery.setUp", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_96e34f39921b537a86bcc7eaa31a11534437912859ddaa910322b9bb7c3fbcfe", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
