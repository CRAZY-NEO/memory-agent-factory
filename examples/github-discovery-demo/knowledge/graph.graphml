    <node id="code_candidate_cd62b4769422dc33c2a8732de0af39f538c458d93e30d863cada80536dd6e085">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_loads_function(self):\n        \"\"\"Test loads function\"\"\"\n        json_str = '{\"key\": \"value\", \"number\": 42}'\n        result = json_functions.loads(json_str)\n        self.assertIsInstance(result, dict)\n        self.assertEqual(result[\"key\"], \"value\")\n        self.assertEqual(result[\"number\"], 42)\n", "code_sha256": "f5b7a8fec16f12ae0e7b138c2a541eb963b598369d707e302c39cd533219c79c", "comments": [], "decorators": [], "definition_line": 45, "docstring": "Test loads function", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_cd62b4769422dc33c2a8732de0af39f538c458d93e30d863cada80536dd6e085", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 51, "line_start": 45, "name": "test_loads_function", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_loads_function", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_loads_function(self)", "source_id": "repo_source_4984691608886d7ad2efe38d4ace55d30ada338a0e182157102471e62e25548f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
