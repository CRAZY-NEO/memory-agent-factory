    <node id="code_candidate_39ca2dbcf47ca17dda3e3ce225aa2bf9739ea040ba955001025225c9daf6ac83">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_git(package_dir):\n    exact_tag = _git_describe(package_dir, \"--exact-match\")\n    if exact_tag:\n        return _normalize_version(exact_tag)\n\n    description = _git_describe(package_dir, \"--long\")\n    if not description:\n        return None\n\n    match = re.match(r\"(.+)-(\\d+)-g([0-9a-f]+)$\", description)\n    if not match:\n        return None\n\n    tag, distance, sha = match.groups()\n    version = _normalize_version(tag)\n    if distance == \"0\":\n        return version\n\n    suffix = \".dev\" if \".post\" in version else \".post\"\n    return f\"{version}{suffix}{distance}+g{sha}\"\n", "code_sha256": "a355c46b32cc59a908d9f87f4a7a812f19fa29887a9d196d18091c08f4daa475", "comments": [], "decorators": [], "definition_line": 72, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_39ca2dbcf47ca17dda3e3ce225aa2bf9739ea040ba955001025225c9daf6ac83", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 91, "line_start": 72, "name": "_version_from_git", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "setup.py", "qualified_name": "_version_from_git", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _version_from_git(package_dir)", "source_id": "repo_source_0d1f311b51d0d09ed327befd6df90b17c01d1bb753011e01353c1c098b4f217d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
