    <node id="code_candidate_fa315fd9d01343e5a2b44dac6936adae2abeb8d7dea41ecf049e999f81aee941">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def build_index_from_tokens(\n        self, corpus_tokens, show_progress=True, leave_progress=False\n    ):\n        \"\"\"\n        Low-level function to build the BM25 index from tokens, used by the `index` method.\n        You can override this function if you want to build the index in a different way.\n        \"\"\"\n        unique_tokens = get_unique_tokens(\n            corpus_tokens,\n            show_progress=show_progress,\n            leave_progress=leave_progress,\n            desc=\"BM25S Create Vocab\",\n        )\n        vocab_dict = {token: i for i, token in enumerate(unique_tokens)}\n        unique_token_ids = [vocab_dict[token] for token in unique_tokens]\n\n        corpus_token_ids = [\n            [vocab_dict[token] for token in tokens]\n            for tokens in tqdm(\n                corpus_tokens,\n                desc=\"BM25S Convert tokens to indices\",\n                leave=leave_progress,\n                disable=not show_progress,\n            )\n        ]\n\n        scores = self.build_index_from_ids(\n            unique_token_ids=unique_token_ids,\n            corpus_token_ids=corpus_token_ids,\n            show_progress=show_progress,\n            leave_progress=leave_progress,\n        )\n\n        return scores, vocab_dict\n", "code_sha256": "ad58c03bfc6a981c5c593401d632b6ffc2f9f31350eb308723eb7d2773995c5e", "comments": [], "decorators": [], "definition_line": 440, "docstring": "\n        Low-level function to build the BM25 index from tokens, used by the `index` method.\n        You can override this function if you want to build the index in a different way.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_fa315fd9d01343e5a2b44dac6936adae2abeb8d7dea41ecf049e999f81aee94