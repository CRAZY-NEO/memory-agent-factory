    <node id="code_candidate_2e59bebbe754d92581b6b17285f499d93586c6d6b5390ab5cdeb6b54cc4a81eb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_with_stopwords(self):\n        \"\"\"Tests the `tokenize` method and `__init__` method with stopwords filtering.\"\"\"\n        stopwords = [\"is\", \"a\", \"for\"]\n        tokenizer = Tokenizer(stopwords=stopwords, stemmer=self.stemmer)\n        result = tokenizer.tokenize(self.corpus, update_vocab=True, return_as=\"string\", show_progress=False)\n        for doc in result:\n            for token in doc:\n                self.assertNotIn(token, stopwords)\n", "code_sha256": "4873ab596db00a6a031de224247e92a23840ab2a0d97ca095fb811e7b06af91d", "comments": [], "decorators": [], "definition_line": 57, "docstring": "Tests the `tokenize` method and `__init__` method with stopwords filtering.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_2e59bebbe754d92581b6b17285f499d93586c6d6b5390ab5cdeb6b54cc4a81eb", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 64, "line_start": 57, "name": "test_tokenize_with_stopwords", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/co