      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_getitem_int(self):\n        \"\"\"Test JsonlCorpus __getitem__ with int index\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False)\n        \n        # Get first item\n        item = corpus[0]\n        self.assertEqual(item[\"id\"], 0)\n        self.assertEqual(item[\"text\"], \"first document\")\n        \n        # Get third item\n        item = corpus[2]\n        self.assertEqual(item[\"id\"], 2)\n        \n        corpus.close()\n", "code_sha256": "0d720729d72e61f4a10e28301cd4c3870faff4fb3ea58d73fa01d395871e64c4", "comments": [{"line": 177, "text": "# Get first item"}, {"line": 182, "text": "# Get third item"}], "decorators": [], "definition_line": 173, "docstring": "Test JsonlCorpus __getitem__ with int index", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_2578911287c64322ac6fe7e58bd97bf4078116d723d8ad66018f5d372d48c1e8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmin