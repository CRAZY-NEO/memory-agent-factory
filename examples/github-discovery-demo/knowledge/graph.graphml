      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef heap_pop(values, indices, length):\n    return_value = values[0]\n    return_index = indices[0]\n    last_value = values[length - 1]\n    last_index = indices[length - 1]\n    values[0] = last_value\n    indices[0] = last_index\n    sift_up(values, indices, 0, length - 1)\n    return return_value, return_index\n", "code_sha256": "7c49d13a707d4e7e3b97311f7393367dd9fe245a74faeaf9a0ac27edcbf0eb5e", "comments": [], "decorators": ["njit(nogil=True)"], "definition_line": 75, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_57f75428038c8a3d8f6d9823b0e6095e68e70c7b30bdb5a18c135106b53f0bac", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 83, "line_start": 74, "name": "heap_pop", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "values"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "length"}], "path": "bm25s/numba/selection.py", "qualified_name": "heap_pop", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def heap_pop(values, indices, length)", "source_id": "repo_source_fe79b4a0e95dc30caa0268cb9c9c83acfa0f516285fcb809326d026e57a94e2b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
