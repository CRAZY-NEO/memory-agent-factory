    <node id="code_candidate_4b001ca441695ee71ec8fd3f1c2fd994f633521049da245dca4771c4886f9f06">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_dumps_function(self):\n        \"\"\"Test dumps function (uses orjson if available, else builtin)\"\"\"\n        data = {\"test\": \"data\", \"num\": 123}\n        result = json_functions.dumps(data)\n        self.assertIsInstance(result, str)\n        \n        # Should be able to load it back\n        loaded = json_functions.loads(result)\n        self.assertEqual(loaded[\"test\"], \"data\")\n        self.assertEqual(loaded[\"num\"], 123)\n", "code_sha256": "07f559bf6bce3edd8292246940d8d69d6a5757ec79021c5802c2e3f408c0090b", "comments": [{"line": 28, "text": "# Should be able to load it back"}], "decorators": [], "definition_line": 22, "docstring": "Test dumps function (uses orjson if available, else builtin)", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_4b001ca441695ee71ec8fd3f1c2fd994f633521049da245dca4771c4886f9f06", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 31, "line_start": 22, "name": "test_dumps_function", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_dumps_function", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_dumps_function(self)", "source_id": "repo_source_4984691608886d7ad2efe38d4ace55d30ada338a0e182157102471e62e25548f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
