itional_or_keyword", "name": "vocab"}], "path": "tests/comparison/test_bm25s_indexing.py", "qualified_name": "BM25SIndexing.test_indexing_by_corpus_type.&lt;locals&gt;.Tokenized.__init__", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def __init__(self, ids, vocab)", "source_id": "repo_source_a0c7e92ca08e22165a378874b1b56c0d2762d507fac7b175365998241338c0d1", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
