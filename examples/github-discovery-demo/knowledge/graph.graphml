      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def download_file(src_url, dst_path, desc):\n        pbar = tqdm(\n            unit=\"B\",\n            unit_scale=True,\n            desc=desc,\n            leave=leave_progress,\n            disable=not show_progress,\n        )\n        with open(dst_path, \"wb\") as f:\n            response = urllib.request.urlopen(src_url)\n            total_size = int(response.headers.get(\"content-length\", 0))\n            block_size = 8192 * 2\n            pbar.total = total_size\n            while True:\n                buffer = response.read(block_size)\n                if not buffer:\n                    break\n                f.write(buffer)\n                pbar.update(len(buffer))\n\n        pbar.close()\n", "code_sha256": "8332442691f54a6ba88cee56115350a6d7eec465cf663f10de3d53ed867ede88", "comments": [], "decorators": [], "definition_line": 149, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_bd767dd90e9f55ad2ec67746ca25530e69caaf6a589ec1da45366820a6cba5e7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 169, "line_start": 149, "name": "download_file", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "src_url"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dst_path"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "desc"}], "path": "bm25s/utils/beir.py", "qualified_name": "download_dataset.&lt;locals&gt;.download_file", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def download_file(src_url, dst_path, desc)", "source_id": "repo_source_77ca391adf493104c5b8e45f605714d19238af83005c86fcfe57f52fd5d17419", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
