    <node id="code_candidate_4c7567e18a1648c248ec43cb10d11f7c96862fa52fa6952e6da906ea94df7158">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_pkg_info(package_dir):\n    pkg_info = package_dir / \"PKG-INFO\"\n    if not pkg_info.exists():\n        return None\n\n    for line in pkg_info.read_text(encoding=\"utf8\").splitlines():\n        if line.startswith(\"Version:\"):\n            return _normalize_version(line.partition(\":\")[2])\n\n    return None\n", "code_sha256": "0f37358ffbdb2f78fbbcea4a5799a408f17b5c904b2bf3dd951a70b29fe1c888", "comments": [], "decorators": [], "definition_line": 39, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_4c7567e18a1648c248ec43cb10d11f7c96862fa52fa6952e6da906ea94df7158", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 48, "line_start": 39, "name": "_version_from_pkg_info", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "setup.py", "qualified_name": "_version_from_pkg_info", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _version_from_pkg_info(package_dir)", "source_id": "repo_source_0d1f311b51d0d09ed327befd6df90b17c01d1bb753011e01353c1c098b4f217d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
