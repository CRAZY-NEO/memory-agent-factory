    <node id="code_candidate_9bfe8af55c7a24c6585a31895b5ce3bd203c956a6ce46667eed22bd81ff8b28f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenizer_update_vocab_if_empty_with_existing_vocab(self):\n        \"\"\"Test tokenizer with update_vocab='if_empty' when vocab exists\"\"\"\n        tokenizer = Tokenizer()\n        # Pre-populate vocab\n        tokenizer.word_to_id = {\"hello\": 0}\n        \n        texts = [\"hello world\"]\n        tokenizer.tokenize(texts, update_vocab=\"if_empty\", return_as=\"ids\")\n        \n        # Should NOT have updated vocab with 'world'\n        self.assertEqual(len(tokenizer.word_to_id), 1)\n", "code_sha256": "f56f6774fbc439b89778612b46448ccd7f5b53c2965a337c06340d487a919651", "comments": [{"line": 82, "text": "# Pre-populate vocab"}, {"line": 88, "text": "# Should NOT have updated vocab with 'world'"}], "decorators": [], "definition_line": 79, "docstring": "Test tokenizer with update_vocab='if_empty' when vocab exists", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_9bfe8af55c7a24c6585a31895b5ce3bd203c956a6ce46667eed22bd81ff8b28f", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 89, "line_start": 79, "name": "test_tokenizer_update_vocab_if_empty_with_existing_vocab", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenizer_update_vocab_if_empty_with_existing_vocab", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_tokenizer_update_vocab_if_empty_with_existing_vocab(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
