      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_getitem_list(self):\n        \"\"\"Test JsonlCorpus __getitem__ with list of indices\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False)\n        \n        # Get list of indices\n        items = corpus[[0, 2, 4]]\n        self.assertEqual(len(items), 3)\n        self.assertEqual(items[0][\"id\"], 0)\n        self.assertEqual(items[1][\"id\"], 2)\n        self.assertEqual(items[2][\"id\"], 4)\n        \n        corpus.close()\n", "code_sha256": "0706b1165b11da5950d312a74013716c50d4c4f124c6cfd5b431c8ae66ed5c70", "comments": [{"line": 204, "text": "# Get list of indices"}], "decorators": [], "definition_line": 200, "docstring": "Test JsonlCorpus __getitem__ with list of indices", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_92fc6fe1284577fd3007572587cc5d415e24c4c15382ad13f4766a3177c09561", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "lin