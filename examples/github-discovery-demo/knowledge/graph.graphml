    <node id="code_candidate_30bef4c9a9e9ff857ea81fc42662a11886519f0b61e465d809437f2f72fdfbc0">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        np.random.seed(42)\n        self.k = 5\n        self.scores = np.random.uniform(-10, 10, 2000)\n        self.expected_scores = np.sort(self.scores)[-self.k:][::-1]\n        self.expected_indices = np.argsort(self.scores)[-self.k:][::-1]\n", "code_sha256": "7cc17233afcb8d62a54b5fe62ce6e4ab1863614ba454e0613da05839295d4583", "comments": [], "decorators": [], "definition_line": 17, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4e6fe4c42ffcc02b2eba717ac7e1ebacb1d7f64f561ecd9bad0fa3e71b47f4fb", "id": "code_candidate_30bef4c9a9e9ff857ea81fc42662a11886519f0b61e465d809437f2f72fdfbc0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.selection", "name": "topk"}], "kind": "method", "line_end": 22, "line_start": 17, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_topk.py", "qualified_name": "TestTopKSingleQuery.setUp", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_f170fde293ed6d8972fe591f8d0f01150ec7c1db1d99a8a1b4550bf94b512791", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
