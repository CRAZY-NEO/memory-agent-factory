    <node id="code_candidate_6040d67ecd2304b92b1722164d025605663488f49fa93edab597ab0df83a83d7">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @staticmethod\n    def _compute_relevance_from_scores(\n        data: np.ndarray,\n        indptr: np.ndarray,\n        indices: np.ndarray,\n        num_docs: int,\n        query_tokens_ids: np.ndarray,\n        dtype: np.dtype,\n    ) -&gt; np.ndarray:\n        \"\"\"\n        This internal static function calculates the relevance scores for a given query,\n        by using the BM25 scores that have been precomputed in the BM25 eager index.\n        It is used by the `get_scores_from_ids` method, which makes use of the precomputed\n        scores assigned as attributes of the BM25 object.\n\n        Parameters\n        ----------\n        data (np.ndarray)\n            Data array of the BM25 index.\n        indptr (np.ndarray)\n            Index pointer array of the BM25 index.\n        indices (np.ndarray)\n            Indices array of the BM25 index.\n        num_docs (int)\n            Number of documents in the BM25 index.\n        query_tokens_ids (np.ndarray)\n            Array of token IDs to score.\n        dtype (np.dtype)\n            Data type for score calculation.\n\n        Returns\n        -------\n        np.ndarray\n            Array of BM25 relevance scores for a given query.\n\n        Note\n        ----\n        This function was optimized by the baguetter library. The original implementation can be found at:\n        https://github.com/mixedbread-ai/baguetter/blob/main/baguetter/indices/sparse/models/bm25/index.py\n        \"\"\"\n        indptr_starts = indptr[query_tokens_ids]\n        indptr_ends = indptr[query_tokens_ids + 1]\n\n        scores = np.zeros(num_docs, dtype=dtype)\n        for i in range(len(query_tokens_ids)):\n            start, end = indptr_starts[i], indptr_ends[i]\n            np.add.at(scores, indices[start:end], data[start:end])\n\n            # # The following code is slower with numpy, but faster after JIT compilation\n            # for j in range(start, end):\n            #     scores[indices[j]] += data[j]\n\n        return scores\n", "code_sha256": "cebdfc09f4c1988a69ed047130a095d20e98fbccf2f40f46bb279de4d84900b7", "comments": [{"line": 320, "text": "# # The following code is slower with numpy, but faster after JIT compilation"}, {"line": 321, "text": "# for j in range(start, end):"}, {"line": 322, "text": "#     scores[indices[j]] += data[j]"}], "decorators": ["staticmethod"], "definition_line": 273, "docstring": "\n        This internal static function calculates the relevance scores for a given query,\n        by using the BM25 scores that have been precomputed in the BM25 eager index.\n        It is used by the `get_scores_from_ids` method, which makes use of the precomputed\n        scores assigned as attributes of the BM25 object.\n\n        Parameters\n        ----------\n        data (np.ndarray)\n            Data array of the BM25 index.\n        indptr (np.ndarray)\n            Index pointer array of the BM25 index.\n        indices (np.ndarray)\n            Indices array of the BM25 index.\n        num_docs (int)\n            Number of documents in the BM25 index.\n        query_tokens_ids (np.ndarray)\n            Array of token IDs to score.\n        dtype (np.dtype)\n            Data type for score calculation.\n\n        Returns\n        -------\n        np.ndarray\n            Array of BM25 relevance scores for a given query.\n\n        Note\n        ----\n        This function was optimized by the baguetter library. The original implementation can be found at:\n        https://github.com/mixedbread-ai/baguetter/blob/main/baguetter/indices/sparse/models/bm25/index.py\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_6040d67ecd2304b92b1722164d025605663488f49fa93edab597ab0df83a83d7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Union"}, {"alias": "np", "level": 0, "line": 11, "module": "numpy", "name": null}, {"alias": "json_functions", "level": 1, "line": 13, "module": "utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "numba", "name": "njit"}, {"alias": "selection_jit", "level": 1, "line": 17, "module": "numba", "name": "selection"}, {"alias": "sp", "level": 0, "line": 23, "module": "scipy.sparse", "name": null}, {"alias": null, "level": 1, "line": 29, "module": "numba.retrieve_utils", "name": "_retrieve_numba_functional"}, {"alias": null, "level": 0, "line": 43, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "scoring"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "stopwords"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "tokenization"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "utils"}, {"alias": "selection_np", "level": 1, "line": 49, "module": null, "name": "selection"}, {"alias": null, "level": 1, "line": 50, "module": "version", "name": "__version__"}, {"alias": null, "level": 1, "line": 51, "module": "tokenization", "name": "tokenize"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_idf_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_nonoccurrence_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_scores_and_indices_for_matrix"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_calculate_doc_freqs"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_jit_ready"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_python"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_tfc_scorer"}, {"alias": null, "level": 0, "line": 1336, "module": "numba", "name": "njit"}, {"alias": null, "level": 1, "line": 1346, "module": "scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 1361, "module": "numba", "name": "njit"}], "kind": "method", "line_end": 324, "line_start": 272, "name": "_compute_relevance_from_scores", "parameters": [{"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indptr"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "num_docs"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "query_tokens_ids"}, {"annotation": "np.dtype", "default": null, "kind": "positional_or_keyword", "name": "dtype"}], "path": "bm25s/__init__.py", "qualified_name": "BM25._compute_relevance_from_scores", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "np.ndarray", "signature": "def _compute_relevance_from_scores(data: np.ndarray, indptr: np.ndarray, indices: np.ndarray, num_docs: int, query_tokens_ids: np.ndarray, dtype: np.dtype) -&gt; np.ndarray", "source_id": "repo_source_8eb1f8d56c3a2f6aec5c33dcdfe9363289533bb4a91754a766f3a81c67b25ae4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
