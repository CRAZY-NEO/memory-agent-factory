      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def show_all(self):\n        for name in self.results:\n            if self.has_stopped(name):\n                self.show(name)\n", "code_sha256": "aad5b005a3eecf0eec37991bf9c2ec66525ce1005ad0531e3f101274ff7a6afc", "comments": [], "decorators": [], "definition_line": 119, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_128fa3665f9f10dac2abf29628984447ed33a4bb214adee790ddaff5a9c6a367", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 122, "line_start": 119, "name": "show_all", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.show_all", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def show_all(self)", "source_id": "repo_source_43fd334d6b3ac591ecde766e3edc2ab0b85c456f8eece5f44d103b24d412ad90", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
