      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def create_test_index():\n    corpus = [\n        \"The quick brown fox jumps over the lazy dog\",\n        \"The quick brown fox jumps over the lazy dog\",\n        \"The quick brown fox jumps over the lazy dog\",\n        \"Hello world\",\n        \"This is a test document for bm25s mcp server\"\n    ]\n    \n    retriever = bm25s.BM25()\n    retriever.index(bm25s.tokenize(corpus))\n    \n    save_dir = \"test_index_mcp\"\n    retriever.save(save_dir, corpus=corpus)\n    print(f\"Index saved to {save_dir}\")\n", "code_sha256": "a27a4d6352bd66a5ec38e22ab6116727f478247469336a8d402a1690b1ae9fab", "comments": [], "decorators": [], "definition_line": 5, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "3fc3f494f8c2071905f5178b426d852d6088ade1acb37d991c7d0db19e263d3b", "id": "code_candidate_14ca52651f5ad72272da3b249f9b9cc7c54b6bf951a6d86277fc129f39bd003e", "imports": [{"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}], "kind": "function", "line_end": 19, "line_start": 5, "name": "create_test_index", "parameters": [], "path": "examples/mcp/create_index.py", "qualified_name": "create_test_index", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def create_test_index()", "source_id": "repo_source_dd7f3615b5d75c9bd80ce0f83fec90d6bdddaf637c2b272dc3e22ea063414b00", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
