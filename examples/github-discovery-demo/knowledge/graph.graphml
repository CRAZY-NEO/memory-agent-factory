      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_with_empty_vocab(self):\n        \"\"\"Tests the `tokenize` method with the `update_vocab=\"if_empty\"` parameter.\"\"\"\n        tokenizer = Tokenizer(stemmer=self.stemmer)\n        tokenizer.tokenize(self.corpus, update_vocab=\"if_empty\", show_progress=False)\n        vocab_size = len(tokenizer.get_vocab_dict())\n        self.assertGreater(vocab_size, 0)\n", "code_sha256": "37574de59a5f57b73b5ee023b3f73339781506f10bf9f72387ea8cf1042dabfc", "comments": [], "decorators": [], "definition_line": 83, "docstring": "Tests the `tokenize` method with the `update_vocab=\"if_empty\"` parameter.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_890c2b98752ea6535f19b8c7910d2f9f9e2c2cd4779dc707fffe2bc0944cfc12", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 88, "line_start": 83, "name": "test_tokenize_with_empty_vocab", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_tokenize_with_empty_vocab", "repository