    <node id="code_candidate_0df7920235b2dcc5e791512dc81dcb2a7160733910fd475fc0769930a4263f89">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def postprocess_results_for_eval(results, scores, query_ids):\n    \"\"\"\n    Given the queried results and scores output by BM25S, postprocess them\n    to be compatible with BEIR evaluation functions.\n    query_ids is a list of query ids in the same order as the results.\n    \"\"\"\n\n    results_record = [\n        {\"id\": qid, \"hits\": results[i], \"scores\": list(scores[i])}\n        for i, qid in enumerate(query_ids)\n    ]\n\n    result_dict_for_eval = {\n        res[\"id\"]: {\n            docid: float(score) for docid, score in zip(res[\"hits\"], res[\"scores\"])\n        }\n        for res in results_record\n    }\n\n    return result_dict_for_eval\n", "code_sha256": "48e88d8900f8ec2568a89b522b13ff020af51abd6ef0186d8d3e77888e40c477", "comments": [], "decorators": [], "definition_line": 29, "docstring": "\n    Given the queried results and scores output by BM25S, postprocess them\n    to be compatible with BEIR evaluation functions.\n    query_ids is a list of query ids in the same order as the results.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_0df7920235b2dcc5e791512dc81dcb2a7160733910fd475fc0769930a4263f89", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 48, "line_start": 29, "name": "postprocess_results_for_eval", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "results"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query_ids"}], "path": "bm25s/utils/beir.py", "qualified_name": "postprocess_results_for_eval", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def postprocess_results_for_eval(results, scores, query_ids)", "source_id": "repo_source_77ca391adf493104c5b8e45f605714d19238af83005c86fcfe57f52fd5d17419", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
