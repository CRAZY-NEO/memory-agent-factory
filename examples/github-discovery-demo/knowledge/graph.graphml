    <node id="code_candidate_6d93311800689c67a5ce90865947db94832d11f83af3be54f1e8a4c03f34f13d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _get_build_version(package_dir):\n    return (\n        _version_from_environment()\n        or _version_from_pkg_info(package_dir)\n        or _version_from_git(package_dir)\n        or \"0.0.0\"\n    )\n", "code_sha256": "736fa4db4a047606223c41a13c00581c238983de7724f46c32f2b8dee7a3dfb9", "comments": [], "decorators": [], "definition_line": 97, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_6d93311800689c67a5ce90865947db94832d11f83af3be54f1e8a4c03f34f13d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 103, "line_start": 97, "name": "_get_build_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_get_build_version", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _get_build_version(package_dir)", "source_id": "repo_source_e5fc7c562f0444f38f1579ffd481649872143a2e16ecd1931db291ef5c679eef", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
