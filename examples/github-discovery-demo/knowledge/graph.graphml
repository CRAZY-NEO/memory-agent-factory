      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef heap_push(values, indices, value, index, length):\n    values[length] = value\n    indices[length] = index\n    sift_down(values, indices, 0, length)\n", "code_sha256": "9c6562fb45f979fd20088c09fa0439e9c4b2fb17f840adbbf7e4e710b6aa2c42", "comments": [], "decorators": ["njit(nogil=True)"], "definition_line": 68, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_a496e3546954b6b2843ad3d5a0edb63c5bcba15ac66c7a443f3aedfec8033712", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 71, "line_start": 67, "name": "heap_push", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "values"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "value"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "index"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "length"}], "path": "bm25s/numba/selection.py", "qualified_name": "heap_push", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def heap_push(values, indices, value, index, length)", "source_id": "repo_source_fe79b4a0e95dc30caa0268cb9c9c83acfa0f516285fcb809326d026e57a94e2b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
