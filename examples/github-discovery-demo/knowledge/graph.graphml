, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "method", "line_end": 511, "line_start": 493, "name": "decode", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[List[int]]", "default": null, "kind": "positional_or_keyword", "name": "docs"}], "path": "bm25s/tokenization.py", "qualified_name": "Tokenizer.decode", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "List[List[str]]", "signature": "def decode(self, docs: List[List[int]]) -&gt; List[List[str]]", "source_id": "repo_source_36f95b7073422ec39462657e59cf575ac2ab039132824d11ee0768e259ce5bbf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
