    <node id="code_candidate_0dfd32cbadc7871f92fd4d7910a94f021827dee1297a3118f6adc33e2c2093f1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        np.random.seed(42)\n        self.k = 5\n        self.scores = np.random.uniform(-10, 10, 2000)\n        self.expected_scores = np.sort(self.scores)[-self.k:][::-1]\n        self.expected_indices = np.argsort(self.scores)[-self.k:][::-1]\n", "code_sha256": "7cc17233afcb8d62a54b5fe62ce6e4ab1863614ba454e0613da05839295d4583", "comments": [], "decorators": [], "definition_line": 17, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "d3edf322f0f6a98845031102b759253f4a38ea8f7bced4d14206cd4b498500ed", "id": "code_candidate_0dfd32cbadc7871f92fd4d7910a94f021827dee1297a3118f6adc33e2c2093f1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.numba.selection", "name": "topk"}], "kind": "method", "line_end": 22, "line_start": 17, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/numba/test_topk_numba.py", "qualified_name": "TestTopKSingleQuery.setUp", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_184f06935512100417aad557b03cf189700ff4a12937593bb981ebe64454f785", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_769c8d8c59cd21b7e541d429595e09fc85f9d6e0f4bd609e2310fd25c827d8b6">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def check_results(self, result_scores, result_indices, sorted=True):\n        if sorted:\n            np.testing.assert_allclose(result_scores, self.expected_scores)\n            np.testing.assert_array_equal(result_indices, self.expected_indices)\n        else:\n            self.assertEqual(len(result_scores), self.k)\n            self.assertEqual(len(result_indices), self.k)\n            self.assertTrue(np.all(np.isin(result_scores, self.expected_scores)))\n            self.assertTrue(np.all(np.isin(result_indices, self.expected_indices)))\n", "code_sha256": "b80fb72e580830f8876bce913f859c57d1d5bfbf670922083953661ed76e4055", "comments": [], "decorators": [], "definition_line": 24, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "d3edf322f0f6a98845031102b759253f4a38ea8f7bced4d14206cd4b498500ed", "id": "code_candidate_769c8d8c59cd21b7e541d429595e09fc85f9d6e0f4bd609e2310fd25c827d8b6", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.numba.selection", "name": "topk"}], "kind": "method", "line_end": 32, "line_start": 24, "name": "check_results", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_indices"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "tests/numba/test_topk_numba.py", "qualified_name": "TestTopKSingleQuery.check_results", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def check_results(self, result_scores, result_indices, sorted=True)", "source_id": "repo_source_184f06935512100417aad557b03cf189700ff4a12937593bb981ebe64454f785", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
