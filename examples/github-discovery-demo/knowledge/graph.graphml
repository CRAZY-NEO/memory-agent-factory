": "False", "kind": "positional_or_keyword", "name": "warmup"}], "path": "bm25s/__init__.py", "qualified_name": "BM25.compile", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def compile(self, activate_numba=True, warmup=False)", "source_id": "repo_source_8eb1f8d56c3a2f6aec5c33dcdfe9363289533bb4a91754a766f3a81c67b25ae4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
