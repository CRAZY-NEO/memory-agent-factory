    <node id="code_candidate_8c9b2ee0e0c4a233362dbe0c7516a346c76aa03436f865dffc762d4c5ba5cf22">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _compute_relevance_from_scores_jit_ready(\n    data: np.ndarray,\n    indptr: np.ndarray,\n    indices: np.ndarray,\n    num_docs: int,\n    query_tokens_ids: np.ndarray,\n    dtype: np.dtype,\n) -&gt; np.ndarray:\n    \"\"\"\n    This internal static function calculates the relevance scores for a given query,\n    by using the BM25 scores that have been precomputed in the BM25 eager index.\n    This version is ready for JIT compilation with numba, but is slow if not compiled.\n    \"\"\"\n    indptr_starts = indptr[query_tokens_ids]\n    indptr_ends = indptr[query_tokens_ids + 1]\n\n    scores = np.zeros(num_docs, dtype=dtype)\n    for i in range(len(query_tokens_ids)):\n        start, end = indptr_starts[i], indptr_ends[i]\n        # The following code is slower with numpy, but faster after JIT compilation\n        for j in range(start, end):\n            scores[indices[j]] += data[j]\n\n    return scores\n", "code_sha256": "077c31865adc4e66bc3bc5332738e1d3164f50a2ee93c981bc1a2b566d751778", "comments": [{"line": 364, "text": "# The following code is slower with numpy, but faster after JIT compilation"}], "decorators": [], "definition_line": 345, "docstring": "\n    This internal static function calculates the relevance scores for a given query,\n    by using the BM25 scores that have been precomputed in the BM25 eager index.\n    This version is ready for JIT compilation with numba, but is slow if not compiled.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_8c9b2ee0e0c4a233362dbe0c7516a346c76aa03436f865dffc762d4c5ba5cf22", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 368, "line_start": 345, "name": "_compute_relevance_from_scores_jit_ready", "parameters": [{"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indptr"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "num_docs"}, {"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "query_tokens_ids"}, {"annotation": "np.dtype", "default": null, "kind": "positional_or_keyword", "name": "dtype"}], "path": "bm25s/scoring.py", "qualified_name": "_compute_relevance_from_scores_jit_ready", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "np.ndarray", "signature": "def _compute_relevance_from_scores_jit_ready(data: np.ndarray, indptr: np.ndarray, indices: np.ndarray, num_docs: int, query_tokens_ids: np.ndarray, dtype: np.dtype) -&gt; np.ndarray", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
