      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_corpus_object_with_object(self):\n        \"\"\"Test _infer_corpus_object with object having ids and vocab\"\"\"\n        class MockCorpus:\n            def __init__(self):\n                self.ids = [[0, 1], [2, 3]]\n                self.vocab = {\"a\": 0, \"b\": 1, \"c\": 2, \"d\": 3}\n        \n        result = BM25._infer_corpus_object(MockCorpus())\n        self.assertEqual(result, \"object\")\n", "code_sha256": "b9b6ab36fec85e1ab5ee8e6403f7516aaf486293fbfc089768d8b890cf1dcfed", "comments": [], "decorators": [], "definition_line": 51, "docstring": "Test _infer_corpus_object with object having ids and vocab", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_2b16f3b0612e671778ea3e32c2d9efcd495f75e903e438995044b16c49a5be80", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 59, "line_start": 51, "name": "test_infer_corpus_object_with_object", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_infer_corpus_obje