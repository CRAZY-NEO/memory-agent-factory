      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_txt(self):\n        corpus = bm25_hl.load(self.txt_path)\n        self.assertEqual(len(corpus), 3)\n        self.assertEqual(corpus[0], \"hello world\")\n        \n        retriever = bm25_hl.index(corpus)\n        results = retriever.search([\"test\"], k=1)\n        self.assertEqual(len(results[0]), 1)\n        self.assertIn(\"test\", results[0][0][\"document\"])\n        self.assertIsInstance(results[0][0][\"score\"], float)\n        self.assertIsInstance(results[0][0][\"id\"], int)\n", "code_sha256": "ce787ed7b7f003a119dc1f3afd1f829c16f6b39567aad4d457d4830922aeefd1", "comments": [], "decorators": [], "definition_line": 56, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "f2daa5e229dd85f66a35367fe63f1cd17e43e18b4276f4497845cbb313d18617", "id": "code_candidate_c8c50f99bfe0be7f0afa92b013baf52bc9effbf09442665cb8525b2d297d2b2d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": "bm25_hl", "level": 0, "line": 7, "module": "bm25s.high_level", "name": null}], "kind": "method", "line_end": 66, "line_start": 56, "name": "test_load_txt", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/high_level/test_high_level.py", "qualified_name": "TestHighLevel.test_load_txt", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_load_txt(s