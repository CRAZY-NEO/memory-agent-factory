    <node id="code_candidate_4289fbc16c8c5a24e72f0b0f3c6ff20c9d37c0298548c66820808c663dff0080">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve(self):\n        ground_truth = np.array([[0, 2]])\n\n        # first, try with default mode\n        query = \"a cat is a feline, it's sometimes beautiful but cannot fly\"\n        query_tokens_obj = bm25s.tokenize([query], stopwords=\"en\", stemmer=self.stemmer, return_ids=True)\n\n        # retrieve the top 2 documents\n        results = self.retriever.retrieve(query_tokens_obj, k=2).documents\n        \n        # assert that the retrieved indices are correct\n        self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n\n        # now, try tokenizing with text tokens\n        query_tokens_texts = bm25s.tokenize([query], stopwords=\"en\", stemmer=self.stemmer, return_ids=False)\n        results = self.retriever.retrieve(query_tokens_texts, k=2).documents\n        self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n\n        # now, try to pass a tuple of tokens\n        ids, vocab = query_tokens_obj\n        query_tokens_tuple = (ids, vocab)\n        results = self.retriever.retrieve(query_tokens_tuple, k=2).documents\n        self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n\n        # finally, try to pass a 2-tuple of tokens with text tokens to \"try to trick the system\"\n        queries_as_tuple = (query_tokens_texts[0], query_tokens_texts[0])\n        # only retrieve 1 document\n        ground_truth = np.array([[0], [0]])\n        results = self.retriever.retrieve(queries_as_tuple, k=1).documents\n        self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n", "code_sha256": "96474fd679bd731b13bdad549fa54a024d8fc6e2901fa37eb70e3c0c4d373da8", "comments": [{"line": 42, "text": "# first, try with default mode"}, {"line": 46, "text": "# retrieve the top 2 documents"}, {"line": 49, "text": "# assert that the retrieved indices are correct"}, {"line": 52, "text": "# now, try tokenizing with text tokens"}, {"line": 57, "text": "# now, try to pass a tuple of tokens"}, {"line": 63, "text": "# finally, try to pass a 2-tuple of tokens with text tokens to \"try to trick the system\""}, {"line": 65, "text": "# only retrieve 1 document"}], "decorators": [], "definition_line": 39, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5718fb93b60a5492163f5d29f31e473256f4b83dc609b998383a179f58528a5b", "id": "code_candidate_4289fbc16c8c5a24e72f0b0f3c6ff20c9d37c0298548c66820808c663dff0080", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 68, "line_start": 39, "name": "test_retrieve", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_retrieve.py", "qualified_name": "TestBM25SLoadingSaving.test_retrieve", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_retrieve(self)", "source_id": "repo_source_273db63b44f0d37acf60819b83caaec5139877aebd8cd52f7099a1d207fba506", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_2c09b801a24fa17e9441e7a108a5a6e3329a61d0f302fd9391bb4d29b418e4de">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_different_return_types(self):\n        queries = [\n            \"a cat is a feline, it's sometimes beautiful but cannot fly\",\n            \"a dog is the human's best friend and loves to play\"\n        ]\n        for method in ['bm25+', 'lucene', 'bm25l', 'atire', 'robertson']:\n            all_docs = []\n            all_scores = []\n            for return_type in ['ids', 'tuple', 'string']:\n                tokenizer = bm25s.tokenization.Tokenizer(lower=True,stopwords=\"en\", stemmer=self.stemmer)\n                corpus_tokens = tokenizer.tokenize(self.corpus, return_as=return_type, show_progress=False, allow_empty=True)\n                query_tokens = tokenizer.tokenize(queries, return_as=return_type, show_progress=False, allow_empty=True)\n                # Create the BM25 model and index the corpus\n                retriever = bm25s.BM25(method=method)\n                retriever.index(corpus_tokens)\n\n                docs, scores = retriever.retrieve(query_tokens, k=2, sorted=False)\n                all_docs.append(docs)\n                all_scores.append(scores)\n            \n            # Check if the results are the same for both return types\n            for doc in all_docs[1:]:\n                self.assertTrue(np.array_equal(all_docs[0], doc), f\"Expected {all_docs[0]}, got {doc}\")\n            # Check if the scores are the same for both return types\n            for score in all_scores[1:]:\n                self.assertTrue(np.array_equal(all_scores[0], score), f\"Expected {all_scores[0]}, got {score}\")\n", "code_sha256": "2f3d7452e1beece6dd4e61045b8898b699df0087e8fe57905fc419e5fbf32af8", "comments": [{"line": 82, "text": "# Create the BM25 model and index the corpus"}, {"line": 90, "text": "# Check if the results are the same for both return types"}, {"line": 93, "text": "# Check if the scores are the same for both return types"}], "decorators": [], "definition_line": 70, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5718fb93b60a5492163f5d29f31e473256f4b83dc609b998383a179f58528a5b", "id": "code_candidate_2c09b801a24fa17e9441e7a108a5a6e3329a61d0f302fd9391bb4d29b418e4de", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 95, "line_start": 70, "name": "test_retrieve_with_different_return_types", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_retrieve.py", "qualified_name": "TestBM25SLoadingSaving.test_retrieve_with_different_return_types", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_retrieve_with_different_return_types(self)", "source_id": "repo_source_273db63b44f0d37acf60819b83caaec5139877aebd8cd52f7099a1d207fba506", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
