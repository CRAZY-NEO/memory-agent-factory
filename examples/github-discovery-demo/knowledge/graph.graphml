    <node id="code_candidate_97c4f98e55c5eb1401c920028fd6d4a9e39d6573a3666fdaeaeb22c1437d2fa2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_del(self):\n        \"\"\"Test JsonlCorpus __del__ closes resources\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False, verbosity=0)\n        \n        # Get an item to ensure it's loaded\n        _ = corpus[0]\n        \n        # Delete should close resources\n        del corpus\n        \n        # Should be able to create new corpus\n        corpus2 = JsonlCorpus(self.test_file, show_progress=False, verbosity=0)\n        _ = corpus2[0]\n        corpus2.close()\n", "code_sha256": "d162cd19295691e96aa6606dabfb9fa16da2613555e8fc78ce83b82fb9087676", "comments": [{"line": 277, "text": "# Get an item to ensure it's loaded"}, {"line": 280, "text": "# Delete should close resources"}, {"line": 283, "text": "# Should be able to create new corpus"}], "decorators": [], "definition_line": 273, "docstring": "Test JsonlCorpus __del__ closes resources", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_97c4f98e55c5eb1401c920028fd6d4a9e39d6573a3666fdaeaeb22c1437d2fa2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm