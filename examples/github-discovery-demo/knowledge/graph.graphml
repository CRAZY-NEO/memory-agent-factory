    <node id="code_candidate_ef1e3f4d6627dc3b925bba573bed188c48f18f1bb84da8f098d0149f0e7082fa">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_stopwords_various_languages(self):\n        \"\"\"Test stopwords inference for all supported languages\"\"\"\n        # Test various language codes\n        lang_codes = [\n            (\"german\", \"de\"),\n            (\"dutch\", \"nl\"),\n            (\"french\", \"fr\"),\n            (\"spanish\", \"es\"),\n            (\"portuguese\", \"pt\"),\n            (\"italian\", \"it\"),\n            (\"russian\", \"ru\"),\n            (\"swedish\", \"sv\"),\n            (\"norwegian\", \"no\"),\n            (\"chinese\", \"zh\"),\n            (\"turkish\", \"tr\"),\n        ]\n        \n        for lang_name, lang_code in lang_codes:\n            # Test full name\n            stopwords = _infer_stopwords(lang_name)\n            self.assertIsInstance(stopwords, (list, tuple))\n            self.assertGreater(len(stopwords), 0)\n            \n            # Test code\n            stopwords = _infer_stopwords(lang_code)\n            self.assertIsInstance(stopwords, (list, tuple))\n            self.assertGreater(len(stopwords), 0)\n", "code_sha256": "98d4bca4eaf0cb4e49ceab0166dce9bb9956735b34da06a8006222fbe9ad7faf", "comments": [{"line": 11, "text": "# Test various language codes"}, {"line": 27, "text": "# Test full name"}, {"line": 32, "text": "# Test code"}], "decorators": [], "definition_line": 9, "docstring": "Test stopwords inference for all supported languages", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_ef1e3f4d6627dc3b925bba573bed188c48f18f1bb84da8f098d0149f0e7082fa", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 35, "line_start": 9, "name": "test_infer_stopwords_various_languages", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_infer_stopwords_various_languages", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_infer_stopwords_various_languages(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
