      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __init__(self, stemmer_name='porter', language='english'):\n        self.stemmer_name = stemmer_name\n        self.language = language\n\n        self.available_stemmers = {\n            'porter': PorterStemmer(),\n            'snowball': SnowballStemmer('english'),\n            'lancaster': LancasterStemmer()\n        }\n        self.stemmer = self.available_stemmers[self.stemmer_name]\n", "code_sha256": "06142a66cdddd11c0e5d46140fd612c148e0a6d5dcc3206f34f1844dfde939b3", "comments": [], "decorators": [], "definition_line": 20, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "c817d2e2a1759dc8373bed500ecb20c84bf1b9d2c5af0d6034e9e700bc05e3cf", "id": "code_candidate_16c747e8c42df903f6fe71971a3014dfdd52f7c2cfb8169dabc2139ae44506e7", "imports": [{"alias": null, "level": 0, "line": 3, "module": "nltk.stem.porter", "name": "PorterStemmer"}, {"alias": null, "level": 0, "line": 4, "module": "nltk.stem.snowball", "name": "SnowballStemmer"}, {"alias": null, "level": 0, "line": 5, "module": "nltk.stem.lancaster", "name": "LancasterStemmer"}], "kind": "method", "line_end": 29, "line_start": 20, "name": "__init__", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": "'porter'", "kind": "positional_or_keyword", "name": "stemmer_name"}, {"annotation": null, "default": "'english'", "kind": "positional_or_keyword", "name": "language"}], "path": "examples/nltk_stemmer.py", "qualified_name": "NLTKMultiStemmer.__init__", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def __init__(self, stemmer_name='porter', language='english')", "source_id": "repo_source_6cf90926071d0bf4704d3af91b1ac0ad74f4d1ac39f5f13670afb12023956c2c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
