    <node id="code_candidate_1388b688ff8ae4042fa5a6ea0f6658e994f2276196496b3f24a18d9bc223f40a">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _get_counts_from_token_ids(token_ids, dtype, int_dtype):\n    token_counter = Counter(token_ids)\n    voc_ind = np.array(list(token_counter.keys()), dtype=int_dtype)\n    tf_array = np.array(list(token_counter.values()), dtype=dtype)\n\n    return voc_ind, tf_array\n", "code_sha256": "9deca861facb0bacfe2f9a6a50bc00ebb37f347f051290a6e4a4c334b0da18ab", "comments": [], "decorators": [], "definition_line": 238, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_1388b688ff8ae4042fa5a6ea0f6658e994f2276196496b3f24a18d9bc223f40a", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 243, "line_start": 238, "name": "_get_counts_from_token_ids", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "token_ids"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dtype"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "int_dtype"}], "path": "bm25s/scoring.py", "qualified_name": "_get_counts_from_token_ids", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _get_counts_from_token_ids(token_ids, dtype, int_dtype)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c