    <node id="repo_source_f1385c4a00cc55579fcff02f56ea05a05a5107b6cce9942e249524fe11e0781a">
      <data key="d0">Source</data>
      <data key="d1">{"byte_count": 1685, "encoding": "utf-8", "id": "repo_source_f1385c4a00cc55579fcff02f56ea05a05a5107b6cce9942e249524fe11e0781a", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tqdm", "name": "tqdm"}, {"alias": null, "level": 0, "line": 6, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 9, "module": "bm25s.utils.beir", "name": "BASE_URL"}], "module_docstring": null, "path": "tests/comparison/test_utils_corpus.py", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "sha256": "fe21cccbd001968adb447b8c015cbe15aa7ec565ef380c4242d1606861744c8e", "source_type": "python_repository", "text": "import json\nimport logging\nimport unittest\n\nfrom tqdm import tqdm\nimport beir.util\n\nfrom bm25s.utils.corpus import JsonlCorpus\nfrom bm25s.utils.beir import BASE_URL\n\nclass TestTopKSingleQuery(unittest.TestCase):\n    def test_utils_corpus(self):\n        save_dir = \"datasets\"\n        dataset = \"scifact\"\n        data_path = beir.util.download_and_unzip(BASE_URL.format(dataset), save_dir)\n\n        corpus_path = f\"{data_path}/corpus.jsonl\"\n\n        nq = JsonlCorpus(corpus_path)\n\n        # get all ids\n\n        corpus_ids = [doc[\"_id\"] for doc in tqdm(nq)]\n\n        # alternatively, try opening the file and read the _ids as we go\n        corpus_ids_2 = []\n        with open(corpus_path, \"r\") as f:\n            for line in f:\n                doc = json.loads(line)\n                corpus_ids_2.append(doc[\"_id\"])\n\n        self.assertListEqual(corpus_ids, corpus_ids_2)\n\n        # check if jsonl corpus can be closed\n        assert nq.file_obj is not None, \"JsonlCorpus file_obj is None, expected file object\"\n        assert nq.mmap_obj is not None, \"JsonlCorpus mmap_obj is None, expected mmap object\"\n\n        # now, we can close\n        nq.close()\n\n        assert nq.file_obj is None, \"JsonlCorpus file_obj is not None, expected None\"\n        assert nq.mmap_obj is None, \"JsonlCorpus mmap_obj is not None, expected None\"\n\n        # check if jsonl corpus can be loaded\n        nq.load()\n\n        assert nq.file_obj is not None, \"JsonlCorpus file_obj is None, expected file object\"\n        assert nq.mmap_obj is not None, \"JsonlCorpus mmap_obj is None, expected mmap object\"\n\n        corpus_ids = [doc[\"_id\"] for doc in tqdm(nq)]\n        self.assertListEqual(corpus_ids, corpus_ids_2)\n\n"}</data>
    </node>
    <node id="repo_source_cb3be2c9415f11a12f773f9f8e99c161cfda96befe49e93a37887c8a71da68f7">
