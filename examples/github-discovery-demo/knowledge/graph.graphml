    <node id="code_candidate_398704dbfdd811619c25cc20bb253043ccfa7cfafc685299a6e4b558603411a2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _compute_relevance_from_scores_legacy(\n    data, indptr, indices, num_docs, query_tokens_ids, dtype\n):\n    \"\"\"\n    The legacy implementation of the `_compute_relevance_from_scores` function. This may\n    be faster than the new implementation for some cases, but it cannot benefit from\n    numba acceleration, as it uses python lists. This function is kept for reference\n    and comparison purposes.\n    \"\"\"\n    # First, we use the query_token_ids to select the relevant columns from the score_matrix\n    query_tokens_ids = np.array(query_tokens_ids, dtype=int)\n    indptr_starts = indptr[query_tokens_ids]\n    indptr_ends = indptr[query_tokens_ids + 1]\n\n    scores_lists = []\n    indices_lists = []\n\n    for i, (start, end) in enumerate(zip(indptr_starts, indptr_ends)):\n        scores_lists.append(data[start:end])\n        indices_lists.append(indices[start:end])\n\n    # combine the lists into a single array\n\n    scores = np.zeros(num_docs, dtype=dtype)\n    if len(scores_lists) == 0:\n        return scores\n\n    scores_flat = np.concatenate(scores_lists)\n    indices_flat = np.concatenate(indices_lists)\n    np.add.at(scores, indices_flat, scores_flat)\n\n    return scores\n", "code_sha256": "cf838bf545b1cbd91f3cdf4bff2987e97dd6195d3c82b95b909d2bb4b1904651", "comments": [{"line": 321, "text": "# First, we use the query_token_ids to select the relevant columns from the score_matrix"}, {"line": 333, "text": "# combine the lists into a single array"}], "decorators": [], "definition_line": 312, "docstring": "\n    The legacy implementation of the `_compute_relevance_from_scores` function. This may\n    be faster than the new implementation for some cases, but it cannot benefit from\n    numba acceleration, as it uses python lists. This function is kept for reference\n    and comparison purposes.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_398704dbfdd811619c25cc20bb253043ccfa7cfafc685299a6e4b558603411a2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 343, "line_start": 312, "name": "_compute_relevance_from_scores_legacy", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indptr"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indices"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "num_docs"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query_tokens_ids"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dtype"}], "path": "bm25s/scoring.py", "qualified_name": "_compute_relevance_from_scores_legacy", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _compute_relevance_from_scores_legacy(data, indptr, indices, num_docs, query_tokens_ids, dtype)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
