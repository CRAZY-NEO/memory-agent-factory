    <node id="code_candidate_64f8e6c6995d4a55391112c032473f7e417a86c7cd68fef11ba75056522f766f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _normalize_version(value):\n    version = value.strip()\n    if version.startswith(\"refs/tags/\"):\n        version = version.rsplit(\"/\", 1)[-1]\n    if version.startswith(\"v\"):\n        version = version[1:]\n    return version\n", "code_sha256": "c0ba7224954d153004286f4cab99c742d6ceb882efbc3fa5c43f93b1e178a098", "comments": [], "decorators": [], "definition_line": 12, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_64f8e6c6995d4a55391112c032473f7e417a86c7cd68fef11ba75056522f766f", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 18, "line_start": 12, "name": "_normalize_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "value"}], "path": "setup.py", "qualified_name": "_normalize_version", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _normalize_version(value)", "source_id": "repo_source_0d1f311b51d0d09ed327befd6df90b17c01d1bb753011e01353c1c098b4f217d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
