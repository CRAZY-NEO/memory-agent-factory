    <node id="code_candidate_45e0ae78576c05f6464126c8dfb4f7b2a10eaa464f84f78220ba5f7624086d95">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_numpy_backend_unsorted(self):\n        \"\"\"Test topk with numpy backend unsorted\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        \n        scores, indices = topk(query_scores, k=2, backend=\"numpy\", sorted=False)\n        \n        # Should return top 2 but unsorted\n        # Check that we got the right values (order doesn't matter)\n        self.assertEqual(len(scores), 2)\n        self.assertEqual(len(indices), 2)\n        self.assertIn(4.0, scores)\n        self.assertIn(3.0, scores)\n", "code_sha256": "99fd9f6dacb56694314c3969505e91809a8407c34c0a7b32994cc6359075e800", "comments": [{"line": 59, "text": "# Should return top 2 but unsorted"}, {"line": 60, "text": "# Check that we got the right values (order doesn't matter)"}], "decorators": [], "definition_line": 53, "docstring": "Test topk with numpy backend unsorted", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_45e0ae78576c05f6464126c8dfb4f7b2a10eaa464f84f78220ba5f7624086d95", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.selection", "name": "topk"}, {"alias": "topk_numba", "level": 0, "line": 6, "module": "bm25s.numba.selection", "name": "topk"}, {"alias": null, "level": 0, "line": 31, "module": "jax", "name": null}], "kind": "method", "line_end": 64, "line_start": 53, "name": "test_topk_numpy_backend_unsorted", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_selection.py", "qualified_name": "TestSelectionFunctions.test_topk_numpy_backend_unsorted", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_topk_numpy_backend_unsorted(self)", "source_id": "repo_source_33f66b9a30f3f6aad8766b2217a780b139864e93e9878cc434c64c8ebc36e517", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
