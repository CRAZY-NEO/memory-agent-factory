      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def chunk(lst, n):\n    return [lst[i : i + n] for i in range(0, len(lst), n)]\n", "code_sha256": "29318f113a1cb8fe628af4e99272109f01bfcd3df6d2e8c8d5378f80a0a2c766", "comments": [], "decorators": [], "definition_line": 29, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "b3c3f4cb4763b2918bfc153e36e6e31970a23a7e6ae57c587215bb3a89e338e4", "id": "code_candidate_d923814f2400e48bf0ea74076d00f28fa1e41cd6da6bfffc64484c764a5d9053", "imports": [{"alias": "mp", "level": 0, "line": 18, "module": "multiprocessing", "name": null}, {"alias": null, "level": 0, "line": 20, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 21, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 22, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 23, "module": "bm25s.utils.benchmark", "name": "Timer"}, {"alias": null, "level": 0, "line": 24, "module": "bm25s.utils.beir", "name": "BASE_URL"}], "kind": "function", "line_end": 30, "line_start": 29, "name": "chunk", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "lst"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "n"}], "path": "examples/tokenize_multiprocess.py", "qualified_name": "chunk", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def chunk(lst, n)", "source_id": "repo_source_f305fe0c49d4a57d1e4effa26234a87eb318d20336222a90e2aa1f426b262b37", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
