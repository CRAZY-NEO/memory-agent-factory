      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @classmethod\n    def setUpClass(cls):\n        cls.corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n        cls.stemmer = Stemmer.Stemmer(\"english\")\n        cls.corpus_tokens = bm25s.tokenize(cls.corpus, stopwords=\"en\", stemmer=cls.stemmer)\n", "code_sha256": "3462c1df6ba69d34e062b87b5e32c7ca49c9b8f1c19d4ecf8a7be3137c39fd3e", "comments": [], "decorators": ["classmethod"], "definition_line": 15, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_78d71fa7e1a1e9d7f07dd433579f800fbeaf5c3763bc673aa2bd7b1fb59d9a70", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 23, "line_start": 14, "name": "setUpClass", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cls"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.setUpClass", "repository_key": "c8acc