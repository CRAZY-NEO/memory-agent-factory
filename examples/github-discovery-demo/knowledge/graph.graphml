    <node id="code_candidate_a33292e3c24fd3cf066c268743d9ea40915a7623c84fb1a866f1757ef9fe4707">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def elapsed(self, name, precision=None):\n        if precision is None:\n            precision = self.precision\n\n        if not self.has_started(name):\n            raise ValueError(f\"Timer with name {name} not started.\")\n        if not self.has_stopped(name):\n            raise ValueError(f\"Timer with name {name} not stopped.\")\n\n        return round(self.results[name][\"elapsed\"], precision)\n", "code_sha256": "eec20682388c33f0fca641ea49b4c86453673ee60e520b1437340bb8dc63490b", "comments": [], "decorators": [], "definition_line": 99, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_a33292e3c24fd3cf066c268743d9ea40915a7623c84fb1a866f1757ef9fe4707", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 108, "line_start": 99, "name": "elapsed", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "precision"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.elapsed", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def elapsed(self, name, precision=None)", "source_id": "repo_source_43fd334d6b3ac591ecde766e3edc2ab0b85c456f8eece5f44d103b24d412ad90", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_9657df38aad9e58134cbe4d60d28022bf52f404609274d45cd0fc5092bfd8093">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def show(self, name, offset=0, n_total=None):\n        t = self.elapsed(name) + offset\n        s = f\"{self.prefix} {name}: {t:.4f}s\"\n        if n_total is not None:\n            # calculate throughput\n            throughput = n_total / t\n            s += f\" ({throughput:.2f}/s)\"\n        print(s)\n", "code_sha256": "c06c94d310fabaa85bdda641930d8985ab4d4c89b742327b06e841a5f0a14e95", "comments": [{"line": 114, "text": "# calculate throughput"}], "decorators": [], "definition_line": 110, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_9657df38aad9e58134cbe4d60d28022bf52f404609274d45cd0fc5092bfd8093", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 117, "line_start": 110, "name": "show", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}, {"annotation": null, "default": "0", "kind": "positional_or_keyword", "name": "offset"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "n_total"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.show", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def show(self, name, offset=0, n_total=None)", "source_id": "repo_source_43fd334d6b3ac591ecde766e3edc2ab0b85c456f8eece5f44d103b24d412ad90", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
