    <node id="code_candidate_a91e42d286fe90291790acb4f015f9f78e48988cbe59a7750f78f3d88d84963e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def can_save_locally(local_save_dir, overwrite_local: bool) -&gt; bool:\n    \"\"\"\n    Check if it is possible to save the model to a local directory.\n\n    Parameters\n    ----------\n    local_save_dir: str\n        The directory to save the model to.\n\n    overwrite_local: bool\n        Whether to overwrite the existing local directory if it exists.\n\n    Returns\n    -------\n    bool\n        True if it is possible to save the model to the local directory, False otherwise.\n    \"\"\"\n    # if local_save_dir is None, we cannot save locally\n    if local_save_dir is None:\n        return False\n\n    # if the directory is empty, we can save locally\n    if is_dir_empty(local_save_dir):\n        return True\n\n    # if we are allowed to overwrite the directory, we can save locally\n    if overwrite_local:\n        return True\n", "code_sha256": "28cc7eec70a3fbc3ab7f7ab33930ea6487f53bbb415a6724354fc9b243932343", "comments": [{"line": 241, "text": "# if local_save_dir is None, we cannot save locally"}, {"line": 245, "text": "# if the directory is empty, we can save locally"}, {"line": 249, "text": "# if we are allowed to overwrite the directory, we can save locally"}], "decorators": [], "definition_line": 224, "docstring": "\n    Check if it is possible to save the model to a local directory.\n\n    Parameters\n    ----------\n    local_save_dir: str\n        The directory to save the model to.\n\n    overwrite_local: bool\n        Whether to overwrite the existing local directory if it exists.\n\n    Returns\n    -------\n    bool\n        True if it is possible to save the model to the local directory, False otherwise.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ef53c4775b6f6fde4a3a4fa5f687268b5f70562a82e11bd0f59c1757b1eed21b", "id": "code_candidate_a91e42d286fe90291790acb4f015f9f78e48988cbe59a7750f78f3d88d84963e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Union"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "BM25"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "__version__"}, {"alias": null, "level": 1, "line": 8, "module": "tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 11, "module": "huggingface_hub", "name": "HfApi"}, {"alias": null, "level": 0, "line": 23, "module": "tqdm.auto", "name": "tqdm"}], "kind": "function", "line_end": 251, "line_start": 224, "name": "can_save_locally", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "local_save_dir"}, {"annotation": "bool", "default": null, "kind": "positional_or_keyword", "name": "overwrite_local"}], "path": "bm25s/hf.py", "qualified_name": "can_save_locally", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "bool", "signature": "def can_save_locally(local_save_dir, overwrite_local: bool) -&gt; bool", "source_id": "repo_source_0276421611c94f62aae4f29f2f8c49b6a55fdbc5f9730e16e2b68068c8b133ae", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
