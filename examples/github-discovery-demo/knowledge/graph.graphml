    <node id="code_candidate_e0caf3432e7e35475da8cac409092a494388d42e18b1b30a13faa59262e896b6">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def convert_tokenized_to_string_list(tokenized: Tokenized) -&gt; List[List[str]]:\n    \"\"\"\n    Convert the token IDs back to strings using the vocab dictionary.\n    \"\"\"\n    reverse_vocab = {v: k for k, v in tokenized.vocab.items()}\n\n    return [\n        [reverse_vocab[token_id] for token_id in doc_ids] for doc_ids in tokenized.ids\n    ]\n", "code_sha256": "45bd12e5b1679b58d20981102b7fb82f1b902c323e5cc255d6bf1c5aa064ca3d", "comments": [], "decorators": [], "definition_line": 514, "docstring": "\n    Convert the token IDs back to strings using the vocab dictionary.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_e0caf3432e7e35475da8cac409092a494388d42e18b1b30a13faa59262e896b6", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Union"}, {"alias": null, "level": 0, "line": 5, "module": "typing", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_CHINESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DUTCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN_PLUS"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_FRENCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_GERMAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_ITALIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_KOREAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_NORWEGIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_PORTUGUESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "function", "line_end": 522, "line_start": 514, "name": "convert_tokenized_to_string_list", "parameters": [{"annotation": "Tokenized", "default": null, "kind": "positional_or_keyword", "name": "tokenized"}], "path": "bm25s/tokenization.py", "qualified_name": "convert_tokenized_to_string_list", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "List[List[str]]", "signature": "def convert_tokenized_to_string_list(tokenized: Tokenized) -&gt; List[List[str]]", "source_id": "repo_source_36f95b7073422ec39462657e59cf575ac2ab039132824d11ee0768e259ce5bbf", "status": "unvalidate