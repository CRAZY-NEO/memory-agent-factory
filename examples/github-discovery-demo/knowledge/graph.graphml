      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_a_save(self):\n        # save the retriever to temp dir\n        self.retriever.save(\n            self.tmpdirname,\n            data_name=\"data.index.csc.npy\",\n            indices_name=\"indices.index.csc.npy\",\n            indptr_name=\"indptr.index.csc.npy\",\n            vocab_name=\"vocab.json\",\n            nnoc_name=\"nonoccurrence_array.npy\",\n            params_name=\"params.json\",\n        )\n\n        # assert that the following files are saved\n        fnames = [\n            \"data.index.csc.npy\",\n            \"indices.index.csc.npy\",\n            \"indptr.index.csc.npy\",\n            \"vocab.json\",\n            \"nonoccurrence_array.npy\",\n            \"params.json\",\n        ]\n\n        for fname in fnames:\n            error_msg = f\"File {fname} not found in even though it should be saved by the .save() method\"\n            path_exists = os.path.exists(os.path.join(self.tmpdirname, fname))\n            self.assertTrue(path_exists, error_msg)\n", "code_sha256": "9f0d8160fb4ca9e25362952353f6ab8670f252fc0ec955bfc0d393cbcea7c3ad", "comments": [{"line": 43, "text": "# save the retriever to temp dir"}, {"line": 54, "text": "# assert that the following files are saved"}], "decorators": [], "definition_line": 42, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "73298969a0628fccdf9af5cde6e7a7c3335a4d3b93692e5f372b8270867b78e9", "id": "code_candidate_69548c363f695ef55515f89b0ab3bb77bfebb051d0df702a3c9fddac5b790cd6", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 8, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 67, "line_start": 42, "name": "test_a_save", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/numba/test_numba_backend_retrieve.py", "qualified_name": "TestNumbaBackendRetrieve.test_a_save", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_a_save(self)", "source_id": "repo_source_26fde66251d86b8bbb54beec5d0a01b27d8b99bab0dca747e6b73355088e35eb", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
