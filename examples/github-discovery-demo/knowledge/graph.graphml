    <node id="code_candidate_c583cd5d37a97a4a33480244bf0e61cfe715bd795dd3abfb89dcd73eacf1c71d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_pkg_info(package_dir):\n    pkg_info = package_dir / \"PKG-INFO\"\n    if not pkg_info.exists():\n        return None\n\n    for line in pkg_info.read_text(encoding=\"utf8\").splitlines():\n        if line.startswith(\"Version:\"):\n            return _normalize_version(line.partition(\":\")[2])\n\n    return None\n", "code_sha256": "0f37358ffbdb2f78fbbcea4a5799a408f17b5c904b2bf3dd951a70b29fe1c888", "comments": [], "decorators": [], "definition_line": 39, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_c583cd5d37a97a4a33480244bf0e61cfe715bd795dd3abfb89dcd73eacf1c71d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 48, "line_start": 39, "name": "_version_from_pkg_info", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "setup.py", "qualified_name": "_version_from_pkg_info", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _version_from_pkg_info(package_dir)", "source_id": "repo_source_3c0d305f10eb306cd3fff0347217bae386f41f7f7d84c64af09d4d3b405f33d8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
