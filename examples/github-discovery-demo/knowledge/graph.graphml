    <node id="code_candidate_a179d20e40e57f912338c5c12df8233b7efb9c02ac0d59a5c52735f30aee119d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenizer_with_length_parameter(self):\n        \"\"\"Test tokenizer with explicit length parameter\"\"\"\n        tokenizer = Tokenizer()\n        \n        # Create a generator\n        texts = (t for t in [\"hello world\", \"foo bar\"])\n        result = tokenizer.tokenize(texts, length=2, return_as=\"ids\", show_progress=False)\n        \n        self.assertEqual(len(result), 2)\n", "code_sha256": "578b64b639c7b701785acc25ec64bfc0e9db17914bd683133496c75cb45e1ae1", "comments": [{"line": 120, "text": "# Create a generator"}], "decorators": [], "definition_line": 116, "docstring": "Test tokenizer with explicit length parameter", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_a179d20e40e57f912338c5c12df8233b7efb9c02ac0d59a5c52735f30aee119d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 124, "line_start": 116, "name": "test_tokenizer_with_length_parameter", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenizer_with_length_parameter", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_tokenizer_with_length_parameter(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6e4f348f68071df2836562d96b9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
