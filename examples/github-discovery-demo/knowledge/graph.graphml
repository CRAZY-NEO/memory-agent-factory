    <node id="code_candidate_ffcdfc5fece12f74863af162450d7781c600a37385ed69b27eaf830620a77e0e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "@njit(nogil=True)\ndef _numba_sorted_top_k(array: np.ndarray, k: int, sorted=True):\n    n = len(array)\n    if k &gt; n:\n        k = n\n\n    values = np.zeros(k, dtype=array.dtype)  # aka scores\n    indices = np.zeros(k, dtype=np.int32)\n    length = 0\n\n    for i, value in enumerate(array):\n        if length &lt; k:\n            heap_push(values, indices, value, i, length)\n            length += 1\n        else:\n            if value &gt; values[0]:\n                values[0] = value\n                indices[0] = i\n                sift_up(values, indices, 0, length)\n\n    if sorted:\n        # # This is the original code for sorting, we can skip it and return the values and indices\n        # # to let numpy handle the sorting\n        # top_k_values = np.zeros(k, dtype=array.dtype)\n        # top_k_indices = np.zeros(k, dtype=np.int32)\n\n        # for i in range(k - 1, -1, -1):\n        #     top_k_values[i], top_k_indices[i] = heap_pop(values, indices, length)\n        #     length -= 1\n        # values = top_k_values\n        # indices = top_k_indices\n\n        # This is the new code that uses numpy to sort the values and indices instead of\n        # using the heap to sort them.\n        sorted_indices = np.flip(np.argsort(values))\n        indices = indices[sorted_indices]\n        values = values[sorted_indices]\n\n    return values, indices\n", "code_sha256": "7c49e35cc62f7ecb36ebec1de89680338f189b9fb72fbd4a4f96d80273b67383", "comments": [{"line": 92, "text": "# aka scores"}, {"line": 107, "text": "# # This is the original code for sorting, we can skip it and return the values and indices"}, {"line": 108, "text": "# # to let numpy handle the sorting"}, {"line": 109, "text": "# top_k_values = np.zeros(k, dtype=array.dtype)"}, {"line": 110, "text": "# top_k_indices = np.zeros(k, dtype=np.int32)"}, {"line": 112, "text": "# for i in range(k - 1, -1, -1):"}, {"line": 113, "text": "#     top_k_values[i], top_k_indices[i] = heap_pop(values, indices, length)"}, {"line": 114, "text": "#     length -= 1"}, {"line": 115, "text": "# values = top_k_values"}, {"line": 116, "text": "# indices = top_k_indices"}, {"line": 118, "text": "# This is the new code that uses numpy to sort the values and indices instead of"}, {"line": 119, "text": "# using the heap to sort them."}], "decorators": ["njit(nogil=True)"], "definition_line": 87, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "25e18ba3d11e9ee1c087bed5cbca6a30d490f9abfe18f8eed498b38e727d6ed8", "id": "code_candidate_ffcdfc5fece12f74863af162450d7781c600a37385ed69b27eaf830620a77e0e", "imports": [{"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 124, "line_start": 86, "name": "_numba_sorted_top_k", "parameters": [{"annotation": "np.ndarray", "default": null, "kind": "positional_or_keyword", "name": "array"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "k"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "bm25s/numba/selection.py", "qualified_name": "_numba_sorted_top_k", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _numba_sorted_top_k(array: np.ndarray, k: int, sorted=True)", "source_id": "repo_source_275760e66b6f7c91ae64ee22b3b6a0d3d558c52aaf93aa3ff022e5f030261f8c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
