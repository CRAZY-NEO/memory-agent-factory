      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @staticmethod\n    def _np_csc(data, rows, cols, shape):\n        \"\"\"\n        Default Hybrid CSC builder. Uses pure Python/NumPy by default.\n        Can be swapped with a Numba version via `activate_numba_csc`.\n        \"\"\"\n        return _np_csc_python(data, rows, cols, shape)\n", "code_sha256": "299ee8a0f3f36bd21fe5a4fcfcd5a18b3d8c4bf588be3751e29f12f83294f12e", "comments": [], "decorators": ["staticmethod"], "definition_line": 1289, "docstring": "\n        Default Hybrid CSC builder. Uses pure Python/NumPy by default.\n        Can be swapped with a Numba version via `activate_numba_csc`.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_9c626773391e71d2d37499fbc7c01dfc0c04d93711e3023844bd56f4961ff9e9", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "