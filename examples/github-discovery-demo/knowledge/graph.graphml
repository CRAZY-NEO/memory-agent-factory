      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def test_discover_version_falls_back_when_distribution_is_missing(monkeypatch):\n    def missing_version(name):\n        raise version_module.PackageNotFoundError(name)\n\n    monkeypatch.setattr(version_module, \"version\", missing_version)\n\n    assert version_module._discover_version() == \"0.0.0\"\n", "code_sha256": "14ae000744b08b159feb3a46eb97098c1b71f3ccb6684277df7d364b796ba811", "comments": [], "decorators": [], "definition_line": 10, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5740d7367d93e8b5e592954f3c78a89571733349f91682289d3f90ff54f96748", "id": "code_candidate_31b378cbab4b384271d20a0be0cfcaf146ec598c6d91dbc640bd49216689ee3d", "imports": [{"alias": "version_module", "level": 0, "line": 1, "module": "bm25s.version", "name": null}], "kind": "function", "line_end": 16, "line_start": 10, "name": "test_discover_version_falls_back_when_distribution_is_missing", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "monkeypatch"}], "path": "tests/core/test_version.py", "qualified_name": "test_discover_version_falls_back_when_distribution_is_missing", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_discover_version_falls_back_when_distribution_is_missing(monkeypatch)", "source_id": "repo_source_50f640253ab5ed6036f2e3052bdfd8178dfe62731374ebbbeaf81989f256b7f4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
