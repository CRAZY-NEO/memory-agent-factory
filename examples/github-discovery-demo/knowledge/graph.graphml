    <node id="code_candidate_60bbfae0bbfa920e5f3c03e86baccff51635f85f24821d650c31341df9034335">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_getitem_list(self):\n        \"\"\"Test JsonlCorpus __getitem__ with list of indices\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False)\n        \n        # Get list of indices\n        items = corpus[[0, 2, 4]]\n        self.assertEqual(len(items), 3)\n        self.assertEqual(items[0][\"id\"], 0)\n        self.assertEqual(items[1][\"id\"], 2)\n        self.assertEqual(items[2][\"id\"], 4)\n        \n        corpus.close()\n", "code_sha256": "0706b1165b11da5950d312a74013716c50d4c4f124c6cfd5b431c8ae66ed5c70", "comments": [{"line": 204, "text": "# Get list of indices"}], "decorators": [], "definition_line": 200, "docstring": "Test JsonlCorpus __getitem__ with list of indices", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_60bbfae0bbfa920e5f3c03e86baccff51635f85f24821d650c31341df9034335", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 211, "line_start": 200, "name": "test_jsonl_corpus_getitem_list", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestJsonlCorpus.test_jsonl_corpus_getitem_list", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_jsonl_corpus_getitem_list(self)", "source_id": "repo_source_211fa7d6af255f93f3dc0b1a3484427853aae774b41a3aaad8f9bf1fcb9a6619", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
