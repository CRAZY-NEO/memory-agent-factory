    <node id="code_candidate_7c26ffa59eef3c443a1ef79123dd9d1e5b4ec2ef10d2d5dbd7b8209841acb4c1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_scores_with_list_of_ints(self):\n        \"\"\"Test get_scores with list of token IDs (ints)\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Get some valid token IDs\n        valid_token_ids = list(retriever.vocab_dict.values())[:3]\n        \n        # Should work with int token IDs\n        scores = retriever.get_scores(valid_token_ids)\n        \n        self.assertIsInstance(scores, np.ndarray)\n        self.assertEqual(len(scores), len(self.corpus))\n", "code_sha256": "8ea8f4502eb78231cfddbfa04c1766f308ec9930551c9ac723debcccd5d32e44", "comments": [{"line": 166, "text": "# Get some valid token IDs"}, {"line": 169, "text": "# Should work with int token IDs"}], "decorators": [], "definition_line": 161, "docstring": "Test get_scores with list of token IDs (ints)", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_7c26ffa59eef3c443a1ef79123dd9d1e5b4ec2ef10d2d5dbd7b8209841acb4c1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 173, "line_start": 161, "name": "test_get_scores_with_list_of_ints", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_get_scores_with_list_of_ints", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_get_scores_with_list_of_ints(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
