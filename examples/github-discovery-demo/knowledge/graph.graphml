okenized], corpus: List[Any]=None, k: int=10, sorted: bool=True, return_as: str='tuple', show_progress: bool=True, leave_progress: bool=False, n_threads: int=0, chunksize: int=50, backend_selection: str='auto', weight_mask: np.ndarray=None)", "source_id": "repo_source_8eb1f8d56c3a2f6aec5c33dcdfe9363289533bb4a91754a766f3a81c67b25ae4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
