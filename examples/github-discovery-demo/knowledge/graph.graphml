    <node id="code_candidate_945a275e8804cf8c4396b9191625130ec906d3b4db7c56a7f7f31427758e4574">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def start(self, name):\n        if name in self.results:\n            raise ValueError(f\"Timer with name {name} already started.\")\n        start_time = time.monotonic()\n        self.results[name] = {\"start\": start_time, \"elapsed\": 0, \"last\": start_time}\n        return name\n", "code_sha256": "4adee8c326c9da51eb9fb3bf5e37c3763d08d10bdfa4b6d195a906657a4aee4c", "comments": [], "decorators": [], "definition_line": 42, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_945a275e8804cf8c4396b9191625130ec906d3b4db7c56a7f7f31427758e4574", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 47, "line_start": 42, "name": "start", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.start", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def start(self, name)", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d013be753eacf3220cbe96f3ac675f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
