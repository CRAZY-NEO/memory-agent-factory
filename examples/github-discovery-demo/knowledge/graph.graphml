    <node id="code_candidate_3b0adffd48f48a9f169aa91ea9911180cf0b5d309682e76c1c0ccb5596c29407">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def check_scores_all_close(score1, score2, **kwargs):\n    for key in score1.keys():\n        matrix1 = score1[key]\n        matrix2 = score2[key]\n            \n        if matrix1.shape != matrix2.shape:\n            return False\n        if not np.allclose(matrix1, matrix2, **kwargs):\n            return False\n\n        return True\n", "code_sha256": "8ce07d3c78bcc51db40ee4b2b143d99680740c08b48fa73dd17c5eabb48cbcb4", "comments": [], "decorators": [], "definition_line": 17, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "b3a35fa2253aa69d19b46cf9b34657d45a1f54cac4d7cf5d538e784c48448e37", "id": "code_candidate_3b0adffd48f48a9f169aa91ea9911180cf0b5d309682e76c1c0ccb5596c29407", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "warnings", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "logging", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 11, "module": "beir.util", "name": "download_and_unzip"}, {"alias": null, "level": 0, "line": 12, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 15, "module": "bm25s.utils.beir", "name": "BASE_URL"}], "kind": "function", "line_end": 27, "line_start": 17, "name": "check_scores_all_close", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "score1"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "score2"}, {"annotation": null, "default": null, "kind": "var_keyword", "name": "kwargs"}], "path": "tests/comparison/test_bm25s_indexing.py", "qualified_name": "check_scores_all_close", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def check_scores_all_close(score1, score2, **kwargs)", "source_id": "repo_source_cfc78b9e1ac7a19386f7739563872f25f225ee3af1d09a7abab58591b5a3c610", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
