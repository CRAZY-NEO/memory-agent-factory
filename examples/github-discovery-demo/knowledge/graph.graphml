    <node id="code_candidate_c621d078e3e827e273fd39d0c29f35dc16ef07cc572fb2e526ad15b7c3aac54b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenizer_update_vocab_if_empty_with_empty_vocab(self):\n        \"\"\"Test tokenizer with update_vocab='if_empty' when vocab is empty\"\"\"\n        tokenizer = Tokenizer()\n        \n        texts = [\"hello world\"]\n        tokenizer.tokenize(texts, update_vocab=\"if_empty\", return_as=\"ids\")\n        \n        # Should have updated vocab\n        self.assertGreater(len(tokenizer.word_to_id), 0)\n", "code_sha256": "bbfd250d7a44f0fc4e52a0b0efc5e4f504a7745de1e85a3c5808b45363797cdf", "comments": [{"line": 76, "text": "# Should have updated vocab"}], "decorators": [], "definition_line": 69, "docstring": "Test tokenizer with update_vocab='if_empty' when vocab is empty", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_c621d078e3e827e273fd39d0c29f35dc16ef07cc572fb2e526ad15b7c3aac54b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 77, "line_start": 69, "name": "test_tokenizer_update_vocab_if_empty_with_empty_vocab", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenizer_update_vocab_if_empty_with_empty_vocab", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_tokenizer_update_vocab_if_empty_with_empty_vocab(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
