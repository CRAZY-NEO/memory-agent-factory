igher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "metrics": {}, "passed": false, "per_query": [], "query_count": 36, "split": "validation", "top_k": 5}}], "dataset_hashes": {"memories.json": "d9a8c6a1fbbd0b6b50798cb4b7915ff10abb3ddb69479798804f2f621e125320", "test_queries.json": "7512ce5cea3fbd40e3e049f167b7ffdbe5443f22cec9f7b320ae5d216adbe826", "validation_queries.json": "cca76193a74262b0dabe271375b3c1322b2330af967c6de6e4b0a0b1ec102e2f"}, "description": "请为中文与英文混合技术笔记检索发现并复刻一个尚未登记的 BM25Plus 算法。自动在 GitHub 寻找独立算法实现库，依据外部源码保留评分公式和参数，适配 retrieve(query, memories, top_k=5)。通过统一 Docker 验证和最终测试后登记，供后续工厂任务使用。", "discovery": {"internal_template_used": false, "method_fidelity": "source-grounded adaptation; functional/metric validation is not a mathematical equivalence proof", "release": null, "search_queries": ["BM25Plus", "BM25"], "source": {"commit": "03eac5a8fb3aa4958ce37415a4cf2220d35157f7", "license": "MIT", "repository": "xhluca/bm25s", "url": "https://github.com/xhluca/bm25s"}, "source_contract": {"cases": [{"expected": [{"id": "a", "score": 1.1996778125075978}, {"id": "b", "score": 1.0397207708399179}, {"id": "c", "score": 0.34657359027997264}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha", "top_k": 3}, {"expected": [{"id": "a", "score": 2.3993556250151955}, {"id": "b", "score": 2.0794415416798357}, {"id": "c", "score": 0.6931471805599453}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha alpha", "top_k": 3}], "defaults": {"b": 0.75, "delta": 0.5, "k1": 1.5}, "kernels": [{"code": "def _score_tfc_bm25plus(tf_array, l_d, l_avg, k1, b, delta):\n    num = (k1 + 1) * tf_array\n    den = k1 * (1 - b + b * l_d / l_avg) + tf_array\n    return (num / den) + delta", "path": "bm25s/scoring.py", "qualified_name": "_score_tfc_bm25plus"}, {"code": "def _score_idf_bm25plus(df, N):\n    return math.log((N + 1) / df)", "path": "bm25s/scoring.py", "qualified_name": "_score_idf_bm25plus"}], "scope": "Small public numeric examples; not a proof of full repository equivalence", "status": "derived_scalar_formula_cases"}}, "environment": {"dependencies": {"langgraph": "1.2.14", "networkx": "3.7", "pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": "agent-factory-runner:0.1", "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "docker", "worker_sha256": "b1101f539da9232bf8bb10ae375a6df8e8c1577775b09b77dc0f257636c7d94f"}, "generation_policy": "focused-repair-v2", "llm_calls": 9, "mock_fault_algorithm": null, "mock_fault_injection": false, "model": "qwen3.5:2b", "plan": {"candidates": [{"algorithm": "github_bm25plus", "capability_id": "cap_github_bm25plus_20261014t104242_7d070237", "rationale": "该仓库提供了基于NumPy和Numba的Fast BM25实现，支持中文与英文混合检索，符合用户要求的retrieve(query, memories, top_k=5)接口。其开源许可（MIT）和独立算法库属性使其适合作为后续工厂任务的基础。相比其他仓库，它更专注于高性能计算，且未过度依赖PyTorch等框架，便于用户直接复刻和扩展。"}], "design_explanation": "从实际 GitHub 搜索结果下载固定提交，依据来源证据复刻新方法：The BM25Plus algorithm adapts the standard BM25 scoring by incorporating a delta parameter to adjust document relevance scores. It utilizes a unified tokenization pipeline to convert query and corpus tokens into indices before applying the scoring formula. The implementation requires a custom backend selection mechanism to handle different numerical computation backends efficiently."}, "plugin_catalog": {"algorithms": [{"dependencies": [], "environment": "retrieval-v1", "guidance": "Reproduce BM25Plus from the pinned source scoring functions and constructor defaults. Adapt the retrieve interface and tokenizer only; do not mix in unrelated scoring methods or install dependencies.", "id": "github_bm25plus", "name": "BM25Plus", "provenance": {"commit": "03eac5a8fb3aa4958ce37415a4cf2220d35157f7", "license": "MIT", "repository": "xhluca/bm25s", "url": "https://github.com/xhluca/bm25s"}, "public_cases": [{"expected": [{"id": "a", "score": 1.1996778125075978}, {"id": "b", "score": 1.0397207708399179}, {"id": "c", "score": 0.34657359027997264}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha", "top_k": 3}, {"expected": [{"id": "a", "score": 2.3993556250151955}, {"id": "b", "score": 2.0794415416798357}, {"id": "c", "score": 0.6931471805599453}], "memories": [{"id": "a", "source": "public formula case", "text": "alpha alpha beta"}, {"id": "b", "source": "public formula case", "text": "alpha beta"}, {"id": "c", "source": "public formula case", "text": "gamma"}], "query": "alpha alpha", "top_k": 3}], "task": "memory_retrieval", "version": "20261014T104242_7d070237"}], "metrics": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "modules": ["agent_factory.plugins.algorithms.bm25", "agent_factory.plugins.algorithms.jaccard", "agent_factory.plugins.algorithms.tfidf", "agent_factory.plugins.metrics.latency", "agent_factory.plugins.metrics.mrr", "agent_factory.plugins.metrics.precision", "agent_factory.plugins.metrics.recall"]}, "provider": "ollama", "request": {"description": "请为中文与英文混合技术笔记检索发现并复刻一个尚未登记的 BM25Plus 算法。自动在 GitHub 寻找独立算法实现库，依据外部源码保留评分公式和参数，适配 retrieve(query, memories, top_k=5)。通过统一 Docker 验证和最终测试后登记，供后续工厂任务使用。", "language": "mixed", "task": "memory_retrieval", "top_k": 5}, "run_id": "20261014T104242_7d070237", "runner": "docker", "selected": null, "status": "failed_validation", "test": null, "validation_config": {"algorithms": ["github_bm25plus"], "compare_all_algorithms": true, "max_candidates": 1, "max_repairs": 2, "metrics": {"mrr_at_k": {"max": null, "min": 0.65}, "p95_ms": {"max": 1000.0, "min": null}, "precision_at_k": {"max": null, "min": 0.2}, "recall_at_k": {"max": null, "min": 0.75}}, "plugin_packages": [], "selection_order": ["recall_at_k", "mrr_at_k", "precision_at_k"], "task": "memory_retrieval", "timeout_seconds": 30.0}, "workflow_events": ["source_search", "github_search", "pick_repository", "download_repository", "extract_repository", "propose_algorithm", "generate", "validate", "review", "generate", "validate", "review", "generate", "validate", "select", "persist"]}</data>
