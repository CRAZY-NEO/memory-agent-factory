    <node id="code_candidate_5388668996ae4b0880773556f3cca521457d2c05a1ffe127f063ba10fd503889">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_jax_not_available(self):\n        \"\"\"Test that topk raises ImportError when JAX backend is requested but not available\"\"\"\n        query_scores = np.array([3.0, 1.0, 4.0, 2.0], dtype=np.float32)\n        \n        # This test will only fail if JAX is not available\n        # Since JAX might be installed, we'll use a different approach\n        # We'll test the error path by checking if the import error is raised\n        try:\n            import jax\n            # If JAX is available, skip this test or test with numpy backend\n            self.skipTest(\"JAX is available, cannot test error case\")\n        except ImportError:\n            # JAX is not available, test should raise ImportError\n            with self.assertRaises(ImportError) as context:\n                topk(query_scores, k=2, backend=\"jax\")\n            self.assertIn(\"JAX is not available\", str(context.exception))\n", "code_sha256": "c8c074789c7478a27d08e62b0e4412afecfea3a581772bb6a6385ac9f610ed55", "comments": [{"line": 27, "text": "# This test will only fail if JAX is not available"}, {"line": 28, "text": "# Since JAX might be installed, we'll use a different approach"}, {"line": 29, "text": "# We'll test the error path by checking if the import error is raised"}, {"line": 32, "text": "# If JAX is available, skip this test or test with numpy backend"}, {"line": 35, "text": "# JAX is not available, test should raise ImportError"}], "decorators": [], "definition_line": 23, "docstring": "Test that topk raises ImportError when JAX backend is requested but not available", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "be02b7eba6b2282301debea9e55562bab8c1f19e6e32357894ed53a9d8f09aeb", "id": "code_candidate_5388668996ae4b0880773556f3cca521457d2c05a1ffe127f063ba10fd503889", "imports": [{"alias": null, "level": 0, "line"