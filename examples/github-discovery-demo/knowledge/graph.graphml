    <node id="code_candidate_0cf556d330ba12312defe2aa8be85dddd8efe868248fba26ba5018b0285eda42">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _np_csc_jit_ready(data, rows, cols, shape):\n    \"\"\"\n    Numba-compilable core implementation of CSC construction.\n    Uses Counting Sort (linear time) instead of Argsort (linear-logarithmic time).\n    \n    This implementation assumes `rows` (doc_ids) are sorted in the input, which is \n    standard for BM25 construction. It performs a stable sort on `cols` to strictly \n    guarantee the final (col, row) sorted order required by CSC matrices.\n    \"\"\"\n    n_cols = shape[1]\n    n_items = len(data)\n\n    # 1. Compute column counts (histogram)\n    col_counts = np.bincount(cols, minlength=n_cols)\n    \n    # 2. Compute indptr and initialize write pointers (heads)\n    # indptr: start/end of each column\n    # heads: current write position for each column (mutable)\n    indptr = np.zeros(n_cols + 1, dtype=np.int64)\n    heads = np.zeros(n_cols, dtype=np.int64)\n    \n    acc = 0\n    for i in range(n_cols):\n        heads[i] = acc\n        acc += col_counts[i]\n        indptr[i+1] = acc\n\n    # 3. Perform Counting Sort to fill data and indices\n    # Since 'heads' tracks the write position, we can fill the output arrays in one pass.\n    sorted_data = np.zeros_like(data)\n    sorted_indices = np.zeros_like(rows)\n\n    for i in range(n_items):\n        col = cols[i]\n        pos = heads[col]\n        sorted_data[pos] = data[i]\n        sorted_indices[pos] = rows[i]\n        heads[col] += 1\n    \n    return sorted_data, sorted_indices, indptr\n", "code_sha256": "03d9e97016d6c7dd8a53e144335ab0ed01a56461ecc70a3f2840eddddcac14a7", "comments": [{"line": 383, "text": "# 1. Compute column counts (histogram)"}, {"line": 386, "text": "# 2. Compute indptr and initialize write pointers (heads)"}, {"line": 387, "text": "# indptr: start/end of each column"}, {"line": 388, "text": "# heads: current write position for each column (mutable)"}, {"line": 398, "text": "# 3. Perform Counting Sort to fill data and indices"}, {"line": 399, "text": "# Since 'heads' tracks the write position, we can fill the output arrays in one pass."}], "decorators": [], "definition_line": 371, "docstring": "\n    Numba-compilable core implementation of CSC construction.\n    Uses Counting Sort (linear time) instead of Argsort (linear-logarithmic time).\n    \n    This implementation assumes `rows` (doc_ids) are sorted in the input, which is \n    standard for BM25 construction. It performs a stable sort on `cols` to strictly \n    guarantee the final (col, row) sorted order required by CSC matrices.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_0cf556d330ba12312defe2aa8be85dddd8efe868248fba26ba5018b0285eda42", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 410, "line_start": 371, "name": "_np_csc_jit_ready", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "data"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "rows"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "cols"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "shape"}], "path": "bm25s/scoring.py", "qualified_name": "_np_csc_jit_ready", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _np_csc_jit_ready(data, rows, cols, shape)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
