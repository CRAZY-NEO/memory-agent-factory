      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_index_with_token_ids_and_create_empty_token(self):\n        \"\"\"Test indexing with token IDs and create_empty_token=True\"\"\"\n        # Create corpus as list of token IDs\n        corpus_token_ids = [[0, 1, 2], [1, 2, 3], [0, 3, 4]]\n        \n        retriever = BM25()\n        retriever.index(corpus_token_ids, create_empty_token=True)\n        \n        # Verify that vocab_dict was created\n        self.assertIsNotNone(retriever.vocab_dict)\n        # Verify that an entry exists for empty token or max+1\n        self.assertTrue(len(retriever.vocab_dict) &gt;= 5)  # 5 unique tokens + possibly empty\n", "code_sha256": "d98c70418475b78acf80f12bf47c6572b2c03499c25edfa17e3641a355e6c584", "comments": [{"line": 126, "text": "# Create corpus as list of token IDs"}, {"line": 132, "text": "# Verify that vocab_dict was created"}, {"line": 134, "text": "# Verify that an entry exists for empty token or max+1"}, {"line": 135, "text": "# 5 unique tokens + possibly empty"}], "decorators": [], "definition_line": 124, "docstring": "Test indexing with token IDs and create_empty_token=True", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_4f15714aaf62e918cb18e28116ae71365b6fd34d2ca5b2cbcb90712faa83661e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 135, "line_start": 124, "name": "test_index_with_token_ids_and_create_empty_token", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_index_with_token_ids_and_create_empty_token", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_index_with_token_ids_and_create_empty_token(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
