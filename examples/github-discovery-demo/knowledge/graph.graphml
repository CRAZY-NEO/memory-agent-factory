    <node id="code_candidate_16d61af4a7eeaeb853330f3fe3ee44e3a7e0642f74842b0cb5fcdeca8934ed3e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def get_scores_from_ids(\n        self, query_tokens_ids: List[int], weight_mask=None\n    ) -&gt; np.ndarray:\n        data = self.scores[\"data\"]\n        indices = self.scores[\"indices\"]\n        indptr = self.scores[\"indptr\"]\n        num_docs = self.scores[\"num_docs\"]\n\n        dtype = np.dtype(self.dtype)\n        int_dtype = np.dtype(self.int_dtype)\n        query_tokens_ids: np.ndarray = np.asarray(query_tokens_ids, dtype=int_dtype)\n\n        max_token_id = int(query_tokens_ids.max(initial=0))\n\n        if max_token_id &gt;= len(indptr) - 1:\n            raise ValueError(\n                f\"The maximum token ID in the query ({max_token_id}) is higher than the number of tokens in the index.\"\n                \"This likely means that the query contains tokens that are not in the index.\"\n            )\n\n        scores = self._compute_relevance_from_scores(\n            data=data,\n            indptr=indptr,\n            indices=indices,\n            num_docs=num_docs,\n            query_tokens_ids=query_tokens_ids,\n            dtype=np.dtype(dtype),\n        )\n\n        if weight_mask is not None:\n            # multiply the scores by the weight mask\n            scores *= weight_mask\n\n        # if there's a non-occurrence array, we need to add the non-occurrence score\n        # back to the scores\n        if self.nonoccurrence_array is not None:\n            nonoccurrence_scores = self.nonoccurrence_array[query_tokens_ids].sum()\n            scores += nonoccurrence_scores\n\n        return scores\n", "code_sha256": "3acea86171ff815360eb006938fc90d86d9313e33d06dbededb06132d4717727", "comments": [{"line": 611, "text": "# multiply the scores by the weight mask"}, {"line": 614, "text": "# if there's a non-occurrence array, we need to add the non-occurrence score"}, {"line": 615, "text": "# back to the scores"}], "decorators": [], "definition_line": 581, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_16d61af4a7eeaeb853330f3fe3ee44e3a7e0642f74842b0cb5fcdeca8934ed3e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Union"}, {"alias": "np", "level": 0, "line": 11, "module": "numpy", "name": null}, {"alias": "json_functions", "level": 1, "line": 13, "module": "utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "numba", "name": "njit"}, {"alias": "selection_jit", "level": 1, "line": 17, "module": "numba", "name": "selection"}, {"alias": "sp", "level": 0, "line": 23, "module": "scipy.sparse", "name": null}, {"alias": null, "level": 1, "line": 29, "module": "numba.retrieve_utils", "name": "_retrieve_numba_functional"}, {"alias": null, "level": 0, "line": 43, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "scoring"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "stopwords"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "tokenization"}, {"alias": null, "level": 1, "line": 48, "module": null, "name": "utils"}, {"alias": "selection_np", "level": 1, "line": 49, "module": null, "name": "selection"}, {"alias": null, "level": 1, "line": 50, "module": "version", "name": "__version__"}, {"alias": null, "level": 1, "line": 51, "module": "tokenization", "name": "tokenize"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_idf_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_nonoccurrence_array"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_build_scores_and_indices_for_matrix"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_calculate_doc_freqs"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_jit_ready"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_np_csc_python"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 1, "line": 52, "module": "scoring", "name": "_select_tfc_scorer"}, {"alias": null, "level": 0, "line": 1336, "module": "numba", "name": "njit"}, {"alias": null, "level": 1, "line": 1346, "module": "scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 1361, "module": "numba", "name": "njit"}], "kind": "method", "line_end": 620, "line_start": 581, "name": "get_scores_from_ids", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[int]", "default": null, "kind": "positional_or_keyword", "name": "query_tokens_ids"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "weight_mask"}], "path": "bm25s/__init__.py", "qualified_name": "BM25.get_scores_from_ids", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "np.ndarray", "signature": "def get_scores_from_ids(self, query_tokens_ids: List[int], weight_mask=None) -&gt; np.ndarray", "source_id": "repo_source_8eb1f8d56c3a2f6aec5c33dcdfe9363289533bb4a91754a766f3a81c67b25ae4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
