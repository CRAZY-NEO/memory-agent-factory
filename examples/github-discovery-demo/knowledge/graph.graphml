    <node id="code_candidate_c231f56b6bb24edc2d8460ea161a22459f18f0e137b5bb7209076fe08c095ca6">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def load(self):\n        \"\"\"\n        Load the file and mmap objects. This is useful if you closed them and want to reopen them.\n\n        Note\n        ----\n        This is called automatically when the object is created. You don't need to call it manually.\n        Also, if there is an existing file and mmap object, this will close them before reopening.\n        \"\"\"\n        self.close()  # close any existing file and mmap objects\n\n        self.file_obj = open(self.path, \"r\", encoding=self.encoding)\n        # mmap cannot map a zero-length file (ValueError: cannot mmap an empty file).\n        # A zero-byte .jsonl is valid only when its line index is empty too. A\n        # nonempty saved/in-memory index means the corpus was truncated after\n        # indexing; accepting it would report a stale nonzero length and fail\n        # only later on item access. Preserve the existing fail-fast behavior.\n        if os.fstat(self.file_obj.fileno()).st_size == 0:\n            if len(self.mmindex) != 0:\n                self.file_obj.close()\n                self.file_obj = None\n                raise ValueError(\"empty corpus file has a nonempty line index\")\n            self.mmap_obj = None\n        else:\n            self.mmap_obj = mmap.mmap(self.file_obj.fileno(), 0, access=mmap.ACCESS_READ)\n        if self.verbosity &gt;= 1:\n            logging.info(\"Opened file and mmap objects\")\n", "code_sha256": "a40fcb31fbf387a6d25a196848b6c8d585c5fa5b110f4a625ca62d3e1b3d2f51", "comments": [{"line": 218, "text": "# close any existing file and mmap objects"}, {"line": 221, "text": "# mmap cannot map a zero-length file (ValueError: cannot mmap an empty file)."}, {"line": 222, "text": "# A zero-byte .jsonl is valid only when its line index is empty too. A"}, {"line": 223, "text": "# nonempty saved/in-memory index means the corpus was truncated after"}, {"line": 224, "text": "# indexing; accepting it would report a stale nonzero length and fail"}, {"line": 225, "text": "# only later on item access. Preserve the existing fail-fast behavior."}], "decorators": [], "definition_line": 209, "docstring": "\n        Load the file and mmap objects. This is useful if you closed them and want to reopen them.\n\n        Note\n        ----\n        This is called automatically when the object is created. You don't need to call it manually.\n        Also, if there is an existing file and mmap object, this will close them before reopening.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_c231f56b6bb24edc2d8460ea161a22459f18f0e137b5bb7209076fe08c095ca6", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "method", "line_end": 235, "line_start": 209, "name": "load", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "bm25s/utils/corpus.py", "qualified_name": "JsonlCorpus.load", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def load(self)", "source_id": "repo_source_3a590e9df8c804c7e0ab59f7ac50e34f1861c4a59d907626f359b08c345a4784", "status": "unvalidated", "task": null, "trust": "untr