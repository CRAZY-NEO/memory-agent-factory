    <node id="code_candidate_e6ef85ea334d103d90310cf6a0a679289f285489779560d545341a9c6ba732c7">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_weight_mask(self):\n        \n\n        # first, try with default mode\n        query = \"cat feline dog bird fish\"  # weights should be [2, 1, 1, 1], but after masking should be [2, 0, 0, 1]\n\n        for dt in [np.float32, np.int32, np.bool_]:\n            weight_mask = np.array([1, 0, 0, 1], dtype=dt)\n            ground_truth = np.array([[0, 3]])\n\n            query_tokens_obj = bm25s.tokenize([query], stopwords=\"en\", stemmer=self.stemmer, return_ids=True)\n\n            # retrieve the top 2 documents\n            results = self.retriever.retrieve(query_tokens_obj, k=2, weight_mask=weight_mask).documents\n            \n            # assert that the retrieved indices are correct\n            self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n\n            # now, try tokenizing with text tokens\n            query_tokens_texts = bm25s.tokenize([query], stopwords=\"en\", stemmer=self.stemmer, return_ids=False)\n            results = self.retriever.retrieve(query_tokens_texts, k=2, weight_mask=weight_mask).documents\n            self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n\n            # now, try to pass a tuple of tokens\n            ids, vocab = query_tokens_obj\n            query_tokens_tuple = (ids, vocab)\n            results = self.retriever.retrieve(query_tokens_tuple, k=2, weight_mask=weight_mask).documents\n            self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n\n            # finally, try to pass a 2-tuple of tokens with text tokens to \"try to trick the system\"\n            queries_as_tuple = (query_tokens_texts[0], query_tokens_texts[0])\n            # only retrieve 1 document\n            ground_truth = np.array([[0], [0]])\n            results = self.retriever.retrieve(queries_as_tuple, k=1, weight_mask=weight_mask).documents\n            self.assertTrue(np.array_equal(ground_truth, results), f\"Expected {ground_truth}, got {results}\")\n", "code_sha256": "65a762795df710cb89e821035e902f461bcb3dc47c1b6170c8b62acd81f89f61", "comments": [{"line": 101, "text": "# first, try with default mode"}, {"line": 102, "text": "# weights should be [2, 1, 1, 1], but after masking should be [2, 0, 0, 1]"}, {"line": 110, "text": "# retrieve the top 2 documents"}, {"line": 113, "text": "# assert that the retrieved indices are correct"}, {"line": 116, "text": "# now, try tokenizing with text tokens"}, {"line": 121, "text": "# now, try to pass a tuple of tokens"}, {"line": 127, "text": "# finally, try to pass a 2-tuple of tokens with text tokens to \"try to trick the system\""}, {"line": 129, "text": "# only retrieve 1 document"}], "decorators": [], "definition_line": 98, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5718fb93b60a5492163f5d29f31e473256f4b83dc609b998383a179f58528a5b", "id": "code_candidate_e6ef85ea334d103d90310cf6a0a679289f285489779560d545341a9c6ba732c7", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 132, "line_start": 98, "name": "test_retrieve_with_weight_mask", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "