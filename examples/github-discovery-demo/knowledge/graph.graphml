    <node id="code_candidate_c96df7ef0b3bef95991958d48d20c123be907505a667be5eddc0fe6bbfe2a827">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_decode_method(self):\n        \"\"\"Tests the `to_lists_of_strings` method to ensure it converts token IDs back to strings properly.\"\"\"\n        docs = self.tokenizer.tokenize(self.corpus_large[:1000], return_as=\"ids\", show_progress=False)\n        strings = self.tokenizer.decode(docs) # type: ignore\n        self.assertIsInstance(strings, list)\n        for doc in strings:\n            self.assertIsInstance(doc, list)\n            for token in doc:\n                self.assertIsInstance(token, str)\n", "code_sha256": "82ceab220a8422326f38f8cc1f09dd050e432b545947a7cc8d7f3389a72d5617", "comments": [{"line": 138, "text": "# type: ignore"}], "decorators": [], "definition_line": 135, "docstring": "Tests the `to_lists_of_strings` method to ensure it converts token IDs back to strings properly.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_c96df7ef0b3bef95991958d48d20c123be907505a667be5eddc0fe6bbfe2a827", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 143, "line_start": 135, "name": "test_decode_method", "parameters": [{"annotation":