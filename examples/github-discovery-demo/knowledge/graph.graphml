      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_allow_empty_false(self):\n        \"\"\"Test tokenization with allow_empty=False\"\"\"\n        texts = [\"\"]  # Empty string\n        result = bm25s.tokenize(texts, allow_empty=False, return_ids=True)\n        \n        # Should have one token (empty string token)\n        self.assertEqual(len(result.ids[0]), 1)\n", "code_sha256": "d5a331beba0c748b0193bcb0f4091b75e21210efedd3b1fcf400a78d2c6e5a04", "comments": [{"line": 149, "text": "# Empty string"}, {"line": 152, "text": "# Should have one token (empty string token)"}], "decorators": [], "definition_line": 147, "docstring": "Test tokenization with allow_empty=False", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_141683041c29ca7d473373207ba75ad821b3514362c8344cae53079d1cde372d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 153, "line_start": 147, "name": "test_tokenize_allow_empty_false", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenize_allow_empty_false", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_tokenize_allow_empty_false(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": n