      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_stopwords_invalid_string(self):\n        \"\"\"Test stopwords inference raises error for invalid language string\"\"\"\n        with self.assertRaises(ValueError):\n            _infer_stopwords(\"invalid_language_code\")\n", "code_sha256": "b90c010ac2d8123967630bba9ab3338458eee4a4f2394ec9e6aa40555a62b3fc", "comments": [], "decorators": [], "definition_line": 45, "docstring": "Test stopwords inference raises error for invalid language string", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_59647a708ab97a848c59690a9c456fca3b66f577f861e8e50bb04afd8b133d53", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 48, "line_start": 45, "name": "test_infer_stopwords_invalid_string", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_infer_stopwords_invalid_string", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_infer_stopwords_invalid_string(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6e4f348f68071df2836562d96b9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
