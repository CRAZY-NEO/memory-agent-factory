    <node id="code_candidate_3a9742b5c1c532adcb58670e827321e8186ee4196c1e174fc01a33af477750b9">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenizer_update_vocab_never(self):\n        \"\"\"Test tokenizer with update_vocab='never'\"\"\"\n        tokenizer = Tokenizer()\n        # Pre-populate vocab\n        tokenizer.word_to_id = {\"hello\": 0, \"world\": 1}\n        \n        # Tokenize with update_vocab='never'\n        texts = [\"hello world new\"]\n        result = tokenizer.tokenize(texts, update_vocab=\"never\", return_as=\"ids\")\n        \n        # Should only have hello and world, not 'new'\n        self.assertEqual(len(result[0]), 2)\n", "code_sha256": "2f91487c13202623afff105d81d0ca6cb6abc58c66d29c3cf0777696de11d18c", "comments": [{"line": 59, "text": "# Pre-populate vocab"}, {"line": 62, "text": "# Tokenize with update_vocab='never'"}, {"line": 66, "text": "# Should only have hello and world, not 'new'"}], "decorators": [], "definition_line": 56, "docstring": "Test tokenizer with update_vocab='never'", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_3a9742b5c1c532adcb58670e827321e8186ee4196c1e174fc01a33af477750b9", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 67, "line_start": 56, "name": "test_tokenizer_update_vocab_never", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenizer_update_vocab_never", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_tokenizer_update_vocab_never(self)", "source_id": "repo_source_5d82e505bf9c8a413a6c0e2ccb1e2f2b3a4efaf3957da90daecaf439042b2d6d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
