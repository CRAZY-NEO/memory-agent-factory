    <node id="code_candidate_ad1399219723512cd4f25c110abd71966834a2b787ad99b2d4047855ca591feb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_truncation_of_large_corpus(self):\n        small_unit = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n            # a line more than 10 tokens\n            \"a cat is a feline and likes to purr and the cat can jump very high with so careful but casual manner\",\n        ]\n        corpus = []\n        for i in range(1000):\n            corpus += small_unit\n        tokenized = bm25s.tokenize(corpus, stopwords=\"en\", return_ids=True)\n        repr_tokenized = repr(tokenized)\n        self.assertIn(\"... (total\", repr_tokenized,\n                      msg=\"it should include the '...' message, for the indication of the truncation.\")\n        self.assertIn(\", ...]\", repr_tokenized,\n                      msg=\"it should include the '...' message, for the indication of the truncation.\")\n", "code_sha256": "de0c39b93e0e4f688fd7a3fb8116896295be56552a009c77188fd236f99ec1e5", "comments": [{"line": 151, "text": "# a line more than 10 tokens"}], "decorators": [], "definition_line": 145, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_ad1399219723512cd4f25c110abd71966834a2b787ad99b2d4047855ca591feb", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 162, "line_start": 145, "name": "test_truncation_of_large_corpus", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_truncation_of_large_corpus", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_truncation_of_large_corpus(self)", "source_id": "repo_source_23d568375b3ef8a255d5097c4dfba9bbfbd9775040bff9bf96c69a677bdcdb80", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_aae7649330e60816b70b31010c7cf7e8a39673cd984bd13dd91ccc35e3a7b721">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_truncation_of_small_corpus(self):\n        corpus = [\"a cat is a feline\"]\n        tokenized = bm25s.tokenize(corpus, stopwords=\"en\", return_ids=True)\n        repr_tokenized = repr(tokenized)\n        self.assertNotIn(\"... (total\", repr_tokenized,\n                         msg=\"it should not include the '...' message when the corpus is small\")\n        self.assertNotIn(\", ...]\", repr_tokenized,\n                         msg=\"it should not include the '...' message when the doc is short\")\n", "code_sha256": "6e6def1418b921a54cf79ca98cce73510f2d8b418111cfb4ba21687b70d3bb40", "comments": [], "decorators": [], "definition_line": 164, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_aae7649330e60816b70b31010c7cf7e8a39673cd984bd13dd91ccc35e3a7b721", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 171, "line_start": 164, "name": "test_truncation_of_small_corpus", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_truncation_of_small_corpus", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_truncation_of_small_corpus(self)", "source_id": "repo_source_23d568375b3ef8a255d5097c4dfba9bbfbd