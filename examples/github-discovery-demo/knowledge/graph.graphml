    <node id="code_candidate_0c5960f6fa860e93baf183103b75db2ae6c386ddf055943d63ec2c6ea291ebfb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_stopwords_various_languages(self):\n        \"\"\"Test stopwords inference for all supported languages\"\"\"\n        # Test various language codes\n        lang_codes = [\n            (\"german\", \"de\"),\n            (\"dutch\", \"nl\"),\n            (\"french\", \"fr\"),\n            (\"spanish\", \"es\"),\n            (\"portuguese\", \"pt\"),\n            (\"italian\", \"it\"),\n            (\"russian\", \"ru\"),\n            (\"swedish\", \"sv\"),\n            (\"norwegian\", \"no\"),\n            (\"chinese\", \"zh\"),\n            (\"turkish\", \"tr\"),\n        ]\n        \n        for lang_name, lang_code in lang_codes:\n            # Test full name\n            stopwords = _infer_stopwords(lang_name)\n            self.assertIsInstance(stopwords, (list, tuple))\n            self.assertGreater(len(stopwords), 0)\n            \n            # Test code\n            stopwords = _infer_stopwords(lang_code)\n            self.assertIsInstance(stopwords, (list, tuple))\n            self.assertGreater(len(stopwords), 0)\n", "code_sha256": "98d4bca4eaf0cb4e49ceab0166dce9bb9956735b34da06a8006222fbe9ad7faf", "comments": [{"line": 11, "text": "# Test various language codes"}, {"line": 27, "text": "# Test full name"}, {"line": 32, "text": "# Test code"}], "decorators": [], "definition_line": 9, "docstring": "Test stopwords inference for all supported languages", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_0c5960f6fa860e93baf183103b75db2ae6c386ddf055943d63ec2c6ea291ebfb", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 35, "line_start": 9, "name": "test_infer_stopwords_various_languages", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_infer_stopwords_various_languages", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_infer_stopwords_various_languages(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6e4f348f68071df2836562d96b9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
