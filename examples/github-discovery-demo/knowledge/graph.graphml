    <node id="code_candidate_7d56856e581425f83f84d26877d65c2811356f2d7595ff0e5de901c3ed0920be">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(data_dir=\"datasets\", dataset=\"scifact\"):\n    # Load the queries from BEIR\n    data_path = beir.util.download_and_unzip(BASE_URL.format(dataset), data_dir)\n    loader = GenericDataLoader(data_folder=data_path)\n    corpus, queries, qrels = GenericDataLoader(data_folder=data_path).load(split='test')\n    corpus_lst = [doc[\"title\"] + \" \" + doc[\"text\"] for doc in corpus.values()]\n    queries_lst = list(queries.values())\n\n    # Initialize the stemmer\n    stemmer = Stemmer.Stemmer(\"english\")\n\n    # Initialize the Tokenizer with the stemmer\n    tokenizer = Tokenizer(\n        stemmer=stemmer,\n        lower=True, # lowercase the tokens\n        stopwords=\"english\",  # or pass a list of stopwords\n        splitter=r\"\\w+\",  # by default r\"(?u)\\b\\w\\w+\\b\", can also be a function\n    )\n\n    # Tokenize the corpus\n    corpus_tokenized = tokenizer.tokenize(\n        corpus_lst, \n        update_vocab=True, # update the vocab as we tokenize\n        return_as=\"ids\"\n    )\n\n    # stream tokenizing the queries, without updating the vocabulary\n    # note: this cannot return as string due to the streaming nature\n    tokenizer_stream = tokenizer.streaming_tokenize(\n        queries_lst, \n        update_vocab=False\n    )\n    query_ids = []\n\n    for q in tokenizer_stream:\n        # you can do something with the ids here, e.g. retrieve from the index\n        if 1 in q:\n            query_ids.append(q)\n\n    # you can convert the ids to a Tokenized namedtuple ids and tokens...\n    res = tokenizer.to_tokenized_tuple(query_ids)\n    # ... which is equivalent to: \n    # tokenizer.tokenize(your_query_lst, return_as=\"tuple\", update_vocab=False)\n\n    # You can verify the results\n    assert res.ids == query_ids\n    assert res.vocab == tokenizer.get_vocab_dict()\n    assert isinstance(res, Tokenized)\n\n    \n    # You can also get strings\n    query_strs = tokenizer.decode(query_ids)\n    # ... which is equivalent to: \n    # tokenizer.tokenize(your_query_lst, return_as=\"string\", update_vocab=False)\n\n    # let's verify the results\n    assert isinstance(query_strs, list)\n    assert isinstance(query_strs[0], list)\n    assert isinstance(query_strs[0][0], str)\n\n    # Let's see how it's all used\n    retriever = bm25s.BM25()\n    retriever.index(corpus_tokenized, leave_progress=False)\n\n    # all of the above can be passed to index a bm25s model\n\n    # e.g. using the ids directly\n    results, scores = retriever.retrieve(query_ids, k=3)\n\n    # or passing the strings\n    results, scores = retriever.retrieve(query_strs, k=3)\n\n    # or passing the Tokenized namedtuple\n    results, scores = retriever.retrieve(res, k=3)\n    \n    # or passing a tuple of ids and vocab dict\n    vocab_dict = tokenizer.get_vocab_dict()\n    results, scores = retriever.retrieve((query_ids, vocab_dict), k=3)\n\n    # If you want, you can save the vocab and stopwords, it can be the same dir as your index\n    your_index_dir = tempfile.mkdtemp()\n    tokenizer.save_vocab(save_dir=your_index_dir)\n\n    # Unhappy with your vocab? you can reset your tokenizer\n    tokenizer.reset_vocab()\n\n\n    # loading:\n    new_tokenizer = Tokenizer(\n        stemmer=stemmer,\n        lower=True,\n        stopwords=[],\n        splitter=r\"\\w+\",\n    )\n    print(\"Vocabulary size before reloading:\", len(new_tokenizer.get_vocab_dict()))\n    new_tokenizer.load_vocab(your_index_dir)\n    print(\"Vocabulary size after reloading:\", len(new_tokenizer.get_vocab_dict()))\n\n    # the same can be done for stopwords\n    print(\"stopwords before reloading:\", new_tokenizer.stopwords)\n    tokenizer.save_stopwords(save_dir=your_index_dir)\n    new_tokenizer.load_stopwords(your_index_dir)\n    print(\"stopwords after reloaded:\", new_tokenizer.stopwords)\n\n    # cleanup\n    shutil.rmtree(your_index_dir)\n", "code_sha256": "47af6d372f60aaa8d1468403268a56fbad4b42824ba85e5df227e44ac58c6195", "comments": [{"line": 19, "text": "# Load the queries from BEIR"}, {"line": 26, "text": "# Initialize the stemmer"}, {"line": 29, "text": "# Initialize the Tokenizer with the stemmer"}, {"line": 32, "text": "# lowercase the tokens"}, {"line": 33, "text": "# or pass a list of stopwords"}, {"line": 34, "text": "# by default r\"(?u)\\b\\w\\w+\\b\", can also be a function"}, {"line": 37, "text": "# Tokenize the corpus"}, {"line": 40, "text": "# update the vocab as we tokenize"}, {"line": 44, "text": "# stream tokenizing the queries, without updating the vocabulary"}, {"line": 45, "text": "# note: this cannot return as string due to the streaming nature"}, {"line": 53, "text": "# you can do something with the ids here, e.g. retrieve from the index"}, {"line": 57, "text": "# you can convert the ids to a Tokenized namedtuple ids and tokens..."}, {"line": 59, "text": "# ... which is equivalent to: "}, {"line": 60, "text": "# tokenizer.tokenize(your_query_lst, return_as=\"tuple\", update_vocab=False)"}, {"line": 62, "text": "# You can verify the results"}, {"line": 68, "text": "# You can also get strings"}, {"line": 70, "text": "# ... which is equivalent to: "}, {"line": 71, "text": "# tokenizer.tokenize(your_query_lst, return_as=\"string\", update_vocab=False)"}, {"line": 73, "text": "# let's verify the results"}, {"line": 78, "text": "# Let's see how it's all used"}, {"line": 82, "text": "# all of the above can be passed to index a bm25s model"}, {"line": 84, "text": "# e.g. using the ids directly"}, {"line": 87, "text": "# or passing the strings"}, {"line": 90, "text": "# or passing the Tokenized namedtuple"}, {"line": 93, "text": "# or passing a tuple of ids and vocab dict"}, {"line": 97, "text": "# If you want, you can save the vocab and stopwords, it can be the same dir as your index"}, {"line": 101, "text": "# Unhappy with your vocab? you can reset your tokenizer"}, {"line": 105, "text": "# loading:"}, {"line": 116, "text": "# the same can be done for stopwords"}, {"line": 122, "text": "# cleanup"}], "decorators": [], "definition_line": 18, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a1f35c37fccfc2beff6702b9ec7482d4edb79ba18ed21f83c2be1e03edb14576", "id": "code_candidate_7d56856e581425f83f84d26877d65c2811356f2d7595ff0e5de901c3ed0920be", "imports": [{"alias": null, "level": 0, "line": 7, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "beir.util", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "beir.datasets.data_loader", "name": "GenericDataLoader"}, {"alias": null, "level": 0, "line": 11, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils.beir", "name": "BASE_URL"}, {"alias": null, "level": 0, "line": 15, "module": "bm25s.tokenization", "name": "Tokenized"}, {"alias": null, "level": 0, "line": 15, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "function", "line_end": 123, "line_start": 18, "name": "main", "parameters": [{"annotation": null, "default": "'datasets'", "kind": "positional_or_keyword", "name": "data_dir"}, {"annotation": null, "default": "'scifact'", "kind": "positional_or_keyword", "name": "dataset"}], "path": "examples/tokenizer_class.py", "qualified_name": "main", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def main(data_dir='datasets', dataset='scifact')", "source_id": "repo_source_c50830230e947767224692d6a30a31234941b40d2d4b93b3aa05024952da07e9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
