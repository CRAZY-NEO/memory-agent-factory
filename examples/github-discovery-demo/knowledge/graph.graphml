    <node id="code_candidate_069e8401228daba5b3e78c7774a521a0a68ecd0a8b58b4abc2ab67b923d428dc">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _build_nonoccurrence_array(\n    doc_frequencies: dict,\n    n_docs: int,\n    compute_idf_fn: callable,\n    calculate_tfc_fn: callable,\n    l_d,\n    l_avg,\n    k1,\n    b,\n    delta,\n    dtype=\"float32\",\n) -&gt; np.ndarray:\n    \"\"\"\n    The non-occurrence array is used to store the idf score for tokens that do not occur in the\n    document. This is useful for BM25L and BM25+ variants, where we need to calculate the idf\n    score for tokens that do not occur in the document, which will be used to calculate the\n    final score.\n\n    The nonoccurence array has length |V|, where V is the set of unique tokens in the corpus.\n\n    The `compute_idf_fn` is the function to calculate the idf score for a token that does not occur\n    in the document. The `calculate_tfc_fn` is the function to calculate the term frequency component\n    of the BM25 score, which is used to calculate the final score for tokens that do not occur in the\n    document.\n    \"\"\"\n    n_vocab = len(doc_frequencies)\n    nonoccurrence_array = np.zeros(n_vocab, dtype=dtype)\n\n    for token_id, df in doc_frequencies.items():\n        if df != 0:\n            idf = compute_idf_fn(df, N=n_docs)\n            tfc = calculate_tfc_fn(\n                tf_array=0, l_d=l_d, l_avg=l_avg, k1=k1, b=b, delta=delta\n            )\n            nonoccurrence_array[token_id] = idf * tfc\n\n    return nonoccurrence_array\n", "code_sha256": "b18045095d4ed27f8abf045fd3f06aa21a0bc81f21d44abbfd664cef99c1701e", "comments": [], "decorators": [], "definition_line": 76, "docstring": "\n    The non-occurrence array is used to store the idf score for tokens that do not occur in the\n    document. This is useful for BM25L and BM25+ variants, where we need to calculate the idf\n    score for tokens that do not occur in the document, which will be used to calculate the\n    final score.\n\n    The nonoccurence array has length |V|, where V is the set of unique tokens in the corpus.\n\n    The `compute_idf_fn` is the function to calculate the idf score for a token that does not occur\n    in the document. The `calculate_tfc_fn` is the function to calculate the term frequency component\n    of the BM25 score, which is used to calculate the final score for tokens that do not occur in the\n    document.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_069e8401228daba5b3e78c7774a521a0a68ecd0a8b58b4abc2ab67b923d428dc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 112, "line_start": 76, "name": "_build_nonoccurrence_array", "parameters": [{"annotation": "dict", "default": null, "kind": "positional_or_keyword", "name": "doc_frequencies"}, {"annotation": "int", "default": null, "kind": "positional_or_keyword", "name": "n_docs"}, {"annotation": "callable", "default": null, "kind": "positional_or_keyword", "name": "compute_idf_fn"}, {"annotation": "callable", "default": null, "kind": "positional_or_keyword", "name": "calculate_tfc_fn"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_d"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_avg"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k1"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "b"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "delta"}, {"annotation": null, "default": "'float32'", "kind": "positional_or_keyword", "name": "dtype"}], "path": "bm25s/scoring.py", "qualified_name": "_build_nonoccurrence_array", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "np.ndarray", "signature": "def _build_nonoccurrence_array(doc_frequencies: dict, n_docs: int, compute_idf_fn: callable, calculate_tfc_fn: callable, l_d, l_avg, k1, b, delta, dtype='float32') -&gt; np.ndarray", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
