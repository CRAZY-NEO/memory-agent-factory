    <node id="code_candidate_03c0e9aa346a4cb188d05f93ec6e9a9194f7e35e67d7ec0a9ad2a463a947ea29">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _normalize_version(value):\n    version = value.strip()\n    if version.startswith(\"refs/tags/\"):\n        version = version.rsplit(\"/\", 1)[-1]\n    if version.startswith(\"v\"):\n        version = version[1:]\n    return version\n", "code_sha256": "c0ba7224954d153004286f4cab99c742d6ceb882efbc3fa5c43f93b1e178a098", "comments": [], "decorators": [], "definition_line": 12, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_03c0e9aa346a4cb188d05f93ec6e9a9194f7e35e67d7ec0a9ad2a463a947ea29", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 18, "line_start": 12, "name": "_normalize_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "value"}], "path": "setup.py", "qualified_name": "_normalize_version", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _normalize_version(value)", "source_id": "repo_source_3c0d305f10eb306cd3fff0347217bae386f41f7f7d84c64af09d4d3b405f33d8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
