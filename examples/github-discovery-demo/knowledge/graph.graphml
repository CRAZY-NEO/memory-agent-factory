      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def search(self, queries: List[str], k: int = 10, n_jobs: int = 1):\n        # Ensure k is not larger than the corpus size\n        num_docs = len(self.corpus)\n        if k &gt; num_docs:\n            k = num_docs\n\n        tokenized_queries = self.tokenizer.tokenize(\n            queries,\n            update_vocab=False,\n            show_progress=self.show_progress,\n            leave_progress=self.leave_progress,\n            return_as=\"tuple\",\n            allow_empty=False,\n        )\n        \n        # Handle empty queries explicitly to avoid issues with Numba backend\n        # We filter out queries that result in no tokens\n        non_empty_indices = []\n        empty_indices = []\n        \n        # We access internal ids list from Tokenized namedtuple\n        # Convert to string list first as retrieve expects that or Tokenized object\n        # But checking emptiness is easier on ids\n        \n        for i, q_ids in enumerate(tokenized_queries.ids):\n            if len(q_ids) &gt; 0:\n                non_empty_indices.append(i)\n            else:\n                empty_indices.append(i)\n        \n        # Prepare results structure\n        results = [None] * len(queries)\n        \n        # Process empty queries immediately\n        for i in empty_indices:\n            # Empty query results in empty list of documents\n            # Or do we want to return empty docs with 0 score? \n            # Standard BM25 usually returns nothing for empty query, or 0 score for all docs.\n            # Let's return empty list as top-k results.\n            results[i] = []\n\n        if len(non_empty_indices) &gt; 0:\n            # Create a new Tokenized object for non-empty queries\n            non_empty_ids = [tokenized_queries.ids[i] for i in non_empty_indices]\n            non_empty_tokenized = self.tokenizer.to_tokenized_tuple(non_empty_ids)\n            \n            # Retrieve for non-empty queries\n            # note: because we did not pass `corpus` when initializing BM25,\n            # the retrieve() will return document ids instead of texts.\n            doc_ids, scores = self.retriever.retrieve(\n                query_tokens=non_empty_tokenized,\n                k=k,\n                sorted=True,\n                return_as=\"tuple\",\n                show_progress=self.show_progress,\n                leave_progress=self.leave_progress,\n                n_threads=n_jobs,\n                chunksize=50,\n                backend_selection=\"auto\",\n            )\n            \n            # Map back to original indices\n            num_docs = doc_ids.shape[1]\n            \n            for idx, original_idx in enumerate(non_empty_indices):\n                query_results = []\n                for di in range(num_docs):\n                    doc_id = doc_ids[idx, di]\n                    doc_text = self.corpus[doc_id]\n                    query_results.append(\n                        {\n                            \"id\": int(doc_id),\n                            \"score\": float(scores[idx, di]),\n                            \"document\": doc_text,\n                        }\n                    )\n                results[original_idx] = query_results\n\n        return results\n", "code_sha256": "5834499f796bb8776ab5cd136e3db2eed16eaa68785680a781e5d5e64d072a01", "comments": [{"line": 93, "text": "# Ensure k is not larger than the corpus size"}, {"line": 107, "text": "# Handle empty queries explicitly to avoid issues with Numba backend"}, {"line": 108, "text": "# We filter out queries that result in no tokens"}, {"line": 112, "text": "# We access internal ids list from Tokenized namedtuple"}, {"line": 113, "text": "# Convert to string list first as retrieve expects that or Tokenized object"}, {"line": 114, "text": "# But checking emptiness is easier on ids"}, {"line": 122, "text": "# Prepare results structure"}, {"line": 125, "text": "# Process empty queries immediately"}, {"line": 127, "text": "# Empty query results in empty list of documents"}, {"line": 128, "text": "# Or do we want to return empty docs with 0 score? "}, {"line": 129, "text": "# Standard BM25 usually returns nothing for empty query, or 0 score for all docs."}, {"line": 130, "text": "# Let's return empty list as top-k results."}, {"line": 134, "text": "# Create a new Tokenized object for non-empty queries"}, {"line": 138, "text": "# Retrieve for non-empty queries"}, {"line": 139, "text": "# note: because we did not pass `corpus` when initializing BM25,"}, {"line": 140, "text": "# the retrieve() will return document ids instead of texts."}, {"line": 153, "text": "# Map back to original indices"}], "decorators": [], "definition_line": 92, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "946e755ab1ea7890870f58c12cc72022dac540c52d09c0cb0be179acbe05acb8", "id": "code_candidate_b4fb97112711915b2b0dfb351d2fee82972c1eee39ec22f031f433c8eda9099c", "imports": [{"alias": null, "level": 0, "line": 9, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "csv", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 12, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 14, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 15, "module": "typing", "name": "List"}], "kind": "method", "line_end": 170, "line_start": 92, "name": "search", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[str]", "default": null, "kind": "positional_or_keyword", "name": "queries"}, {"annotation": "int", "default": "10", "kind": "positional_or_keyword", "name": "k"}, {"annotation": "int", "default": "1", "kind": "positional_or_keyword", "name": "n_jobs"}], "path": "bm25s/high_level/__init__.py", "qualified_name": "BM25Search.search", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def search(self, queries: List[str], k: int=10, n_jobs: int=1)", "source_id": "repo_source_db732141b7e7ae5212e90e5896dac429d4373f6c35b2637f77baeca3592a4c3b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
