      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_topk_numba_sorted(self):\n        result_scores, result_indices = topk(self.scores, self.k, backend=\"numba\", sorted=True)\n        self.check_results(result_scores, result_indices, sorted=True)\n", "code_sha256": "c307d0059bc1bec4596beca802d2f6666df3ddf447c7cb2a76cc79cc9ae5d776", "comments": [], "decorators": [], "definition_line": 34, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "d3edf322f0f6a98845031102b759253f4a38ea8f7bced4d14206cd4b498500ed", "id": "code_candidate_4a9def6418f37f5252a732f869cf2cd6846a375dcdb81b3ad019618d3e6e8d64", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.numba.selection", "name": "topk"}], "kind": "method", "line_end": 36, "line_start": 34, "name": "test_topk_numba_sorted", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/numba/test_topk_numba.py", "qualified_name": "TestTopKSingleQuery.test_topk_numba_sorted", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_topk_numba_sorted(self)", "source_id": "repo_source_96e34f39921b537a86bcc7eaa31a11534437912859ddaa910322b9bb7c3fbcfe", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
