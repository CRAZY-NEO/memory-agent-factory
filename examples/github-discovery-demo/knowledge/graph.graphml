    <node id="code_candidate_747d9a6ca0442b277b44d1ef6ed45d1ab00b364884dfec95e1474abc3fe96b7e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _normalize_version(value):\n    version = value.strip()\n    if version.startswith(\"refs/tags/\"):\n        version = version.rsplit(\"/\", 1)[-1]\n    if version.startswith(\"v\"):\n        version = version[1:]\n    return version\n", "code_sha256": "c0ba7224954d153004286f4cab99c742d6ceb882efbc3fa5c43f93b1e178a098", "comments": [], "decorators": [], "definition_line": 15, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_747d9a6ca0442b277b44d1ef6ed45d1ab00b364884dfec95e1474abc3fe96b7e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 21, "line_start": 15, "name": "_normalize_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "value"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_normalize_version", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _normalize_version(value)", "source_id": "repo_source_e5fc7c562f0444f38f1579ffd481649872143a2e16ecd1931db291ef5c679eef", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
