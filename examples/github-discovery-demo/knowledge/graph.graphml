    <node id="code_candidate_d105f5efc8170be42718b36e9ff632a8c778174ce54e0138d6a72972f77da8dc">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def check_results(self, result_scores, result_indices, sorted=True):\n        if sorted:\n            np.testing.assert_allclose(result_scores, self.expected_scores)\n            np.testing.assert_array_equal(result_indices, self.expected_indices)\n        else:\n            self.assertEqual(len(result_scores), self.k)\n            self.assertEqual(len(result_indices), self.k)\n            self.assertTrue(np.all(np.isin(result_scores, self.expected_scores)))\n            self.assertTrue(np.all(np.isin(result_indices, self.expected_indices)))\n", "code_sha256": "b80fb72e580830f8876bce913f859c57d1d5bfbf670922083953661ed76e4055", "comments": [], "decorators": [], "definition_line": 24, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4e6fe4c42ffcc02b2eba717ac7e1ebacb1d7f64f561ecd9bad0fa3e71b47f4fb", "id": "code_candidate_d105f5efc8170be42718b36e9ff632a8c778174ce54e0138d6a72972f77da8dc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.selection", "name": "topk"}], "kind": "method", "line_end": 32, "line_start": 24, "name": "check_results", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "result_indices"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "sorted"}], "path": "tests/core/test_topk.py", "qualified_name": "TestTopKSingleQuery.check_results", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def check_results(self, result_scores, result_indices, sorted=True)", "source_id": "repo_source_f170fde293ed6d8972fe591f8d0f01150ec7c1db1d99a8a1b4550bf94b512791", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
