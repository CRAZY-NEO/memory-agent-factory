    <node id="code_candidate_e88d5163008a23437550df498a5f204406cce63a9f31f7a401add0b98a5cebf2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_scores_with_invalid_token_type(self):\n        \"\"\"Test get_scores with invalid token type in list\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Try with a list of floats\n        with self.assertRaises(ValueError) as context:\n            retriever.get_scores([1.5, 2.5])\n        self.assertIn(\"must be a list of tokens\", str(context.exception))\n", "code_sha256": "be9beeec1905d54349f11bfd72bc69327be1f7c2ae5f06d5f1c63169a4feac1b", "comments": [{"line": 190, "text": "# Try with a list of floats"}], "decorators": [], "definition_line": 185, "docstring": "Test get_scores with invalid token type in list", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_e88d5163008a23437550df498a5f204406cce63a9f31f7a401add0b98a5cebf2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 193, "line_start": 185, "name": "test_get_scores_with_invalid_token_type", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_get_scores_with_invalid_token_type", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_get_scores_with_invalid_token_type(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
