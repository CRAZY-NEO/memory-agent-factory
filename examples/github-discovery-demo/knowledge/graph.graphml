      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_dumps_with_builtin_ensure_ascii(self):\n        \"\"\"Test dumps_with_builtin with ensure_ascii parameter\"\"\"\n        data = {\"text\": \"hello world\"}\n        result = json_functions.dumps_with_builtin(data, ensure_ascii=True)\n        self.assertIsInstance(result, str)\n", "code_sha256": "21f7ff167ae230a13e6b805fc8cd4d40590976741837b7323dee1836cb35882e", "comments": [], "decorators": [], "definition_line": 16, "docstring": "Test dumps_with_builtin with ensure_ascii parameter", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_94ea60d1d21dae39e85c6f12ccc2b4f30b3a479cdbdc5f2372ba352ef9386e4f", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 20, "line_start": 16, "name": "test_dumps_with_builtin_ensure_ascii", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_dumps_with_builtin_ensure_ascii", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_dumps_with_builtin_ensure_ascii(self)", "source_id": "repo_source_86363c7bd77007a75cd4fcb61002823231dd283e1b4458a0392c9c3492df5123", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
