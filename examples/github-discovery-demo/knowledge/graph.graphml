    <node id="code_candidate_8687a7a6798c5e775a06643434c1f1f56d8747956f79d601853e0a4e34c8b2d3">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def evaluate(\n    qrels: Dict[str, Dict[str, int]],\n    results: Dict[str, Dict[str, float]],\n    k_values: List[int],\n    ignore_identical_ids: bool = True,\n) -&gt; Tuple[Dict[str, float], Dict[str, float], Dict[str, float], Dict[str, float]]:\n    \"\"\"\n    Acknowledgement: This function is adapted from BEIR's EvaluateRetrieval class.\n    License for this function: Apache-2.0\n    \"\"\"\n    try:\n        import pytrec_eval\n    \n    except ImportError:\n        raise ImportError(\n            \"Please install pytrec_eval to use this function. You can install it via `pip install pytrec_eval`.\"\n        )\n\n    if ignore_identical_ids:\n        logging.info(\n            \"For evaluation, we ignore identical query and document ids (default), please explicitly set ``ignore_identical_ids=False`` to ignore this.\"\n        )\n        popped = []\n        for qid, rels in results.items():\n            for pid in list(rels):\n                if qid == pid:\n                    results[qid].pop(pid)\n                    popped.append(pid)\n\n    ndcg = {}\n    _map = {}\n    recall = {}\n    precision = {}\n\n    for k in k_values:\n        ndcg[f\"NDCG@{k}\"] = 0.0\n        _map[f\"MAP@{k}\"] = 0.0\n        recall[f\"Recall@{k}\"] = 0.0\n        precision[f\"P@{k}\"] = 0.0\n\n    map_string = \"map_cut.\" + \",\".join([str(k) for k in k_values])\n    ndcg_string = \"ndcg_cut.\" + \",\".join([str(k) for k in k_values])\n    recall_string = \"recall.\" + \",\".join([str(k) for k in k_values])\n    precision_string = \"P.\" + \",\".join([str(k) for k in k_values])\n    evaluator = pytrec_eval.RelevanceEvaluator(\n        qrels, {map_string, ndcg_string, recall_string, precision_string}\n    )\n    scores = evaluator.evaluate(results)\n\n    for query_id in scores.keys():\n        for k in k_values:\n            ndcg[f\"NDCG@{k}\"] += scores[query_id][\"ndcg_cut_\" + str(k)]\n            _map[f\"MAP@{k}\"] += scores[query_id][\"map_cut_\" + str(k)]\n            recall[f\"Recall@{k}\"] += scores[query_id][\"recall_\" + str(k)]\n            precision[f\"P@{k}\"] += scores[query_id][\"P_\" + str(k)]\n\n    for k in k_values:\n        ndcg[f\"NDCG@{k}\"] = round(ndcg[f\"NDCG@{k}\"] / len(scores), 5)\n        _map[f\"MAP@{k}\"] = round(_map[f\"MAP@{k}\"] / len(scores), 5)\n        recall[f\"Recall@{k}\"] = round(recall[f\"Recall@{k}\"] / len(scores), 5)\n        precision[f\"P@{k}\"] = round(precision[f\"P@{k}\"] / len(scores), 5)\n\n    for eval in [ndcg, _map, recall, precision]:\n        logging.info(\"\\n\")\n        for k in eval.keys():\n            logging.info(\"{}: {:.4f}\".format(k, eval[k]))\n\n    return ndcg, _map, recall, precision\n", "code_sha256": "a6243d5cccce1a3023406c510d538067a3f3281560d06e6172c322c1a44c663d", "comments": [], "decorators": [], "definition_line": 334, "docstring": "\n    Acknowledgement: This function is adapted from BEIR's EvaluateRetrieval class.\n    License for this function: Apache-2.0\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_8687a7a6798c5e775a06643434c1f1f56d8747956f79d601853e0a4e34c8b2d3", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 401, "line_start": 334, "name": "evaluate", "parameters": [{"annotation": "Dict[str, Dict[str, int]]", "default": null, "kind": "positional_or_keyword", "name": "qrels"}, {"annotation": "Dict[str, Dict[str, float]]", "default": null, "kind": "positional_or_keyword", "name": "results"}, {"annotation": "List[int]", "default": null, "kind": "positional_or_keyword", "name": "k_values"}, {"annotation": "bool", "default": "True", "kind": "positional_or_keyword", "name": "ignore_identical_ids"}], "path": "bm25s/utils/beir.py", "qualified_name": "evaluate", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "Tuple[Dict[str, float], Dict[str, float], Dict[str, float], Dict[str, float]]", "signature": "def evaluate(qrels: Dict[str, Dict[str, int]], results: Dict[str, Dict[str, float]], k_values: List[int], ignore_identical_ids: bool=True) -&gt; Tuple[Dict[str, float], Dict[str, float], Dict[str, float], Dict[str, float]]", "source_id": "repo_source_77ca391adf493104c5b8e45f605714d19238af83005c86fcfe57f52fd5d17419", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
