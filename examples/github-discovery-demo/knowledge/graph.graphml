    <node id="code_candidate_5fd21422558856d97a7cfdf9e534c9b692549af7abc37ed8830430251f95eadb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def dumps_with_orjson(d: dict, **kwargs) -&gt; str:\n    if kwargs.get(\"ensure_ascii\", True):\n        # Simulate `ensure_ascii=True` by escaping non-ASCII characters\n        return orjson.dumps(d).decode(\"utf-8\").encode(\"ascii\", \"backslashreplace\").decode(\"utf-8\")\n    # Ignore other kwargs not supported by orjson\n    return orjson.dumps(d).decode(\"utf-8\")\n", "code_sha256": "7b825f6e197541e22428d3f33fea9642beb418f7270345d20d220b6213c6cede", "comments": [{"line": 15, "text": "# Simulate `ensure_ascii=True` by escaping non-ASCII characters"}, {"line": 17, "text": "# Ignore other kwargs not supported by orjson"}], "decorators": [], "definition_line": 13, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "8c3ebfc1efe2024a36692729d1eea6a8c49676966b96ce4c347fbdc338034450", "id": "code_candidate_5fd21422558856d97a7cfdf9e534c9b692549af7abc37ed8830430251f95eadb", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "orjson", "name": null}], "kind": "function", "line_end": 18, "line_start": 13, "name": "dumps_with_orjson", "parameters": [{"annotation": "dict", "default": null, "kind": "positional_or_keyword", "name": "d"}, {"annotation": null, "default": null, "kind": "var_keyword", "name": "kwargs"}], "path": "bm25s/utils/json_functions.py", "qualified_name": "dumps_with_orjson", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "str", "signature": "def dumps_with_orjson(d: dict, **kwargs) -&gt; str", "source_id": "repo_source_141eb3492d81f410ceeddc418c0bf3fd6e0b391c6f120f962d2ca9bc0986a2f8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
