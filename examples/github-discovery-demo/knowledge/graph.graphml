      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_invalid_weight_mask_type(self):\n        \"\"\"Test retrieve with weight_mask that is not numpy array\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\"]]\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(query_tokens, k=2, weight_mask=[1, 0, 1, 0])\n        self.assertIn(\"weight_mask must be a numpy array\", str(context.exception))\n", "code_sha256": "6040c2c31da187a860a4509feeee072b8dd7e056e8e892f1dd3bd6333badffc7", "comments": [], "decorators": [], "definition_line": 276, "docstring": "Test retrieve with weight_mask that is not numpy array", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_9013a1866775c0e5464d46cc071e76372002e4a990305d64a8c00d8fe001ab43", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 285, "line_start": 276, "name": "test_retrieve_with_invalid_weight_mask_type", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.p