      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_compute_relevance_from_scores_legacy_empty_query(self):\n        \"\"\"Test the legacy implementation with empty query\"\"\"\n        data = np.array([1.0, 2.0], dtype=np.float32)\n        indices = np.array([0, 1], dtype=np.int32)\n        indptr = np.array([0, 1, 2], dtype=np.int32)\n        num_docs = 3\n        query_tokens_ids = []\n        dtype = np.float32\n\n        scores = _compute_relevance_from_scores_legacy(\n            data, indptr, indices, num_docs, query_tokens_ids, dtype\n        )\n\n        # Expected: all zeros for empty query\n        expected = np.array([0.0, 0.0, 0.0], dtype=np.float32)\n        np.testing.assert_array_almost_equal(scores, expected)\n", "code_sha256": "954a7f283e1900630b7145a636024cdde88ce5b4aa46d25b5c7f41a0ed88095c", "comments": [{"line": 60, "text": "# Expected: all zeros for empty query"}], "decorators": [], "definition_line": 47, "docstring": "Test the legacy implementation with empty query", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "12dde22d99c544ae01ed2fce528c6a05ab27be8a781de28a699c38a8397797a8", "id": "code_candidate_d451a65bcc3688c22f4c39a30c2349a67c384fb47c8d2c87f2586f0e80d5f740", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_legacy"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_tfc_scorer"}], "kind": "method", "line_end": 62, "line_start": 47, "name": "test_compute_rele