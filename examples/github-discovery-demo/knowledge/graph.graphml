    <node id="code_candidate_b8245ffb59bb2ae5439604bcaa467e580d771b8f991732bfa4389e1e230fa1bb">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_with_custom_splitter(self):\n        \"\"\"Tests the `tokenize` method and `__init__` method with a custom splitter.\"\"\"\n        custom_splitter = lambda text: re.findall(r\"\\w+\", text)\n        tokenizer = Tokenizer(splitter=custom_splitter, stemmer=self.stemmer)\n        result = tokenizer.tokenize(self.corpus, update_vocab=True, return_as=\"ids\", show_progress=False)\n        self.assertIsInstance(result, list)\n", "code_sha256": "742ef3c71528d631933fc1ee35afe79c282fc8ca5bff125cac281a707d44cad1", "comments": [], "decorators": [], "definition_line": 50, "docstring": "Tests the `tokenize` method and `__init__` method with a custom splitter.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_b8245ffb59bb2ae5439604bcaa467e580d771b8f991732bfa4389e1e230fa1bb", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 55, "line_start": 50, "name": "test_tokenize_with_custom_splitter", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_