    <node id="code_candidate_1f4e5d17a5f9c10b12527c11fd612f8d762afac17b720b3a5b87ae90ee20d7dc">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_n_threads_minus_one(self):\n        \"\"\"Test retrieve with n_threads=-1 to use all CPUs\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\", \"feline\"]]\n        \n        # Should work with n_threads=-1\n        results = retriever.retrieve(query_tokens, k=2, n_threads=-1)\n        self.assertEqual(len(results.documents), 1)\n", "code_sha256": "64656859308c88e0ac05e1f98a065e4230aa787125e13883bd5cec572d0094af", "comments": [{"line": 202, "text": "# Should work with n_threads=-1"}], "decorators": [], "definition_line": 195, "docstring": "Test retrieve with n_threads=-1 to use all CPUs", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_1f4e5d17a5f9c10b12527c11fd612f8d762afac17b720b3a5b87ae90ee20d7dc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 204, "line_start": 195, "name": "test_retrieve_with_n_threads_minus_one", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_n_threads_minus_one", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_retrieve_with_n_threads_minus_one(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
