    <node id="code_candidate_649a801aa69a8e369a6a882b4259fdfb83d857626a02622844f8fe203c78e1f1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_change_extension(self):\n        \"\"\"Test change_extension utility\"\"\"\n        path = \"/path/to/file.txt\"\n        result = change_extension(path, \".json\")\n        self.assertEqual(result, \"/path/to/file.json\")\n        \n        for path, expected in [\n            (\"file\", \"file.json\"),\n            (\".corpus\", \".corpus.json\"),\n            (os.path.join(\"data.v1\", \"corpus\"), os.path.join(\"data.v1\", \"corpus.json\")),\n            (os.path.join(\"data.v1\", \"corpus.jsonl\"), os.path.join(\"data.v1\", \"corpus.json\")),\n            (\"corpus.backup.jsonl\", \"corpus.backup.json\"),\n        ]:\n            with self.subTest(path=path):\n                self.assertEqual(change_extension(path, \".json\"), expected)\n", "code_sha256": "d7bf9d29420476ded7898cf8de699d1c10ea791e48812642a38799b165c92abc", "comments": [], "decorators": [], "definition_line": 40, "docstring": "Test change_extension utility", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_649a801aa69a8e369a6a882b4259fdfb83d857626a02622844f8fe203c78e1f1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 54, "line_start": 40, "name": "test_change_extension", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestCorpusUtilities.test_change_extension", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_change_extension(self)", "source_id": "repo_source_211fa7d6af255f93f3dc0b1a3484427853aae774b41a3aaad8f9bf1fcb9a6619", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
