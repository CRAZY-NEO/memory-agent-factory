      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_reload_rejects_truncated_file_with_in_memory_index(self):\n        corpus = JsonlCorpus(\n            self.path, show_progress=False, save_index=False, verbosity=0\n        )\n        self.addCleanup(corpus.close)\n        self.assertEqual(len(corpus), 2)\n        corpus.close()\n        self.path.write_bytes(b\"\")\n\n        with self.assertRaises(ValueError):\n            corpus.load()\n        self.assertIsNone(corpus.file_obj)\n        self.assertIsNone(corpus.mmap_obj)\n", "code_sha256": "7112eb77f020cf68e5ce85268e532de8d06545092605dfe54c991aeaebe84a4c", "comments": [], "decorators": [], "definition_line": 31, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "89148d421a705bf1e74fea0181523df8aa3f52c4b7aa048dbc71814b6de92aba", "id": "code_candidate_9712fca57450dcdf365745910f080246d68c31b168653dabf78a07148570fe16", "imports": [{"alias": null, "level": 0, "line": 1, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}], "kind": "method", "line_end": 43, "line_start": 31, "name": "test_reload_rejects_truncated_file_with_in_memory_index", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus_truncation.py", "qualified_name": "TestCorpusTruncation.test_reload_rejects_truncated_file_with_in_memory_index", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annota