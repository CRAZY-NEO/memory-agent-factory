": "False", "kind": "positional_or_keyword", "name": "warmup"}], "path": "bm25s/__init__.py", "qualified_name": "BM25.compile", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def compile(self, activate_numba=True, warmup=False)", "source_id": "repo_source_d2d8bec12150dbd29fb5b8e9c0612950ac3a929c94086450a1edb9144458393c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
