    <node id="code_candidate_69458ad0b8ca4ef4b361b3e43ee8fe773d9684eeceae9cb4a0f2a44beb04370b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_dumps_with_orjson_ensure_ascii_true(self):\n        \"\"\"Test dumps_with_orjson with ensure_ascii=True\"\"\"\n        # Only run if orjson is available\n        if json_functions.ORJSON_AVAILABLE:\n            data = {\"text\": \"héllo\"}\n            result = json_functions.dumps_with_orjson(data, ensure_ascii=True)\n            self.assertIsInstance(result, str)\n            # Should have escaped non-ASCII characters\n            self.assertIn(\"\\\\\", result)\n", "code_sha256": "c6ca313720d02a8c1a46f590d95d5912e5cba4e3b9f689e3b1612487847a4029", "comments": [{"line": 55, "text": "# Only run if orjson is available"}, {"line": 60, "text": "# Should have escaped non-ASCII characters"}], "decorators": [], "definition_line": 53, "docstring": "Test dumps_with_orjson with ensure_ascii=True", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "387f9868dbab9855a91522dfbfc5b5a082685f88b2737a312a8855bf82b17e8b", "id": "code_candidate_69458ad0b8ca4ef4b361b3e43ee8fe773d9684eeceae9cb4a0f2a44beb04370b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 61, "line_start": 53, "name": "test_dumps_with_orjson_ensure_ascii_true", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_json_functions.py", "qualified_name": "TestJsonFunctions.test_dumps_with_orjson_ensure_ascii_true", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_dumps_with_orjson_ensure_ascii_true(self)", "source_id": "repo_source_4984691608886d7ad2efe38d4ace55d30ada338a0e182157102471e62e25548f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
