    <node id="code_candidate_f14032356ce3815ef18d4834c1fb6ef5fdc5073d36ae98b39b1e7eba24889069">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def to_tokenized_tuple(self, docs: List[List[int]]) -&gt; Tokenized:\n        \"\"\"\n        Convert the token IDs to a Tokenized namedtuple, which contains the word IDs, or the stemmed IDs\n        if a stemmer is used. The Tokenized namedtuple contains two fields: ids and vocab. The latter\n        is a dictionary mapping the token IDs to the tokens, or a dictionary mapping the stemmed IDs to\n        the stemmed tokens (if a stemmer is used).\n        \"\"\"\n        return Tokenized(ids=docs, vocab=self.get_vocab_dict())\n", "code_sha256": "54ccebdc330f662af2f2a87f6741c62bc25f0fdf318963a8fa46a64d46e64921", "comments": [], "decorators": [], "definition_line": 484, "docstring": "\n        Convert the token IDs to a Tokenized namedtuple, which contains the word IDs, or the stemmed IDs\n        if a stemmer is used. The Tokenized namedtuple contains two fields: ids and vocab. The latter\n        is a dictionary mapping the token IDs to the tokens, or a dictionary mapping the stemmed IDs to\n        the stemmed tokens (if a stemmer is used).\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_f14032356ce3815ef18d4834c1fb6ef5fdc5073d36ae98b39b1e7eba24889069", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Union"}, {"alias": null, "level": 0, "line": 5, "module": "typing", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_CHINESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DUTCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN_PLUS"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_FRENCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_GERMAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_ITALIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_KOREAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_NORWEGIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_PORTUGUESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "method", "line_end": 491, "line_start": 484, "name": "to_tokenized_tuple", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[List[int]]", "default": null, "kind": "positional_or_keyword", "name": "docs"}], "path": "bm25s/tokenization.py", "qualified_name": "Tokenizer.to_tokenized_tuple", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "Tokenized", "signature": "def to_tokenized_tuple(self, docs: List[List[int]]) -&gt; Tokenized", "source_id": "repo_source_36f95b7073422ec39462657e59cf575ac2ab039132824d11ee0768e259ce5bbf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
