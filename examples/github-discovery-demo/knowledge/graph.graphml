    <node id="code_candidate_47ed5d579439c449d588c1b1650a5bfb5fb3bce58c759d2e15db259a901f6229">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_corpus_with_mmap(self):\n        \"\"\"Test load_corpus with mmap=True\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        retriever.save(self.tmpdir, corpus=self.corpus)\n        \n        # Load with mmap and corpus\n        loaded = BM25.load(self.tmpdir, load_corpus=True, mmap=True)\n        \n        # Corpus should be JsonlCorpus\n        self.assertIsInstance(loaded.corpus, bm25s.utils.corpus.JsonlCorpus)\n        loaded.corpus.close()\n", "code_sha256": "2de4dfe0a6568778e3e44b4172c23a33ae416afaf82f2f0ce7676d3eab53030d", "comments": [{"line": 425, "text": "# Load with mmap and corpus"}, {"line": 428, "text": "# Corpus should be JsonlCorpus"}], "decorators": [], "definition_line": 419, "docstring": "Test load_corpus with mmap=True", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_47ed5d579439c449d588c1b1650a5bfb5fb3bce58c759d2e15db259a901f6229", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 430, "line_start": 419, "name": "test_load_corpus_with_mmap", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25LoadingSaving.test_load_corpus_with_mmap", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_load_corpus_with_mmap(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
