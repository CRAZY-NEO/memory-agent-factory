      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _is_tuple_of_list_of_tokens(obj):\n    if not isinstance(obj, tuple):\n        return False\n\n    if len(obj) == 0:\n        return False\n\n    first_elem = obj[0]\n    if not isinstance(first_elem, list):\n        return False\n\n    if len(first_elem) == 0:\n        return False\n\n    first_token = first_elem[0]\n    if not isinstance(first_token, str):\n        return False\n\n    return True\n", "code_sha256": "4f06ccfcdaf648b4a3482b811e1a162c7c1dbb8bbff4cffcf729d4de8306004b", "comments": [], "decorators": [], "definition_line": 122, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_e3a5f19f3d3e4c836f0a2fd5c60121031dd9c4e27e1c70acc6dfc438b356597e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 