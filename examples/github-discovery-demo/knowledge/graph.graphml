    <node id="code_candidate_174d75157c47eb9650ca0cc13304c8a49d7b955bb77603354e775f142aff4d26">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def is_dir_empty(local_save_dir):\n    \"\"\"\n    Check if a directory is empty or not.\n\n    Parameters\n    ----------\n    local_save_dir: str\n        The directory to check.\n\n    Returns\n    -------\n    bool\n        True if the directory is empty, False otherwise.\n    \"\"\"\n    if not os.path.exists(local_save_dir):\n        return True\n    return len(os.listdir(local_save_dir)) == 0\n", "code_sha256": "4da6fd85d03d5f517c51148d1f29904f57b55ee667fc585e4721b3c09a433a3f", "comments": [], "decorators": [], "definition_line": 205, "docstring": "\n    Check if a directory is empty or not.\n\n    Parameters\n    ----------\n    local_save_dir: str\n        The directory to check.\n\n    Returns\n    -------\n    bool\n        True if the directory is empty, False otherwise.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ef53c4775b6f6fde4a3a4fa5f687268b5f70562a82e11bd0f59c1757b1eed21b", "id": "code_candidate_174d75157c47eb9650ca0cc13304c8a49d7b955bb77603354e775f142aff4d26", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 6, "module": "typing", "name": "Union"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "BM25"}, {"alias": null, "level": 1, "line": 7, "module": null, "name": "__version__"}, {"alias": null, "level": 1, "line": 8, "module": "tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 11, "module": "huggingface_hub", "name": "HfApi"}, {"alias": null, "level": 0, "line": 23, "module": "tqdm.auto", "name": "tqdm"}], "kind": "function", "line_end": 221, "line_start": 205, "name": "is_dir_empty", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "local_save_dir"}], "path": "bm25s/hf.py", "qualified_name": "is_dir_empty", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def is_dir_empty(local_save_dir)", "source_id": "repo_source_304890f95653eb167c106807f7767ede53c0bbce2076a3c6ab02cc78ffbc3b9c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
