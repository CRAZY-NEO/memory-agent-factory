    <node id="code_candidate_b6f985ba2755b94a3e43c5a0be4bbd745856fb5dffe39a290f78ce964a98f484">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_save_with_invalid_document_in_corpus(self):\n        \"\"\"Test save with invalid document type in corpus\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Create corpus with invalid document type\n        invalid_corpus = [\"valid string\", {\"valid\": \"dict\"}, None, 12345]\n        \n        # This should log warnings for invalid docs but not crash\n        retriever.save(self.tmpdir, corpus=invalid_corpus)\n        \n        # Verify save succeeded\n        self.assertTrue(os.path.exists(os.path.join(self.tmpdir, \"params.index.json\")))\n", "code_sha256": "cbe6b7361340168b45958c13807724abf4a41967c5c77fc9e0e12491b8f8faad", "comments": [{"line": 398, "text": "# Create corpus with invalid document type"}, {"line": 401, "text": "# This should log warnings for invalid docs but not crash"}, {"line": 404, "text": "# Verify save succeeded"}], "decorators": [], "definition_line": 393, "docstring": "Test save with invalid document type in corpus", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_b6f985ba2755b94a3e43c5a0be4bbd745856fb5dffe39a290f78ce964a98f484", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 405, "line_start": 393, "name": "test_save_with_invalid_document_in_corpus", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25LoadingSaving.test_save_with_invalid_document_in_corpus", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_save_with_invalid_document_in_corpus(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
