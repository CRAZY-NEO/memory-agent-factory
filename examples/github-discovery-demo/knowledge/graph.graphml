      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_getitem_int(self):\n        \"\"\"Test JsonlCorpus __getitem__ with int index\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False)\n        \n        # Get first item\n        item = corpus[0]\n        self.assertEqual(item[\"id\"], 0)\n        self.assertEqual(item[\"text\"], \"first document\")\n        \n        # Get third item\n        item = corpus[2]\n        self.assertEqual(item[\"id\"], 2)\n        \n        corpus.close()\n", "code_sha256": "0d720729d72e61f4a10e28301cd4c3870faff4fb3ea58d73fa01d395871e64c4", "comments": [{"line": 177, "text": "# Get first item"}, {"line": 182, "text": "# Get third item"}], "decorators": [], "definition_line": 173, "docstring": "Test JsonlCorpus __getitem__ with int index", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_918f22648ee157bf18b37c67dc245df680f44d23ecdc3e63a698aca8376292f3", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 186, "line_start": 173, "name": "test_jsonl_corpus_getitem_int", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestJsonlCorpus.test_jsonl_corpus_getitem_int", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_jsonl_corpus_getitem_int(self)", "source_id": "repo_source_4788d7ad1823b10d4c7616a36d80244f130a74dc22f961e34ba43e6e81e60af6", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
