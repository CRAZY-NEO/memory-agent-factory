    <node id="code_candidate_73ff58e912e9738908058851fd02815cf001938dc20fd07f4dd63f15c1816f3f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_empty_string(self):\n        # Create an empty corpus\n        corpus = [\"\", \"\", \"\", \"\"]\n        # Create a list of queries\n        queries = [\"what is the meaning of life?\"]\n\n        # The tokenizer will return a list of list of tokens\n        tokenizer = Tokenizer()\n        corpus_tokens = tokenizer.tokenize(corpus, return_as=\"tuple\", allow_empty=True)\n\n        self.assertEqual(\n            corpus_tokens,\n            bm25s.tokenization.Tokenized(ids=[[0], [0], [0], [0]], vocab={\"\": 0}),\n            msg=f\"Corpus tokens differ from expected: {corpus_tokens}\",\n        )\n\n        query_tokens = tokenizer.tokenize(\n            queries, return_as=\"ids\", update_vocab=False, allow_empty=True\n        )\n\n        self.assertEqual(\n            [[0]],\n            query_tokens,\n            msg=f\"Query tokens differ from expected: {query_tokens}\",\n        )\n\n        retriever = bm25s.BM25()\n        retriever.index(corpus_tokens)\n\n        results, scores = retriever.retrieve(query_tokens, corpus=corpus, k=2)\n        self.assertTrue(\n            np.all(results == np.array([[\"\", \"\"]])),\n            msg=f\"Results differ from expected: {results}, {scores}\",\n        )\n", "code_sha256": "73c44c9c90d7cbdac9c9d1e326d0128b91979ef15a560e67bdde9b68f20e4a67", "comments": [{"line": 16, "text": "# Create an empty corpus"}, {"line": 18, "text": "# Create a list of queries"}, {"line": 21, "text": "# The tokenizer will return a list of list of tokens"}], "decorators": [], "definition_line": 15, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_73ff58e912e9738908058851fd02815cf001938dc20fd07f4dd63f15c1816f3f", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 48, "line_start": 15, "name": "test_empty_string", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_empty_string", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_empty_string(self)", "source_id": "repo_source_23d568375b3ef8a255d5097c4dfba9bbfbd9775040bff9bf96c69a677bdcdb80", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_0a5dbc099a21ce14cd43392ab32aa36f68fec885a4e48f13d3d8187e06a2357d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_new_ids(self):\n        corpus = [\n            \"a cat is a feline and likes to purr\",\n            \"a dog is the human's best friend and loves to play\",\n            \"a bird is a beautiful animal that can fly\",\n            \"a fish is a creature that lives in water and swims\",\n        ]\n\n        tokenizer = Tokenizer(\n            stemmer=None, stopwords=None, splitter=lambda x: x.split()\n        )\n        corpus_tokens = tokenizer.tokenize(corpus, allow_empty=False)\n\n        bm25 = bm25s.BM25()\n        bm25.index(corpus_tokens, create_empty_token=False)\n\n        query = \"What is a fly?\"\n        query_tokens = tokenizer.tokenize([query], update_vocab=True, allow_empty=False)\n        self.assertListEqual([[27, 2, 0, 28]], query_tokens)\n\n        results, scores = bm25.retrieve(query_tokens, k=3)\n        self.assertTrue(\n            np.all(np.array([[0, 2, 3]]) == results),\n            msg=f\"Results differ from expected: {results}, {scores}\",\n        )\n", "code_sha256": "ec7a1b774b90bf798744154630abe9415bf60726edaa1f9321ba3fc5788adf5e", "comments": [], "decorators": [], "definition_line": 50, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ac95bd4c28ce75b68b4d363c942a7255e4776bfdbcaa6f2487e4ad2551c79d7f", "id": "code_candidate_0a5dbc099a21ce14cd43392ab32aa36f68fec885a4e48f13d3d8187e06a2357d", "imports": [{"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 7, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 74, "line_start": 50, "name": "test_new_ids", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer_misc.py", "qualified_name": "TestBM25SNewIds.test_new_ids", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_new_ids(self)", "source_id": "repo_source_23d568375b3ef8a255d5097c4dfba9bbfbd9775040bff9bf96c69a677bdcdb80", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
