      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def missing_version(name):\n        raise version_module.PackageNotFoundError(name)\n", "code_sha256": "9367d0baace3f13f46401191c7ecd5635f5e8144853238c96e550c0d5adfd9eb", "comments": [], "decorators": [], "definition_line": 11, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5740d7367d93e8b5e592954f3c78a89571733349f91682289d3f90ff54f96748", "id": "code_candidate_2331f2062ce98132ee4cf0afece027bf6568872b96321e6931d029a86d008ece", "imports": [{"alias": "version_module", "level": 0, "line": 1, "module": "bm25s.version", "name": null}], "kind": "function", "line_end": 12, "line_start": 11, "name": "missing_version", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}], "path": "tests/core/test_version.py", "qualified_name": "test_discover_version_falls_back_when_distribution_is_missing.&lt;locals&gt;.missing_version", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def missing_version(name)", "source_id": "repo_source_50f640253ab5ed6036f2e3052bdfd8178dfe62731374ebbbeaf81989f256b7f4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
