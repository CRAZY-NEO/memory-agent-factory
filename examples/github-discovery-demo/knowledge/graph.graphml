      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_a_save_and_load(self):\n        # both of these fail: UnicodeEncodeError: 'charmap' codec can't encode characters in position 2-6: character maps to &lt;undefined&gt;\n        self.retriever.save(self.tmpdirname, corpus=self.corpus) \n        self.retriever.load(self.tmpdirname, load_corpus=True)\n", "code_sha256": "fe21306fbd720b1ccfdbbea772c17904ee7c8a7f0f8ff899604ade11cf54d23a", "comments": [{"line": 166, "text": "# both of these fail: UnicodeEncodeError: 'charmap' codec can't encode characters in position 2-6: character maps to &lt;undefined&gt;"}], "decorators": [], "definition_line": 165, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5c821b6a5a4313298a2dd6cf0c18ca5a42d4e9ce84bab16a261cfb3edb01562b", "id": "code_candidate_4bd59971fc1bea62525a24fb98694608ca77513407d400108426a305d9956e69", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 20, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 55, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 139, "module": "bm25s", "name": null}