    <node id="code_candidate_73d52a67afe7193bbf4522db6bbf1f6f20fc2b4f3c7014cc1a83aaa63f5cdb9e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __getitem__(self, index):\n        # An empty corpus has no lines: integer indexing is out of range, mirroring a\n        # regular empty list. Slice/list/ndarray indexing return an empty result.\n        if len(self.mmindex) == 0 and isinstance(index, int):\n            raise IndexError(\"index out of range for empty JsonlCorpus\")\n\n        # handle multiple indices\n        if isinstance(index, int):\n            return json_functions.loads(\n                get_line(\n                    self.path,\n                    index,\n                    self.mmindex,\n                    encoding=self.encoding,\n                    file_obj=self.file_obj,\n                    mmap_obj=self.mmap_obj,\n                )\n            )\n\n        if isinstance(index, slice):\n            return [self.__getitem__(i) for i in range(*index.indices(len(self)))]\n        if isinstance(index, (list, tuple)):\n            return [self.__getitem__(i) for i in index]\n        if isinstance(index, np.ndarray):\n            # if it's an ndarray, this means each element is an index, and the array can\n            # be of any shape. thus, we should flatten it first, get the results as if it\n            # was a list, and then reshape it back to the original shape\n            index_flat = index.flatten().tolist()\n            results = [self.__getitem__(i) for i in index_flat]\n            reshaped = np.array(results).reshape(index.shape)\n            return reshaped\n        \n        raise TypeError(\"Invalid index type\")\n", "code_sha256": "7afcd64923f60941a92afc8a29dc66bbb068b0053386951605d7a9fe57153e3e", "comments": [{"line": 158, "text": "# An empty corpus has no lines: integer indexing is out of range, mirroring a"}, {"line": 159, "text": "# regular empty list. Slice/list/ndarray indexing return an empty result."}, {"line": 163, "text": "# handle multiple indices"}, {"line": 181, "text": "# if it's an ndarray, this means each element is an index, and the array can"}, {"line": 182, "text": "# be of any shape. thus, we should flatten it first, get the results as if it"}, {"line": 183, "text": "# was a list, and then reshape it back to the original shape"}], "decorators": [], "definition_line": 157, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_73d52a67afe7193bbf4522db6bbf1f6f20fc2b4f3c7014cc1a83aaa63f5cdb9e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "method", "line_end": 189, "line_start": 157, "name": "__getitem__", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "index"}], "path": "bm25s/utils/corpus.py", "qualified_name": "JsonlCorpus.__getitem__", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def __getitem__(self, index)", "source_id": "repo_source_3a590e9df8c804c7e0ab59f7ac50e34f1861c4a59d907626f359b08c345a4784", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
    </node>
    <node id="code_candidate_ea6d7802c94653f6d2a79eb0a163a14f46afe04232d935e0621a07bf89333d80">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def close(self):\n        \"\"\"\n        Close the file and mmap objects. This is useful if you want to free up memory. To reopen them, use the `load` method.\n        If you don't call this method, the objects will be closed automatically when the object is deleted.\n        \"\"\"\n        if hasattr(self, \"file_obj\") and self.file_obj is not None:\n            self.file_obj.close()\n            # delete the object\n            del self.file_obj\n            self.file_obj = None\n        if hasattr(self, \"mmap_obj\") and self.mmap_obj is not None:\n            self.mmap_obj.close()\n            # delete the object\n            del self.mmap_obj\n            self.mmap_obj = None\n        if self.verbosity &gt;= 1:\n            logging.info(\"Closed file and mmap objects\")\n", "code_sha256": "ce466bf7a0facc69f6add33fef83286f63f6866458255c746b465840cbec43ea", "comments": [{"line": 198, "text": "# delete the object"}, {"line": 203, "text": "# delete the object"}], "decorators": [], "definition_line": 191, "docstring": "\n        Close the file and mmap objects. This is useful if you want to free up memory. To reopen them, use the `load` method.\n        If you don't call this method, the objects will be closed automatically when the object is deleted.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_ea6d7802c94653f6d2a79eb0a163a14f46afe04232d935e0621a07bf89333d80", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "method", "line_end": 207, "line_start": 191, "name": "close", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "bm25s/utils/corpus.py", "qualified_name": "JsonlCorpus.close", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def close(self)", "source_id": "repo_source_3a590e9df8c804c7e0ab59f7ac50e34f1861c4a59d907626f359b08c345a4784", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
