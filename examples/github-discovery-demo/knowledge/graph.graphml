    <node id="code_candidate_85755605edda37cd4db4f7ba56c6253f48acb2a8600035f57b18a3f2bc8bedd5">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_change_extension(self):\n        \"\"\"Test change_extension utility\"\"\"\n        path = \"/path/to/file.txt\"\n        result = change_extension(path, \".json\")\n        self.assertEqual(result, \"/path/to/file.json\")\n        \n        for path, expected in [\n            (\"file\", \"file.json\"),\n            (\".corpus\", \".corpus.json\"),\n            (os.path.join(\"data.v1\", \"corpus\"), os.path.join(\"data.v1\", \"corpus.json\")),\n            (os.path.join(\"data.v1\", \"corpus.jsonl\"), os.path.join(\"data.v1\", \"corpus.json\")),\n            (\"corpus.backup.jsonl\", \"corpus.backup.json\"),\n        ]:\n            with self.subTest(path=path):\n                self.assertEqual(change_extension(path, \".json\"), expected)\n", "code_sha256": "d7bf9d29420476ded7898cf8de699d1c10ea791e48812642a38799b165c92abc", "comments": [], "decorators": [], "definition_line": 40, "docstring": "Test change_extension utility", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_85755605edda37cd4db4f7ba56c6253f48acb2a8600035f57b18a3f2bc8bedd5", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 54, "line_start": 40, "name": "test_change_extension", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestCorpusUtilities.test_change_extension", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_change_extension(self)", "source_id": "repo_source_4788d7ad1823b10d4c7616a36d80244f130a74dc22f961e34ba43e6e81e60af6", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
