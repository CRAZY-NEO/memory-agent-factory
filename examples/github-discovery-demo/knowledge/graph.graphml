      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_with_invalid_mmap_type(self):\n        \"\"\"Test load with invalid mmap parameter type\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        retriever.save(self.tmpdir)\n        \n        with self.assertRaises(ValueError) as context:\n            BM25.load(self.tmpdir, mmap=\"invalid\")\n        self.assertIn(\"must be a boolean\", str(context.exception))\n", "code_sha256": "4a1674f2661e68a801f433d9c0f9955d5f126e485cad62aa4fe669f44cfd2c2c", "comments": [], "decorators": [], "definition_line": 373, "docstring": "Test load with invalid mmap parameter type", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_6c646d1d5c2cd015858c6909cd74702083f4d5741be4a28a3aa1e3a838d50dfc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 381, "line_start": 373, "name": "test_load_with_invalid_mmap_type", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25LoadingSaving.test_load_with_invalid_mmap_type", "repository_ke