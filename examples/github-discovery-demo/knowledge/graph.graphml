    <node id="code_candidate_b5607a2437b90dbac69c0cb7ada7ea5f132060d1ac05c7179e2672aad7d881d2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jax_installed_but_unavailable(self):\n        global JAX_IS_AVAILABLE\n        original_jax_is_available = JAX_IS_AVAILABLE\n        JAX_IS_AVAILABLE = False  # Temporarily pretend JAX is not available\n        \n        result_scores, result_indices = topk(self.scores, self.k, backend=\"auto\", sorted=True)\n        self.check_results(result_scores, result_indices, sorted=True)\n        \n        JAX_IS_AVAILABLE = original_jax_is_available  # Restore the original value\n", "code_sha256": "34eba8e1869f1c17d384d2ef80bb2c84f06aa7e070a140a4c537b971b3bff5d0", "comments": [{"line": 59, "text": "# Temporarily pretend JAX is not available"}, {"line": 64, "text": "# Restore the original value"}], "decorators": [], "definition_line": 56, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4e6fe4c42ffcc02b2eba717ac7e1ebacb1d7f64f561ecd9bad0fa3e71b47f4fb", "id": "code_candidate_b5607a2437b90dbac69c0cb7ada7ea5f132060d1ac05c7179e2672aad7d881d2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "jax", "name": null}, {"alias": "jnp", "level": 0, "line": 8, "module": "jax.numpy", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.selection", "name": "topk"}], "kind": "method", "line_end": 64, "line_start": 56, "name": "test_jax_installed_but_unavailable", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_topk.py", "qualified_name": "TestTopKSingleQuery.test_jax_installed_but_unavailable", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_jax_installed_but_unavailable(self)", "source_id": "repo_source_d8c0c16807ca643d93b05e35468e304719f6928525fd4f102c4d86f6a999ba21", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
