    <node id="code_candidate_9234db2caaa514b7ad56e500d3163ddf8eaf67c4ae18171473c7736f33612de1">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _build_scores_and_indices_for_matrix(\n    corpus_token_ids,\n    idf_array,\n    avg_doc_len,\n    doc_frequencies,\n    k1,\n    b,\n    delta,\n    nonoccurrence_array,\n    method=\"robertson\",\n    dtype=\"float32\",\n    int_dtype=\"int32\",\n    show_progress=True,\n    leave_progress=False,\n):\n    array_size = sum(doc_frequencies.values())\n\n    # We create 3 arrays to store the scores, document indices, and vocabulary indices\n    # The length is at most n_tokens, remaining elements will be truncated at the end\n    scores = np.empty(array_size, dtype=dtype)\n    doc_indices = np.empty(array_size, dtype=int_dtype)\n    voc_indices = np.empty(array_size, dtype=int_dtype)\n\n    calculate_tfc = _select_tfc_scorer(method)\n\n    i = 0\n    for doc_idx, token_ids in enumerate(\n        tqdm(\n            corpus_token_ids,\n            desc=\"BM25S Compute Scores\",\n            disable=not show_progress,\n            leave=leave_progress,\n        )\n    ):\n        doc_len = len(token_ids)\n\n        # Get the term frequency array for the document\n        # Note: tokens might contain duplicates, we use Counter to get the term freq\n        voc_ind_doc, tf_array = _get_counts_from_token_ids(\n            token_ids, dtype=dtype, int_dtype=int_dtype\n        )\n\n        # Calculate the BM25 score for each token in the document\n        tfc = calculate_tfc(\n            tf_array=tf_array, l_d=doc_len, l_avg=avg_doc_len, k1=k1, b=b, delta=delta\n        )\n        idf = idf_array[voc_ind_doc]\n        scores_doc = idf * tfc\n\n        # If the method is uses a non-occurrence score array, then we need to subtract\n        # the non-occurrence score from the scores\n        if method in (\"bm25l\", \"bm25+\"):\n            scores_doc -= nonoccurrence_array[voc_ind_doc]\n\n        # Update the arrays with the new scores, document indices, and vocabulary indices\n        doc_len = len(scores_doc)\n        start, end = i, i + doc_len\n        i = end\n\n        doc_indices[start:end] = doc_idx\n        voc_indices[start:end] = voc_ind_doc\n        scores[start:end] = scores_doc\n\n    return scores, doc_indices, voc_indices\n", "code_sha256": "ab9d0e1f02392d0c3f117bb8aee859d2023419aa9ab99a224dc009479aa631ab", "comments": [{"line": 263, "text": "# We create 3 arrays to store the scores, document indices, and vocabulary indices"}, {"line": 264, "text": "# The length is at most n_tokens, remaining elements will be truncated at the end"}, {"line": 282, "text": "# Get the term frequency array for the document"}, {"line": 283, "text": "# Note: tokens might contain duplicates, we use Counter to get the term freq"}, {"line": 288, "text": "# Calculate the BM25 score for each token in the document"}, {"line": 295, "text": "# If the method is uses a non-occurrence score array, then we need to subtract"}, {"line": 296, "text": "# the non-occurrence score from the scores"}, {"line": 300, "text": "# Update the arrays with the new scores, document indices, and vocabulary indices"}], "decorators": [], "definition_line": 246, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_9234db2caaa514b7ad56e500d3163ddf8eaf67c4ae18171473c7736f33612de1", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 309, "line_start": 246, "name": "_build_scores_and_indices_for_matrix", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "corpus_token_ids"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "idf_array"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "avg_doc_len"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "doc_frequencies"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k1"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "b"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "delta"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "nonoccurrence_array"}, {"annotation": null, "default": "'robertson'", "kind": "positional_or_keyword", "name": "method"}, {"annotation": null, "default": "'float32'", "kind": "positional_or_keyword", "name": "dtype"}, {"annotation": null, "default": "'int32'", "kind": "positional_or_keyword", "name": "int_dtype"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}], "path": "bm25s/scoring.py", "qualified_name": "_build_scores_and_indices_for_matrix", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _build_scores_and_indices_for_matrix(corpus_token_ids, idf_array, avg_doc_len, doc_frequencies, k1, b, delta, nonoccurrence_array, method='robertson', dtype='float32', int_dtype='int32', show_progress=True, leave_progress=False)", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
