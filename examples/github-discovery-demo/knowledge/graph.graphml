      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_can_save_locally_empty_dir(self):\n        \"\"\"Test can_save_locally with empty directory\"\"\"\n        empty_dir = os.path.join(self.tmpdir, \"empty\")\n        os.makedirs(empty_dir)\n        \n        self.assertTrue(can_save_locally(empty_dir, overwrite_local=False))\n        self.assertTrue(can_save_locally(empty_dir, overwrite_local=True))\n", "code_sha256": "21fd5b62b8555f0004ea7f99992113c6ed3f6a31eeee48cb5eb034b2c3162772", "comments": [], "decorators": [], "definition_line": 45, "docstring": "Test can_save_locally with empty directory", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "28e6fa925022fe2389bec7b19a3d2b1bd8637d9c789a30cbf321af111dcbe48e", "id": "code_candidate_1aba52a2a0348dbcc2404eb35cd43fcc2e26961c69ee9620223246b35e9f14b4", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "can_save_locally"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "is_dir_empty"}], "kind": "method", "line_end": 51, "line_start": 45, "name": "test_can_save_locally_empty_dir", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_hf_utils.py", "qualified_name": "TestHFUtilities.test_can_save_locally_empty_dir", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_can_save_locally_empty_dir(self)", "source_id": "repo_source_b93555c8051bf289456ff1961240e5a819a993a70688c43b39b458a563813c0f", "status": "u