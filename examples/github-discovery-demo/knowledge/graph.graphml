    <node id="code_candidate_82133000c795c7de4e93fb354c3da7e7826affbcc270470eb3149df1c03bb5e0">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def get_max_memory_usage(format=\"GB\"):\n    if resource is None:\n        logger.warning(\"resource module not available, cannot get memory usage\")\n        return None\n    if format not in [\"GB\", \"MB\", \"KB\"]:\n        raise ValueError(\"format should be one of 'GB', 'MB', 'KB'\")\n\n    usage_kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n    # for mac, ru_maxrss is in bytes\n    \n    if sys.platform == \"darwin\":\n        usage_kb /= 1024\n    \n    if format == \"GB\":\n        return usage_kb / (1024**2)\n    elif format == \"MB\":\n        return usage_kb / 1024\n    else:\n        return usage_kb\n", "code_sha256": "92816fe73002286fe3b39b2960964a7dba1277deb935c050b8ea82412a9304a6", "comments": [{"line": 23, "text": "# for mac, ru_maxrss is in bytes"}], "decorators": [], "definition_line": 15, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_82133000c795c7de4e93fb354c3da7e7826affbcc270470eb3149df1c03bb5e0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "function", "line_end": 33, "line_start": 15, "name": "get_max_memory_usage", "parameters": [{"annotation": null, "default": "'GB'", "kind": "positional_or_keyword", "name": "format"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "get_max_memory_usage", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "