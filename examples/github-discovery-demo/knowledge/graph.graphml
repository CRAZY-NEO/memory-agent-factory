    <node id="code_candidate_5a58394d99040ffd978339889d8e78451459d72ad20ffce4094179fe5a8edd93">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_b_load(self):\n        # load the retriever from temp dir\n        r1 = self.retriever\n        r2 = bm25s.BM25.load(\n            self.tmpdirname,\n            data_name=\"data.index.csc.npy\",\n            indices_name=\"indices.index.csc.npy\",\n            indptr_name=\"indptr.index.csc.npy\",\n            vocab_name=\"vocab.json\",\n            nnoc_name=\"nonoccurrence_array.npy\",\n            params_name=\"params.json\",\n        )\n\n        # for each of data, indices, indptr, vocab, nnoc, params\n        # assert that the loaded object is the same as the original object\n        # data, indices, indptr are stored in self.scores\n        self.assertTrue((r1.scores['data'] == r2.scores['data']).all())\n        self.assertTrue((r1.scores['indices'] == r2.scores['indices']).all())\n        self.assertTrue((r1.scores['indptr'] == r2.scores['indptr']).all())\n\n        # vocab is stored in self.vocab\n        self.assertEqual(r1.vocab_dict, r2.vocab_dict)\n\n        # nnoc is stored in self.nnoc\n        self.assertTrue((r1.nonoccurrence_array == r2.nonoccurrence_array).all())\n", "code_sha256": "c2f90b44745f17938d2214aded6be759c98eecacf7592c8bf32cb3b1ad69f5dc", "comments": [{"line": 87, "text": "# load the retriever from temp dir"}, {"line": 99, "text": "# for each of data, indices, indptr, vocab, nnoc, params"}, {"line": 100, "text": "# assert that the loaded object is the same as the original object"}, {"line": 101, "text": "# data, indices, indptr are stored in self.scores"}, {"line": 106, "text": "# vocab is stored in self.vocab"}, {"line": 109, "text": "# nnoc is stored in self.nnoc"}], "decorators": [], "definition_line": 86, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5c821b6a5a4313298a2dd6cf0c18ca5a42d4e9ce84bab16a261cfb3edb01562b", "id": "code_candidate_5a58394d99040ffd978339889d8e78451459d72ad20ffce4094179fe5a8edd93", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 20, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 55, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 139, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 161, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 184, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 185, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 110, "line_start": 86, "name": "test_b_load", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_save_load.py", "qualified_name": "TestBM25SLoadingSaving.test_b_load", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_b_load(self)", "source_id": "repo_source_f6f16b47903aa7267a69de367190d46e23e404c17dc67b599c3fad64d79d6741", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
