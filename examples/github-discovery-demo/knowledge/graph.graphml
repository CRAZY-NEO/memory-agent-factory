      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def setUp(self):\n        temporary = tempfile.TemporaryDirectory()\n        self.addCleanup(temporary.cleanup)\n        self.directory = Path(temporary.name)\n        self.path = self.directory / \"corpus.jsonl\"\n        self.path.write_text('{\"id\":0}\\n{\"id\":1}\\n', encoding=\"utf-8\")\n", "code_sha256": "36f42b69f9c4d3e97e98d73cdcc50dfdf600a2f8dbd65e2cb9e0b9a3fca395ff", "comments": [], "decorators": [], "definition_line": 12, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "89148d421a705bf1e74fea0181523df8aa3f52c4b7aa048dbc71814b6de92aba", "id": "code_candidate_05985e49ced79d69ab6abe5d3751aabc9d6133d7b3b3e4136047ea9088223c89", "imports": [{"alias": null, "level": 0, "line": 1, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}], "kind": "method", "line_end": 17, "line_start": 12, "name": "setUp", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus_truncation.py", "qualified_name": "TestCorpusTruncation.setUp", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def setUp(self)", "source_id": "repo_source_916ea447a52fddd7945de51f690d6ff5eb59e69caef98bac29449edcddd14a4f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
