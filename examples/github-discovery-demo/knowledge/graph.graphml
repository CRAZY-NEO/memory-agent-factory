    <node id="code_candidate_0659b870d0c0a9b6c26e4b7f5b3a1570a877fa7cb719c6631a826b68f8bf08c5">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _calculate_doc_freqs(\n    corpus_tokens, unique_tokens, show_progress=True, leave_progress=False\n) -&gt; dict:\n    \"\"\"\n    Document Frequency, aka DF, is the number of documents that contain a specific token.\n    This function return a dictionary with the document frequency of each token, which is\n    why it is called `doc_frequencies`.\n    \"\"\"\n    unique_tokens = set(unique_tokens)\n\n    # Now that we have all the unique tokens, we can count the number of\n    # documents that contain each token\n    doc_frequencies = {token: 0 for token in unique_tokens}\n\n    for doc_tokens in tqdm(\n        corpus_tokens,\n        leave=leave_progress,\n        disable=not show_progress,\n        desc=\"BM25S Count Tokens\",\n    ):\n\n        # get intersection of unique tokens and the tokens in the document\n        shared_tokens = unique_tokens.intersection(doc_tokens)\n\n        # for each token in the document, we increment the count of documents\n        # This is a simple way to count the number of documents that contain each token\n        for token in shared_tokens:\n            doc_frequencies[token] += 1\n\n    return doc_frequencies\n", "code_sha256": "369563ca4844772bb198fa39d837f2af83e599a05753a86cfb3b4356e81651e3", "comments": [{"line": 38, "text": "# Now that we have all the unique tokens, we can count the number of"}, {"line": 39, "text": "# documents that contain each token"}, {"line": 49, "text": "# get intersection of unique tokens and the tokens in the document"}, {"line": 52, "text": "# for each token in the document, we increment the count of documents"}, {"line": 53, "text": "# This is a simple way to count the number of documents that contain each token"}], "decorators": [], "definition_line": 28, "docstring": "\n    Document Frequency, aka DF, is the number of documents that contain a specific token.\n    This function return a dictionary with the document frequency of each token, which is\n    why it is called `doc_frequencies`.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_0659b870d0c0a9b6c26e4b7f5b3a1570a877fa7cb719c6631a826b68f8bf08c5", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 57, "line_start": 28, "name": "_calculate_doc_freqs", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "corpus_tokens"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "unique_tokens"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}], "path": "bm25s/scoring.py", "qualified_name": "_calculate_doc_freqs", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": "dict", "signature": "def _calculate_doc_freqs(corpus_tokens, unique_tokens, show_progress=True, leave_progress=False) -&gt; dict", "source_id": "repo_source_25d6fde31da79e4011f2522211babe7dddce22c04e260cd1a946f6f1c106ed3c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
