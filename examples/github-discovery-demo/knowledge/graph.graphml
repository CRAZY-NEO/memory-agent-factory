    <node id="code_candidate_346264064e1d792307c8bc385e7ed07b1c6a9b0d186923b60ed0246a29878993">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_jsonl_corpus_getitem_ndarray(self):\n        \"\"\"Test JsonlCorpus __getitem__ with numpy array\"\"\"\n        corpus = JsonlCorpus(self.test_file, show_progress=False)\n        \n        # Get with 1D array\n        indices = np.array([0, 2, 4])\n        items = corpus[indices]\n        self.assertEqual(items.shape, (3,))\n        self.assertEqual(items[0][\"id\"], 0)\n        \n        # Get with 2D array\n        indices_2d = np.array([[0, 1], [2, 3]])\n        items_2d = corpus[indices_2d]\n        self.assertEqual(items_2d.shape, (2, 2))\n        self.assertEqual(items_2d[0, 0][\"id\"], 0)\n        self.assertEqual(items_2d[1, 1][\"id\"], 3)\n        \n        corpus.close()\n", "code_sha256": "2859f4bd6b0c0bf5bd2311272989465a38bcb5aac8cbc26ecd05017d34607f59", "comments": [{"line": 229, "text": "# Get with 1D array"}, {"line": 235, "text": "# Get with 2D array"}], "decorators": [], "definition_line": 225, "docstring": "Test JsonlCorpus __getitem__ with numpy array", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_346264064e1d792307c8bc385e7ed07b1c6a9b0d186923b60ed0246a29878993", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "save_mmindex"}, {"alias": null, "level": 0, "line": 14, "module": "bm25s.utils", "name": "json_functions"}], "kind": "method", "line_end": 242, "line_start": 225, "name": "test_jsonl_corpus_getitem_ndarray", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus.py", "qualified_name": "TestJsonlCorpus.test_jsonl_corpus_getitem_ndarray", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_jsonl_corpus_getitem_ndarray(self)", "source_id": "repo_source_211fa7d6af255f93f3dc0b1a3484427853aae774b41a3aaad8f9bf1fcb9a6619", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
