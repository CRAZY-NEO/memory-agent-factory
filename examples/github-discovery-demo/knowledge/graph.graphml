    <node id="code_candidate_4b9cbc41a1fe5504ee78d8fa2468e0a0ed52a0d565a31b2ea43b0dac2467e17f">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_missing_resource_does_not_write_to_stdout(self):\n        original_import = builtins.__import__\n\n        def _import_with_missing_resource(name, globals=None, locals=None, fromlist=(), level=0):\n            if name == \"resource\":\n                raise ImportError(\"resource module not available\")\n            return original_import(name, globals, locals, fromlist, level)\n\n        mock_logger = mock.Mock()\n\n        try:\n            with mock.patch(\"logging.getLogger\", return_value=mock_logger):\n                with mock.patch(\"builtins.__import__\", side_effect=_import_with_missing_resource):\n                    with contextlib.redirect_stdout(io.StringIO()) as stdout:\n                        importlib.reload(benchmark)\n\n            self.assertEqual(stdout.getvalue(), \"\")\n            self.assertIsNone(benchmark.resource)\n            self.assertIsNone(benchmark.get_max_memory_usage())\n            mock_logger.warning.assert_called_once_with(\n                \"resource module not available, cannot get memory usage\"\n            )\n        finally:\n            importlib.reload(benchmark)\n", "code_sha256": "57203863e9a934e5e60d72037cd968a2ad93ba68e44098ec9eca01ba75bd45f7", "comments": [], "decorators": [], "definition_line": 12, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5e8ff442c2db17d417a49af3808c90a045f29f6a43a552937873e523862de0b1", "id": "code_candidate_4b9cbc41a1fe5504ee78d8fa2468e0a0ed52a0d565a31b2ea43b0dac2467e17f", "imports": [{"alias": null, "level": 0, "line": 1, "module": "builtins", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "contextlib", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "importlib", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "io", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "unittest", "name": "mock"}, {"alias": "benchmark", "level": 0, "line": 8, "module": "bm25s.utils.benchmark", "name": null}], "kind": "method", "line_end": 35, "line_start": 12, "name": "test_missing_resource_does_not_write_to_stdout", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_benchmark_utils.py", "qualified_name": "TestBenchmarkUtils.test_missing_resource_does_not_write_to_stdout", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_missing_resource_does_not_write_to_stdout(self)", "source_id": "repo_source_9ce52c73b166c4e80e9109253f3da301a6e6fe4a7f799b7f5f4262bfb6a53b7f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
