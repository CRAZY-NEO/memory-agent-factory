    <node id="code_candidate_c5c2bcd5aadf725e61d5c899995f46556e454bd8f81f67e062f3d9a7d831b2de">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_git(package_dir):\n    exact_tag = _git_describe(package_dir, \"--exact-match\")\n    if exact_tag:\n        return _normalize_version(exact_tag)\n\n    description = _git_describe(package_dir, \"--long\")\n    if not description:\n        return None\n\n    match = re.match(r\"(.+)-(\\d+)-g([0-9a-f]+)$\", description)\n    if not match:\n        return None\n\n    tag, distance, sha = match.groups()\n    version = _normalize_version(tag)\n    if distance == \"0\":\n        return version\n\n    suffix = \".dev\" if \".post\" in version else \".post\"\n    return f\"{version}{suffix}{distance}+g{sha}\"\n", "code_sha256": "a355c46b32cc59a908d9f87f4a7a812f19fa29887a9d196d18091c08f4daa475", "comments": [], "decorators": [], "definition_line": 72, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_c5c2bcd5aadf725e61d5c899995f46556e454bd8f81f67e062f3d9a7d831b2de", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 91, "line_start": 72, "name": "_version_from_git", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "setup.py", "qualified_name": "_version_from_git", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _version_from_git(package_dir)", "source_id": "repo_source_3c0d305f10eb306cd3fff0347217bae386f41f7f7d84c64af09d4d3b405f33d8", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
