      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def test_discover_version_falls_back_when_distribution_is_missing(monkeypatch):\n    def missing_version(name):\n        raise version_module.PackageNotFoundError(name)\n\n    monkeypatch.setattr(version_module, \"version\", missing_version)\n\n    assert version_module._discover_version() == \"0.0.0\"\n", "code_sha256": "14ae000744b08b159feb3a46eb97098c1b71f3ccb6684277df7d364b796ba811", "comments": [], "decorators": [], "definition_line": 10, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5740d7367d93e8b5e592954f3c78a89571733349f91682289d3f90ff54f96748", "id": "code_candidate_bb99beb08a4454d21d40f8ade238f2481308e2123030571094c7a286e5be3730", "imports": [{"alias": "version_module", "level": 0, "line": 1, "module": "bm25s.version", "name": null}], "kind": "function", "line_end": 16, "line_start": 10, "name": "test_discover_version_falls_back_when_distribution_is_missing", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "monkeypatch"}], "path": "tests/core/test_version.py", "qualified_name": "test_discover_version_falls_back_when_distribution_is_missing", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_discover_version_falls_back_when_distribution_is_missing(monkeypatch)", "source_id": "repo_source_165d96b441141ad74af1ea0216fc5c6a56007f64e5c0eff92a99111e09a2e449", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
