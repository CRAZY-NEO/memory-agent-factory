    <node id="code_candidate_3ec8c267ad10ab44e71a4d48dca325e1704179ad59f61c193e4d4be15649d223">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_environment():\n    for key in (\"BM25S_VERSION\", \"RELEASE_TAG\"):\n        value = os.environ.get(key)\n        if value:\n            return _normalize_version(value)\n\n    if os.environ.get(\"GITHUB_REF_TYPE\") == \"tag\":\n        value = os.environ.get(\"GITHUB_REF_NAME\")\n        if value:\n            return _normalize_version(value)\n\n    github_ref = os.environ.get(\"GITHUB_REF\", \"\")\n    if github_ref.startswith(\"refs/tags/\"):\n        return _normalize_version(github_ref)\n\n    return None\n", "code_sha256": "662f585cfae403cc6ea71da1add4eeb07a164ef9e6cc41b52d519996c3a9d088", "comments": [], "decorators": [], "definition_line": 24, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_3ec8c267ad10ab44e71a4d48dca325e1704179ad59f61c193e4d4be15649d223", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 39, "line_start": 24, "name": "_version_from_environment", "parameters": [], "path": "bm25s/high_level/setup.py", "qualified_name": "_version_from_environment", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _version_from_environment()", "source_id": "repo_source_e5fc7c562f0444f38f1579ffd481649872143a2e16ecd1931db291ef5c679eef", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
