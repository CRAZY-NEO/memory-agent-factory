      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_with_invalid_stemmer(self):\n        \"\"\"Test tokenization with invalid stemmer raises error\"\"\"\n        texts = [\"hello world\"]\n        \n        # Pass a non-callable, non-stemmer object\n        with self.assertRaises(ValueError) as context:\n            bm25s.tokenize(texts, stemmer=\"not_a_stemmer\", return_ids=False)\n        self.assertIn(\"Stemmer must have\", str(context.exception))\n", "code_sha256": "14a12e7cdae717daaef046280ca687f62ac6d40bf453c3ec128a0c4fd243bf3a", "comments": [{"line": 142, "text": "# Pass a non-callable, non-stemmer object"}], "decorators": [], "definition_line": 138, "docstring": "Test tokenization with invalid stemmer raises error", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_ea65fc8a32e02527982d39c60564590d75d92f4f3bc882656015824dd07659f5", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 145, "line_start": 138, "name": "test_tokenize_with_invalid_stemmer", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenize_with_invalid_stemmer", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_tokenize_with_invalid_stemmer(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6