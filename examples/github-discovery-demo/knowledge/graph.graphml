    <node id="code_candidate_65299c8707b270ed510bb4026c3a72a68b1de4d605f5be746cc0dc0e9d237ca3">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _topk_numpy(query_scores, k, sorted):\n    # https://stackoverflow.com/questions/65038206/how-to-get-indices-of-top-k-values-from-a-numpy-array\n    # np.argpartition is faster than np.argsort, but do not return the values in order\n    partitioned_ind = np.argpartition(query_scores, -k)\n    # Since lit's a single query, we can take the last k elements\n    partitioned_ind = partitioned_ind.take(indices=range(-k, 0))\n    # We use the newly selected indices to find the score of the top-k values\n    partitioned_scores = np.take(query_scores, partitioned_ind)\n\n    if sorted:\n        # Since our top-k indices are not correctly ordered, we can sort them with argsort\n        # only if sorted=True (otherwise we keep it in an arbitrary order)\n        sorted_trunc_ind = np.flip(np.argsort(partitioned_scores))\n\n        # We again use np.take_along_axis as we have an array of indices that we use to\n        # decide which values to select\n        ind = partitioned_ind[sorted_trunc_ind]\n        query_scores = partitioned_scores[sorted_trunc_ind]\n\n    else:\n        ind = partitioned_ind\n        query_scores = partitioned_scores\n\n    return query_scores, ind\n", "code_sha256": "9c069a0097808c8dae0e73e6818c771ec8a21faa6619bda788eed02dd67708fb", "comments": [{"line": 15, "text": "# https://stackoverflow.com/questions/65038206/how-to-get-indices-of-top-k-values-from-a-numpy-array"}, {"line": 16, "text": "# np.argpartition is faster than np.argsort, but do not return the values in order"}, {"line": 18, "text": "# Since lit's a single query, we can take the last k elements"}, {"line": 20, "text": "# We use the newly selected indices to find the score of the top-k values"}, {"line": 24, "text": "# Since our top-k indices are not correctly ordered, we can sort them with argsort"}, {"line": 25, "text": "# only if sorted=True (otherwise we keep it in an arbitrary order)"}, {"line": 28, "text": "# We again use np.take_along_axis as we have an array of indices that we use to"}, {"line": 29, "text": "# decide which values to select"}], "decorators": [], "definition_line": 14, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "fc6d6e68870a83c13fdd3cfd8fdcbfeb3f200cb7eb65e77b1e9c969214816481", "id": "code_candidate_65299c8707b270ed510bb4026c3a72a68b1de4d605f5be746cc0dc0e9d237ca3", "imports": [{"alias": "np", "level": 0, "line": 1, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "jax.lax", "name": null}], "kind": "function", "line_end": 37, "line_start": 14, "name": "_topk_numpy", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "sorted"}], "path": "bm25s/selection.py", "qualified_name": "_topk_numpy", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _topk_numpy(query_scores, k, sorted)", "source_id": "repo_source_c7da3e4b95a090d35669bdcb2a5e2934540ab6c49f042c6f7e4a8a521b80a18c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
