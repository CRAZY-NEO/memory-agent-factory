    <node id="code_candidate_81647202fab69bcd228e0650755bdc72f66bd5b3e5a931b013645f208e8741ac">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def get_max_memory_usage(format=\"GB\"):\n    if resource is None:\n        logger.warning(\"resource module not available, cannot get memory usage\")\n        return None\n    if format not in [\"GB\", \"MB\", \"KB\"]:\n        raise ValueError(\"format should be one of 'GB', 'MB', 'KB'\")\n\n    usage_kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n    # for mac, ru_maxrss is in bytes\n    \n    if sys.platform == \"darwin\":\n        usage_kb /= 1024\n    \n    if format == \"GB\":\n        return usage_kb / (1024**2)\n    elif format == \"MB\":\n        return usage_kb / 1024\n    else:\n        return usage_kb\n", "code_sha256": "92816fe73002286fe3b39b2960964a7dba1277deb935c050b8ea82412a9304a6", "comments": [{"line": 23, "text": "# for mac, ru_maxrss is in bytes"}], "decorators": [], "definition_line": 15, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_81647202fab69bcd228e0650755bdc72f66bd5b3e5a931b013645f208e8741ac", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "function", "line_end": 33, "line_start": 15, "name": "get_max_memory_usage", "parameters": [{"annotation": null, "default": "'GB'", "kind": "positional_or_keyword", "name": "format"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "get_max_memory_usage", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def get_max_memory_usage(format='GB')", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d013be753eacf3220cbe96f3ac675f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
