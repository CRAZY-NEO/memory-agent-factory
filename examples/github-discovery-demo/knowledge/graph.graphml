      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_idf_bm25plus(df, N):\n    \"\"\"\n    Computes the inverse document frequency component of the BM25 score using BM25+ variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    return math.log((N + 1) / df)\n", "code_sha256": "0562111d9a60bd837333eefc9e171712b817dbe4c321bb109a9d685f28da4bca", "comments": [], "decorators": [], "definition_line": 214, "docstring": "\n    Computes the inverse document frequency component of the BM25 score using BM25+ variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_73c773e4c5e20aad6a8de921f98aab55d376e0d0d90ddb3a46f9b8dbf28066e0", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 219, "line_start": 214, "name": "_score_idf_bm25plus", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "df"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "N"}], "path": "bm25s/scoring.py", "qualified_name": "_score_idf_bm25plus", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _score_idf_bm25plus(df, N)", "source_id"