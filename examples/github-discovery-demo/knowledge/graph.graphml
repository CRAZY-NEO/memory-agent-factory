    <node id="code_candidate_5954c35a7eca5ba54f67e5c233ca78da1a4ddfe6f6eaf7f8c5f4458dbd2a55c2">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_pkg_info(package_dir):\n    pkg_info = package_dir / \"PKG-INFO\"\n    if not pkg_info.exists():\n        return None\n\n    for line in pkg_info.read_text(encoding=\"utf8\").splitlines():\n        if line.startswith(\"Version:\"):\n            return _normalize_version(line.partition(\":\")[2])\n\n    return None\n", "code_sha256": "0f37358ffbdb2f78fbbcea4a5799a408f17b5c904b2bf3dd951a70b29fe1c888", "comments": [], "decorators": [], "definition_line": 42, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ab9e5cf80de785d9b6fe576a61255ad29aa9ef65eff5f576514fdcd90c99ffcf", "id": "code_candidate_5954c35a7eca5ba54f67e5c233ca78da1a4ddfe6f6eaf7f8c5f4458dbd2a55c2", "imports": [{"alias": null, "level": 0, "line": 1, "module": "setuptools", "name": "setup"}, {"alias": null, "level": 0, "line": 2, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "pathlib", "name": "Path"}], "kind": "function", "line_end": 51, "line_start": 42, "name": "_version_from_pkg_info", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "package_dir"}], "path": "bm25s/high_level/setup.py", "qualified_name": "_version_from_pkg_info", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _version_from_pkg_info(package_dir)", "source_id": "repo_source_e5fc7c562f0444f38f1579ffd481649872143a2e16ecd1931db291ef5c679eef", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
