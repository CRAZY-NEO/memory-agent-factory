    <node id="code_candidate_b2d0e2ac74aa4939841a456c4f709cf9e5990720a756cd4fddbaa6e759997e0e">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def to_tokenized_tuple(self, docs: List[List[int]]) -&gt; Tokenized:\n        \"\"\"\n        Convert the token IDs to a Tokenized namedtuple, which contains the word IDs, or the stemmed IDs\n        if a stemmer is used. The Tokenized namedtuple contains two fields: ids and vocab. The latter\n        is a dictionary mapping the token IDs to the tokens, or a dictionary mapping the stemmed IDs to\n        the stemmed tokens (if a stemmer is used).\n        \"\"\"\n        return Tokenized(ids=docs, vocab=self.get_vocab_dict())\n", "code_sha256": "54ccebdc330f662af2f2a87f6741c62bc25f0fdf318963a8fa46a64d46e64921", "comments": [], "decorators": [], "definition_line": 484, "docstring": "\n        Convert the token IDs to a Tokenized namedtuple, which contains the word IDs, or the stemmed IDs\n        if a stemmer is used. The Tokenized namedtuple contains two fields: ids and vocab. The latter\n        is a dictionary mapping the token IDs to the tokens, or a dictionary mapping the stemmed IDs to\n        the stemmed tokens (if a stemmer is used).\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_b2d0e2ac74aa4939841a456c4f709cf9e5990720a756cd4fddbaa6e759997e0e", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Union"}, {"alias": null, "level": 0, "line": 5, "module": "typing", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 16, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_CHINESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_DUTCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_EN_PLUS"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_FRENCH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_GERMAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_ITALIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_KOREAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_NORWEGIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_PORTUGUESE"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_RUSSIAN"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SPANISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_SWEDISH"}, {"alias": null, "level": 1, "line": 21, "module": "stopwords", "name": "STOPWORDS_TURKISH"}], "kind": "method", "line_end": 491, "line_start": 484, "name": "to_tokenized_tuple", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": "List[List[int]]", "default": null, "kind": "positional_or_keyword", "name": "docs"}], "path": "bm25s/tokenization.py", "qualified_name": "Tokenizer.to_tokenized_tuple", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": "Tokenized", "signature": "def to_tokenized_tuple(self, docs: List[List[int]]) -&gt; Tokenized", "source_id": "repo_source_78ed1251f3a4d45980eaad9bcd59ff615e2d8534417caea3ee1795928fc59963", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
