      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_line_with_index(self):\n        \"\"\"Test get_line function\"\"\"\n        mmindex = find_newline_positions(self.test_file, show_progress=False)\n        \n        # Get first line\n        line = get_line(self.test_file, 0, mmindex)\n        self.assertIn(\"first line\", line)\n        \n        # Get second line\n        line = get_line(self.test_file, 1, mmindex)\n        self.assertIn(\"second line\", line)\n", "code_sha256": "f10af73b0d82f73c5c2d1665cad94abd4cf8884362ec4baac32a82440662e9be", "comments": [{"line": 81, "text": "# Get first line"}, {"line": 85, "text": "# Get second line"}], "decorators": [], "definition_line": 77, "docstring": "Test get_line function", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4dac517c5ff4f5b46d0f9038e04f3b1eb91c4264925b6d3b5060caac84d0f0a6", "id": "code_candidate_cbae8d40bb9cd0b39ef55682cdb2a01ec1e5d9e18c9a3fbc33ebeb060db0277b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "find_newline_positions"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "get_line"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "load_mmindex"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corp