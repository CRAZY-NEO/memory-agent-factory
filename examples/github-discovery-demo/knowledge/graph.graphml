      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    @unittest.mock.patch(\"bm25s.utils.json_functions.dumps\", json_functions.dumps_with_builtin)\n    @unittest.mock.patch(\"bm25s.utils.json_functions.loads\", json.loads)\n    def test_load_and_save_mmindex_no_orjson(self):\n        self.assertEqual(json_functions.dumps_with_builtin, json_functions.dumps)\n        self.assertEqual(json_functions.loads, json.loads)\n        self.test_load_and_save_mmindex()\n", "code_sha256": "56c73c227ac4b47fab3838377579114e68fbb2a72defbf92eba33ee1054ffade", "comments": [], "decorators": ["unittest.mock.patch('bm25s.utils.json_functions.dumps', json_functions.dumps_with_builtin)", "unittest.mock.patch('bm25s.utils.json_functions.loads', json.loads)"], "definition_line": 52, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "48c282942a3b7bcef2d80831cae74609ace88762a0a192c05508e36deafde792", "id": "code_candidate_2acd3318b5a8af786e7bca07b93a5e7fb838b9f90f1d5a60ed6c7316e2e72f04", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 21, "module": "uuid", "name": null}, {"alias": null, "level": 0, "line": 33, "mod