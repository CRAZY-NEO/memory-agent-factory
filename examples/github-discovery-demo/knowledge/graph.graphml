    <node id="code_candidate_a67ddb02cf4c7cebd7faaf4a63e5d0de02eb7d112c86c39a4b17d558ee1c9326">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_with_invalid_weight_mask_dimensions(self):\n        \"\"\"Test retrieve with weight_mask that is not 1D\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\"]]\n        \n        # Create 2D weight mask\n        weight_mask = np.array([[1, 0], [1, 0]])\n        \n        with self.assertRaises(ValueError) as context:\n            retriever.retrieve(query_tokens, k=2, weight_mask=weight_mask)\n        self.assertIn(\"weight_mask must be a 1D array\", str(context.exception))\n", "code_sha256": "7090b3f6a5108bcced47643eeda5824fa4b6821a47e5851ead156aef66555fa3", "comments": [{"line": 294, "text": "# Create 2D weight mask"}], "decorators": [], "definition_line": 287, "docstring": "Test retrieve with weight_mask that is not 1D", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_a67ddb02cf4c7cebd7faaf4a63e5d0de02eb7d112c86c39a4b17d558ee1c9326", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 299, "line_start": 287, "name": "test_retrieve_with_invalid_weight_mask_dimensions", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_with_invalid_weight_mask_dimensions", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_retrieve_with_invalid_weight_mask_dimensions(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
