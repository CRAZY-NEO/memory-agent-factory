    <node id="code_candidate_cc799b7f4c84942cb9a72833d37f4966e67dbc48a7ea2a36a4a6faa5951a005a">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def get_tokens_ids(self, query_tokens: List[str]) -&gt; List[int]:\n        \"\"\"\n        For a given list of tokens, return the list of token IDs, leaving out tokens\n        that are not in the vocabulary.\n        \"\"\"\n        return [\n            self.vocab_dict[token] for token in query_tokens if token in self.vocab_dict\n        ]\n", "code_sha256": "129d14f68362a978a929f96278fb4563e9bfc5c2aa216aa5e1b3dc9c49d00bc6", "comments": [], "decorators": [], "definition_line": 572, "docstring": "\n        For a given list of tokens, return the list of token IDs, leaving out tokens\n        that are not in the vocabulary.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "acfe408d3cafec38b061d055743a4081ab7ce38c93b300815bfbf9a399b7d6eb", "id": "code_candidate_cc799b7f4c84942cb9a72833d37f4966e67dbc48a7ea2a36a4a6faa5951a005a", "imports": [{"alias": null, "level": 0, "line": 1, "module": "concurrent.futures", "name": "ThreadPoolExecutor"}, {"alias": null, "level": 0, "line": 2, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 3, "module": "functools", "name": "partial"}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "Iterable"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 9, "module": "typing", "name": "NamedTuple"}, {"alias": null, "level":