    <node id="code_candidate_1d023e60acadea32e3828cab4c09429512a85d0fb0a1ba93136b27902350f254">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def find_newline_positions(path, show_progress=True, leave_progress=True, encoding=\"utf-8\"):\n    path = str(path)\n    indexes = []\n    with open(path, \"r\", encoding=encoding) as f:\n        indexes.append(f.tell())\n        pbar = tqdm(\n            total=os.path.getsize(path),\n            desc=\"Finding newlines for mmindex\",\n            unit=\"B\",\n            unit_scale=True,\n            disable=not show_progress,\n            leave=leave_progress,\n        )\n\n        while f.readline():\n            t = f.tell()\n            indexes.append(t)\n        \n            if pbar is not None:\n                pbar.update(t - indexes[-2])\n        \n        if pbar is not None:\n            pbar.close()\n\n    return indexes[:-1]\n", "code_sha256": "059dac6c1b9b3bdb51b16a98f6586c0230e462cc75f64ca5cbc1b2b67d9d46e5", "comments": [], "decorators": [], "definition_line": 31, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_1d023e60acadea32e3828cab4c09429512a85d0fb0a1ba93136b27902350f254", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "function", "line_end": 55, "line_start": 31, "name": "find_newline_positions", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "path"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "leave_progress"}, {"annotation": null, "default": "'utf-8'", "kind": "positional_or_keyword", "name": "encoding"}], "path": "bm25s/utils/corpus.py", "qualified_name": "find_newline_positions", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def find_newline_positions(path, show_progress=True, leave_progress=True, encoding='utf-8')", "source_id": "repo_source_9c238e0d8cf02a60a1ca21fc96a53350ddd66bc2d369bca811ec00af2621e2bf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
