    <node id="code_candidate_225c25781e3c411b03f436914a2d6e34201e0af3df89df8a34e8184d05130dee">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_reload_rejects_truncated_file_with_in_memory_index(self):\n        corpus = JsonlCorpus(\n            self.path, show_progress=False, save_index=False, verbosity=0\n        )\n        self.addCleanup(corpus.close)\n        self.assertEqual(len(corpus), 2)\n        corpus.close()\n        self.path.write_bytes(b\"\")\n\n        with self.assertRaises(ValueError):\n            corpus.load()\n        self.assertIsNone(corpus.file_obj)\n        self.assertIsNone(corpus.mmap_obj)\n", "code_sha256": "7112eb77f020cf68e5ce85268e532de8d06545092605dfe54c991aeaebe84a4c", "comments": [], "decorators": [], "definition_line": 31, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "89148d421a705bf1e74fea0181523df8aa3f52c4b7aa048dbc71814b6de92aba", "id": "code_candidate_225c25781e3c411b03f436914a2d6e34201e0af3df89df8a34e8184d05130dee", "imports": [{"alias": null, "level": 0, "line": 1, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "JsonlCorpus"}, {"alias": null, "level": 0, "line": 6, "module": "bm25s.utils.corpus", "name": "change_extension"}], "kind": "method", "line_end": 43, "line_start": 31, "name": "test_reload_rejects_truncated_file_with_in_memory_index", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_corpus_truncation.py", "qualified_name": "TestCorpusTruncation.test_reload_rejects_truncated_file_with_in_memory_index", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_reload_rejects_truncated_file_with_in_memory_index(self)", "source_id": "repo_source_916ea447a52fddd7945de51f690d6ff5eb59e69caef98bac29449edcddd14a4f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
