    <node id="code_candidate_66a833e18081000cb7ddf46d0fbe9d34e1116cf28cf8083fd2abb8600ce2c72b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def main(index_dir=\"bm25s_indices\", data_dir=\"datasets\", dataset=\"nq\", split=\"test\", mmap=True):\n    index_dir = Path(index_dir) / dataset\n    \n    if mmap:\n        print(\"Using memory-mapped index (mmap) to reduce memory usage.\")\n\n    timer = bm25s.utils.benchmark.Timer(\"[BM25S]\")\n\n    queries = bm25s.utils.beir.load_queries(dataset, save_dir=data_dir)\n    qrels = bm25s.utils.beir.load_qrels(dataset, split=split, save_dir=data_dir)\n    queries_lst = [v[\"text\"] for k, v in queries.items() if k in qrels]\n    print(f\"Loaded {len(queries_lst)} queries.\")\n\n    stemmer = Stemmer.Stemmer(\"english\")\n    \n    # Tokenize the queries\n    queries_tokenized = bm25s.tokenize(queries_lst, stemmer=stemmer, return_ids=False)\n    \n    # # Alternatively, you can use the following code to tokenize the queries\n    # # using the saved tokenizer from the index directory\n    # tokenizer = bm25s.tokenization.Tokenizer(stemmer=stemmer)\n    # tokenizer.load_stopwords(index_dir)\n    # tokenizer.load_vocab(index_dir)\n    # queries_tokenized = tokenizer.tokenize(queries_lst, update_vocab=False)\n\n    mem_use = bm25s.utils.benchmark.get_max_memory_usage()\n    print(f\"Initial memory usage: {mem_use:.2f} GB\")\n\n    # Load the BM25 index and retrieve the top-k results\n    print(f\"Loading the BM25 index for: {dataset}\")\n    t = timer.start(\"Loading index\")\n    retriever = bm25s.BM25.load(index_dir, mmap=mmap, load_corpus=True)\n    retriever.backend = \"numba\"\n    num_docs = retriever.scores['num_docs']\n    timer.stop(t, show=True, n_total=num_docs)\n\n    mem_use = bm25s.utils.benchmark.get_max_memory_usage()\n    print(f\"Memory usage after loading the index: {mem_use:.2f} GB\")\n\n    print(\"Retrieving the top-k results...\")\n    t = timer.start(\"Retrieving\")\n    results = retriever.retrieve(queries_tokenized, k=10)\n    timer.stop(t, show=True, n_total=len(queries_lst))\n\n    # get memory usage\n    mem_use = bm25s.utils.benchmark.get_max_memory_usage()\n    print(f\"Final (peak) memory usage: {mem_use:.2f} GB\")\n\n    print(\"-\" * 50)\n    first_result = results.documents[0]\n    print(f\"First score (# 1 result): {results.scores[0, 0]:.4f}\")\n    print(f\"First result (# 1 result):\\n{first_result[0]}\")\n", "code_sha256": "2737331a0fedd0e49ac62b1330f7fcf58b0e5251d68ede1fc9ecba36123f8290", "comments": [{"line": 49, "text": "# Tokenize the queries"}, {"line": 52, "text": "# # Alternatively, you can use the following code to tokenize the queries"}, {"line": 53, "text": "# # using the saved tokenizer from the index directory"}, {"line": 54, "text": "# tokenizer = bm25s.tokenization.Tokenizer(stemmer=stemmer)"}, {"line": 55, "text": "# tokenizer.load_stopwords(index_dir)"}, {"line": 56, "text": "# tokenizer.load_vocab(index_dir)"}, {"line": 57, "text": "# queries_tokenized = tokenizer.tokenize(queries_lst, update_vocab=False)"}, {"line": 62, "text": "# Load the BM25 index and retrieve the top-k results"}, {"line": 78, "text": "# get memory usage"}], "decorators": [], "definition_line": 34, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "ca9dec55cf3f01b97d3f32595bb1acbb6c44f9157668622e24cd62485a289ad1", "id": "code_candidate_66a833e18081000cb7ddf46d0fbe9d34e1116cf28cf8083fd2abb8600ce2c72b", "imports": [{"alias": null, "level": 0, "line": 27, "module": "pathlib", "name": "Path"}, {"alias": "np", "level": 0, "line": 28, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 29, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 30, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 31, "module": "tqdm", "name": "tqdm"}], "kind": "function", "line_end": 85, "line_start": 34, "name": "main", "parameters": [{"annotation": null, "default": "'bm25s_indices'", "kind": "positional_or_keyword", "name": "index_dir"}, {"annotation": null, "default": "'datasets'", "kind": "positional_or_keyword", "name": "data_dir"}, {"annotation": null, "default": "'nq'", "kind": "positional_or_keyword", "name": "dataset"}, {"annotation": null, "default": "'test'", "kind": "positional_or_keyword", "name": "split"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "mmap"}], "path": "examples/retrieve_nq.py", "qualified_name": "main", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def main(index_dir='bm25s_indices', data_dir='datasets', dataset='nq', split='test', mmap=True)", "source_id": "repo_source_9ba43ff15a0a39653d3511cca784024c564522d346ffb094bdc542941c076dcd", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
