    <node id="code_candidate_7239e199db0960e4e7d9adc5171dca7a5bdcf0b3be63a67b74777f3ff665aa21">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_faketqdm_when_tqdm_disabled(self):\n        \"\"\"Test that fake tqdm works when DISABLE_TQDM is set\"\"\"\n        # Save original value\n        original_tqdm = os.environ.get(\"DISABLE_TQDM\")\n        \n        try:\n            # Set DISABLE_TQDM\n            os.environ[\"DISABLE_TQDM\"] = \"1\"\n            \n            # Re-import to get the fake tqdm\n            import importlib\n            importlib.reload(bm25s)\n            \n            # Test that tqdm just returns the iterable\n            test_list = [1, 2, 3]\n            # The fake tqdm should just return the iterable as-is\n            self.assertIs(bm25s.tqdm(test_list), test_list)\n        finally:\n            # Restore original value\n            if original_tqdm is None:\n                os.environ.pop(\"DISABLE_TQDM\", None)\n            else:\n                os.environ[\"DISABLE_TQDM\"] = original_tqdm\n            \n            # Reload to restore normal behavior\n            importlib.reload(bm25s)\n", "code_sha256": "18fcd30924928c53fedf62c1b9f644c5f83ffa112db0163a45c5cb27a4e61472", "comments": [{"line": 78, "text": "# Save original value"}, {"line": 82, "text": "# Set DISABLE_TQDM"}, {"line": 85, "text": "# Re-import to get the fake tqdm"}, {"line": 89, "text": "# Test that tqdm just returns the iterable"}, {"line": 91, "text": "# The fake tqdm should just return the iterable as-is"}, {"line": 94, "text": "# Restore original value"}, {"line": 100, "text": "# Reload to restore normal behavior"}], "decorators": [], "definition_line": 76, "docstring": "Test that fake tqdm works when DISABLE_TQDM is set", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e3931e4316271c69f108b1b84deeda9b0db9b6b572aabb8cdf9a72c919e42678", "id": "code_candidate_7239e199db0960e4e7d9adc5171dca7a5bdcf0b3be63a67b74777f3ff665aa21", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 86, "module": "importlib", "name": null}], "kind": "method", "line_end": 101, "line_start": 76, "name": "test_faketqdm_when_tqdm_disabled", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_init_utils.py", "qualified_name": "TestBM25SUtilityFunctions.test_faketqdm_when_tqdm_disabled", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_faketqdm_when_tqdm_disabled(self)", "source_id": "repo_source_d2e25ca3d658c6e9e322eb7ac31fb9670b4a1818f495385ec9ffab88d1efb78c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
