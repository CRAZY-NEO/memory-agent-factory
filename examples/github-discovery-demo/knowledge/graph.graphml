    <node id="code_candidate_89f3fd96a31aad06de711f8a0958f6ae776419220d431202e1ac26426c0e6b93">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_get_scores_from_ids_with_invalid_token_id(self):\n        \"\"\"Test get_scores_from_ids with token ID higher than vocab size\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        # Get the max token ID in vocab\n        max_token_id = max(retriever.vocab_dict.values())\n        \n        # Try to query with a token ID that's too high\n        with self.assertRaises(ValueError) as context:\n            retriever.get_scores_from_ids([max_token_id + 100])\n        self.assertIn(\"maximum token ID\", str(context.exception))\n", "code_sha256": "17879d667e3a7378235fcb5cb049308adccd5a1d4e90949055e07d1fad09dc2b", "comments": [{"line": 153, "text": "# Get the max token ID in vocab"}, {"line": 156, "text": "# Try to query with a token ID that's too high"}], "decorators": [], "definition_line": 148, "docstring": "Test get_scores_from_ids with token ID higher than vocab size", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_89f3fd96a31aad06de711f8a0958f6ae776419220d431202e1ac26426c0e6b93", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 159, "line_start": 148, "name": "test_get_scores_from_ids_with_invalid_token_id", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_get_scores_from_ids_with_invalid_token_id", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_get_scores_from_ids_with_invalid_token_id(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
