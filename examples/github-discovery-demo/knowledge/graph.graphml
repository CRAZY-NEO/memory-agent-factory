      <data key="d1">{"byte_count": 49, "encoding": "utf-8", "id": "repo_source_54ca2caa9b1942f4d3bb2a650935c0436e5f86c5e648b9c4874fb6d5ed34e8d0", "imports": [], "module_docstring": "\nTesting for stopwords needs to be define.\n", "path": "tests/stopwords/test_stopwords.py", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "sha256": "f6b187de4976fbb4c0db6e378380015fc628732452a1fbb57b043b6d3f7d696c", "source_type": "python_repository", "text": "\"\"\"\nTesting for stopwords needs to be define.\n\"\"\""}</data>
