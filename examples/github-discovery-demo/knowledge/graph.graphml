      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_infer_corpus_object_with_tokens(self):\n        \"\"\"Test _infer_corpus_object with list of tokens\"\"\"\n        corpus = [[\"hello\", \"world\"], [\"foo\", \"bar\"]]\n        result = BM25._infer_corpus_object(corpus)\n        self.assertEqual(result, \"tokens\")\n", "code_sha256": "1d26d80c81edb0e323fd31cbb7e7a2cafc476806dc19092516f1359ca9a13f77", "comments": [], "decorators": [], "definition_line": 73, "docstring": "Test _infer_corpus_object with list of tokens", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_e75e89b49cb8235b85f05af775ce60129ce9d61ab9cc3ab3ccaf451304d6a311", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 77, "line_start": 73, "name": "test_infer_corpus_object_with_tokens", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_infer_corpus_object_with_tokens", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_infer_corpus_object_with_tokens(self)", "source_id": "repo_source_baa3c34d80de4f6b3adb112428e9b949d7171f2768ace170195807dfbca97eca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
