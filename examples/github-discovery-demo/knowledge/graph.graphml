    <node id="code_candidate_a94d5354ce8ecf663fd177dbcf2fa7b7d1c4e5ad00713d278557fc3e00f6f986">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def load_qrels(\n    dataset, split=\"test\", save_dir=\"./datasets\", show_progress=True, leave_progress=False, return_dict=True\n):\n    \"\"\"\n    This is tsv files\n    \"\"\"\n    if split not in [\"train\", \"dev\", \"test\"]:\n        raise ValueError(\"split must be one of ['train', 'dev', 'test']\")\n\n    dataset_path = Path(save_dir) / dataset\n    qrels_path = dataset_path / \"qrels\" / f\"{split}.tsv\"\n\n    if not qrels_path.exists():\n        raise FileNotFoundError(f\"Qrels file not found at {qrels_path}\")\n\n    qrels = []\n    with open(qrels_path, \"r\") as f:\n        # skip first line\n        next(f)\n        for line in tqdm(\n            f,\n            desc=\"Loading Qrels {}\".format(dataset),\n            leave=leave_progress,\n            disable=not show_progress,\n        ):\n            qid, cid, score = line.strip().split(\"\\t\")\n            qrels.append((qid, cid, int(score)))\n\n    if return_dict:\n        qrels = {qid: {cid: score} for qid, cid, score in qrels}\n\n    return qrels\n", "code_sha256": "675a1334a3ae901388e188b33f6b1180a6048592d11e2d1ea9df36653e97b11f", "comments": [{"line": 317, "text": "# skip first line"}], "decorators": [], "definition_line": 300, "docstring": "\n    This is tsv files\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e55bdbe5978ef2884aedc5ce246e8f8fb41c4e15ca153b4f9b580e1110d87c63", "id": "code_candidate_a94d5354ce8ecf663fd177dbcf2fa7b7d1c4e5ad00713d278557fc3e00f6f986", "imports": [{"alias": null, "level": 0, "line": 1, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "List"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Tuple"}, {"alias": null, "level": 0, "line": 6, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 14, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 19, "module": null, "name": "json_functions"}, {"alias": null, "level": 0, "line": 135, "module": "urllib.request", "name": null}, {"alias": null, "level": 0, "line": 136, "module": "urllib.error", "name": null}, {"alias": null, "level": 0, "line": 137, "module": "zipfile", "name": null}, {"alias": null, "level": 0, "line": 138, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 139, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 345, "module": "pytrec_eval", "name": null}], "kind": "function", "line_end": 331, "line_start": 300, "name": "load_qrels", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "dataset"}, {"annotation": null, "default": "'test'", "kind": "positional_or_keyword", "name": "split"}, {"annotation": null, "default": "'./datasets'", "kind": "positional_or_keyword", "name": "save_dir"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "show_progress"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "leave_progress"}, {"annotation": null, "default": "True", "kind": "positional_or_keyword", "name": "return_dict"}], "path": "bm25s/utils/beir.py", "qualified_name": "load_qrels", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def load_qrels(dataset, split='test', save_dir='./datasets', show_progress=True, leave_progress=False, return_dict=True)", "source_id": "repo_source_77ca391adf493104c5b8e45f605714d19238af83005c86fcfe57f52fd5d17419", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": nu