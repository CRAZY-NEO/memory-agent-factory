    <node id="code_candidate_3d43d06ceb655112bedb20c3cb7db4dd51b5fb86bc5ed3962908fdd7b89e49e8">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_load_and_save_mmindex(self):\n        import bm25s\n\n        try:\n            import orjson\n        except ImportError:\n            self.fail(\"orjson is not installed\")\n\n        file = self.file\n        mmindex = bm25s.utils.corpus.find_newline_positions(file)\n        bm25s.utils.corpus.save_mmindex(mmindex, file)\n\n        # read the first line\n        mmindex = bm25s.utils.corpus.load_mmindex(file)\n        \n        for i in range(500):\n            self.assertEqual(bm25s.utils.corpus.get_line(file, i, mmindex), self.strings[i])\n", "code_sha256": "cd9b27a39a8f604e4d882d15aee9825e6698a1872ad5b72b7d0f90f2165cd59f", "comments": [{"line": 31, "text": "# hide orjson from importable"}, {"line": 44, "text": "# read the first line"}], "decorators": [], "definition_line": 32, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "48c282942a3b7bcef2d80831cae74609ace88762a0a192c05508e36deafde792", "id": "code_candidate_3d43d06ceb655112bedb20c3cb7db4dd51b5fb86bc5ed3962908fdd7b89e49e8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "unittest.mock", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 8, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.utils", "name": "json_functions"}, {"alias": null, "level": 0, "line": 21, "module": "uuid", "name": null}, {"alias": null, "level": 0, "line": 33, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 36, "module": "orjson", "name": null}], "kind": "method", "line_end": 48, "line_start": 32, "name": "test_load_and_save_mmindex", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_utils_corpus.py", "qualified_name": "TestUtilsCorpus.test_load_and_save_mmindex", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_load_and_save_mmindex(self)", "source_id": "repo_source_0c531e1ca2d23bbeced4a19c29842684c6029387294f8269bf1ad2bfa2ef1431", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
