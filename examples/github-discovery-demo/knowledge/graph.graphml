    <node id="code_candidate_eee93654a73660f945705d5684ed16fde42630b66d54319f4587867b868a6e5d">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def reset_vocab(self):\n        \"\"\"\n        Reset the vocabulary dictionaries to empty dictionaries, allowing you to\n        tokenize a new set of texts without reusing the previous vocabulary.\n        \"\"\"\n        self.word_to_stem = {}  # word -&gt; stemmed word, e.g. \"apple\" -&gt; \"appl\"\n        self.stem_to_sid = {}  # stem -&gt; stemmed id, e.g. \"appl\" -&gt; 0\n        # word -&gt; {stemmed, unstemmed} id, e.g. \"apple\" -&gt; 0 (appl) or \"apple\" -&gt; 2 (apple)\n        self.word_to_id = {}\n", "code_sha256": "e77caf7096322985258b032babdaccd4a762163458783cee148a20fcbb292900", "comments": [{"line": 180, "text": "# word -&gt; stemmed word, e.g. \"apple\" -&gt; \"appl\""}, {"line": 181, "text": "# stem -&gt; stemmed id, e.g. \"appl\" -&gt; 0"}, {"line": 182, "text": "# word -&gt; {stemmed, unstemmed} id, e.g. \"apple\" -&gt; 0 (appl) or \"apple\" -&gt; 2 (apple)"}], "decorators": [], "definition_line": 175, "docstring": "\n        Reset the vocabulary dictionaries to empty dictionaries, allowing you to\n        tokenize a new set of texts without reusing the previous vocabulary.\n        ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "647f463ad0b83e9f6dd19802e2c6e51996e64b5f6fa420e46f33097be1112871", "id": "code_candidate_eee93654a73660f945705d5684ed16fde42630b66d54319f4587867b868a6e5d", "imports": [{"alias": null, "level": 0, "line": 1, "module": "ast", "name": "Tuple"}, {"alias": null, "level": 0, "line": 2, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 3, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Any"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Callable"}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Dict"}, {"alias": null, "level": 0, "line": 4,