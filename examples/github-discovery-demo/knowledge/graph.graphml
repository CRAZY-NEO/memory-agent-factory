      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_mixed_empty_query(self):\n        corpus = bm25_hl.load(self.txt_path)\n        retriever = bm25_hl.index(corpus)\n        # One valid, one empty\n        results = retriever.search([\"test\", \"\"], k=1)\n        self.assertEqual(len(results), 2)\n        self.assertEqual(len(results[0]), 1)\n        self.assertEqual(len(results[1]), 0)\n", "code_sha256": "f330fbb6c38c3b417dc7f02ba8bbf3dc0449356b488d7bc41fda951f676c4bc9", "comments": [{"line": 116, "text": "# One valid, one empty"}], "decorators": [], "definition_line": 113, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "f2daa5e229dd85f66a35367fe63f1cd17e43e18b4276f4497845cbb313d18617", "id": "code_candidate_15859e61a9ea7746f11429ef6d3099b44c92e07b554252a215e4230d4ab63b6b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "csv", "name": null}, {"alias": "bm25_hl", "level": 0, "line": 7, "module": "bm25s.high_level", "name": null}], "kind": "method", "line_end": 120, "line_start": 113, "name": "test_mixed_empty_query", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/high_level/test_high_level.py", "qualified_name": "TestHighLevel.test_mixed_empty_query", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_mixed_empty_query(self)", "source_id": "repo_source_94a8358cf0efa7e5536338bc0206c227e225d63e90b69