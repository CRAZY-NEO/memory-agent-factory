      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_can_save_locally_non_empty_with_overwrite(self):\n        \"\"\"Test can_save_locally with non-empty directory and overwrite\"\"\"\n        non_empty_dir = os.path.join(self.tmpdir, \"non_empty\")\n        os.makedirs(non_empty_dir)\n        \n        # Add a file\n        with open(os.path.join(non_empty_dir, \"file.txt\"), \"w\") as f:\n            f.write(\"test\")\n        \n        self.assertTrue(can_save_locally(non_empty_dir, overwrite_local=True))\n", "code_sha256": "76d856a1d3821f265f010a086927ef9720c8c88e2aa90981fa17b6bf6c87f72f", "comments": [{"line": 72, "text": "# Add a file"}], "decorators": [], "definition_line": 67, "docstring": "Test can_save_locally with non-empty directory and overwrite", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "28e6fa925022fe2389bec7b19a3d2b1bd8637d9c789a30cbf321af111dcbe48e", "id": "code_candidate_98b492630fe5fc2a46acac7ebe2984a9149d4c36baf73d629d6c0d9a9a274824", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "can_save_locally"}, {"alias": null, "level": 0, "line": 5, "module": "bm25s.hf", "name": "is_dir_empty"}], "kind": "method", "line_end": 76, "line_start": 67, "name": "test_can_save_locally_non_empty_with_overwrite", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_hf_utils.py", "qualified_name": "TestHFUtilities.test_can_save_locally_non_empty_with_overwrite", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac8