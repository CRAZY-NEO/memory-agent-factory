    <node id="code_candidate_2c693c94ad5297fabe58361adc508d9d095963852c0c1dc7a6b27aaae5cbf2ab">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def search_command(args):\n    \"\"\"\n    Search an index with a query and print results.\n    Uses the high-level API components for search.\n    \"\"\"\n    from .. import BM25\n    from ..high_level import BM25Search\n    \n    use_user_dir = getattr(args, 'user', False)\n    index_arg = getattr(args, 'index', None)\n    \n    # Determine index path\n    if use_user_dir:\n        if index_arg:\n            # Use specified index from user directory\n            index_dir = get_user_indices_dir() / index_arg\n        else:\n            # Interactive picker\n            index_path = select_index_interactive()\n            index_dir = Path(index_path)\n    elif index_arg:\n        index_dir = Path(index_arg)\n    else:\n        print(\"Error: Must specify --index or use --user flag.\", file=sys.stderr)\n        sys.exit(1)\n    \n    if not index_dir.exists():\n        print(f\"Error: Index directory '{index_dir}' not found.\", file=sys.stderr)\n        sys.exit(1)\n    \n    query = args.query\n    k = args.top_k\n    \n    print(f\"Loading index from '{index_dir}'...\")\n    \n    try:\n        # Load the BM25 index with corpus\n        retriever = BM25.load(str(index_dir), load_corpus=True)\n    except Exception as e:\n        print(f\"Error loading index: {e}\", file=sys.stderr)\n        sys.exit(1)\n    \n    # Load corpus from the retriever\n    corpus = retriever.corpus\n    if corpus is None:\n        print(\"Error: Corpus not found in index.\", file=sys.stderr)\n        sys.exit(1)\n    \n    # Convert corpus to list of strings if needed\n    corpus_texts = []\n    for doc in corpus:\n        if isinstance(doc, dict):\n            if 'text' in doc:\n                corpus_texts.append(doc['text'])\n            else:\n                # Use first value\n                corpus_texts.append(str(list(doc.values())[0] if doc else \"\"))\n        else:\n            corpus_texts.append(str(doc))\n    \n    # Create a BM25Search object with the loaded corpus\n    # This will re-tokenize but ensures consistent behavior with high-level API\n    search_obj = BM25Search(corpus=corpus_texts)\n    \n    # Perform search using high-level API\n    num_docs = len(corpus_texts)\n    actual_k = min(k, num_docs)\n    \n    results = search_obj.search([query], k=actual_k)\n    \n    # Save results to file if requested\n    save_path = getattr(args, 'save', None)\n    if save_path:\n        output_data = {\n            \"query\": query,\n            \"num_results\": len(results[0]),\n            \"total_documents\": num_docs,\n            \"results\": results[0]\n        }\n        save_path = Path(save_path)\n        save_path.parent.mkdir(parents=True, exist_ok=True)\n        with open(save_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(output_data, f, indent=2, ensure_ascii=False)\n        print(f\"Results saved to '{save_path}'\")\n    \n    # Print results\n    print(f\"\\nSearch results for: \\\"{query}\\\"\\n\")\n    print(\"-\" * 60)\n    \n    for i, result in enumerate(results[0]):\n        doc_text = result[\"document\"]\n        score = result[\"score\"]\n        \n        # Truncate long documents for display\n        max_len = 200\n        if len(doc_text) &gt; max_len:\n            doc_text = doc_text[:max_len] + \"...\"\n        \n        print(f\"[{i+1}] (score: {score:.4f})\")\n        print(f\"    {doc_text}\")\n        print()\n    \n    print(\"-\" * 60)\n    print(f\"Showing top {len(results[0])} of {num_docs} documents\")\n", "code_sha256": "70f9c1c4cce9de98cf7ab57ae856be02c18cb70ed8b46562c1bebc989949f548", "comments": [{"line": 201, "text": "# Determine index path"}, {"line": 204, "text": "# Use specified index from user directory"}, {"line": 207, "text": "# Interactive picker"}, {"line": 226, "text": "# Load the BM25 index with corpus"}, {"line": 232, "text": "# Load corpus from the retriever"}, {"line": 238, "text": "# Convert corpus to list of strings if needed"}, {"line": 245, "text": "# Use first value"}, {"line": 250, "text": "# Create a BM25Search object with the loaded corpus"}, {"line": 251, "text": "# This will re-tokenize but ensures consistent behavior with high-level API"}, {"line": 254, "text": "# Perform search using high-level API"}, {"line": 260, "text": "# Save results to file if requested"}, {"line": 275, "text": "# Print results"}, {"line": 283, "text": "# Truncate long documents for display"}], "decorators": [], "definition_line": 190, "docstring": "\n    Search an index with a query and print results.\n    Uses the high-level API components for search.\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "494e56b9ebbe6dbee99d7037fdad57f53423edd7135b51252c8f65ce514a9a38", "id": "code_candidate_2c693c94ad5297fabe58361adc508d9d095963852c0c1dc7a6b27aaae5cbf2ab", "imports": [{"alias": null, "level": 0, "line": 15, "module": "argparse", "name": null}, {"alias": null, "level": 0, "line": 16, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 17, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 18, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 56, "module": "rich.console", "name": "Console"}, {"alias": null, "level": 0, "line": 57, "module": "rich.prompt", "name": "Prompt"}, {"alias": null, "level": 0, "line": 58, "module": "rich.table", "name": "Table"}, {"alias": null, "level": 0, "line": 59, "module": "rich.panel", "name": "Panel"}, {"alias": "create_index", "level": 2, "line": 130, "module": "high_level", "name": "index"}, {"alias": "load_documents", "level": 2, "line": 130, "module": "high_level", "name": "load"}, {"alias": null, "level": 2, "line": 195, "module": null, "name": "BM25"}, {"alias": null, "level": 2, "line": 196, "module": "high_level", "name": "BM25Search"}], "kind": "function", "line_end": 293, "line_start": 190, "name": "search_command", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "args"}], "path": "bm25s/terminal/__init__.py", "qualified_name": "search_command", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def search_command(args)", "source_id": "repo_source_d90ec750371a8e4f760393696c89eb4723fedbe28852d9f0c4288c8fc61d6fd9", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
