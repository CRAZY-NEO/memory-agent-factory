      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def index(documents, language: str = \"english\"):\n    return BM25Search(corpus=documents, language=language)\n", "code_sha256": "fd1ebd8d988d5c2c0d77cd06527937ec84fa3caedab7222ff5841bccf1cbdb07", "comments": [], "decorators": [], "definition_line": 173, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "946e755ab1ea7890870f58c12cc72022dac540c52d09c0cb0be179acbe05acb8", "id": "code_candidate_acc0ff52d4bd5b6acb567ec2ff737ee676f0d4dd894ecbdb58d150934a8538a6", "imports": [{"alias": null, "level": 0, "line": 9, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "csv", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 12, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 13, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 14, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 15, "module": "typing", "name": "List"}], "kind": "function", "line_end": 174, "line_start": 173, "name": "index", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "documents"}, {"annotation": "str", "default": "'english'", "kind": "positional_or_keyword", "name": "language"}], "path": "bm25s/high_level/__init__.py", "qualified_name": "index", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def index(documents, language: str='english')", "source_id": "repo_source_db732141b7e7ae5212e90e5896dac429d4373f6c35b2637f77baeca3592a4c3b", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
