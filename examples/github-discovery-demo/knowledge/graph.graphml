    <node id="code_candidate_8547da6e06f59348f3c0fbb218feca346102e3ca1e5bdf2cc3ea29e6418122ef">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_streaming_tokenize(self):\n        \"\"\"Tests the `streaming_tokenize` method directly for its functionality.\"\"\"\n        stream = self.tokenizer.streaming_tokenize(self.corpus)\n        assert isinstance(stream, Generator)\n        for doc_ids in stream:\n            self.assertIsInstance(doc_ids, list)\n            for token_id in doc_ids:\n                self.assertIsInstance(token_id, int)\n", "code_sha256": "b4bea2280976f0b0334a335ac2508b24e9544d5a02f50a62d6f46210e466eeb5", "comments": [], "decorators": [], "definition_line": 90, "docstring": "Tests the `streaming_tokenize` method directly for its functionality.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_8547da6e06f59348f3c0fbb218feca346102e3ca1e5bdf2cc3ea29e6418122ef", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 97, "line_start": 90, "name": "test_streaming_tokenize", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_streaming_tokenize", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_streaming_tokenize(self)", "source_id": "repo_source_f01c1006e1a4861755fc65ea7a7f183e7109351add93b6ab38a478c435375b0f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
