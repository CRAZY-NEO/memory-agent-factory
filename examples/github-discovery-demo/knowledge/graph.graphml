    <node id="code_candidate_2f168c74f7addd2fa70b1821e1fc8e3d16a83cd17b1332df8e5b5b0d5ef3234b">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def to_dict(self, underscore=False, lowercase=False):\n        results_to_save = deepcopy(self.results)\n        if underscore:\n            results_to_save = {\n                k.replace(\" \", \"_\"): v for k, v in results_to_save.items()\n            }\n\n        if lowercase:\n            results_to_save = {k.lower(): v for k, v in results_to_save.items()}\n\n        return results_to_save\n", "code_sha256": "ce79a833b1da99791ca331cd6c1fa872ac2a60e97fb1e318e73d6c1fe9551dca", "comments": [], "decorators": [], "definition_line": 124, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_2f168c74f7addd2fa70b1821e1fc8e3d16a83cd17b1332df8e5b5b0d5ef3234b", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 134, "line_start": 124, "name": "to_dict", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "underscore"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "lowercase"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.to_dict", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def to_dict(self, underscore=False, lowercase=False)", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d0