    <node id="code_candidate_51c41f9839a78b523324ae309bb1601fe3fadcadfe6682fec2d3c6491ad2f2d8">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def stop(self, name, show=False, n_total=None):\n        if name not in self.results:\n            raise ValueError(f\"Timer with name {name} not started.\")\n\n        stop_time = time.monotonic()\n        r = self.results[name]\n        r[\"stopped\"] = stop_time\n        r[\"elapsed\"] += stop_time - r.pop(\"last\")\n\n        if show:\n            self.show(name, n_total=n_total)\n\n        return self.results[name][\"elapsed\"]\n", "code_sha256": "277d78178a849a48841bb7e6519537042fe6c0f492c3d8197e4efc5efa5e8110", "comments": [], "decorators": [], "definition_line": 49, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "e6a7c4a36aa6b8a1c22c85ad1a7a146c992ccdf3d93d107ffdb826f53bdc62b4", "id": "code_candidate_51c41f9839a78b523324ae309bb1601fe3fadcadfe6682fec2d3c6491ad2f2d8", "imports": [{"alias": null, "level": 0, "line": 1, "module": "copy", "name": "deepcopy"}, {"alias": null, "level": 0, "line": 2, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "time", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "sys", "name": null}, {"alias": null, "level": 0, "line": 9, "module": "resource", "name": null}], "kind": "method", "line_end": 61, "line_start": 49, "name": "stop", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "name"}, {"annotation": null, "default": "False", "kind": "positional_or_keyword", "name": "show"}, {"annotation": null, "default": "None", "kind": "positional_or_keyword", "name": "n_total"}], "path": "bm25s/utils/benchmark.py", "qualified_name": "Timer.stop", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def stop(self, name, show=False, n_total=None)", "source_id": "repo_source_37ba6567dde132f9882ef2e47abd6f84d7d013be753eacf3220cbe96f3ac675f", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
