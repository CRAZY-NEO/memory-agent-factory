      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def test_discover_version_uses_package_metadata(monkeypatch):\n    monkeypatch.setattr(version_module, \"version\", lambda name: \"1.2.3\")\n\n    assert version_module._discover_version() == \"1.2.3\"\n", "code_sha256": "414bfb66cea32abc31e8445c075ad997625a90c8b46fde9da2be79db9d1e1392", "comments": [], "decorators": [], "definition_line": 4, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "5740d7367d93e8b5e592954f3c78a89571733349f91682289d3f90ff54f96748", "id": "code_candidate_b1a0ad2f7f1fb44f541ead42fcd4c25e37bfe39b35daf4e853ee30a5c1e913c0", "imports": [{"alias": "version_module", "level": 0, "line": 1, "module": "bm25s.version", "name": null}], "kind": "function", "line_end": 7, "line_start": 4, "name": "test_discover_version_uses_package_metadata", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "monkeypatch"}], "path": "tests/core/test_version.py", "qualified_name": "test_discover_version_uses_package_metadata", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_discover_version_uses_package_metadata(monkeypatch)", "source_id": "repo_source_50f640253ab5ed6036f2e3052bdfd8178dfe62731374ebbbeaf81989f256b7f4", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
