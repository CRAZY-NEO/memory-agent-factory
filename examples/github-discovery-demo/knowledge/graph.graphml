    <node id="code_candidate_89ffffba36a9bbbb50e9380277625a42abe7d447cdbede1a4a2a1d4660318afc">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def __len__(self):\n        return len(self.mmindex)\n", "code_sha256": "c4c6edb1e2855efa1a5b5103d97542405ea11b745d24af6de0b2fea41c3ba76c", "comments": [], "decorators": [], "definition_line": 154, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_89ffffba36a9bbbb50e9380277625a42abe7d447cdbede1a4a2a1d4660318afc", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "method", "line_end": 155, "line_start": 154, "name": "__len__", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "bm25s/utils/corpus.py", "qualified_name": "JsonlCorpus.__len__", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def __len__(self)", "source_id": "repo_source_9c238e0d8cf02a60a1ca21fc96a53350ddd66bc2d369bca811ec00af2621e2bf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
