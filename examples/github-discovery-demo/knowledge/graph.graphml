    <node id="code_candidate_8db38cdb629b2cf64c448d7889117106956ca2cac71e0933ea45ec49a3f7a901">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def change_extension(path, new_extension):\n    \"\"\"Replace the final filename extension, or append one if it has none.\"\"\"\n    path = str(path)\n    return os.path.splitext(path)[0] + new_extension\n", "code_sha256": "ed6318de9be4cdd24db899368ea220969c752ba4bfc9b7e1bd00e02d20302c1b", "comments": [], "decorators": [], "definition_line": 25, "docstring": "Replace the final filename extension, or append one if it has none.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_8db38cdb629b2cf64c448d7889117106956ca2cac71e0933ea45ec49a3f7a901", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "function", "line_end": 28, "line_start": 25, "name": "change_extension", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "path"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "new_extension"}], "path": "bm25s/utils/corpus.py", "qualified_name": "change_extension", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def change_extension(path, new_extension)", "source_id": "repo_source_3a590e9df8c804c7e0ab59f7ac50e34f1861c4a59d907626f359b08c345a4784", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
