      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_tokenize_allow_empty_false(self):\n        \"\"\"Test tokenization with allow_empty=False\"\"\"\n        texts = [\"\"]  # Empty string\n        result = bm25s.tokenize(texts, allow_empty=False, return_ids=True)\n        \n        # Should have one token (empty string token)\n        self.assertEqual(len(result.ids[0]), 1)\n", "code_sha256": "d5a331beba0c748b0193bcb0f4091b75e21210efedd3b1fcf400a78d2c6e5a04", "comments": [{"line": 149, "text": "# Empty string"}, {"line": 152, "text": "# Should have one token (empty string token)"}], "decorators": [], "definition_line": 147, "docstring": "Test tokenization with allow_empty=False", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "80baffa6e6ad702b1e2ad32e0d642402f6691fce41a978a523ccda2413129066", "id": "code_candidate_645c3906a7d77905c00266abb945e52503209fded21d3e2138584b59613ba101", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "Tokenizer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.tokenization", "name": "_infer_stopwords"}], "kind": "method", "line_end": 153, "line_start": 147, "name": "test_tokenize_allow_empty_false", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenization_extended.py", "qualified_name": "TestTokenizationEdgeCases.test_tokenize_allow_empty_false", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def test_tokenize_allow_empty_false(self)", "source_id": "repo_source_6e2bce9e2b16d310c2ca816467344f0cd946d6e4f348f68071df2836562d96b9", "status": "unvalidated", "task": n