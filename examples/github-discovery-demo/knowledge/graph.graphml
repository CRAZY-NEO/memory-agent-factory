    <node id="code_candidate_abb528d42b00be2396c2d3d87e785f62178a01b38019885237632be5c32f90d4">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def save_mmindex(indexes, path, encoding=\"utf-8\"):\n    path = str(path)\n    index_file = change_extension(path, \".mmindex.json\")\n    with open(index_file, \"w\", encoding=encoding) as f:\n        f.write(json_functions.dumps(indexes))\n", "code_sha256": "d5af8e24e8f015aa4f2513bed3b0af39d5f1575a4314b2aa51aeec151dff5ed9", "comments": [], "decorators": [], "definition_line": 58, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6e766e407c789db38b8ae4f56fbd0b9f3bf84e410ffad595493603de9179c007", "id": "code_candidate_abb528d42b00be2396c2d3d87e785f62178a01b38019885237632be5c32f90d4", "imports": [{"alias": null, "level": 0, "line": 1, "module": "logging", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "mmap", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "os", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": "json", "level": 0, "line": 8, "module": "orjson", "name": null}, {"alias": null, "level": 0, "line": 10, "module": "json", "name": null}, {"alias": null, "level": 0, "line": 19, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 1, "line": 23, "module": null, "name": "json_functions"}], "kind": "function", "line_end": 62, "line_start": 58, "name": "save_mmindex", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "indexes"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "path"}, {"annotation": null, "default": "'utf-8'", "kind": "positional_or_keyword", "name": "encoding"}], "path": "bm25s/utils/corpus.py", "qualified_name": "save_mmindex", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def save_mmindex(indexes, path, encoding='utf-8')", "source_id": "repo_source_9c238e0d8cf02a60a1ca21fc96a53350ddd66bc2d369bca811ec00af2621e2bf", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
