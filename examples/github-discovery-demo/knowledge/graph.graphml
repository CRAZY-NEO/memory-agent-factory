      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_tfc_lucene(tf_array, l_d, l_avg, k1, b, delta=None):\n    \"\"\"\n    Computes the term frequency component of the BM25 score using Lucene variant (accurate)\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    return _score_tfc_robertson(tf_array, l_d, l_avg, k1, b)\n", "code_sha256": "1cb7b4789c17358bd89e60254b551cc4d12e42fe8642f4fcd96603e24399cf9e", "comments": [], "decorators": [], "definition_line": 125, "docstring": "\n    Computes the term frequency component of the BM25 score using Lucene variant (accurate)\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_5077531ddeca5cb940e2d8ea9ea2548fc9411933dbd13f246e5a4c9a20a3ed30", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 130, "line_start": 125, "name": "_score_tfc_lucene", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "tf_array"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_d"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "l_avg"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k1"}, {