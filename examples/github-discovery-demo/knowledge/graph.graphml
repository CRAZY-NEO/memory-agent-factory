      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_compute_relevance_from_scores_jit_ready(self):\n        \"\"\"Test the JIT-ready implementation of _compute_relevance_from_scores\"\"\"\n        # Create sample data for testing\n        data = np.array([1.0, 2.0], dtype=np.float32)\n        indices = np.array([0, 1], dtype=np.int32)\n        indptr = np.array([0, 1, 2], dtype=np.int32)\n        num_docs = 3\n        query_tokens_ids = np.array([0, 1], dtype=np.int32)\n        dtype = np.float32\n\n        scores = _compute_relevance_from_scores_jit_ready(\n            data, indptr, indices, num_docs, query_tokens_ids, dtype\n        )\n\n        # Expected: doc 0 has score 1.0, doc 1 has score 2.0, doc 2 has score 0.0\n        expected = np.array([1.0, 2.0, 0.0], dtype=np.float32)\n        np.testing.assert_array_almost_equal(scores, expected)\n", "code_sha256": "d2d054acb64903f57df65d32d07c8bae2f778b00ba9424f6979845a78dfa0dc5", "comments": [{"line": 66, "text": "# Create sample data for testing"}, {"line": 78, "text": "# Expected: doc 0 has score 1.0, doc 1 has score 2.0, doc 2 has score 0.0"}], "decorators": [], "definition_line": 64, "docstring": "Test the JIT-ready implementation of _compute_relevance_from_scores", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "12dde22d99c544ae01ed2fce528c6a05ab27be8a781de28a699c38a8397797a8", "id": "code_candidate_818449daf33a6756f36a4ed774b10a67b7491c92cb4fcff3a9ba0142b203666c", "imports": [{"alias": null, "level": 0, "line": 1, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 2, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_jit_ready"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_compute_relevance_from_scores_legacy"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_idf_scorer"}, {"alias": null, "level": 0, "line": 3, "module": "bm25s.scoring", "name": "_select_tfc_scorer"}], "kind": "method", "line_end": 80, "line_start": 64, "name": "test_compute_relevance_from_scores_jit_ready", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_scoring.py", "qualified_name": "TestScoringFunctions.test_compute_relevance_from_scores_jit_ready", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_compute_relevance_from_scores_jit_ready(self)", "source_id": "repo_source_3dfd7ffc50ded65ec33600c3a1707b7fc7dcd90c18a3c7dd083a37fbc92d70ca", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
