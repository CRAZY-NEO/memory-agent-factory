    <node id="code_candidate_417c05e10e517b0f3ffa251bce853666ae069602d1ed142f205927e46dd82f01">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _topk_jax(query_scores, k):\n    topk_scores, topk_indices = jax.lax.top_k(query_scores, k)\n    topk_scores = np.asarray(topk_scores)\n    topk_indices = np.asarray(topk_indices)\n\n    return topk_scores, topk_indices\n", "code_sha256": "633da807bffbffdee4f919455eb50faea4a39247692ded76f81ede7d383afcce", "comments": [], "decorators": [], "definition_line": 40, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "fc6d6e68870a83c13fdd3cfd8fdcbfeb3f200cb7eb65e77b1e9c969214816481", "id": "code_candidate_417c05e10e517b0f3ffa251bce853666ae069602d1ed142f205927e46dd82f01", "imports": [{"alias": "np", "level": 0, "line": 1, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "jax.lax", "name": null}], "kind": "function", "line_end": 45, "line_start": 40, "name": "_topk_jax", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query_scores"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "k"}], "path": "bm25s/selection.py", "qualified_name": "_topk_jax", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _topk_jax(query_scores, k)", "source_id": "repo_source_c7da3e4b95a090d35669bdcb2a5e2934540ab6c49f042c6f7e4a8a521b80a18c", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
