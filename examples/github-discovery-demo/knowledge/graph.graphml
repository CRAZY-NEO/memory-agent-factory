      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _score_idf_bm25l(df, N):\n    \"\"\"\n    Computes the inverse document frequency component of the BM25 score using BM25L variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    \"\"\"\n    return math.log((N + 1) / (df + 0.5))\n", "code_sha256": "5b4c865fecf54cc6e1e5e7e209b565192f0e435bca7aed1aa237bcf9021dd3f8", "comments": [], "decorators": [], "definition_line": 206, "docstring": "\n    Computes the inverse document frequency component of the BM25 score using BM25L variant\n    Implementation: https://cs.uwaterloo.ca/~jimmylin/publications/Kamphuis_etal_ECIR2020_preprint.pdf\n    ", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "859c13bd8e346d0d585b6743aad010b9e9fcbe163b1b3d6f1d67a72e369e2318", "id": "code_candidate_69aabc7c894219e9bad32084728b283d5219fb33f4572a97a1c0483f75d26dbf", "imports": [{"alias": null, "level": 0, "line": 1, "module": "collections", "name": "Counter"}, {"alias": null, "level": 0, "line": 2, "module": "math", "name": null}, {"alias": "np", "level": 0, "line": 4, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 5, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 13, "module": "tqdm.auto", "name": "tqdm"}, {"alias": null, "level": 0, "line": 18, "module": "numba", "name": "njit"}], "kind": "function", "line_end": 211, "line_start": 206, "name": "_score_idf_bm25l", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "df"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "N"}], "path": "bm25s/scoring.py", "qualified_name": "_score_idf_bm25l", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def _score_idf_bm25l(df, N)", "source_id": "r