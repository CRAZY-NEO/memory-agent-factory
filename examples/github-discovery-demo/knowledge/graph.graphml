    <node id="code_candidate_8e98e281a1c9ce7e4bb82a5e3b9ff225b76b8fdcad7afc04a55760e27eaf0fb9">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "def _version_from_environment():\n    for key in (\"BM25S_VERSION\", \"RELEASE_TAG\"):\n        value = os.environ.get(key)\n        if value:\n            return _normalize_version(value)\n\n    if os.environ.get(\"GITHUB_REF_TYPE\") == \"tag\":\n        value = os.environ.get(\"GITHUB_REF_NAME\")\n        if value:\n            return _normalize_version(value)\n\n    github_ref = os.environ.get(\"GITHUB_REF\", \"\")\n    if github_ref.startswith(\"refs/tags/\"):\n        return _normalize_version(github_ref)\n\n    return None\n", "code_sha256": "662f585cfae403cc6ea71da1add4eeb07a164ef9e6cc41b52d519996c3a9d088", "comments": [], "decorators": [], "definition_line": 21, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "a9a92f87da3e8d01d37b7b7afb5b78b335e4f9b85932a1a120079e6e9b2a47ca", "id": "code_candidate_8e98e281a1c9ce7e4bb82a5e3b9ff225b76b8fdcad7afc04a55760e27eaf0fb9", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "re", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "subprocess", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "pathlib", "name": "Path"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "find_packages"}, {"alias": null, "level": 0, "line": 6, "module": "setuptools", "name": "setup"}], "kind": "function", "line_end": 36, "line_start": 21, "name": "_version_from_environment", "parameters": [], "path": "setup.py", "qualified_name": "_version_from_environment", "repository_key": "38ba002e64c8a5f738a220b2ab6e648320500b4e0b32119f567a7deb1499ac82", "return_annotation": null, "signature": "def _version_from_environment()", "source_id": "repo_source_0d1f311b51d0d09ed327befd6df90b17c01d1bb753011e01353c1c098b4f217d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
