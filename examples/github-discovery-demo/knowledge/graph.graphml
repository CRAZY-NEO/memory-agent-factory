    <node id="code_candidate_d538bbb24def9c9d1c228741111345973a1ee9495574b4b4109acf87af3e17f3">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_retrieve_return_as_documents(self):\n        \"\"\"Test retrieve with return_as='documents'\"\"\"\n        retriever = BM25()\n        retriever.index(self.corpus_tokens)\n        \n        query_tokens = [[\"cat\"]]\n        \n        # Test return_as='documents'\n        results = retriever.retrieve(query_tokens, k=2, return_as=\"documents\")\n        \n        # Should return only documents, not Results tuple\n        self.assertIsInstance(results, np.ndarray)\n        self.assertEqual(len(results), 1)\n        self.assertEqual(len(results[0]), 2)\n", "code_sha256": "d2064ce9c2db31203547ef9a4b2692f46f1b0236b1108c7b3d22f7fc1df1c0e5", "comments": [{"line": 336, "text": "# Test return_as='documents'"}, {"line": 339, "text": "# Should return only documents, not Results tuple"}], "decorators": [], "definition_line": 329, "docstring": "Test retrieve with return_as='documents'", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "95d2516736423343fc897271fbc7ecb19d76000c34f2953efffaf45057ad9dd4", "id": "code_candidate_d538bbb24def9c9d1c228741111345973a1ee9495574b4b4109acf87af3e17f3", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "unittest", "name": null}, {"alias": "np", "level": 0, "line": 5, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "bm25s", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "BM25"}, {"alias": null, "level": 0, "line": 7, "module": "bm25s", "name": "Results"}, {"alias": null, "level": 0, "line": 8, "module": "Stemmer", "name": null}], "kind": "method", "line_end": 342, "line_start": 329, "name": "test_retrieve_return_as_documents", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_core_coverage.py", "qualified_name": "TestBM25CoreFunctions.test_retrieve_return_as_documents", "repository_key": "c8acc94ab355e86dbe463ac794dfa18da6b5e4fed07f459ccf52d0fc838f56e9", "return_annotation": null, "signature": "def test_retrieve_return_as_documents(self)", "source_id": "repo_source_cd2cd4d6081cb8a1a42e2f3f54cd6700f475c55d94c410e0cba07f4da679975d", "status": "unvalidated", "task": null, "trust": "untrusted_repository_evidence", "type_comment": null}</data>
