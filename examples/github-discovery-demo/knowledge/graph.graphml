    <node id="code_candidate_a93c75a6ce32bbe67c2297a37e22ab69013ee1ecd7e6da37d41e5a2de7105c75">
      <data key="d0">CodeCandidate</data>
      <data key="d1">{"algorithm": null, "algorithm_plugin_version": null, "association_method": null, "async": false, "code": "    def test_reset_vocab(self):\n        \"\"\"Tests the `reset_vocab` method to ensure it properly clears all vocabulary dictionaries.\"\"\"\n        self.tokenizer.tokenize(self.corpus, update_vocab=True, show_progress=False)\n        self.tokenizer.reset_vocab()\n        vocab = self.tokenizer.get_vocab_dict()\n        self.assertEqual(len(vocab), 0)\n", "code_sha256": "12834ba2605f76bbc10ad5606e83512781b288e648f49641fa439fef106d8d88", "comments": [], "decorators": [], "definition_line": 121, "docstring": "Tests the `reset_vocab` method to ensure it properly clears all vocabulary dictionaries.", "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "6106a244c483e95035d2242a76957b5f9717fab1005210a6724a274131b1e4ae", "id": "code_candidate_a93c75a6ce32bbe67c2297a37e22ab69013ee1ecd7e6da37d41e5a2de7105c75", "imports": [{"alias": null, "level": 0, "line": 1, "module": "os", "name": null}, {"alias": null, "level": 0, "line": 2, "module": "shutil", "name": null}, {"alias": null, "level": 0, "line": 3, "module": "tempfile", "name": null}, {"alias": null, "level": 0, "line": 4, "module": "typing", "name": "Generator"}, {"alias": null, "level": 0, "line": 5, "module": "unittest", "name": null}, {"alias": null, "level": 0, "line": 6, "module": "Stemmer", "name": null}, {"alias": null, "level": 0, "line": 7, "module": "re", "name": null}, {"alias": "np", "level": 0, "line": 9, "module": "numpy", "name": null}, {"alias": null, "level": 0, "line": 11, "module": "bm25s.tokenization", "name": "Tokenizer"}], "kind": "method", "line_end": 126, "line_start": 121, "name": "test_reset_vocab", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "self"}], "path": "tests/core/test_tokenizer.py", "qualified_name": "TestTokenizer.test_reset_vocab", "repository_key": "c8acc94ab355e86dbe463ac794dfa1