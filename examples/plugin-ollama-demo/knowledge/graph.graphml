ore": 0.06976744186046512}, {"id": "m04", "score": 0.0392156862745098}, {"id": "m20", "score": 0.024390243902439025}], "query": "Jetson Ollama 如何在局域网访问", "query_id": "v07", "relevant_ids": ["m13"]}, {"predictions": [{"id": "m16", "score": 0.32432432432432434}, {"id": "m24", "score": 0.05}, {"id": "m11", "score": 0.03773584905660377}, {"id": "m15", "score": 0.03636363636363636}, {"id": "m07", "score": 0.03571428571428571}], "query": "文本分类类别不平衡不能只看 accuracy", "query_id": "v08", "relevant_ids": ["m16"]}, {"predictions": [{"id": "m19", "score": 0.23809523809523808}, {"id": "m09", "score": 0.0784313725490196}, {"id": "m20", "score": 0.075}, {"id": "m23", "score": 0.05357142857142857}, {"id": "m05", "score": 0.043478260869565216}], "query": "SQLite 并发写事务被阻塞", "query_id": "v09", "relevant_ids": ["m19"]}, {"predictions": [{"id": "m21", "score": 0.15384615384615385}, {"id": "m02", "score": 0.08163265306122448}, {"id": "m06", "score": 0.06818181818181818}, {"id": "m11", "score": 0.0625}, {"id": "m08", "score": 0.041666666666666664}], "query": "BM25 和向量检索怎么融合", "query_id": "v10", "relevant_ids": ["m21"]}, {"predictions": [{"id": "m22", "score": 0.2857142857142857}, {"id": "m11", "score": 0.038461538461538464}, {"id": "m14", "score": 0.03636363636363636}, {"id": "m16", "score": 0.02127659574468085}, {"id": "m02", "score": 0.01818181818181818}], "query": "中文 TF-IDF 字符 ngram 余弦相似度", "query_id": "v11", "relevant_ids": ["m22"]}, {"predictions": [{"id": "m18", "score": 0.24444444444444444}, {"id": "m01", "score": 0.09090909090909091}, {"id": "m14", "score": 0.07407407407407407}, {"id": "m23", "score": 0.06896551724137931}, {"id": "m02", "score": 0.05555555555555555}], "query": "API 超时指数退避与幂等重试", "query_id": "v12", "relevant_ids": ["m18"]}], "query_count": 12, "split": "validation", "top_k": 5}}, {"algorithm": "jaccard", "capability_id": "char_jaccard_d9bf825b40ee", "code_hash": "9042726a7393d61ec400d4004c85731d00f46422cc77be12e48e2a00c56a59ef", "code_path": "./runs/20261013T101009_6655f03f/jaccard/r1/retrieval.py", "explanation": "修复后的代码严格遵循了算法插件的 guidance 和参考示例。主要改进包括：\n1. **Token 处理逻辑**：修复了原代码中中文大词（如'MySQL'）被错误地计入集合重合度的问题。修复版仅提取英文标识符（[a-z0-9_]+）和中文单字/双字，确保 Jaccard 计算仅针对英文单词进行精确匹配，忽略中文字符的复杂组合干扰。\n2. **大小写统一**：在 tokenization 阶段统一将文本转为小写，避免大小写差异导致分数波动。\n3. **空集合处理**：增加了 `if union` 判断，防止因分母为零导致分数异常。\n4. **输入验证**：保留了原有的空查询、空列表、top_k&lt;=0 返回空列表的逻辑。\n5. **排序稳定性**：保持同分按 ID 排序的要求。\n6. **依赖限制**：仅使用 Python 标准库和 `re` 模块，符合依赖要求。接口约定（参数名、返回格式）保持不变。", "implementation_id": "implementation_20261013T101009_6655f03f_jaccard_r1", "parent": "implementation_20261013T101009_6655f03f_jaccard_r0", "revision": 1, "validation": {"errors": ["stability: fresh process returned different results"], "execution": {"runner": "docker", "wall_seconds": 0.24545950000174344}, "gates": {"algorithms": ["tfidf", "bm25", "jaccard"], "max_candidates": 3, "max_repairs": 2, "metrics": {"mrr_at_k": {"max": null, "min": 0.65}, "p95_ms": {"max": 1000.0, "min": null}, "precision_at_k": {"max": null, "min": 0.2}, "recall_at_k": {"max": null, "min": 0.75}}, "plugin_packages": [], "selection_order": ["recall_at_k", "mrr_at_k", "precision_at_k"], "task": "memory_retrieval", "timeout_seconds": 30.0}, "memory_count": 24, "metric_plugins": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "metrics": {"mrr_at_k": 1.0, "p95_ms": 0.6215768662514164, "precision_at_k": 0.20000000000000004, "recall_at_k": 1.0}, "passed": false, "per_query": [{"predictions": [{"id": "m01", "score": 0.2978723404255