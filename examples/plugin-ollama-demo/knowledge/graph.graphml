    <node id="implementation_20261013T172815_22ac726c_jaccard_r0">
      <data key="d0">Implementation</data>
      <data key="d1">{"algorithm": "jaccard", "capability_id": "char_jaccard_d9bf825b40ee", "code_hash": "b05fe3022a50627d18773ff032b7967bd4baa25d3716c0efa03b0951e9b0168a", "code_path": "examples/plugin-ollama-demo/jaccard/r0/retrieval.py", "explanation": "The Jaccard retrieval algorithm implements token-based similarity matching for memory retrieval. It tokenizes both the query and each memory text into sets of characters (including English identifiers and Chinese characters with bigram expansion). The similarity score is calculated as the ratio of the intersection of tokens to the union of tokens. Results are sorted by score descending and ID ascending for stability. Edge cases like empty queries, empty memories, or invalid top_k values return empty lists. The implementation strictly follows the Jaccard guidance: no word frequency or TF-IDF weighting, only set-based intersection and union calculations, and handles Chinese characters and English identifiers separately before combining them into a single token set for comparison.", "implementation_id": "implementation_20261013T172815_22ac726c_jaccard_r0", "parent": null, "revision": 0}</data>
    </node>
