eError: 'set' object is not subscriptable", "v03: TypeError: 'set' object is not subscriptable", "v04: TypeError: 'set' object is not subscriptable", "v05: TypeError: 'set' object is not subscriptable", "v06: TypeError: 'set' object is not subscriptable", "v07: TypeError: 'set' object is not subscriptable", "v08: TypeError: 'set' object is not subscriptable", "v09: TypeError: 'set' object is not subscriptable", "v10: TypeError: 'set' object is not subscriptable", "v11: TypeError: 'set' object is not subscriptable", "v12: TypeError: 'set' object is not subscriptable", "contract:exact: TypeError: 'set' object is not subscriptable", "contract:repeat: TypeError: 'set' object is not subscriptable", "contract:large_k: TypeError: 'set' object is not subscriptable", "contract:unicode: TypeError: 'set' object is not subscriptable"], "execution": {"runner": "docker", "wall_seconds": 0.24799620802514255}, "gates": {"algorithms": ["tfidf", "bm25", "jaccard"], "compare_all_algorithms": true, "max_candidates": 3, "max_repairs": 2, "metrics": {"mrr_at_k": {"max": null, "min": 0.65}, "p95_ms": {"max": 1000.0, "min": null}, "precision_at_k": {"max": null, "min": 0.2}, "recall_at_k": {"max": null, "min": 0.75}}, "plugin_packages": [], "selection_order": ["recall_at_k", "mrr_at_k", "precision_at_k"], "task": "memory_retrieval", "timeout_seconds": 30.0}, "memory_count": 24, "metric_plugins": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "metrics": {}, "passed": false, "per_query": [], "query_count": 12, "split": "validation", "top_k": 5}}], "dataset_hashes": {"memories.json": "95f29cd9ec9088a3e2e531dd5eb30417178dd8d489cf7891caebf55c376bf2bf", "test_queries.json": "3c5c674a30ac8b77037aa9767fbff88eba5f0c276e0f207a28dc68ef06a08fe2", "validation_queries.json": "88ba34d04d0e885026cd26c1ad3d778afd78282246a37147bb4c7cf6267bc9c1"}, "description": "请为个人技术记忆库复刻检索算法，分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较三者，不要只选择其中一个来生成。输入 query、memories、top_k，输出相关记忆 ID 与分数，默认前 5 条。每个候选使用自己的评分方法：TF-IDF 使用余弦相似度，BM25 使用词频与逆文档频率，Jaccard 使用词集合交并比；Jaccard 的集合规则仅约束 Jaccard 候选，不能用于排除 TF-IDF 或 BM25。三者都遵循各自的算法插件指导和参考示例。按配置评估 Recall@k、MRR@k、Precision@k 和 P95 查询耗时，同时检查接口、空输入及跨进程稳定性，选择验证通过的方案并将结果沉淀回知识库。\n", "environment": {"dependencies": {"langgraph": "1.2.14", "networkx": "3.7", "pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": "agent-factory-runner:0.1", "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "docker"}, "llm_calls": 13, "mock_fault_algorithm": null, "mock_fault_injection": false, "model": "qwen3.5:2b", "plan": {"candidates": [{"algorithm": "tfidf", "capability_id": "char_tfidf_efd747a4fcac", "rationale": "TF-IDF 利用词频与逆文档频率加权，能有效捕捉技术文档中特定组件或故障词的语义重要性，适合包含明确组件名的查询场景。"}, {"algorithm": "bm25", "capability_id": "char_bm25_3819f381772f", "rationale": "BM25 结合词频、逆文档频率与文档长度归一化，能更精确地处理不同长度技术笔记，对故障词和组件名的召回率通常优于纯集合算法。"}, {"algorithm": "jaccard", "capability_id": "char_jaccard_d9bf825b40ee", "rationale": "Jaccard 仅基于词集合交并比，计算简单且可解释，但受限于对中文大词敏感及无法区分大小写，需严格限制仅用于英文标识符匹配。"}], "design_explanation": "为满足用户要求，本方案同时规划 TF-IDF、BM25 和 Jaccard 三个独立候选算法。TF-IDF 侧重词频加权以捕捉特定组件信息；BM25 结合长度归一化以优化不同长度文档的匹配精度；Jaccard 作为轻量级集合算法，仅用于英文标识符的精确集合重合检索。三者均遵循各自算法插件指导，并针对中文/英文混合场景进行了针对性优化（如 Jaccard 限制仅匹配英文、TF-IDF 忽略同义改写等），确保在 Recall@k、MRR@k、Precision@k 及 P95 查询耗时指标上全面评估并沉淀验证结果。"}, "plugin_catalog": {"algorithms": [{"dependencies": ["scikit-learn"], "environment": "retrieval-v1", "guidance": "使用 sklearn 字符 1 至 3 元组 TF-IDF 与余弦相似度。拟合语料仅为记忆文本，transform([query]) 后与整个语料计算相似度。", "id": "tfidf", "name": "字符 TF-IDF", "task": "memory_retrieval", "version": "1.0.0"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用原文中的非负 IDF、k1=1.5 和 b=0.75。中文单字/双字及英文词分词；将去重的查询词排序后累加，保持跨进程浮点结果一致。", "id": "bm25", "name": "字符 BM25", "task": "memory_retrieval", "version": "1.0.0"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用中文单字/双字及英文词的集合交并比 len(Q &amp; D)/len(Q | D)。中文双字必须从原文连续中文片段按相邻位置切分，不能从无序集合取字符再拼接。不使用词频、TF-IDF 或 BM25；只返回正分结果，处理空集合。", "id": "jaccard", "name": "集合 Jaccard", "task": "memory_retrieval", "version": "1.0.0"}], "metrics": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "modules": ["agent_factory.plugins.algorithms.bm25", "agent_factory.plugins.algorithms.jaccard", "agent_factory.plugins.algorithms.tfidf", "agent_factory.plugins.metrics.latency", "agent_factory.plugins.metrics.mrr", "agent_factory.plugins.metrics.precision", "agent_factory.plugins.metrics.recall"]}, "provider": "ollama", "request": {"description": "请为个人技术记忆库复刻检索算法，分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较三者，不要只选择其中一个来生成。输入 query、memories、top_k，输出相关记忆 ID 与分数，默认前 5 条。每个候选使用自己的评分方法：TF-IDF 使用余弦相似度，BM25 使用词频与逆文档频率，Jaccard 使用词集合交并比；Jaccard 的集合规则仅约束 Jaccard 候选，不能用于排除 TF-IDF 或 BM25。三者都遵循各自的算法插件指导和参考示例。按配置评估 Recall@k、MRR@k、Precision@k 和 P95 查询耗时，同时检查接口、空输入及跨进程稳定性，选择验证通过的方案并将结果沉淀回知识库。\n", "language": "zh", "task": "memory_retrieval", "top_k": 5}, "run_id": "20261013T172815_22ac726c", "runner": "docker", "selected": {"algorithm": "bm25", "capability_id": "char_bm25_3819f381772f", "code_hash": "196298654b48dd0f8cc11f03254e52a60118b0f5102862f2245f350aaa66deef", "code_path": "examples/plugin-ollama-demo/bm25/r0/retrieval.py", "explanation": "实现字符 BM25 检索算法，包含以下核心步骤：1. 使用确定性分词器将中文单字/双字及英文单词转换为 token 列表；2. 计算文档频率统计每个 token 在文档中的出现次数；3. 对查询词进行去重排序以稳定浮点累加；4. 应用非负 IDF 公式 log(1 + (N - df + 0.5)/(df + 0.5)) 计算词频加权得分；5. 按得分降序、ID 升序排序并截取前 top_k 结果。算法严格遵循参考示例中的参数 k1=1.5、b=0.75 及分词策略，确保跨进程结果稳定性。", "implementation_id": "implementation_20261013T172815_22ac726c_bm25_r0", "parent": null, "revision": 0, "validation": {"errors": [], "execution": {"runner": "docker", "wall_seconds": 0.3582032499834895}, "gates": {"algorithms": ["tfidf", "bm25", "jaccard"], "compare_all_algorithms": true, "max_candidates": 3, "max_repairs": 2, "metrics": {"mrr_at_k": {"max": null, "min": 0.65}, "p95_ms": {"max": 1000.0, "min": null}, "precision_at_k": {"max": null, "min": 0.2}, "recall_at_k": {"max": null, "min": 0.75}}, "plugin_packages": [], "selection_order": ["recall_at_k", "mrr_at_k", "precision_at_k"], "task": "memory_retrieval", "timeout_seconds": 30.0}, "memory_count": 24, "metric_plugins": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "metrics": {"mrr_at_k": 1.0, "p95_ms": 1.128077055909671, "precision_at_k": 0.20000000000000004, "recall_at_k": 1.0}, "passed": true, "per_query": [{"predictions": [{"id": "m01", "score": 46.80145774093894}, {"id": "m09", "score": 8.24913288024384}, {"id":