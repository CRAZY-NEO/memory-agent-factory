    <node id="environment_1b948765de34bb4e7a8dbf31f6924344cc964c86d73efd7ffa509d4de787e46f">
      <data key="d0">Environment</data>
      <data key="d1">{"dependencies": {"langgraph": "1.2.14", "networkx": "3.7", "pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": "agent-factory-runner:0.1", "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "docker", "worker_sha256": "b1101f539da9232bf8bb10ae375a6df8e8c1577775b09b77dc0f257636c7d94f"}</data>
