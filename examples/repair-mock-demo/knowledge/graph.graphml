pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": "agent-factory-runner:0.1", "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "docker", "worker_sha256": "b1101f539da9232bf8bb10ae375a6df8e8c1577775b09b77dc0f257636c7d94f"}, "generation_policy": "focused-repair-v2", "llm_calls": 10, "mock_fault_algorithm": null, "mock_fault_injection": false, "model": "mock-template-v1", "plan": {"candidates": [{"algorithm": "tfidf", "capability_id": "char_tfidf_b4505e839264", "rationale": "来自材料的适用条件：适用：小规模中文与英文混合笔记、词面相近的排错记录和项目决策。"}, {"algorithm": "bm25", "capability_id": "char_bm25_0f592b104c61", "rationale": "来自材料的适用条件：适用：不同长度的技术笔记、包含明确组件名或故障词的查询。"}, {"algorithm": "jaccard", "capability_id": "char_jaccard_45115d64dc38", "rationale": "来自材料的适用条件：适用：小规模中文与英文混合技术笔记、需要轻量且可解释的词集合重合检索。"}], "design_explanation": "比较注册算法 tfidf, bm25, jaccard，按配置的可信验证集指标选择通过检查的方案。"}, "plugin_catalog": {"algorithms": [{"dependencies": ["scikit-learn"], "environment": "retrieval-v1", "guidance": "使用 sklearn 字符 1 至 3 元组 TF-IDF 与余弦相似度。必须对 texts=[memory[\"text\"] for memory in memories] 拟合，每条完整记忆对应矩阵一行，行数必须等于 len(memories)。禁止把拆分去重的词当成多篇文档，禁止移除中文或过滤行后仍用原列表索引；transform([query]) 后与整个语料计算相似度。", "id": "tfidf", "name": "字符 TF-IDF", "public_cases": [{"expected": [{"id": "a", "score": 1.0000000000000016}, {"id": "b", "score": 0.46518071501565006}], "memories": [{"id": "a", "source": "public://a", "text": "甲乙 alpha beta"}, {"id": "b", "source": "public://b", "text": "乙丙 alpha gamma"}], "query": "甲乙 alpha beta", "top_k": 5}], "task": "memory_retrieval", "version": "1.0.0"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用原文中的非负 IDF、k1=1.5 和 b=0.75。中文单字/双字及英文词分词；将去重的查询词排序后累加，保持跨进程浮点结果一致。", "id": "bm25", "name": "字符 BM25", "public_cases": [], "task": "memory_retrieval", "version": "1.0.0"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用中文单字/双字及英文词的集合交并比 len(Q &amp; D)/len(Q | D)。中文双字必须从原文连续中文片段按相邻位置切分，不能从无序集合取字符再拼接。不使用词频、TF-IDF 或 BM25；只返回正分结果，处理空集合。", "id": "jaccard", "name": "集合 Jaccard", "public_cases": [{"expected": [{"id": "a", "score": 1.0}, {"id": "b", "score": 0.2}], "memories": [{"id": "a", "source": "public://a", "text": "甲乙"}, {"id": "b", "source": "public://b", "text": "乙丙"}], "query": "甲乙", "top_k": 5}], "task": "memory_retrieval", "version": "1.0.0"}], "metrics": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "modules": ["agent_factory.plugins.algorithms.bm25", "agent_factory.plugins.algorithms.jaccard", "agent_factory.plugins.algorithms.tfidf", "agent_factory.plugins.metrics.latency", "agent_factory.plugins.metrics.mrr", "agent_factory.plugins.metrics.precision", "agent_factory.plugins.metrics.recall"]}, "provider": "mock", "request": {"description": "请为个人技术记忆库复刻检索算法，分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较三者，不要只选择其中一个来生成。输入 query、memories、top_k，输出相关记忆 ID 与分数，默认前 5 条。每个候选使用自己的评分方法：TF-IDF 使用余弦相似度，BM25 使用词频与逆文档频率，Jaccard 使用词集合交并比；Jaccard 的集合规则仅约束 Jaccard 候选，不能用于排除 TF-IDF 或 BM25。三者都遵循各自的算法插件指导和参考示例。按配置评估 Recall@k、MRR@k、Precision@k 和 P95 查询耗时，同时检查接口、空输入及跨进程稳定性，选择验证通过的方案并将结果沉淀回知识库。\n", "language": "mixed", "task": "memory_retrieval", "top_k": 5}, "run_id": "20261013T182515_5f56e71b", "runner": "docker", "selected": {"algorithm": "bm25", "capability_id": "char_bm25_0f592b104c61", "code_hash": "a68fae3c50925689492cb3cb78dca5d24c96396b70083db2577e39e4af1c2b4c", "code_path": "examples/repair-mock-demo/bm25/r0/retrieval.py", "explanation": "规则模板演示", "genera