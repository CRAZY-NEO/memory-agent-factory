sed_relevant_ids": [], "predictions": [{"id": "m18", "score": 0.11764705882352941}, {"id": "m42", "score": 0.11702127659574468}, {"id": "m17", "score": 0.10891089108910891}, {"id": "m09", "score": 0.07766990291262135}, {"id": "m14", "score": 0.07547169811320754}], "query": "API 请求超时怎样做幂等退避，同时日志如何避免保存密钥", "query_id": "v35", "relevant_ids": ["m18", "m17"]}, {"annotation": "要求事实版本与访问权限，刷新页面缓存不足以回答。", "category": "multi_relevance", "failure_types": [], "first_relevant_rank": 1, "hard_negative_confusions": [], "hard_negative_hits": [{"id": "m47", "rank": 3}], "hard_negative_ids": ["m47"], "missed_relevant_ids": [], "predictions": [{"id": "m24", "score": 0.19827586206896552}, {"id": "m46", "score": 0.11538461538461539}, {"id": "m47", "score": 0.09848484848484848}, {"id": "m45", "score": 0.04918032786885246}, {"id": "m35", "score": 0.047244094488188976}], "query": "个人记忆新旧事实冲突如何保留证据，检索又怎样按租户控制访问", "query_id": "v36", "relevant_ids": ["m24", "m46"]}], "query_count": 36, "split": "validation", "top_k": 5}}], "dataset_hashes": {"memories.json": "d9a8c6a1fbbd0b6b50798cb4b7915ff10abb3ddb69479798804f2f621e125320", "test_queries.json": "7512ce5cea3fbd40e3e049f167b7ffdbe5443f22cec9f7b320ae5d216adbe826", "validation_queries.json": "cca76193a74262b0dabe271375b3c1322b2330af967c6de6e4b0a0b1ec102e2f"}, "description": "请为个人技术记忆库复刻检索算法，分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较三者，不要只选择其中一个来生成。输入 query、memories、top_k，输出相关记忆 ID 与分数，默认前 5 条。每个候选使用自己的评分方法：TF-IDF 使用余弦相似度，BM25 使用词频与逆文档频率，Jaccard 使用词集合交并比；Jaccard 的集合规则仅约束 Jaccard 候选，不能用于排除 TF-IDF 或 BM25。三者都遵循各自的算法插件指导和参考示例。按配置评估 Recall@k、MRR@k、Precision@k 和 P95 查询耗时，同时检查接口、空输入及跨进程稳定性，选择验证通过的方案并将结果沉淀回知识库。\n", "environment": {"dependencies": {"langgraph": "1.2.14", "networkx": "3.7", "pydantic": "2.14.1", "scikit-learn": "1.9.1"}, "docker_image": "agent-factory-runner:0.1", "platform": "macOS-26.6.2-arm64-arm-64bit", "python": "3.12.14 (main, Aug 25 2026, 13:50:33) [Clang 22.1.3 ]", "runner": "docker", "worker_sha256": "b1101f539da9232bf8bb10ae375a6df8e8c1577775b09b77dc0f257636c7d94f"}, "generation_policy": "focused-repair-v2", "llm_calls": 10, "mock_fault_algorithm": "bm25", "mock_fault_injection": true, "model": "mock-template-v1", "plan": {"candidates": [{"algorithm": "tfidf", "capability_id": "char_tfidf_1c2a193fe7ef", "rationale": "来自材料的适用条件：适用：小规模中文与英文混合笔记、词面相近的排错记录和项目决策。"}, {"algorithm": "bm25", "capability_id": "char_bm25_0f592b104c61", "rationale": "来自材料的适用条件：适用：不同长度的技术笔记、包含明确组件名或故障词的查询。"}, {"algorithm": "jaccard", "capability_id": "char_jaccard_00f7e68fbdb0", "rationale": "来自材料的适用条件：适用：小规模中文与英文混合技术笔记、需要轻量且可解释的词集合重合检索。"}], "design_explanation": "比较注册算法 tfidf, bm25, jaccard，按配置的可信验证集指标选择通过检查的方案。"}, "plugin_catalog": {"algorithms": [{"dependencies": ["scikit-learn"], "environment": "retrieval-v1", "guidance": "使用 sklearn 字符 1 至 3 元组 TF-IDF 与余弦相似度。必须对 texts=[memory[\"text\"] for memory in memories] 拟合，每条完整记忆对应矩阵一行，行数必须等于 len(memories)。禁止把拆分去重的词当成多篇文档，禁止移除中文或过滤行后仍用原列表索引；transform([query]) 后与整个语料计算相似度。", "id": "tfidf", "name": "字符 TF-IDF", "public_cases": [{"expected": [{"id": "a", "score": 1.0000000000000016}, {"id": "b", "score": 0.46518071501565006}], "memories": [{"id": "a", "source": "public://a", "text": "甲乙 alpha beta"}, {"id": "b", "source": "public://b", "text": "乙丙 alpha gamma"}], "query": "甲乙 alpha beta", "top_k": 5}], "task": "memory_retrieval", "version": "1.0.1"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用原文中的非负 IDF、k1=1.5 和 b=0.75。中文单字/双字及英文词分词；将去重的查询词排序后累加，保持跨进程浮点结果一致。", "id": "bm25", "name": "字符 BM25", "public_cases": [], "task": "memory_retrieval", "version": "1.0.0"}, {"dependencies": [], "environment": "retrieval-v1", "guidance": "使用中文单字/双字及英文词的集合交并比 len(Q &amp; D)/len(Q | D)。中文双字必须从原文连续中文片段按相邻位置切分，不能从无序集合取字符再拼接。英文标识符必须整词加入集合，例如 tokens.add(fragment)，禁止 tokens.update(fragment) 将英文拆成字母；alpha 与 beta 的英文词集合没有交集。不使用词频、TF-IDF 或 BM25；只返回正分结果，处理空集合。", "id": "jaccard", "name": "集合 Jaccard", "public_cases": [{"expected": [{"id": "a", "score": 1.0}, {"id": "b", "score": 0.2}], "memories": [{"id": "a", "source": "public://a", "text": "甲乙"}, {"id": "b", "source": "public://b", "text": "乙丙"}], "query": "甲乙", "top_k": 5}, {"expected": [{"id": "a", "score": 1.0}], "memories": [{"id": "a", "source": "public://a", "text": "alpha"}, {"id": "b", "source": "public://b", "text": "beta"}], "query": "ALPHA", "top_k": 5}], "task": "memory_retrieval", "version": "1.0.1"}], "metrics": [{"direction": "higher", "id": "recall_at_k", "maximum": 1, "minimum": 0, "name": "Recall@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "mrr_at_k", "maximum": 1, "minimum": 0, "name": "MRR@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "higher", "id": "precision_at_k", "maximum": 1, "minimum": 0, "name": "Precision@k", "task": "memory_retrieval", "version": "1.0.0"}, {"direction": "lower", "id": "p95_ms", "maximum": null, "minimum": 0, "name": "P95 ms", "task": "memory_retrieval", "version": "1.0.0"}], "modules": ["agent_factory.plugins.algorithms.bm25", "agent_factory.plugins.algorithms.jaccard", "agent_factory.plugins.algorithms.tfidf", "agent_factory.plugins.metrics.latency", "agent_factory.plugins.metrics.mrr", "agent_factory.plugins.metrics.precision", "agent_factory.plugins.metrics.recall"]}, "provider": "mock", "request": {"description": "请为个人技术记忆库复刻检索算法，分别生成 TF-IDF、BM25、Jaccard 三个独立候选并比较三者，不要只选择其中一个来生成。输入 query、memories、top_k，输出相关记忆 ID 与分数，默认前 5 条。每个候选使用自己的评分方法：TF-IDF 使用余弦相似度，BM25 使用词频与逆文档频率，Jaccard 使用词集合交并比；Jaccard 的集合规则仅约束 Jaccard 候选，不能用于排除 TF-IDF 或 BM25。三者都遵循各自的算法插件指导和参考示例。按配置评估 Recall@k、MRR@k、Precision@k 和 P95 查询耗时，同时检查接口、空输入及跨进程稳定性，选择验证通过的方案并将结果沉淀回知识库。\n", "language": "mixed", "task": "memory_retrieval", "top_k": 5}, "run_id": "20261014T033355_6999daf6", "runner": "docker", "selected": {"algorithm": "tfidf", "capability_id": "char_tfidf_1c2a193fe7ef", "code_hash": "84fbe993c241919f3a551f0f81a7be700dfa09e16c23ae1a37b746ca7b432d6a", "code_path": "examples/repository-demo/tfidf/r0/retrieval.py", "explanation":