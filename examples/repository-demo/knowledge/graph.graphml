      <data key="d1">{"algorithm": "jaccard", "algorithm_plugin_version": "1.0.1", "association_method": "operator_explicit", "async": false, "code": "def retrieve(query, memories, top_k=5):\n    if not query.strip() or not memories or top_k &lt;= 0:\n        return []\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    hits = []\n    for memory in memories:\n        document_tokens = tokenize(memory[\"text\"])\n        union = query_tokens | document_tokens\n        score = len(query_tokens &amp; document_tokens) / len(union) if union else 0.0\n        if score &gt; 0:\n            hits.append({\"id\": memory[\"id\"], \"score\": float(score)})\n    return sorted(hits, key=lambda hit: (-hit[\"score\"], hit[\"id\"]))[:top_k]\n", "code_sha256": "333b1fae1d32a4ce3bad2a633720270473d699dac470b86c779a67ce0efe2e85", "comments": [], "decorators": [], "definition_line": 14, "docstring": null, "extraction_method": "python_ast", "extractor_version": "1.0.0", "file_sha256": "4fb0baa6a02f22aae5d5a6329794e367342d3c178e437b7c22b8d96b77de0894", "id": "code_candidate_211d8eb3d6ad1e05835dce6f72435004da8200e4abd13fe6b330caf57b1acfb8", "imports": [{"alias": null, "level": 0, "line": 3, "module": "re", "name": null}], "kind": "function", "line_end": 27, "line_start": 14, "name": "retrieve", "parameters": [{"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "query"}, {"annotation": null, "default": null, "kind": "positional_or_keyword", "name": "memories"}, {"annotation": null, "default": "5", "kind": "positional_or_keyword", "name": "top_k"}], "path": "agent_factory/templates/jaccard.py", "qualified_name": "retrieve", "repository_key": "25aa67c66aeae3b8fd517565692c0cb67ac566c47c861d881a51ff304adb9d1f", "return_annotation": null, "signature": "def retrieve(query, memories, top_k=5)", "source_id": "repo_source_84d383c36e221568fbd7bc1fee96980c6fdece020b761264441a66ed307bb88c", "status": "unvalidated", "task": "memory_retrieval", "trust": "untrusted_repository_evidence", "type_comment": null}</data>
