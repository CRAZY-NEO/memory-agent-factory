    <node id="repo_source_84d383c36e221568fbd7bc1fee96980c6fdece020b761264441a66ed307bb88c">
      <data key="d0">Source</data>
      <data key="d1">{"byte_count": 956, "encoding": "utf-8", "id": "repo_source_84d383c36e221568fbd7bc1fee96980c6fdece020b761264441a66ed307bb88c", "imports": [{"alias": null, "level": 0, "line": 3, "module": "re", "name": null}], "module_docstring": "Set Jaccard retrieval with Chinese characters/bigrams and English identifiers.", "path": "agent_factory/templates/jaccard.py", "repository_key": "25aa67c66aeae3b8fd517565692c0cb67ac566c47c861d881a51ff304adb9d1f", "sha256": "4fb0baa6a02f22aae5d5a6329794e367342d3c178e437b7c22b8d96b77de0894", "source_type": "python_repository", "text": "\"\"\"Set Jaccard retrieval with Chinese characters/bigrams and English identifiers.\"\"\"\n\nimport re\n\n\ndef tokenize(text):\n    tokens = set(re.findall(r\"[a-z0-9_]+\", text.lower()))\n    for fragment in re.findall(r\"[\\u4e00-\\u9fff]+\", text):\n        tokens.update(fragment)\n        tokens.update(fragment[index:index + 2] for index in range(len(fragment) - 1))\n    return tokens\n\n\ndef retrieve(query, memories, top_k=5):\n    if not query.strip() or not memories or top_k &lt;= 0:\n        return []\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    hits = []\n    for memory in memories:\n        document_tokens = tokenize(memory[\"text\"])\n        union = query_tokens | document_tokens\n        score = len(query_tokens &amp; document_tokens) / len(union) if union else 0.0\n        if score &gt; 0:\n            hits.append({\"id\": memory[\"id\"], \"score\": float(score)})\n    return sorted(hits, key=lambda hit: (-hit[\"score\"], hit[\"id\"]))[:top_k]\n"}</data>
    </node>
    <node id="code_candidate_c5e0adf886224595fdeb580385806d49ad95766817190e36a08926fd31510acd">
