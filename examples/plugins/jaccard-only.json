{
  "task": "memory_retrieval",
  "algorithms": [
    "jaccard"
  ],
  "max_candidates": 1,
  "metrics": {
    "recall_at_k": {
      "min": 0.75
    },
    "mrr_at_k": {
      "min": 0.65
    },
    "precision_at_k": {
      "min": 0.2
    },
    "p95_ms": {
      "max": 1000
    }
  },
  "selection_order": [
    "recall_at_k",
    "mrr_at_k",
    "precision_at_k"
  ],
  "timeout_seconds": 30,
  "max_repairs": 2
}
