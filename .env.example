# 默认：Mac 直接调用 DeepSeek API，无需 Jetson / SSH 隧道。
# 复制为 .env 后填写 Key；该文件被 Git 与 Docker 构建上下文忽略。
FACTORY_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=8192
# 如需切回本地模型，设置 FACTORY_PROVIDER=ollama，并调整以下地址。
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:2b
# 可选：上下文 token 容量，默认 8192；内存有限的 Jetson 可尝试 4096。
OLLAMA_NUM_CTX=8192
# 当前 TF-IDF/BM25 不使用 embedding；保留你已有项目的模型约定。
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
FACTORY_RUNNER=docker
# serve_web.py 会自动管理网页访问密钥；手动部署 API / Compose 时另设随机值。
# FACTORY_API_TOKEN=CHANGE_ME_GENERATE_A_PRIVATE_RANDOM_TOKEN
# Docker API 容器与宿主 worker 使用同一用户的 UID/GID，按 id -u / id -g 修改。
FACTORY_UID=1000
FACTORY_GID=1000
